# ============================================================================
# std/livereload.fpr -- std.livereload: HOT MODULE SWAP for running
# FP-RISC programs on QOS.
#
# The pieces this composes (all of which existed; this module is the
# convention that makes them a reload system):
#
#   the DISK STORE      versioned module .qa records on the qlog disk
#                       (apps/<id>.qa -- the .fpr/store ON the .disk:
#                       mathv1, mathv2, ... are separate records, and
#                       `fpr commit` is what minted them as versions,
#                       carrying the STATIC row-polymorphic signature
#                       compatibility check)
#   Sys.attachQa        load the .qa bytes into a plugin sub-slot of
#                       the running image and register its module
#                       table -- the new version sits ALONGSIDE the
#                       old (no W^X, no GOT: a resolve is a table
#                       walk, a call is a PAP apply, deliberately)
#   Mod.find            NEWEST ATTACHMENT WINS (mod.c): re-resolving
#                       a name after an attach binds the new code;
#                       in-flight calls into the old image run to
#                       completion -- nothing is unmapped
#   Mod.compatAt        the LOAD-TIME seatbelt: every export of the
#                       version being replaced must exist in the new
#                       table with the same arity, else the swap is
#                       REFUSED and the old binding stands
#
# The protocol: a SUPERVISOR owns the swap; WORKERS re-bind on its
# message.
#
#   supervisor:  r = LR.load dsk head "mathv2";     # store -> slot
#                case r of Ok i -> broadcast (LiveReload "mathv2")
#   worker:      m = receive me;
#                case m of
#                  LiveReload u -> loop me (LR.bind "mathOp") state
#                | w             -> ... use the bound fn ...
#
# State survives BY CONSTRUCTION: the worker's accumulator is its own
# loop argument; only the fn value it calls through changes.
# ============================================================================

QL = use "../programs/mods/qlog".

LRMsg = Type (LiveReload url).

# ---- the supervisor side ----------------------------------------------------

# load a module version out of the DISK store into the running image:
# read apps/<id>.qa off the qlog, attach it (new plugin sub-slot +
# module table), and GATE it against the previously newest table --
# refuse (Err) rather than let an incompatible swap through.  Ok n =
# the attached table's index (n-1 tables existed before it).
load : unsafe _ -> Int -> String -> Result Int String .
load dsk head id =
  before = Mod.plugs 0;
  bytes = QL.readLatest dsk head (strcat "apps/" (strcat id ".qa"));
  case bytes of
    Err e -> Err (strcat "store: " e)
  | Ok b -> loadAttach before b.
loadAttach : unsafe Int -> String -> Result Int String .
loadAttach before b =
  r = Sys.attachQa b;
  case r of
    Err e -> Err e
  | Ok u -> loadGate before.
loadGate : unsafe Int -> Result Int String .
loadGate before =
  after = Mod.plugs 0;
  case before == 0 of
    True -> Ok (after - 1)          # first version: nothing to gate against
  | False -> loadGate2 before after.
loadGate2 : unsafe Int -> Int -> Result Int String .
loadGate2 before after =
  (ok, why) = Mod.compatAt (before - 1) (after - 1);
  case ok == 1 of
    True -> Ok (after - 1)
  | False -> loadRefuse why.
loadRefuse : unsafe String -> Result Int String .
loadRefuse why =
  # DETACH the just-attached table: a refused swap must leave every
  # binding exactly as it was (newest-wins would otherwise resolve
  # into the incompatible code).  The sub-slot is spent -- stated
  # cost of no-unload v1 -- but the registry falls back cleanly.
  _ = Mod.detachLast Unit;
  Err (strcat "incompatible module refused: " why).

# tell every worker to re-bind; workers answer nothing (fire-and-forget)
broadcast : unsafe List Int -> String -> Unit .
broadcast workers url = case workers of
    Nil -> Unit
  | w :: r -> send w (LiveReload url) >> broadcast r url.

# ---- the worker side --------------------------------------------------------

# re-resolve an export by name; newest attached module wins.  A miss
# is a bug at this layer (the supervisor gated the load), so be loud.
bind : String -> _ .
bind name =
  (ok, f) = Mod.find name;
  case ok == 1 of
    True -> f
  | False -> error "livereload: no attached module exports {name}".
