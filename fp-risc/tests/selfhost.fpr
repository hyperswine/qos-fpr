# selfhost.fpr -- the on-QOS ladder, END TO END, without leaving the
# running system: SOURCE STRINGS edited inside the app are compiled
# and PACKAGED into hot-loadable module .qa bytes (CP.plugin -> the
# tag-7 channel -> the host fprd daemon running the plugin-qa
# pipeline), appended to the app's own qlog store as apps/<id>.qa --
# the same records a seeded disk carries -- and pulled back through
# std.livereload's compat gate:
#
#   1. v1 ("editLine s = s") packaged at sub-slot 0, stored, loaded,
#      bound, used
#   2. v2 (capitalize-first, same signature) packaged at sub-slot 1:
#      the gate passes, the SAME app re-binds -- a hot swap whose
#      whole toolchain round trip started from a string in the model
#   3. the impostor (arity drift) packages FINE but the load REFUSES
#      it and v2 stays bound -- the checked precondition, not a
#      convention, exactly as with disk-seeded versions
#
# The store records SURVIVE: a later boot of this disk can LR.load
# "selfed2" without any compiler present.
#
#   ./qos.py run tests/selfhost.fpr     (the directive below starts the
#                                        compiler daemon for the run)
#: fprd
#: expect selfhost: v1 one | v2 hot self-compiled Two | bad: refused | still v2: Three ver=self.v2
#
#   by hand: python3 tools/fprd.py &  then the usual qos-app + qosp run

CP = use "../std/compile".
QL = use "../programs/mods/qlog".
LR = use "../std/livereload".

srcV1 = "editLine s = s.\neditName u = \"self.v1\".".

# no string interpolation inside the embedded source (keeps escaping
# honest): v2 capitalizes via strcat/chr instead of a {..} splice
srcV2 = "editLine s = case strlen s == 0 of True -> s | False -> strcat (chr (upC (charAt s 1))) (substr s 2 (strlen s - 1)).\nupC c = case c >= 97 of True -> upD c | False -> c.\nupD c = case c <= 122 of True -> c - 32 | False -> c.\neditName u = \"self.v2\".".

srcBad = "editLine a b = a.\neditName u = \"self.bad\".".

expectOk what r = case r of
    Ok v -> v
  | Err e -> error "selfhost {what}: {e}".

# source -> .qa bytes (the daemon packages at sub-slot <slot>'s base)
# -> a store record any later boot can load; returns the new head
mint dsk h slot id src =
  qa = expectOk "package {id}" (CP.plugin slot id src);
  QL.appendRec dsk h "QREC" "apps/{id}.qa" qa.

main =
  dsk = device "blk";
  h0 = QL.ensure dsk;
  h1 = mint dsk h0 0 "selfed1" srcV1;
  _ = expectOk "load v1" (LR.load dsk h1 "selfed1");
  n1 = (LR.bind "editLine") "one";
  h2 = mint dsk h1 1 "selfed2" srcV2;
  _ = expectOk "load v2" (LR.load dsk h2 "selfed2");
  n2 = (LR.bind "editLine") "two";
  h3 = mint dsk h2 2 "selfedbad" srcBad;
  bad = LR.load dsk h3 "selfedbad";
  badS = case bad of Ok i -> "ACCEPTED?!" | Err e -> "refused";
  n3 = (LR.bind "editLine") "three";
  ver = (LR.bind "editName") "";
  "selfhost: v1 {n1} | v2 hot self-compiled {n2} | bad: {badS} | still v2: {n3} ver={ver}".
