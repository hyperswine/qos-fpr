# autodrop.fpr — the drop-what-you-receive LAW discharged by the
# compiler.  NO actor below writes a manual drop; the autodrop pass
# inserts them (see the compile-time notes) and arcLive stays flat:
#   echo   the destructure shape: m = receive; (a, b) = m
#   nsvc   the CASE-SCRUTINEE shape: m = receive; case m of Ask r s ->
#          — the storage-actor loop.  The drop lands at the ARM's
#          START while the arm still reads the STRING s out of the
#          message; that borrow survives because the runtime defers
#          the slab release to this actor's next receive
#          (fpr_drop_park), which is the whole deferred-drop contract
#          proved end to end here.
# loop's reply handling is the destructure shape too, so main's own
# receives are covered.
uart = device "uart" .
lsrReady = v = read (reg8 uart 5); BITTEST v 5 .
putc : unsafe Int -> Unit .
putc c | lsrReady = write (reg8 uart 0) c.
putc c = putc c .
# console text over THIS file's putc (the prelude cannot host these:
# putc is per-target device code, and the prelude is a cached unit)
puts : unsafe String -> Unit .
puts s = putsFrom s 1 .
putsFrom : unsafe String -> Int -> Unit .
putsFrom s i | i > strlen s = Unit.
putsFrom s i = putc (charAt s i) >> putsFrom s (i + 1) .
nl : unsafe Unit .
nl = putc 13 >> putc 10 .

Ask = Type (Ask replyTo s).

# no manual drop anywhere in this file
echo : unsafe Int -> i36 .
echo me =
  m = receive me;
  (replyTo, n) = m;
  send replyTo (n * 2, 0) >> echo me .

# the case-scrutinee shape, with a HEAP payload: strlen s runs after
# the compiler-inserted drop
nsvc : unsafe Int -> a1 .
nsvc me =
  m = receive me;
  case m of
    Ask replyTo s -> send replyTo (strlen s, 0) >> nsvc me .

nloop : unsafe Int -> Int -> Int -> Int -> Int -> Int .
nloop me v n stop acc | n > stop = acc.
nloop me v n stop acc =
  _ = send v (Ask me "payload-{n}");
  r = receive me;
  (ln, z) = r;
  nloop me v (n + 1) stop (acc + ln) .

loop : unsafe Int -> Int -> Int -> Int -> Int -> Int .
loop me e n stop acc | n > stop = acc.
loop me e n stop acc =
  _ = send e (me, n);
  r = receive me;
  (v, z) = r;
  loop me e (n + 1) stop (acc + v) .

main =
  me = myself 0;
  _ = nl >> puts "autodrop: the drop law, discharged by the compiler" >> nl;
  e = spawn echo;
  s1 = loop me e 1 1 0;
  base = arcLive 0;
  _ = puts "after round 1:    arcLive = {base}" >> nl;
  s = loop me e 2 200 s1;
  lv = arcLive 0;
  _ = puts "after round 200:  arcLive = {lv}   (sum = {s})" >> nl;
  v = spawn nsvc;
  s2 = nloop me v 1 200 0;
  lv2 = arcLive 0;
  _ = puts "case-shape 200:   arcLive = {lv2}  (lensum = {s2})" >> nl;
  verdict2 (lv == base) (lv2 == base) (s2 == 2092) .

verdict2 : unsafe Bool -> Bool -> Bool -> Unit .
verdict2 True True True = puts "AUTODROP HOLDS: 400 undropped-by-hand round trips (destructure + case shapes), zero Arc growth" >> nl.
verdict2 a b c = puts "AUTODROP FAILED: flat1={a} flat2={b} sum={c}" >> nl.
