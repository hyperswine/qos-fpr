# mvutick.fpr -- std.MVU's first app: a tick-driven counter, headless,
# proving the extracted architecture without a display:
#
#   - no input actor (input = 0): update receives ONLY the per-frame
#     tick (k = 0)
#   - skey = count / 10: the statics REBUILD exactly when the tens
#     digit rolls -- expect builds #1..#4 banners from textRender and
#     "4 statics builds" in the result (counts 1..30 span keys 0..3)
#   - MQuit at count 31 -> exactly 30 rendered frames
#   - vals runs in the persistent worker each frame; poolReset at every
#     frame boundary keeps the arena flat (Sys.memStats in the result)
#
#   make qos-app-macos PROG=tests/mvutick.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# Expected result line:
#   mvutick: final count=31, arena <g>g/<m>MB [mvu: 30 frames, 4 statics builds]

MV = use "../std/mvu".

MApp = MV.MApp.
MQuit = MV.MQuit.
MLog = MV.MLog.

appInit env = 0.

appUpdate me env k count = case k == 0 of
    True -> tickUp count
  | False -> (count, Nil).
tickUp count = case count + 1 > 30 of
    True -> (count + 1, MQuit :: Nil)
  | False -> tickQ (count + 1).
tickQ c = case c == 10 of
    True -> (c, MLog "mvutick: crossed 10" :: Nil)
  | False -> (c, Nil).

appSkey count = count / 10.

appView vp count =
  (vw, vh) = vp;
  band = count / 10;
  "MVUTICK  {vw}x{vh}" :: "band {band}0s" :: Nil.

appVals self env vp count =
  (g, mb) = Sys.memStats 0;
  "count={count}" :: "arena={g}g" :: Nil.

appDone count =
  (g, mb) = Sys.memStats 0;
  "mvutick: final count={count}, arena {g}g/{mb}MB".

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  render = spawn MV.textRender;
  # cfg is an open record now: name what you provide, in any order,
  # and add app-private fields freely -- nothing downstream re-arities
  cfg = { env = 0, mt = mt, tick = 30000, input = 0, render = render };
  app = MApp appInit appUpdate appSkey appView appVals appDone;
  MV.run me cfg app.
