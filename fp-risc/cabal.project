-- one package; sol/ is examples+lib sources for the LANGUAGE, not
-- Haskell -- the fold put all the Haskell under compiler/
packages: .

package fp-risc
  -- `make fpr` discovers Homebrew llvm@18 automatically on macOS.
  -- These are only needed for direct `cabal build` on this example host.
  extra-lib-dirs: /opt/homebrew/opt/llvm@18/lib
  include-dirs: /opt/homebrew/opt/llvm@18/include
  -- profiling build: uncomment
  -- profiling: True
