# ============================================================================
# terra2.fpr -- Terra II, the card game (docs/TERRA2.md), in FP-RISC on QOS.
#
# The V1 rules cut down to what proves the POSITIONAL economy on a screen:
# two zones x five slots a side, supply earned from rear units and drained
# by heavies, CALL / RETREAT / ADVANCE, attack within +-1 column, cover
# (a rear unit behind a friendly forward unit cannot be hit), lanes (both
# slots of a column empty expose the HQ), Overwatch (50% intercept, once
# per enemy turn), face-down ambush in the rear (full ATK to the first
# attacker in its column), artillery (charge, then fire past cover), the
# ENV track, veterancy, HQ at 0 = the game.  Tactics cards, card texts and
# the Unsupplied rule are out (noted at the bottom).
#
# THE SHAPE.  MVU.game -- the elm four over one model record -- against
# the GLES scene walker as the render service (mods/glsvc.fpr).  view
# builds the whole board as a Scene every frame: the table, tiles, HQs,
# units as simple solids (infantry = block + head, heavy = hull + turret,
# artillery = carriage + barrel, support = tower, ambush = a face-down
# slab), unit labels as the walker's text entities standing over them;
# the hand, the status bar, the unit panel and the banner are a 2D layer
# (mods/scene2d) drawn over the board in a second pass.  The camera is
# Hearthstone's: behind and above your hand, looking down the board.
#
# TIME.  A 40 ms STick drives everything that moves.  Player and AI both
# ENQUEUE actions; the tick pops one at a time, plays its animation
# (summon pop, attack lunge, artillery/ambush shot, retreat slide, turn
# banner) and applies the rule at the animation's midpoint, so what you
# see is when it happens.  Keys are buffered and taken one per idle tick,
# so a replayed key file (FPR_EVDEV) drives an identical game.
#
# KEYS  arrows: cursor (left/right column or card, up/down zone)
#       enter: pick card / pick unit / confirm target      esc: cancel
#       on a selected unit: A attack  O overwatch  R retreat  V advance
#                           C charge (artillery)  F fire (artillery)
#       1-5: jump to a column   space or E: end turn   P: screenshot  Q: quit
#
#   make qos-app PROG=programs/terra2.fpr
#   (cd ../qos && make portable-gl && ./qosp-gl --yes ../fp-risc/app.qa)
#   headless: xvfb-run -a ./qosp-gl ... with FPR_EVDEV=keys.evd (see
#   qos/tests-host/terra2-check.py: a scripted game, frames read back)
# ============================================================================
#: host gl
#: expect game over
#: music ../models/music/Sunrise_Over_The_Spire.mp3

unsafe program.

MV = use "../std/mvu".
GL = use "mods/glsvc".
S2 = use "mods/scene2d".
Fm = use "mods/fontm".
Sfx = use "mods/sfx".
Tank = use "../models/tank/tank".
Inf = use "../models/infantry/infantry".
Truck = use "../models/truck/truck".
Hq = use "../models/hq/hq".
models = Tank.meshes + Inf.meshes + Truck.meshes + Hq.meshes.

App = MV.App.
MQuit = MV.MQuit.
MLog = MV.MLog.
ETick = MV.ETick.
EKey = MV.EKey.
EResize = MV.EResize.
STick = MV.STick.
SKeys = MV.SKeys.

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).

# the 2D layer's view AST (mods/scene2d): boxes and labels laid out like
# a miniature flexbox, emitted as flat cubes, discs and text entities in
# a 960 x 600 pixel space (one virtual px per window px)
Box = S2.Box.
Lbl = S2.Lbl.
Row = S2.Row.
Col = S2.Col.
Pad = S2.Pad.
Gap = S2.Gap.
W = S2.W.
H = S2.H.
Grow = S2.Grow.
Bg = S2.Bg.
Fg = S2.Fg.
Bord = S2.Bord.
Sc = S2.Sc.
Fs = S2.Fs.
Round = S2.Round.
Shadow = S2.Shadow.
Bga = S2.Bga.
Center = S2.Center.
Mid = S2.Mid.

# ---- little prelude ---------------------------------------------------------

nth : (l : List a | measure l) -> Int -> a -> a .
nth l i d = case l of
    Nil -> d
  | x :: r -> case i == 0 of True -> x | False -> nth r (i - 1) d.
setAt : (l : List a | measure l) -> Int -> a -> List a .
setAt l i v = case l of
    Nil -> Nil
  | x :: r -> case i == 0 of True -> v :: r | False -> x :: setAt r (i - 1) v.
delAt : (l : List a | measure l) -> Int -> List a .
delAt l i = case l of
    Nil -> Nil
  | x :: r -> case i == 0 of True -> r | False -> x :: delAt r (i - 1).
rev l acc = l |> List.fold (fn x xs -> x :: xs) acc.
takeAt : (l : List a | measure l) -> Int -> (a, List a) .
takeAt l k = case l of
    Nil -> error "takeAt: index outside list"
  | x :: r -> case k == 0 of
      True -> (x, r)
    | False -> (y, rest) = takeAt r (k - 1); (y, x :: rest).
bi True = 1.
bi False = 0.
rnd s = (s * 1103515245 + 12345) % 2147483648.

# ---- cards ------------------------------------------------------------------
# Card id name cost atk def gen drain kind soft   kind 0 combat, 1 support,
# 2 artillery.  soft 1 = Soft (ENV bites), 0 = Hard/Structure.  Names are
# at most 8 glyphs (the card face).

Card = Type (Card id name cost atk def gen drain kind soft).

# Republic VI
cardOf 0 = Card 0 "Convoy" 2 0 4 1 0 1 0.
cardOf 1 = Card 1 "Depot" 3 0 5 2 0 1 0.
cardOf 2 = Card 2 "EngCorps" 3 0 3 0 0 1 1.
cardOf 3 = Card 3 "Registry" 1 0 2 0 0 1 0.
cardOf 4 = Card 4 "Conscrpt" 1 1 3 0 0 0 1.
cardOf 5 = Card 5 "CivDef" 2 2 3 0 0 0 1.
cardOf 6 = Card 6 "Medic" 2 0 2 0 0 0 1.
cardOf 7 = Card 7 "LightInf" 2 2 2 0 0 0 1.
cardOf 8 = Card 8 "Guard" 3 2 4 0 0 0 1.
cardOf 9 = Card 9 "Recon" 1 1 1 0 0 0 1.
cardOf 10 = Card 10 "MechInf" 3 3 4 0 1 0 0.
cardOf 11 = Card 11 "CombArms" 4 4 5 0 1 0 0.
cardOf 12 = Card 12 "Coilgun" 4 4 2 0 1 2 0.
cardOf 13 = Card 13 "AirWing" 5 3 3 0 1 0 0.
cardOf 14 = Card 14 "CmdrJake" 5 2 5 0 0 0 1.
# Southern Empire
cardOf 20 = Card 20 "FwdDepot" 2 0 3 1 0 1 0.
cardOf 21 = Card 21 "WarInd" 4 0 5 1 0 1 0.
cardOf 22 = Card 22 "Salvage" 2 0 2 0 0 1 1.
cardOf 23 = Card 23 "ExplPost" 3 0 2 2 0 1 0.
cardOf 24 = Card 24 "Levy" 1 2 2 0 0 0 1.
cardOf 25 = Card 25 "Ironclad" 2 2 4 0 0 0 1.
cardOf 26 = Card 26 "VetSquad" 2 3 2 0 0 0 1.
cardOf 27 = Card 27 "Grenadr" 3 3 3 0 0 0 1.
cardOf 28 = Card 28 "Storm" 3 3 2 0 0 0 1.
cardOf 29 = Card 29 "Commisar" 2 1 3 0 0 0 1.
cardOf 30 = Card 30 "AsltGun" 3 4 3 0 1 0 0.
cardOf 31 = Card 31 "Railgun" 4 5 2 0 1 2 0.
cardOf 32 = Card 32 "IronCol" 4 4 6 0 1 0 0.
cardOf 33 = Card 33 "HvyArmor" 5 5 7 0 2 0 0.
cardOf 34 = Card 34 "Maximlan" 5 3 4 0 0 0 1.
cardOf 35 = Card 35 "Executrs" 5 4 4 0 0 0 1.
cardOf k = Card k "?" 99 0 1 0 0 0 0.

cName (Card i n co a d g dr k s) = n.
cCost (Card i n co a d g dr k s) = co.
cAtk (Card i n co a d g dr k s) = a.
cDef (Card i n co a d g dr k s) = d.
cGen (Card i n co a d g dr k s) = g.
cDrain (Card i n co a d g dr k s) = dr.
cKind (Card i n co a d g dr k s) = k.
cSoft (Card i n co a d g dr k s) = s.

# the decks (tactics cut: 34 cards each), as copies of ids
reps : Int -> (n : Int | measure n) -> List Int .
reps k n | n <= 0 = Nil.
reps k n = k :: reps k (n - 1).
deckRep = reps 0 3 + reps 1 2 + reps 2 2 + reps 3 3 + reps 4 3
  + reps 5 3 + reps 6 3 + reps 7 3 + reps 8 2 + reps 9 2
  + reps 10 2 + reps 11 2 + reps 12 2 + reps 13 1 + reps 14 1.
deckSou = reps 20 3 + reps 21 2 + reps 22 2 + reps 23 2 + reps 24 3
  + reps 25 3 + reps 26 3 + reps 27 3 + reps 28 2 + reps 29 2
  + reps 30 2 + reps 31 2 + reps 32 2 + reps 33 1 + reps 34 1 + reps 35 1.

shuffle seed l = l |> shuf seed Nil.
shuf seed acc Nil = acc.
shuf seed acc l =
  s2 = rnd seed;
  (x, rest) = takeAt l (s2 % List.len l);
  rest |> shuf s2 (x :: acc).

# ---- units and sides ----------------------------------------------------------
# A slot holds a unit record; id < 0 is empty.  mode 0 attack / 1 overwatch,
# ready = may act this turn, down = face-down ambush (rdy = became ready),
# chg = artillery charged, vet = veterancy tokens, age = turns on board,
# ow = intercepted already this enemy turn.  flash/born/dead/dt are purely
# visual (ms).

noU = { id = 0 - 1, hp = 0, atk = 0, mode = 0, ready = 0, down = 0, rdy = 0,
        chg = 0, vet = 0, age = 0, ow = 0, flash = 0, born = 900, dead = 0, dt = 0 }.
mkU c down = { id = cId c, hp = cDef c, atk = cAtk c, mode = 0, ready = 0, down = down, rdy = 0,
               chg = 0, vet = 0, age = 0, ow = 0, flash = 0, born = 0, dead = 0, dt = 0 }.
cId (Card i n co a d g dr k s) = i.
alive u = u.id >= 0 and u.dead == 0.
uCard u = cardOf u.id.
uKind u = cKind (uCard u).
uSoft u = cSoft (uCard u).
uMax u = cDef (uCard u) + u.vet.
emptyRow = noU :: noU :: noU :: noU :: noU :: Nil.

# side = { hq, stock, deck, hand, fwd, rear }
mkSide deck hand = { hq = 15, stock = 0, deck = deck, hand = hand, fwd = emptyRow, rear = emptyRow }.
rowOf p 1 = p.fwd.
rowOf p z = p.rear.
setRow p 1 row = { p | fwd = row }.
setRow p z row = { p | rear = row }.
slotOf p z c = nth (rowOf p z) c noU.
setSlot p z c u = setRow p z (setAt (rowOf p z) c u).
occ p z c = alive (slotOf p z c).

sideOf m 0 = m.me.
sideOf m s = m.en.
setSide m 0 p = { m | me = p }.
setSide m s p = { m | en = p }.

# supply rate: HQ 2 (1 at ENV 7+) + GEN of face-up rear support - DRAIN of everything
genRow row = row |> List.fold (fn u total -> case alive u and u.down == 0 and uKind u == 1 of
    True -> cGen (uCard u) + total
  | False -> total) 0.
drainRow row = row |> List.fold (fn u total -> case alive u of
    True -> cDrain (uCard u) + total
  | False -> total) 0.
rate m p = hqGen m + genRow p.rear - drainRow p.fwd - drainRow p.rear.
hqGen m | m.env >= 7 = 1.
hqGen m = 2.

# ---- geometry: the board in the walker's milli units ------------------------------
# z runs from the enemy HQ (far, negative) to your hand (near, positive).

colX c = (c - 2) * 2400.
zOf 0 1 = 2400.          # my forward
zOf 0 2 = 5000.          # my rear
zOf 0 3 = 7300.          # my HQ
zOf 1 1 = 0 - 2400.
zOf 1 2 = 0 - 5000.
zOf 1 3 = 0 - 7600.
zOf s z = 0.
zHand = 8300.
posOf s z c = (colX c, 0, zOf s z).
hqPos s = (0, 0, zOf s 3).
dirOf 0 = 0 - 1.          # "toward the enemy" along z
dirOf s = 1.

# the sun, then the sky: (fog and clear colour, ambient) -- the walker's
# second light entry
lights = ((3000, 14000, 9000), sun) :: (sky, ambient) :: Nil.
camera = ((0, 12500, 16000), (0, 0, 1500), 1000).

# ---- the palette: every colour the game uses, named once --------------------------
# A dusk board: a cool blue-grey sky and ground, two desaturated factions
# (a steel blue and a brick red) with one saturated accent (the amber the
# cursor, the hand's highlight and every "yours" pulse share), and a
# danger red for what can be hit.  The 3D pass fogs toward `sky` and is
# lit by `ambient` (cool) plus the warm sun; the 2D layer's ink and
# paper are the last group.
white = (1000, 1000, 1000).
yellow = (1000, 860, 300).           # the accent (amber)
danger = (960, 360, 300).
sky = (190, 210, 260).
skyTop = (110, 130, 190).
ground = (215, 240, 232).
groundEdge = (160, 185, 190).
ambient = (330, 360, 430).
sun = (900, 840, 720).
blue = (270, 440, 860).
blueLight = (520, 640, 940).
red = (860, 330, 290).
redLight = (960, 560, 500).
sideCol 0 = blue.
sideCol s = red.
sideLight 0 = blueLight.
sideLight s = redLight.
hqCol 0 = (400, 480, 660).
hqCol s = (660, 420, 400).
dark = (95, 100, 125).
khaki = (690, 630, 430).
steel = (560, 600, 680).
shadow = (95, 110, 120).
tileMine = (350, 385, 372).
tileTheirs = (385, 345, 360).
tileRear = (318, 348, 348).
tileEdge = (430, 470, 480).
ink = (930, 940, 960).
inkDim = (600, 630, 700).
paper = (34, 40, 56).
paperLit = (62, 74, 108).
edge = (330, 370, 440).
# the 2D layer's surfaces: glass (translucent, over the board), chips, bands
glass = (12, 16, 26, 800).
glassLit = (34, 44, 66, 860).
chip = (48, 58, 84).
blueDark = (30, 54, 104).
redDark = (104, 36, 42).
bandInf = (58, 96, 156).
bandArm = (92, 88, 120).
bandArt = (150, 84, 58).
bandSup = (40, 118, 96).
supCol 0 = (330, 640, 520).
supCol s = (760, 560, 300).

# ---- text in the scene -------------------------------------------------------------
# The walker's text entity: Ent (0, s) pen 0 (em, em, 1) col stands the
# string upright facing +z with the pen at the left end of the baseline.
# (x, y) is the top-left of the line box, cell an em/9 size unit kept from
# the glyph days so the callers' numbers still read.

txt es s x y z cell col =
  em = cell * 9;
  Ent (0, s) (x, y - Fm.ascent * em / 1000, z) 0 (em, em, 1000) col :: es.
# centered on x
txtC es s x y z cell col = txt es s (x - textW s (cell * 9) / 2) y z cell col.
textW s em = Fm.width s * em / 1000.

# ---- the model --------------------------------------------------------------------
# sel: SNone | SCard i | SPlace i z | SUnit z c | STarget z c (the attacker)
# zone: the cursor's zone (0 hand, 1 my fwd, 2 my rear; under STarget 1 enemy
# fwd, 2 enemy rear, 3 enemy HQ), cur: its index.

Sel = Type (SNone | SCard i | SPlace i z | SUnit z c | STarget z c).
# actions, queued and played one at a time
Act = Type (ACall s i z c | AAttack s z c tz tc | AOver s c | ARetreat s c
          | AAdvance s c | ACharge s c | AFire s c tz tc | AEnd s | AStart s | ABeat).
# the animation in flight: kind 0 none, 1 lunge, 2 shot, 3 slide, 4 pause
An = Type (An kind s fz fc tz tc t done).
noAn = An 0 0 0 0 0 0 0 0.

initWith s0 s1 =
  d0 = shuffle s0 deckRep;
  d1 = shuffle s1 deckSou;
  (h0, r0) = split d0 5 Nil;
  (h1, r1) = split d1 5 Nil;
  { me = mkSide r0 h0, en = mkSide r1 h1, turn = 0, tno = 0, env = 0,
    anim = noAn, queue = Nil, sel = SNone, zone = 0, cur = 0,
    msg = "arrows, enter, esc; space ends the turn -- press ENTER to begin", keys = Nil,
    snap = 0, auto = 0, banner = "TERRA II", bt = 100000, seed = 99, over = 0, fx = Nil, ms = 0, log = Nil,
    sfx = Nil, nums = Nil, shake = 0, title = 1, qt = 0, music = 0, puffs = Nil,
    ring = (0, 2400), hov = (0, 0), hovT = 1000, marks = Nil, supV = (0, 0), vt = 0,
    gone = (0 - 1, 1000), dealt = 1000 }.
initModel = initWith 8675309 4242.
note m s = { m | msg = s, log = s :: m.log }.
# a sound cue: queued on the model, played by the tick (like the log)
cue m r = { m | sfx = r :: m.sfx }.
oops m s = cue (note m s) Sfx.refuse.
# a floating number over a spot on the table
number m pos s = (x, y, z) = pos; { m | nums = (x, z, s, 0) :: m.nums }.
split l 0 acc = (rev acc Nil, l).
split Nil n acc = (rev acc Nil, Nil).
split (x :: r) n acc = split r (n - 1) (x :: acc).

# ---- rules: validation ------------------------------------------------------------

# a forward unit at column c on side s may hit (tz, tc) on the other side
targetOk m s c tz tc =
  o = sideOf m (1 - s);
  case Int.abs (c - tc) <= 1 of
    False -> False
  | True -> targetOk2 o tz tc.
targetOk2 o 1 tc = occ o 1 tc.
targetOk2 o 2 tc = occ o 2 tc and not (occ o 1 tc).       # cover
targetOk2 o 3 tc = lane o (tc - 1) or lane o tc or lane o (tc + 1).
targetOk2 o z tc = False.
lane o c | c < 0 or c > 4 = False.
lane o c = not (occ o 1 c) and not (occ o 2 c).
# artillery ignores cover, columns and lanes: any rear unit, or the HQ
fireOk m s tz tc =
  o = sideOf m (1 - s);
  case tz == 3 of
    True -> True
  | False -> tz == 2 and occ o 2 tc.

canAct u = alive u and u.ready == 1 and u.down == 0.

# ---- rules: effects -----------------------------------------------------------------

damageUnit m s z c dmg =
  p = sideOf m s;
  u = slotOf p z c;
  hp2 = u.hp - dmg;
  u2 = { u | hp = hp2, flash = 250 };
  m2 = cue (number (note (setSide m s (setSlot p z c u2)) "{cName (uCard u)} takes {dmg}") (posOf s z c) "-{dmg}") Sfx.hit;
  case alive u and hp2 <= 0 of
    True -> slay m2 s z c
  | False -> m2.
slay m s z c =
  p = sideOf m s;
  u = slotOf p z c;
  m2 = setSide m s (setSlot p z c { u | dead = 1, dt = 0, hp = 0 });
  (mx, my, mz) = posOf s z c;
  cue (note { m2 | env = Int.min 10 (m2.env + (case uSoft u == 1 of True -> 1 | False -> 2)),
                   fx = sparks m2.fx (posOf s z c) 6, shake = 160, marks = (mx, mz, 0) :: m2.marks } "{cName (uCard u)} destroyed") Sfx.kill.
damageHq m s dmg =
  p = sideOf m s;
  hq2 = p.hq - dmg;
  m2 = setSide m s { p | hq = hq2 };
  (hx, hy, hz) = hqPos s;
  m3 = cue (number (note { m2 | fx = sparks m2.fx (hqPos s) 8, shake = 320,
                               marks = (hx + (p.hq * 1237) % 2400 - 1200, hz - dirOf s * ((p.hq * 811) % 900 + 300), 0) :: m2.marks }
                        "HQ hit for {dmg}: {hq2} left") (hqPos s) "-{dmg}") Sfx.hqHit;
  case hq2 <= 0 of
    True -> cue (note { m3 | over = 1 + (1 - s), banner = (case s == 1 of True -> "VICTORY" | False -> "DEFEAT"), bt = 100000, queue = Nil,
                             msg = "press ENTER for a new game, Q to quit" }
                      (case s == 1 of True -> "VICTORY" | False -> "DEFEAT"))
                (case s == 1 of True -> Sfx.victory | False -> Sfx.defeat)
  | False -> m3.
sparks fx pos n | n == 0 = fx.
sparks fx pos n =
  (x, y, z) = pos;
  sparks ((x + (n * 337) % 900 - 450, 900 + (n * 191) % 500, z + (n * 271) % 700 - 350, 0) :: fx) pos (n - 1).

# the attack itself: overwatch intercept (once per enemy turn) and ambush
# reveal happen BEFORE the blow lands; a dead attacker lands nothing.
resolveAttack m s c tz tc =
  m1 = intercept m s c tc;
  m2 = ambush m1 s c tz tc;
  a = slotOf (sideOf m2 s) 1 c;
  case alive a of
    False -> note m2 "the attacker fell before striking"
  | True -> landBlow (spend m2 s 1 c) s c tz tc a.atk.
landBlow m s c 3 tc dmg = damageHq m (1 - s) dmg.
landBlow m s c tz tc dmg = damageUnit m (1 - s) tz tc dmg.
spend m s z c =
  p = sideOf m s;
  u = slotOf p z c;
  setSide m s (setSlot p z c { u | ready = 0, chg = 0 }).

intercept m s c tc = intGo m s c tc (Int.max 0 (tc - 1)) (Int.min 4 (tc + 1)).
intGo m s c tc k hi | k > hi = m.
intGo m s c tc k hi =
  o = sideOf m (1 - s);
  u = slotOf o 1 k;
  case alive u and u.mode == 1 and u.ow == 0 of
    True -> interceptBy (setSide m (1 - s) (setSlot o 1 k { u | ow = 1 })) s c k (u.atk / 2)
  | False -> intGo m s c tc (k + 1) hi.
interceptBy m s c k dmg =
  m2 = damageUnit m s 1 c dmg;
  cue (note { m2 | fx = sparks m2.fx (posOf s 1 c) 4 } "overwatch intercepts for {dmg}") Sfx.intercept.

# ambush: attacking the forward unit in a column, or the face-down card
# itself, wakes a READY face-down rear card: full ATK to the attacker, then
# it stands face-up in the rear
ambush m s c tz tc | tz == 3 = m.
ambush m s c tz tc =
  o = sideOf m (1 - s);
  u = slotOf o 2 tc;
  case alive u and u.down == 1 and u.rdy == 1 of
    True -> reveal m s c tc u
  | False -> m.
reveal m s c tc u =
  o = sideOf m (1 - s);
  m2 = setSide m (1 - s) (setSlot o 2 tc { u | down = 0, born = 0 });
  m3 = damageUnit m2 s 1 c u.atk;
  cue (note m3 "AMBUSH! {cName (uCard u)} hits for {u.atk}") Sfx.ambush.

# ---- rules: phases --------------------------------------------------------------------

readyRow row = row |> List.map rdyOne.
rdyOne u | alive u =
  age2 = u.age + 1;
  vet2 = case age2 % 3 == 0 and uKind u != 1 of True -> 1 | False -> 0;
  { u | ready = 1, ow = 0, age = age2, vet = u.vet + vet2, atk = u.atk + vet2, hp = u.hp + vet2,
        rdy = u.down }.
rdyOne u = u.
# repair: combat units in the rear recover 1 (2 with Engineering Corps)
repairRow row amt = row |> List.map (fn u -> repairOne u amt).
repairOne u amt | alive u and uKind u != 1 = { u | hp = Int.min (uMax u) (u.hp + amt) }.
repairOne u amt = u.
hasId row k = row |> List.fold (fn u found -> found or alive u and u.id == k) False.

startTurn m s =
  p = sideOf m s;
  eng = bi (hasId p.rear 2);
  p1 = { p | fwd = readyRow p.fwd, rear = repairRow (readyRow p.rear) (1 + eng) };
  m1 = setSide m s p1;
  r = rate m1 p1;
  stock2 = Int.max 0 (Int.min p1.stock 3 + r);
  p2 = { p1 | stock = stock2 };
  (p3, m2) = draw (setSide m1 s p2) s p2;
  m3 = cue (note { m2 | turn = s, tno = m2.tno + bi (s == 0),
              banner = (case s == 0 of True -> "YOUR TURN" | False -> "ENEMY TURN"), bt = 900,
              sel = SNone } "turn {m2.tno + bi (s == 0)} side {s}: supply {stock2} (rate {r})")
           (case s == 0 of True -> Sfx.yourTurn | False -> Sfx.enemyTurn);
  case s == 1 of
    True -> { m3 | queue = aiPlan m3 + (AEnd 1 :: Nil) }
  | False -> m3.
draw m s p = case p.deck of
    Nil -> (p, damageHq { m | msg = "deck out: HQ takes 2" } s 2)
  | k :: r -> drawn (case s == 0 of True -> { m | dealt = 0 } | False -> m) s { p | deck = r, hand = p.hand + (k :: Nil) }.
drawn m s p = (p, setSide m s p).

endTurn m s =
  p = sideOf m s;
  p1 = { p | fwd = envRow p.fwd m.env, rear = envRow p.rear m.env, hand = trim p.hand 7 };
  m1 = setSide m s p1;
  m2 = collect m1 s 1 0;
  m3 = collect m2 s 2 0;
  { m3 | queue = AStart (1 - s) :: Nil, sel = SNone }.
envRow row env | env >= 10 = envAll row.
envRow row env | env >= 4 = envSoft row.
envRow row env = row.
envSoft row = row |> List.map (fn u -> case alive u and uSoft u == 1 of
    True -> { u | hp = u.hp - 1, flash = 250 }
  | False -> u).
envAll row = row |> List.map (fn u -> case alive u of
    True -> { u | hp = u.hp - 1, flash = 250 }
  | False -> u).
# units the ENV took to 0
collect m s z c | c > 4 = m.
collect m s z c =
  u = slotOf (sideOf m s) z c;
  case alive u and u.hp <= 0 of
    True -> collect (slay m s z c) s z (c + 1)
  | False -> collect m s z (c + 1).
trim l n | List.len l <= n = l.
trim l n = trim (delAt l (List.len l - 1)) n.

# ---- rules: the player's and the AI's actions, applied ------------------------------

callCard m s i z c =
  p = sideOf m s;
  k = nth p.hand i (0 - 1);
  cd = cardOf k;
  down = bi (z == 2 and cKind cd != 1);
  cost = cCost cd - down;
  case k >= 0 and p.stock >= cost and not (occ p z c) and (z == 1 or z == 2) of
    False -> oops m "cannot call {cName cd} there"
  | True -> called m s p i z c cd (mkU cd down) cost.
called m s p i z c cd u cost =
  p2 = setSlot { p | stock = p.stock - cost, hand = delAt p.hand i } z c { u | born = 0 - 380 };
  m2 = case s == 0 of True -> setSide { m | gone = (i, 0) } s p2 | False -> setSide m s p2;
  cue (note m2 "{sideName s}: {cName cd} called to {zoneName z} {c + 1}") Sfx.call.
sideName 0 = "you".
sideName s = "enemy".
zoneName 1 = "forward".
zoneName z = "rear".

# ---- the AI (side 1): greedy, positional -----------------------------------------------
# calls: up to three, dearest affordable first, supports to a covered rear
# slot, combat to a forward slot in front of its own rear; acts: every ready
# forward unit hits the HQ through a lane if it can, else an uncovered rear
# unit, else the weakest forward unit in reach, else goes to overwatch;
# artillery charges then fires at the richest rear unit (or the HQ).

aiPlan m =
  p = m.en;
  (calls, p2) = aiCalls m p 0 Nil 3;
  acts = aiActs m p2 0 Nil;
  beats (calls + acts).
beats Nil = Nil.
beats (a :: r) = a :: ABeat :: beats r.
aiCalls m p i acc n | n == 0 = (rev acc Nil, p).
aiCalls m p i acc n =
  k = bestCard p.hand p.stock 0 (0 - 1) (0 - 1);
  case k < 0 of
    True -> (rev acc Nil, p)
  | False -> aiCall m p acc n k (cardOf (nth p.hand k 0)).
aiCall m p acc n k cd =
  z = case cKind cd == 1 of True -> 2 | False -> 1;
  c = freeCol p z;
  case c < 0 of
    True -> (rev acc Nil, p)
  | False -> aiCalls m (setSlot { p | stock = p.stock - cCost cd, hand = delAt p.hand k } z c (mkU cd 0))
                     0 (ACall 1 k z c :: acc) (n - 1).
# index of the dearest affordable card (support preferred when nothing is in the rear)
bestCard Nil stock i best bcost = best.
bestCard (k :: r) stock i best bcost =
  co = cCost (cardOf k);
  worth = co + 2 * cGen (cardOf k);
  case co <= stock and worth > bcost of
    True -> bestCard r stock (i + 1) i worth
  | False -> bestCard r stock (i + 1) best bcost.
# a free column for zone z: forward slots in front of a rear unit first,
# rear slots behind a forward unit first, centre outward
freeCol p z = fcGo p z (2 :: 1 :: 3 :: 0 :: 4 :: Nil) (0 - 1).
fcGo p z Nil best = best.
fcGo p z (c :: r) best | occ p z c = fcGo p z r best.
fcGo p z (c :: r) best | occ p (3 - z) c = c.
fcGo p z (c :: r) best | best < 0 = fcGo p z r c.
fcGo p z (c :: r) best = fcGo p z r best.

aiActs m p c acc | c > 4 = rev acc Nil.
aiActs m p c acc =
  u = slotOf p 1 c;
  ru = slotOf p 2 c;
  acc2 = case canAct ru and uKind ru != 1 and not (occ p 1 c) of
    True -> AAdvance 1 c :: acc
  | False -> acc;
  case canAct u and u.mode == 0 of
    True -> aiActs m p (c + 1) (aiUnit m p c u :: acc2)
  | False -> aiActs m p (c + 1) acc2.
aiUnit m p c u | uKind u == 2 = aiArt m c u.
aiUnit m p c u =
  o = m.me;
  case targetOk m 1 c 3 c of
    True -> AAttack 1 1 c 3 c
  | False -> aiPick m c (bestIn m c 2) (bestIn m c 1).
aiPick m c rc fc | rc >= 0 = AAttack 1 1 c 2 rc.
aiPick m c rc fc | fc >= 0 = AAttack 1 1 c 1 fc.
aiPick m c rc fc = AOver 1 c.
# the weakest valid target in zone tz within reach of column c, or -1
bestIn m c tz = biGo m c tz (Int.max 0 (c - 1)) (Int.min 4 (c + 1)) (0 - 1) 999.
biGo m c tz k hi best bhp | k > hi = best.
biGo m c tz k hi best bhp =
  u = slotOf m.me tz k;
  case targetOk m 1 c tz k and u.hp < bhp of
    True -> biGo m c tz (k + 1) hi k u.hp
  | False -> biGo m c tz (k + 1) hi best bhp.
aiArt m c u | u.chg == 0 = ACharge 1 c.
aiArt m c u =
  rc = richest m.me.rear 0 (0 - 1) (0 - 1);
  case rc < 0 of
    True -> AFire 1 c 3 0
  | False -> AFire 1 c 2 rc.
richest Nil i best bg = best.
richest (u :: r) i best bg | alive u and cGen (uCard u) > bg = richest r (i + 1) i (cGen (uCard u)).
richest (u :: r) i best bg = richest r (i + 1) best bg.

# ---- the queue: starting an action = validating it and choosing its animation ------------

startAct m a = case a of
    ABeat -> pause m 260
  | AStart s -> pause (startTurn m s) 900
  | AEnd s -> pause (endTurn m s) 500
  | ACall s i z c -> flyCard (callCard m s i z c) m s i z c
  | AOver s c -> pause (overwatch m s c) 250
  | ACharge s c -> pause (charge m s c) 250
  | ARetreat s c -> slide m s 1 c 2 c
  | AAdvance s c -> slide m s 2 c 1 c
  | AAttack s z c tz tc -> attack m s c tz tc
  | AFire s c tz tc -> fire m s c tz tc.
pause m ms = { m | anim = An 4 0 0 0 0 0 (0 - ms) 1 }.
# the summon: a card slab flies from the hand's edge (the enemy's from
# beyond its HQ) to the slot over 380 ms, easing in and out, shrinking;
# the unit pops up as it lands (its born runs up from -380).  A refused
# call has left the model unchanged: no flight, a short beat.
flyCard m2 m s i z c | m2.me.stock == m.me.stock and m2.en.stock == m.en.stock = pause m2 250.
flyCard m2 m s i z c = { m2 | anim = An 5 s i 0 z c 0 1 }.

overwatch m s c =
  p = sideOf m s;
  u = slotOf p 1 c;
  case canAct u and uKind u != 2 of
    False -> oops m "that unit cannot change mode now"
  | True -> setSide (cue { m | msg = (case u.mode == 0 of True -> "overwatch" | False -> "back to attack mode") } Sfx.toggle)
                    s (setSlot p 1 c { u | mode = 1 - u.mode, ready = 0 }).
charge m s c =
  p = sideOf m s;
  u = slotOf p 1 c;
  case canAct u and uKind u == 2 of
    False -> oops m "only ready artillery charges"
  | True -> setSide (cue { m | msg = "charging" } Sfx.charge) s (setSlot p 1 c { u | chg = 1, ready = 0 }).
slide m s fz fc tz tc =
  p = sideOf m s;
  u = slotOf p fz fc;
  ok = canAct u and uKind u != 1 and not (occ p tz tc);
  case ok of
    False -> oops m "cannot move that unit"
  | True -> cue { m | anim = An 3 s fz fc tz tc 0 0, msg = (case tz == 2 of True -> "retreat" | False -> "advance") } Sfx.move.
attack m s c tz tc =
  u = slotOf (sideOf m s) 1 c;
  ok = canAct u and u.mode == 0 and uKind u != 2 and targetOk m s c tz tc;
  case ok of
    False -> oops m "no valid attack there"
  | True -> cue (note { m | anim = An 1 s 1 c tz tc 0 0, puffs = smoke m.puffs (muzzle m s c (aimYaw m s c tz tc)) (case uSoft u == 1 of True -> 3 | False -> 6) (case uSoft u == 1 of True -> 0 | False -> 60) }
                      "{sideName s}: {cName (uCard u)} attacks {tgtName tz (tc + 1)}")
                (case uSoft u == 1 of True -> Sfx.rifle | False -> Sfx.cannon).
# muzzle smoke: n puffs around a point, held (negative age) until the shot
smoke ps pos n delay | n == 0 = ps.
smoke ps pos n delay =
  (x, y, z) = pos;
  smoke ((x + (n * 271) % 300 - 150, y + (n * 97) % 200 - 100, z + (n * 181) % 300 - 150, 0 - delay - n * 25) :: ps) pos (n - 1) delay.
tgtName 3 c = "the HQ".
tgtName z c = "{zoneName z} {c}".
fire m s c tz tc =
  u = slotOf (sideOf m s) 1 c;
  ok = canAct u and u.chg == 1 and uKind u == 2 and fireOk m s tz tc;
  case ok of
    False -> oops m "artillery must be charged, and aimed at the rear or the HQ"
  | True -> cue (note { m | anim = An 2 s 1 c tz tc 0 0 } "{sideName s}: artillery fires at {tgtName tz (tc + 1)}") Sfx.shot.

# the animation clock: midpoint applies the rule, the end clears it
durOf 1 = 520.
durOf 2 = 700.
durOf 3 = 360.
durOf 5 = 400.
durOf k = 0.
advance m dt =
  An kind s fz fc tz tc t done = m.anim;
  t2 = t + dt;
  m1 = case done == 0 and t2 >= durOf kind / 2 of
    True -> { (midpoint m kind s fz fc tz tc) | anim = An kind s fz fc tz tc t2 1, snap = m.snap + m.auto * bi (kind < 4) }
  | False -> { m | anim = An kind s fz fc tz tc t2 done };
  case t2 >= (case kind == 4 of True -> 0 | False -> durOf kind) of
    True -> finishAn m1 kind s fz fc tz tc
  | False -> m1.
midpoint m 1 s fz fc tz tc = resolveAttack m s fc tz tc.
midpoint m 2 s fz fc tz tc =
  m2 = spend m s 1 fc;
  a = slotOf (sideOf m s) 1 fc;
  landBlow m2 s fc tz tc a.atk.
midpoint m k s fz fc tz tc = m.
finishAn m 3 s fz fc tz tc =
  p = sideOf m s;
  u = slotOf p fz fc;
  m2 = setSide m s (setSlot (setSlot p fz fc noU) tz tc { u | ready = 0, chg = 0, born = 600, mode = 0 });
  { m2 | anim = noAn }.
finishAn m k s fz fc tz tc = { m | anim = noAn }.

# ---- the tick ----------------------------------------------------------------------------

tickMs = 40.

tick m | m.qt > 0 and m.qt <= tickMs = (m, MQuit :: Nil).
tick m | m.qt > 0 = ({ m | qt = m.qt - tickMs }, Nil).
tick m =
  m1 = ageAll { m | ms = m.ms + tickMs, log = Nil, sfx = Nil } tickMs;
  An kind s fz fc tz tc t done = m1.anim;
  (m2, cs) = case kind != 0 of
    True -> (advance m1 tickMs, Nil)
  | False -> idle m1;
  _ = say (rev m2.log Nil);
  _ = Sfx.playAllVar m2.ms (rev m2.sfx Nil);
  (m2, cs).
# the transcript goes straight to stdout: the host's log echo is
# rate-limited (rings are not), and a scripted game must be readable
say Nil = 0.
say (s :: r) = _ = print "[terra2] {s}"; say r.
idle m = case m.queue of
    a :: r -> (startAct { m | queue = r } a, Nil)
  | Nil -> takeKey m.
takeKey m = case m.keys of
    Nil -> (m, Nil)
  | k :: r -> key { m | keys = r } k.

ageAll m dt =
  m1 = chase m dt;
  { m1 | me = ageSide m.me dt, en = ageSide m.en dt, bt = Int.max 0 (m.bt - dt), fx = ageFx m.fx dt Nil,
         marks = ageMarks m.marks dt Nil, vt = (case m.turn == 1 of True -> Int.min 400 (m.vt + dt) | False -> Int.max 0 (m.vt - dt)),
         gone = ageGone m.gone dt, dealt = Int.min 1000 (m.dealt + dt),
        nums = ageNums m.nums dt Nil, shake = Int.max 0 (m.shake - dt), puffs = agePuffs m.puffs dt Nil }.
agePuffs Nil dt acc = acc.
agePuffs ((x, y, z, t) :: r) dt acc | t + dt > 700 = agePuffs r dt acc.
agePuffs ((x, y, z, t) :: r) dt acc = agePuffs r dt ((x, y, z, t + dt) :: acc).
# the visual state chasing the model: the cursor ring glides a third of
# the way to its slot each tick; hovT counts since the hover last moved
chase m dt =
  (tx, tz) = ringTarget m;
  (x, z) = m.ring;
  ring2 = (x + (tx - x) * 35 / 100, z + (tz - z) * 35 / 100);
  hov2 = (m.zone, m.cur);
  same = hov2 == m.hov;
  (sv, st) = m.supV;
  sv2 = case sv < m.me.stock of True -> sv + 1 | False -> (case sv > m.me.stock of True -> sv - 1 | False -> sv);
  { m | ring = ring2, hov = hov2, hovT = (case same of True -> Int.min 2000 (m.hovT + dt) | False -> 0),
        supV = (sv2, case sv2 == m.me.stock of True -> Int.min 1000 (st + dt) | False -> 0) }.
ringTarget m = case m.sel of
    STarget az ac -> (case m.zone == 3 of
        True -> (0, zOf 1 3 + 700)
      | False -> (colX m.cur, zOf 1 m.zone))
  | s -> (case m.zone == 0 of True -> m.ring | False -> (colX m.cur, zOf 0 m.zone)).
ageGone (i, t) dt = (i, Int.min 1000 (t + dt)).
ageMarks Nil dt acc = acc.
ageMarks ((x, z, t) :: r) dt acc | t + dt > 20000 = ageMarks r dt acc.
ageMarks ((x, z, t) :: r) dt acc = ageMarks r dt ((x, z, t + dt) :: acc).
ageNums Nil dt acc = acc.
ageNums ((x, z, s, t) :: r) dt acc | t + dt > 750 = ageNums r dt acc.
ageNums ((x, z, s, t) :: r) dt acc = ageNums r dt ((x, z, s, t + dt) :: acc).
ageSide p dt = { p | fwd = ageRow p.fwd dt, rear = ageRow p.rear dt }.
ageRow row dt = row |> List.map (fn u -> ageU u dt).
ageU u dt | u.id < 0 = u.
ageU u dt | u.dead == 1 and u.dt + dt > 420 = noU.
ageU u dt = { u | flash = Int.max 0 (u.flash - dt), born = Int.min 1000 (u.born + dt), dt = u.dt + dt }.
ageFx Nil dt acc = acc.
ageFx ((x, y, z, t) :: r) dt acc | t + dt > 380 = ageFx r dt acc.
ageFx ((x, y, z, t) :: r) dt acc = ageFx r dt ((x, y, z, t + dt) :: acc).

# the track beside the .qa (`#: music` above: run points FPR_ASSETS at it,
# pack copies it into the bundle); M toggles it
musicFile = "Sunrise_Over_The_Spire.mp3".
musicVol = 450.

# ---- keys: the selection state machine ---------------------------------------------------
# (one clause group: a definition in the middle of it would split it, and
# the later half wins)
# evdev codes: 105 left 106 right 103 up 108 down 28 enter 1 esc 14 bksp
# 57 space 18 e 16 q 25 p 30 a 24 o 19 r 46 c 33 f 47 v 2..6 columns

key m 16 = (cue { m | qt = 600, msg = "bye" } Sfx.close, Nil).
key m 25 = ({ m | snap = m.snap + 1 }, Nil).
key m 31 = ({ m | auto = 1 - m.auto, msg = "auto snapshots {1 - m.auto}" }, Nil).
key m 28 | m.title == 1 =
  _ = sndMusic musicFile musicVol;
  (cue { m | title = 0, bt = 0, queue = AStart 0 :: Nil, msg = "", music = 1 } Sfx.open, Nil).
key m 50 =
  on = 1 - m.music;
  _ = sndMusic musicFile (on * musicVol);
  ({ m | music = on, msg = (case on == 1 of True -> "music on" | False -> "music off") }, Nil).
key m 28 | m.over != 0 =
  m2 = initWith (rnd m.seed) (rnd (rnd m.seed));
  (cue { m2 | title = 0, bt = 0, queue = AStart 0 :: Nil, msg = "", seed = rnd m.seed, snap = m.snap, auto = m.auto } Sfx.open, Nil).
key m k | m.title == 1 or m.over != 0 = (m, Nil).
key m k | m.turn != 0 = ({ m | msg = "enemy turn" }, Nil).
key m 57 = (cue { m | queue = AEnd 0 :: Nil, sel = SNone, msg = "end of turn" } Sfx.turnOver, Nil).
key m 18 = key m 57.
key m 1 = (cue (cancel m) Sfx.cancel, Nil).
key m 14 = key m 1.
key m k | k >= 2 and k <= 6 = (cue (moveCur m (k - 2)) Sfx.cursor, Nil).
key m 105 = (cue (moveCur m (m.cur - 1)) Sfx.cursor, Nil).
key m 106 = (cue (moveCur m (m.cur + 1)) Sfx.cursor, Nil).
key m 103 = (cue (moveZone m 1) Sfx.cursor, Nil).
key m 108 = (cue (moveZone m (0 - 1)) Sfx.cursor, Nil).
key m 28 = (confirm m, Nil).
key m 30 = (unitKey m 30, Nil).
key m 24 = (unitKey m 24, Nil).
key m 19 = (unitKey m 19, Nil).
key m 46 = (unitKey m 46, Nil).
key m 33 = (unitKey m 33, Nil).
key m 47 = (unitKey m 47, Nil).
key m k = (m, Nil).

# esc: back to where the selection started -- the attacker's slot, the
# card being placed, or just the selection cleared
cancel m = case m.sel of
    STarget z c -> { m | sel = SNone, zone = z, cur = c, msg = "" }
  | SPlace i z -> { m | sel = SNone, zone = 0, cur = i, msg = "" }
  | s -> { m | sel = SNone, msg = "" }.

curMax m = case m.sel of
    SNone -> (case m.zone == 0 of True -> List.len m.me.hand - 1 | False -> 4)
  | SCard i -> List.len m.me.hand - 1
  | s -> 4.
moveCur m c = { m | cur = Int.max 0 (Int.min (curMax m) c) }.

# zones stack bottom to top: hand 0, my rear 2, my forward 1; for a target:
# enemy forward 1, enemy rear 2, enemy HQ 3
moveZone m d = case m.sel of
    STarget z c -> { m | zone = Int.max 1 (Int.min 3 (m.zone + d)), cur = Int.min 4 m.cur }
  | SPlace i z -> placeZone m i z d
  | s -> { m | zone = zoneStep m.zone d, cur = Int.min (curMax { m | zone = zoneStep m.zone d }) m.cur }.
zoneStep 0 d | d > 0 = 2.
zoneStep 2 d | d > 0 = 1.
zoneStep 1 d | d < 0 = 2.
zoneStep 2 d | d < 0 = 0.
zoneStep z d = z.
placeZone m i z d =
  cd = cardOf (nth m.me.hand i 0);
  z2 = case d > 0 of True -> 1 | False -> 2;
  case z2 == 1 and cKind cd == 1 of
    True -> oops m "support units serve in the rear"
  | False -> { m | sel = SPlace i z2, zone = z2 }.

confirm m = case m.sel of
    SNone -> cue (pick m) Sfx.pick
  | SCard i -> m
  | SPlace i z -> { m | queue = ACall 0 i z m.cur :: Nil, sel = SNone, zone = z }
  | SUnit z c -> unitKey m 30
  | STarget z c -> aim m z c.
pick m | m.zone == 0 =
  k = nth m.me.hand (Int.min m.cur (List.len m.me.hand - 1)) (0 - 1);
  case k < 0 of
    True -> oops m "no card there"
  | False -> { m | sel = SPlace m.cur (case cKind (cardOf k) == 1 of True -> 2 | False -> 1),
                   zone = (case cKind (cardOf k) == 1 of True -> 2 | False -> 1), cur = 2,
                   msg = "place {cName (cardOf k)}: arrows, enter (up/down: forward or rear)" }.
pick m =
  u = slotOf m.me m.zone m.cur;
  case alive u of
    False -> oops m "empty slot"
  | True -> { m | sel = SUnit m.zone m.cur, msg = unitHelp m.zone u }.
unitHelp 2 u = "rear: V advance to the front".
unitHelp z u | uKind u == 2 = "artillery: C charge, F fire, R retreat".
unitHelp z u = "A attack  O overwatch  R retreat".

unitKey m k = case m.sel of
    SUnit z c -> unitAct m z c k
  | s -> oops m "select one of your units first".
unitAct m 1 c 30 = { m | sel = STarget 1 c, zone = 1, cur = c, msg = "target: arrows (up/down: forward, rear, HQ), enter" }.
unitAct m 1 c 33 = { m | sel = STarget 1 c, zone = 2, cur = c, msg = "aim: arrows, enter (rear units or the HQ)" }.
unitAct m 1 c 24 = { m | queue = AOver 0 c :: Nil, sel = SNone }.
unitAct m 1 c 19 = { m | queue = ARetreat 0 c :: Nil, sel = SNone }.
unitAct m 1 c 46 = { m | queue = ACharge 0 c :: Nil, sel = SNone }.
unitAct m 2 c 47 = { m | queue = AAdvance 0 c :: Nil, sel = SNone }.
unitAct m z c k = oops m "not that, here".
aim m 1 c =
  u = slotOf m.me 1 c;
  case uKind u == 2 of
    True -> { m | queue = AFire 0 c m.zone m.cur :: Nil, sel = SNone, zone = 1, cur = c }
  | False -> { m | queue = AAttack 0 1 c m.zone m.cur :: Nil, sel = SNone, zone = 1, cur = c }.
aim m z c = { m | sel = SNone }.

# ---- the view: the whole board as a Scene, every frame ------------------------------------

scene m =
  es0 = markEnts m.marks (backdrop Nil);
  es1 = cursorRing m (tiles m es0);
  es2 = hqEnts (hqEnts es1 m 0) m 1;
  es3 = rowEnts (rowEnts (rowEnts (rowEnts es2 m 0 1 0) m 0 2 0) m 1 1 0) m 1 2 0;
  es4 = es3;
  es5 = projEnts m (shotEnts m es4);
  es5b = puffEnts m.puffs es5;
  es6 = fxEnts m.fx es5b;
  es7 = numEnts m.nums es6;
  es8 = veil m es7;
  Scene Nil es8 lights (cameraOf m).
# where a unit fell: a dark ellipse that fades over twenty seconds
markEnts Nil es = es.
markEnts ((x, z, t) :: r) es =
  a = 520 - t * 520 / 20000;
  markEnts r (Ent "sphere" (x, 64, z) 0 (1900, 24, 1500) (40, 35, 35, a) :: es).
# the enemy's turn under a veil: a translucent dark sheet over the board,
# fading in and out over 400 ms, so their moves read as theirs
veil m es | m.turn == 0 and m.vt == 0 = es.
veil m es =
  a = 330 * m.vt / 400;
  Ent "cube" (0, 5200, 0) 0 (40000, 10, 40000) (20, 20, 40, a) :: es.
# floating damage numbers: white on a dark tag, in front of the target,
# rising and shrinking over 750 ms
numEnts Nil es = es.
numEnts ((x, z, s, t) :: r) es =
  k = easeOut (clampK (t * 1000 / 750));
  cell = 190 - k / 8;
  y = 2100 + k * 22 / 10;
  zz = z + 1500;
  w = textW s (cell * 9) + 3 * cell;
  a = 1000 - easeIn k;
  es1 = Ent "cube" (x, y - 43 * cell / 10, zz - 60) 0 (w, 8 * cell, 60) (60, 30, 30, a * 85 / 100) :: es;
  numEnts r (txtC es1 s x (y + cell / 2) zz cell (1000, 980, 900, a)).
# the camera, knocked about while shake > 0 (a hash of the clock, not a
# random stream: a replayed game shakes the same way)
cameraOf m | m.title == 1 =
  a = m.ms / 3;
  ((sinM a * 6000 / 1000, 12500 + sinM (a / 2) * 1500 / 1000, 17500 + cosM a * 2500 / 1000), (0, 0, 0 - 1200), 1000).
cameraOf m | m.shake == 0 = camera.
cameraOf m =
  a = m.shake;
  dx = ((m.ms * 7919) % 400 - 200) * a / 300;
  dy = ((m.ms * 104729) % 300 - 150) * a / 300;
  ((dx, 12500 + dy, 16000), (dx, 0, 1500), 1000).

# the world behind the board: the ground, a darker rim, and a far wall
# for the sky gradient (the fog does the rest)
backdrop es =
  Ent "plane" (0, 0, 0) 0 (60000, 1000, 60000) groundEdge ::
  Ent "cube" (0, 10, 0) 0 (26000, 20, 22000) ground ::
  Ent "cube" (0, 9000, 0 - 30000) 0 (90000, 18000, 200) skyTop ::
  Ent "cube" (0, 2500, 0 - 26000) 0 (90000, 5000, 200) sky :: es.

# the cursor: a ring of four strips that GLIDES between slots (the model
# keeps its position chasing the target) and breathes
cursorRing m es | m.zone == 0 or m.title == 1 or m.over != 0 = es.
cursorRing m es = targetRings m (cursorRingAt m es).
# while aiming, every slot the attacker can hit wears a breathing red ring
targetRings m es = case m.sel of
    STarget az ac -> hqRing m ac (ringsGo m ac 1 0 (ringsGo m ac 2 0 es))
  | s -> es.
ringsGo m ac z c es | c > 4 = es.
ringsGo m ac z c es =
  (x, y, zz) = posOf 1 z c;
  es2 = case aimOk m ac z c and not (m.zone == z and m.cur == c) of
    True -> ring es x zz 2000 2400 (breathe m danger (600, 300, 280)) 84
  | False -> es;
  ringsGo m ac z (c + 1) es2.
hqRing m ac es | aimOk m ac 3 0 and m.zone != 3 =
  (x, y, z) = hqPos 1;
  ring es x z 4400 2600 (breathe m danger (600, 300, 280)) 84.
hqRing m ac es = es.
ring es x z w d col h =
  Ent "cube" (x, h, z - d / 2) 0 (w + 40, 60, 50) col ::
  Ent "cube" (x, h, z + d / 2) 0 (w + 40, 60, 50) col ::
  Ent "cube" (x - w / 2, h, z) 0 (50, 60, d) col ::
  Ent "cube" (x + w / 2, h, z) 0 (50, 60, d) col :: es.
cursorRingAt m es =
  (x, z) = m.ring;
  side = case m.sel of STarget az ac -> 1 | s -> 0;
  pulse = 700 + (tri 900 m.ms + 1000) * 3 / 20;
  col = case side == 1 of True -> (1000, pulse * 4 / 10, 300) | False -> (1000, pulse * 86 / 100, 300);
  h = 95;
  Ent "cube" (x, h, z - 1250) 0 (2140, 70, 60) col ::
  Ent "cube" (x, h, z + 1250) 0 (2140, 70, 60) col ::
  Ent "cube" (x - 1070, h, z) 0 (60, 70, 2560) col ::
  Ent "cube" (x + 1070, h, z) 0 (60, 70, 2560) col :: es.

# tiles, lit by the selection and the valid targets (the cursor is the ring)
tiles m es = tileRow (tileRow (tileRow (tileRow es m 0 1) m 0 2) m 1 1) m 1 2.
tileRow es m s z = trGo es m s z 0.
trGo es m s z c | c > 4 = es.
trGo es m s z c =
  (x, y, zz) = posOf s z c;
  trGo (Ent "cube" (x, 30, zz) 0 (2100, 40, 2500) (tileCol m s z c) ::
        Ent "cube" (x, 56, zz + 1220) 0 (2100, 20, 60) tileEdge ::
        Ent "cube" (x - 1020, 56, zz) 0 (60, 20, 2500) tileEdge :: es) m s z (c + 1).
tileCol m s z c | s == 1 and isAim m z c = breathe m danger (500, 250, 240).
tileCol m s z c | s == 0 and isSelected m z c = (560, 540, 340).
tileCol m 0 1 c = tileMine.
tileCol m 0 2 c = tileRear.
tileCol m 1 1 c = tileTheirs.
tileCol m 1 2 c = tileRear.
tileCol m s z c = tileRear.
# a colour breathing between two, on the clock
breathe m (r1, g1, b1) (r2, g2, b2) =
  k = (tri 1100 m.ms + 1000) / 2;
  (r2 + (r1 - r2) * k / 1000, g2 + (g1 - g2) * k / 1000, b2 + (b1 - b2) * k / 1000).
isCursor m z c = case m.sel of
    SPlace i pz -> pz == z and c == m.cur
  | SNone -> m.zone == z and c == m.cur
  | s -> False.
isSelected m z c = case m.sel of
    SUnit uz uc -> uz == z and uc == c
  | STarget uz uc -> uz == z and uc == c
  | s -> False.
isTarget m z c = case m.sel of
    STarget az ac -> m.zone == z and c == m.cur
  | s -> False.
isAim m z c = case m.sel of
    STarget az ac -> aimOk m ac z c
  | s -> False.
aimOk m ac z c | uKind (slotOf m.me 1 ac) == 2 = fireOk m 0 z c.
aimOk m ac z c = targetOk m 0 ac z c.

hqEnts es m s =
  p = sideOf m s;
  (x, y, z) = hqPos s;
  col = hqCol s;
  hl = case s == 1 and m.zone == 3 and isTargetHq m of True -> breathe m (1000, 520, 420) col | False -> col;
  d = dirOf s;
  hy = case s == 0 of True -> 0 | False -> 3142;
  es1 = Ent "hq" (x, y, z) hy (1000, 1000, 1000) hl ::
        Ent "hq_fence" (x, y, z) hy (1000, 1000, 1000) (620, 660, 720) ::
        Ent "hq_dish" (x + 1350 * d, 1080, z - 700 * d) (m.ms / 60 % 6284) (1000, 1000, 1000) (950, 950, 950) :: es;
  case s == 1 of
    True -> txtC es1 "HQ {p.hq}" x 3400 (z + 750) 95 white
  | False -> es1.
isTargetHq m = case m.sel of STarget az ac -> True | s -> False.

rowEnts es m s z c | c > 4 = es.
rowEnts es m s z c =
  u = slotOf (sideOf m s) z c;
  es2 = case u.id >= 0 of
    True -> unitEnts es m s z c u
  | False -> es;
  rowEnts es2 m s z (c + 1).

# where a unit is drawn: its slot, plus the animation's offset if it is
# the one lunging or sliding
unitPos m s z c =
  An kind as fz fc tz tc t done = m.anim;
  (x, y, zz) = posOf s z c;
  case as == s and fz == z and fc == c and kind == 3 of
    True -> lunge kind t (x, y, zz) (tgtPos (1 - s) tz tc s)
  | False -> case as == s and fz == z and fc == c and kind == 1 of
      True -> recoil s t (x, y, zz)
    | False -> (x, y, zz).
# an attacker fires from where it stands; a tank rocks back 90 milli from
# the shot at 60 ms and settles by 300
recoil s t (x, y, zz) =
  k = case t < 60 of True -> 0 | False -> easeOut (clampK ((300 - t) * 1000 / 240)) * 90 / 1000;
  (x, y, zz - dirOf s * k).
tgtPos s 3 c me = hqPos s.
tgtPos s z c me = posOf s z c.
# kind 1: out to 70% of the way at the midpoint and back; kind 3: all the way
lunge 1 t from to =
  d = durOf 1;
  k = case t * 2 < d of True -> t * 2000 / d | False -> Int.max 0 ((d - t) * 2000 / d);
  lerp from to (easeOut (clampK k) * 7 / 10).
lunge k t from to = lerp from to (easeInOut (clampK (t * 1000 / durOf 3))).
lerp (ax, ay, az) (bx, by, bz) k = (ax + (bx - ax) * k / 1000, ay + (by - ay) * k / 1000, az + (bz - az) * k / 1000).

# the unit's solids, scaled by its birth pop and its death shrink
unitEnts es m s z c u | u.born < 0 = es.
unitEnts es m s z c u =
  (x, y, zz) = unitPos m s z c;
  k = case u.dead == 1 of True -> Int.max 50 (1000 - easeIn (u.dt * 1000 / 420)) | False -> 150 + backOut (Int.min 1000 (u.born * 1000 / 340)) * 850 / 1000;
  bob = case s == 0 and (isCursor m z c or isSelected m z c) of True -> 120 - Int.abs ((m.ms % 800) - 400) * 3 / 10 | False -> 0;
  lift = (case u.born < 340 of True -> (1000 - easeOut (u.born * 1000 / 340)) * 12 / 10 | False -> 0) + bob;
  col = case u.flash > 0 of True -> fade white 1000 | False -> (case u.dead == 1 of True -> fade (unitCol s u) (1000 - easeIn (clampK (u.dt * 1000 / 420))) | False -> fade (unitCol s u) 1000);
  d = dirOf s;
  es1 = case u.down == 1 of
    True -> Ent "cube" (x, 80, zz) 0 (1700, 120, 2200) (150, 150, 180) ::
            txtC es "?" x 700 (zz + 600) 90 (600, 600, 700)
  | False -> solids es (uKind u) (uSoft u) x (y + lift) zz d k col (accent s u) (turretYaw m s z c x zz) m.ms (phaseOf s z c);
  es2 = Ent "sphere" (x, 60, zz) 0 (1500 * k / 1000, 30, 1500 * k / 1000) shadow :: es1;
  hot = s == 0 and (isCursor m z c or isSelected m z c);
  case u.down == 1 of
    True -> es2
  | False -> labelEnts es2 u x zz hot.
unitCol s u | uKind u == 1 = supCol s.
unitCol s u = sideCol s.
accent s u | uSoft u == 0 and uKind u == 0 = lighter (sideCol s).
accent s u = (950, 950, 900).
lighter (r, g, b) = (r + (1000 - r) / 3, g + (1000 - g) / 3, b + (1000 - b) / 3).
fade (r, g, b) a = (r, g, b, a).

# ---- easing (milli): the difference between a thing moving and a thing
# ARRIVING.  k in 0..1000 -> 0..1000.
easeOut k = 1000 - (1000 - k) * (1000 - k) / 1000.
easeIn k = k * k / 1000.
easeInOut k = k * k * (3000 - 2 * k) / 1000000.
# a back-out: overshoots by ~10% and settles (the summon pop, the banner)
backOut k =
  t = k - 1000;
  t2 = t * t / 1000;
  1000 + t2 * (2702 * t / 1000 + 1702) / 1000.
clampK k = Int.max 0 (Int.min 1000 k).

# ---- integer trig (milli-radians): Bhaskara's sine; atanM is below ------
sinM x =
  r = ((x % 6283) + 6283) % 6283;
  case r > 3142 of
    True -> 0 - sinM (r - 3142)
  | False -> 16 * r * (3142 - r) * 1000 / (5 * 3142 * 3142 - 4 * r * (3142 - r)).
cosM x = sinM (x + 1571).
# the direction a yaw faces, milli: yaw 0 is -z (the player's front)
facing yaw = (0 - sinM yaw, 0 - cosM yaw).
# the yaw a unit at column c on side s turns to hit (tz, tc)
aimYaw m s c tz tc = aimAt (case s == 0 of True -> 0 | False -> 3142) s (posOf s 1 c) (tgtPos (1 - s) tz tc s).
# where the shot leaves: the rifle's tip for a soldier, the barrel's for a tank
muzzle m s c yaw =
  u = slotOf (sideOf m s) 1 c;
  (x, y, z) = posOf s 1 c;
  (fx, fz) = facing yaw;
  case uSoft u == 1 of
    True -> (x + fx * 720 / 1000, 860, z + fz * 720 / 1000)
  | False -> (x + fx * 2200 / 1000, 1090, z + fz * 2200 / 1000).

# ---- idle motion: waves of the clock, each unit on its own phase ----------
# tri p t: a triangle wave of period p ms, -1000..1000.  sweep p t: the
# same span with holds -- 35% at each end, 15% moving between -- the
# "look here, then there" of a scanning turret or a soldier squaring up.
# phaseOf: a hash of the slot, so neighbours never move in step.
tri p t =
  x = ((t % p) + p) % p * 2000 / p;
  1000 - Int.abs (x - 1000).
sweep p t =
  x = ((t % p) + p) % p * 1000 / p;
  case x < 350 of
    True -> 0 - 1000
  | False -> case x < 500 of
      True -> (x - 425) * 1000 / 75
    | False -> case x < 850 of
        True -> 1000
      | False -> (925 - x) * 1000 / 75.
phaseOf s z c = (s * 7 + z * 3 + c * 11) * 397.

# the turret's one degree of freedom: forward at rest (yaw 0 faces -z, the
# player's front; the enemy's tanks sit at yaw pi), swung onto the target
# while this unit is the one lunging or firing -- and between actions it
# scans, two sweeps of different periods summed so it never quite repeats
turretYaw m s z c x zz =
  An kind as fz fc tz tc t done = m.anim;
  base = case s == 0 of True -> 0 | False -> 3142;
  ph = phaseOf s z c;
  idle = sweep 4700 (m.ms + ph) * 260 / 1000 + tri 3100 (m.ms + ph * 2) * 90 / 1000;
  case as == s and fz == z and fc == c and (kind == 1 or kind == 2) of
    False -> base + idle
  | True -> aimAt base s (posOf s z c) (tgtPos (1 - s) tz tc s).
aimAt base s (x, y, z) (tx, ty, tz) =
  base + dirOf s * atanM (tx - x) (Int.abs (tz - z)).
# atan(dx/dz) in milli-radians, signed like dx; |r| <= 1 by the polynomial
# r(pi/4 + 0.273(1 - |r|)), beyond it by pi/2 - atan(dz/dx)
atanM dx dz | dz == 0 = case dx > 0 of True -> 1571 | False -> (case dx < 0 of True -> 0 - 1571 | False -> 0).
atanM dx dz | Int.abs dx > dz = case dx > 0 of True -> 1571 - atanM dz (Int.abs dx) | False -> 0 - 1571 + atanM dz (Int.abs dx).
atanM dx dz =
  r = Int.abs dx * 1000 / dz;
  a = r * (785 + 273 * (1000 - r) / 1000) / 1000;
  case dx < 0 of True -> 0 - a | False -> a.

# each kind: a few primitives placed relative to the slot, scaled by k/1000
solids es 1 soft x y z d k col acc ty ms ph =
  hy = case d < 0 of True -> 0 | False -> 3142;
  bob = (tri 140 (ms + ph) + 1000) * 8 / 2000;
  Ent "truck" (x, y + bob, z) hy (k, k, k) col ::
  Ent "truck_kit" (x, y, z) hy (k, k, k) dark ::
  Ent "truck_canvas" (x, y + bob + (tri 290 (ms + ph) + 1000) * 6 / 2000, z) hy (k, k, k) khaki :: es.
solids es 2 soft x y z d k col acc ty ms ph =
  Ent "cube" (x, y + 300 * k / 1000, z) 0 (1300 * k / 1000, 550 * k / 1000, 900 * k / 1000) col ::
  Ent "cube" (x, y + 800 * k / 1000, z + d * 500 * k / 1000) 0 (240 * k / 1000, 240 * k / 1000, 1700 * k / 1000) acc :: es.
solids es kind 1 x y z d k col acc ty ms ph =
  hy = case d < 0 of True -> 0 | False -> 3142;
  sc = k * 13 / 10;
  sway = tri 3400 (ms + ph);                      # weight, side to side
  turn = sweep 6100 (ms + ph * 3);                # squaring up, now and then
  draw = sweep 5300 (ms + ph * 5);                # the rifle, forward and back
  bx = x + sway * 40 / 1000;
  by = hy + sway * 70 / 1000 + turn * 120 / 1000;
  rz = z + d * (0 - (draw + 1000) * 60 / 2000);   # forward = toward the enemy
  Ent "infantry" (bx, y, z) by (sc, sc, sc) col ::
  Ent "infantry_kit" (bx, y, z) by (sc, sc, sc) dark ::
  Ent "infantry_rifle" (bx, y + (draw + 1000) * 30 / 2000, rz) (by + draw * 160 / 1000) (sc, sc, sc) dark :: es.
# heavy: the CoScad tank (models/tank), hull + turret, 1 model unit = 1000
solids es kind soft x y z d k col acc ty ms ph =
  hy = case d < 0 of True -> 0 | False -> 3142;
  sc = k * 115 / 100;
  Ent "tank_hull" (x, y, z) hy (sc, sc, sc) col ::
  Ent "tank_turret" (x, y + 750 * sc / 1000, z) ty (sc, sc, sc) acc :: es.

labelEnts es u x z hot | u.dead == 1 = es.
labelEnts es u x z hot =
  s = case uKind u == 1 of True -> "+{cGen (uCard u)} {u.hp}" | False -> "{u.atk}/{u.hp}";
  tag = case u.mode == 1 of True -> " OW" | False -> (case u.chg == 1 of True -> " CHG" | False -> "");
  vet = case u.vet > 0 of True -> " *{u.vet}" | False -> "";
  col = case hot of True -> white | False -> (case u.ready == 1 of True -> yellow | False -> (800, 800, 800));
  txtC es "{s}{tag}{vet}" x 2750 (z - 300) (case hot of True -> 80 | False -> 70) col.

# an artillery or ambush shell in flight (kind 2), or the summon's card (kind 5)
shotEnts m es =
  An kind s fz fc tz tc t done = m.anim;
  case kind == 2 of
    True -> shell es (posOf s 1 fc) (tgtPos (1 - s) tz tc s) t
  | False -> case kind == 5 of
      True -> cardFlight es m s fz tz tc t
    | False -> es.
cardFlight es m s i z c t =
  k = easeInOut (clampK (t * 1000 / 380));
  side = sideOf m s;
  n = List.len side.hand + 1;
  from = case s == 0 of
    True -> ((i * 2 - (n - 1)) * 950, 900, 11500)
  | False -> (0, 2600, 0 - 12500);
  (x, y, zz) = lerp from (posOf s z c) k;
  arc = 1800 * k * (1000 - k) / 1000000;
  sc = 1000 - k * 55 / 100;
  yaw = case s == 0 of True -> 0 | False -> 3142;
  Ent "cube" (x, y + arc, zz) (yaw + k * 3 / 10) (1750 * sc / 1000, 60, 2300 * sc / 1000) (sideLight s) ::
  Ent "cube" (x, y + arc + 40, zz) (yaw + k * 3 / 10) (1500 * sc / 1000, 40, 2000 * sc / 1000) (paperLit) :: es.
shell es from to t =
  k = Int.min 1000 (t * 1000 / durOf 2);
  (x, y, z) = lerp from to k;
  Ent "sphere" (x, 700 + 6 * k * (1000 - k) / 1000, z) 0 (420, 420, 420) (1000, 800, 300) :: es.

# kind 1: a soldier fires a burst of tracers from the rifle, a tank one
# shell from the barrel, with a muzzle flash; both land at the midpoint
projEnts m es =
  An kind s fz fc tz tc t done = m.anim;
  case kind == 1 of
    False -> es
  | True -> projOf m es s fc tz tc t.
projOf m es s c tz tc t =
  u = slotOf (sideOf m s) 1 c;
  yaw = aimYaw m s c tz tc;
  from = muzzle m s c yaw;
  to = tgtPos (1 - s) tz tc s;
  case uSoft u == 1 of
    True -> flash (tracers es from to yaw t 0) from t 90 260
  | False -> flash (shell2 es from to t) from t 80 420.
flash es (x, y, z) t upto size | t < upto = Ent "sphere" (x, y, z) 0 (size, size, size) (1000, 950, 600) :: es.
flash es p t upto size = es.
# four rounds 55 ms apart, each crossing in 230 ms; elongated along the aim
tracers es from to yaw t i | i == 4 = es.
tracers es from to yaw t i =
  ti = t - i * 55;
  es2 = case ti > 0 and ti < 230 of
    True -> tracer es from to yaw (ti * 1000 / 230)
  | False -> es;
  tracers es2 from to yaw t (i + 1).
tracer es from to yaw k =
  (x, y, z) = lerp from to k;
  Ent "cube" (x, y - (y - 700) * k / 1000, z) yaw (70, 70, 420) (1000, 900, 300) :: es.
# the shell leaves at 60 ms and lands at 260, on a flat arc
shell2 es from to t | t < 60 or t > 260 = es.
shell2 es from to t =
  k = (t - 60) * 1000 / 200;
  (x, y, z) = lerp from to k;
  Ent "sphere" (x, y + 500 * k * (1000 - k) / 1000000 - (y - 800) * k / 1000, z) 0 (220, 220, 220) (300, 300, 320) :: es.
# smoke: grey puffs that rise, grow and fade over 700 ms; a puff with a
# negative age is still in the barrel
puffEnts Nil es = es.
puffEnts ((x, y, z, t) :: r) es | t < 0 = puffEnts r es.
puffEnts ((x, y, z, t) :: r) es =
  k = easeOut (clampK (t * 1000 / 700));
  sz = 160 + k * 7 / 10;
  a = 800 - k * 8 / 10;
  puffEnts r (Ent "sphere" (x, y + k * 6 / 10, z) 0 (sz, sz, sz) (520, 520, 550, a) :: es).
fxEnts Nil es = es.
fxEnts ((x, y, z, t) :: r) es =
  k = easeOut (clampK (t * 1000 / 380));
  fxEnts r (Ent "cube" (x, y + k * 11 / 10, z) 0 (160 - k / 8, 160 - k / 8, 160 - k / 8) (1000, 850 - k * 38 / 100, 300, 1000 - k * 7 / 10) :: es).

# ---- the 2D UI: scene2d over the board -------------------------------------------------
# A 480 x 300 virtual screen (the 960 x 600 window at an integer 2x, so
# every glyph cell is exactly 2 x 2 real pixels): a status bar and the
# message at the top, a unit panel at the right, the banner in the middle,
# the hand along the bottom as cards facing the viewer -- rebuilt from the
# model every frame and drawn by the walker's second pass, in front of
# everything, with the depth cleared.  Every box has a rectangle in this
# space, which is what a mouse will hit-test against later: no raycasting.

uiW = 960.
uiH = 600.
ui m =
  (ents, slots) = S2.buildW (uiW, uiH) (uiTree m);
  (ents, S2.camAt uiH).

grow = Box (Grow :: Nil) Nil.
spacer h = Box (H h :: W 1 :: Nil) Nil.
hspace w = Box (W w :: H 1 :: Nil) Nil.
# text in the proportional face at em px
t em col s = Lbl (Fs em :: Fg col :: Nil) s.
centred kid = Box (Row :: Center :: Nil) (kid :: Nil).
# a rounded chip with a word in it
tag bg fg s = Box (Row :: Pad 5 :: Round 9 :: Bg bg :: Mid :: Nil) (t 12 fg s :: Nil).
# a small caption over a figure
stat cap col v =
  Box (Row :: Gap 5 :: Mid :: Nil) (t 10 inkDim cap :: t 15 col v :: Nil).
# a key cap and what it does
keyLine k what =
  Box (Row :: Gap 7 :: Mid :: Nil)
      (Box (Row :: W 26 :: Pad 3 :: Round 5 :: Bg chip :: Center :: Mid :: Nil) (t 11 ink k :: Nil) ::
       t 12 inkDim what :: Nil).

uiTree m | m.title == 1 = titleTree m.
uiTree m =
  Box (Col :: W uiW :: H uiH :: Nil)
      (topBar m :: msgLine m :: middle m :: handBar m :: Nil).
# the title: a glass card over the drifting board, the prompt blinking
titleTree m =
  blink = case tri 1200 m.ms > 0 of True -> ink | False -> inkDim;
  logo = Box (Col :: Pad 30 :: Gap 10 :: Round 18 :: Shadow :: Bga glass :: Bord yellow :: Nil)
             (centred (t 64 yellow "TERRA II") ::
              centred (t 14 inkDim "a positional card game  |  Republic VI against the Southern Empire") ::
              spacer 10 ::
              centred (t 20 blink "press ENTER") ::
              spacer 4 ::
              centred (t 12 inkDim "arrows  enter  esc     space ends the turn     M music     Q quit") :: Nil);
  Box (Col :: W uiW :: H uiH :: Nil)
      (grow :: centred logo :: grow :: centred (t 12 inkDim "FP-RISC on QOS Portable") :: spacer 14 :: Nil).

topBar m =
  Box (Row :: H 46 :: Pad 8 :: Gap 14 :: Mid :: Bga glass :: Nil)
      (tag yellow paper "TURN {m.tno}" ::
       tag blueDark blueLight "YOU" ::
       stat "HQ" ink "{m.me.hq}" ::
       stat "SUPPLY" (supplyCol m) "{supplyShown m}" ::
       stat "DECK" ink "{List.len m.me.deck}" ::
       stat "HAND" ink "{List.len m.me.hand}" ::
       grow ::
       stat "HQ" ink "{m.en.hq}" ::
       stat "SUPPLY" ink "{m.en.stock}" ::
       tag redDark redLight "ENEMY" ::
       tag (case m.env >= 4 of True -> yellow | False -> chip) (case m.env >= 4 of True -> paper | False -> ink) "ENV {m.env}" :: Nil).

# the supply figure: counts up or down one a tick, amber while it moves
supplyShown m =
  (sv, st) = m.supV;
  sv.
supplyCol m =
  (sv, st) = m.supV;
  case st < 400 of True -> yellow | False -> ink.
msgLine m =
  Box (Row :: H 30 :: Pad 4 :: Center :: Mid :: Nil) (t 14 (960, 930, 720) m.msg :: Nil).

middle m =
  Box (Row :: Grow :: Pad 10 :: Nil)
      (Box (Col :: Grow :: Nil) (grow :: bannerBox m :: grow :: Nil) :: panel m :: Nil).
bannerBox m | m.bt > 0 =
  age = case m.title == 1 of True -> 1000 | False -> clampK ((900 - m.bt) * 1000 / 260);
  em = case m.title == 1 of True -> 44 | False -> 16 + backOut age * 28 / 1000;
  centred (Box (Row :: Pad 14 :: Round 14 :: Bga glass :: Nil) (t em yellow m.banner :: Nil)).
bannerBox m = spacer 1.

# the unit panel: whatever the cursor or the selection is on
panel m = panelOf m (panelUnit m).
panelOf m (s, z, c) | s < 0 = spacer 1.
panelOf m (s, z, c) = Box (Col :: Nil) (panelFor m s z c (slotOf (sideOf m s) z c) :: grow :: Nil).
panelUnit m = case m.sel of
    SUnit z c -> (0, z, c)
  | STarget z c -> panelTarget m z c
  | SPlace i z -> (0 - 1, 0, 0)
  | s -> case m.zone == 0 of
      True -> (0 - 1, 0, 0)
    | False -> case alive (slotOf m.me m.zone m.cur) of True -> (0, m.zone, m.cur) | False -> (0 - 1, 0, 0).
panelTarget m az ac = case m.zone == 3 of
    True -> (0, 1, ac)
  | False -> case alive (slotOf m.en m.zone m.cur) of True -> (1, m.zone, m.cur) | False -> (0, 1, ac).
panelFor m s z c u =
  cd = uCard u;
  who = case s == 0 of True -> "YOURS" | False -> "ENEMY";
  mode = case u.down == 1 of
    True -> "face down"
  | False -> case u.mode == 1 of True -> "OVERWATCH" | False -> (case u.chg == 1 of True -> "CHARGED" | False -> "attack mode");
  k = easeOut (clampK (m.hovT * 1000 / 220));
  rim = case s == 0 of True -> blueLight | False -> redLight;
  Box (Col :: W 250 :: Pad 6 :: Gap 8 :: Round 12 :: Shadow :: Bga (mixA glass glassLit (1000 - k)) :: Bord rim :: Nil)
      (Box (Row :: Pad 8 :: Gap 8 :: Round 8 :: Bg (bandOf cd) :: Mid :: Nil)
           (t 17 white (cName cd) :: grow :: t 11 (mixC white (bandOf cd) 300) who :: Nil) ::
       Box (Col :: Pad 4 :: Gap 8 :: Nil)
           (t 12 inkDim "{zoneName z} {c + 1}   {mode}{vetTag u}{readyTag u}" ::
            Box (Row :: Gap 8 :: Nil) (statChips cd u) ::
            t 11 inkDim "drain {cDrain cd}   call {cCost cd}" ::
            panelHelp m s z u :: Nil) :: Nil).
statChips cd u | cKind cd == 1 = chipOf "GEN" "+{cGen cd}" :: chipOf "HP" "{u.hp}/{uMax u}" :: Nil.
statChips cd u = chipOf "ATK" "{u.atk}" :: chipOf "HP" "{u.hp}/{uMax u}" :: Nil.
chipOf cap v =
  Box (Col :: Grow :: Pad 6 :: Round 8 :: Bg chip :: Center :: Mid :: Nil)
      (t 10 inkDim cap :: t 20 ink v :: Nil).
helpLines ls = Box (Col :: Gap 5 :: Nil) ls.
mixC (r1, g1, b1) (r2, g2, b2) k = (r1 + (r2 - r1) * k / 1000, g1 + (g2 - g1) * k / 1000, b1 + (b2 - b1) * k / 1000).
mixA (r1, g1, b1, a1) (r2, g2, b2, a2) k = (r1 + (r2 - r1) * k / 1000, g1 + (g2 - g1) * k / 1000, b1 + (b2 - b1) * k / 1000, a1 + (a2 - a1) * k / 1000).
vetTag u | u.vet > 0 = "   vet {u.vet}".
vetTag u = "".
readyTag u | u.ready == 1 = "   ready".
readyTag u = "   spent".
panelHelp m 0 1 u | uKind u == 2 = helpLines (keyLine "C" "charge" :: keyLine "F" "fire" :: keyLine "R" "retreat" :: keyLine "esc" "back" :: Nil).
panelHelp m 0 1 u = helpLines (keyLine "A" "attack" :: keyLine "O" "overwatch" :: keyLine "R" "retreat" :: keyLine "esc" "back" :: Nil).
panelHelp m 0 2 u | uKind u != 1 = helpLines (keyLine "V" "advance" :: keyLine "esc" "back" :: Nil).
panelHelp m s z u = spacer 1.

# a card's header band by kind
bandOf cd | cKind cd == 1 = bandSup.
bandOf cd | cKind cd == 2 = bandArt.
bandOf cd | cSoft cd == 1 = bandInf.
bandOf cd = bandArm.

# the hand: cards facing the viewer, centred; the cursor's card lifted,
# lit and rimmed amber
cardW = 124.
cardH = 150.
handBar m =
  Box (Row :: H 184 :: Pad 10 :: Gap 10 :: Center :: Nil) (cards m m.me.hand 0).
# the departing card's ghost shrinks in place over 200 ms so the hand
# closes the gap; the last card, just dealt, grows in over 200 ms
cards m Nil i = ghost m i Nil.
cards m (k :: r) i = ghost m i (card m (cardOf k) i (dealtW m i) :: cards m r (i + 1)).
ghost m i rest =
  (gi, gt) = m.gone;
  case gi == i and gt < 200 of
    True -> stub (Int.max 1 (cardW - easeOut (gt * 1000 / 200) * cardW / 1000)) :: rest
  | False -> rest.
dealtW m i | i == List.len m.me.hand - 1 and m.dealt < 200 = Int.max 1 (easeOut (m.dealt * 1000 / 200) * cardW / 1000).
dealtW m i = cardW.
stub w =
  Box (Col :: W w :: H (cardH + 14) :: Nil)
      (spacer 14 :: Box (Col :: Grow :: Round 10 :: Bg paper :: Bord edge :: Nil) Nil :: Nil).
card m cd i w | w < cardW = stub w.
card m cd i w =
  sel = case m.sel of SNone -> m.zone == 0 and m.cur == i | SPlace j z -> j == i | s -> False;
  afford = m.me.stock >= cCost cd;
  k = case sel of True -> easeOut (clampK (m.hovT * 1000 / 140)) | False -> 0;
  face = mixC paper paperLit k;
  rim = case sel of True -> mixC edge yellow k | False -> edge;
  body = Box (Col :: W cardW :: H cardH :: Pad 5 :: Gap 6 :: Round 10 :: Shadow :: Bg face :: Bord rim :: Nil)
             (Box (Row :: H 32 :: Pad 6 :: Round 7 :: Bg (bandOf cd) :: Mid :: Gap 4 :: Nil)
                  (t 13 white (cName cd) :: grow :: costBadge afford (cCost cd) :: Nil) ::
              Box (Row :: Grow :: Round 7 :: Bg (mixC face paper 500) :: Center :: Mid :: Nil)
                  (t 11 (mixC inkDim (bandOf cd) 400) (kindName cd) :: Nil) ::
              Box (Row :: H 44 :: Pad 2 :: Gap 6 :: Mid :: Nil) (bigStats cd) :: Nil);
  lift = 14 - k * 14 / 1000;
  Box (Col :: W cardW :: H (cardH + 14) :: Nil) (spacer lift :: body :: Nil).
costBadge afford cost =
  Box (Row :: W 22 :: H 22 :: Round 11 :: Bg (case afford of True -> yellow | False -> danger) :: Center :: Mid :: Nil)
      (t 12 paper "{cost}" :: Nil).
bigStats cd | cKind cd == 1 = figure "+{cGen cd}" "GEN" yellow :: grow :: figure "{cDef cd}" "DEF" ink :: Nil.
bigStats cd = figure "{cAtk cd}" "ATK" ink :: grow :: figure "{cDef cd}" "DEF" ink :: Nil.
figure v cap col = Box (Col :: Center :: Mid :: Nil) (t 22 col v :: t 9 inkDim cap :: Nil).
kindName cd | cKind cd == 1 = "SUPPORT".
kindName cd | cKind cd == 2 = "ARTILLERY".
kindName cd | cSoft cd == 1 = "INFANTRY".
kindName cd = "ARMOUR".

# ---- the elm four ---------------------------------------------------------------------------

init env = initModel.

update env ev m = case ev of
    ETick -> tick m
  | EKey k -> keyIn m k
  | e -> (m, Nil).
# buffered; a live window also sends kind-1 chars (negative codes): ignored
keyIn m k | k < 0 = (m, Nil).
keyIn m k = ({ m | keys = m.keys + (k :: Nil) }, Nil).

subs m = STick tickMs :: SKeys :: Nil.

view m = (scene m, ui m, m.snap).

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  gl = spawn (GL.serve 960 600 "terra2" models);
  cfg = { env = 0, mt = mt, tick = 160000, input = gl, render = gl };
  MV.game me cfg (App init update subs view).

# ---- not in this cut --------------------------------------------------------------------------
# Tactics cards, every card text (Rally, Last Stand, Breakthrough, Hammer
# Strike, ...), the Unsupplied rule (negative rate clamps to 0 here), RECALL,
# redraw / requisition, the mulligan, and Turn 1's skipped Act phase.
