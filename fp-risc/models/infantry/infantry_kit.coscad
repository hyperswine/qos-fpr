// infantry_kit.coscad -- the soldier's kit, drawn dark: helmet, boots,
// backpack and the rifle held across the chest.  Same frame as
// infantry.coscad.

boot_l = χ -0.17 (ψ -0.12 (ζ 0 (▬ 0.16 0.26 0.12)))
boot_r = χ 0.01 (ψ -0.12 (ζ 0 (▬ 0.16 0.26 0.12)))
// helmet: a wider hex prism over the head, with a brim
helmet = ζ 1.02 (⎏ 6 0.14 0.1)
brim = ζ 1.0 (⎏ 6 0.17 0.03)
// backpack on the back (-Y)
pack = χ -0.15 (ψ -0.3 (ζ 0.52 (▬ 0.3 0.16 0.3)))
// the rifle: a hex barrel along +Y, yawed 25 deg so it reads as held
// diagonally, with a stock behind and a magazine below
barrel = ω 25 (ψ 0.08 (ζ 0.66 (θ -90 (⎏ 6 0.045 0.55))))
stock = ω 25 (χ -0.045 (ψ -0.22 (ζ 0.58 (▬ 0.09 0.32 0.13))))
mag = ω 25 (χ -0.025 (ψ 0.12 (ζ 0.54 (▬ 0.05 0.06 0.14))))
grip = ω 25 (χ -0.025 (ψ 0.0 (ζ 0.55 (▬ 0.05 0.05 0.12))))

main = boot_l ⊕ boot_r ⊕ helmet ⊕ brim ⊕ pack ⊕ barrel ⊕ stock ⊕ mag ⊕ grip
