# ttp229.fpr -- the touch-pad driver against the pattern stimulus:
# Pin.feed answers the 16 clocks the way the chip would, both active
# levels are exercised, and the trace confirms exactly 16 SCL pulses.
T = use "../programs/mods/ttp229.fpr".
scl = 0. sdo = 1.
main =
  _ = T.init Pin.mode scl sdo;
  _ = Pin.feed sdo 65535 16;                       # nothing pressed (idle high)
  _ = print "idle map = {T.readMap Pin.write Pin.read scl sdo}";
  _ = Pin.feed sdo 64511 16;                       # bit for key 6 low
  _ = print "key (active-low) = {T.key Pin.write Pin.read scl sdo 0}";
  _ = Pin.feed sdo 2048 16;                        # only key 5 high
  _ = print "key (active-high) = {T.key Pin.write Pin.read scl sdo 1}";
  _ = Pin.tclear Unit;
  _ = Pin.feed sdo 65535 16;
  _ = T.readMap Pin.write Pin.read scl sdo;
  _ = print "scl edges in one read = {Pin.tlen Unit}";
  print "ttp229 done".
