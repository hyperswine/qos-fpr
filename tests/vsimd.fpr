# vsimd.fpr -- the numeric SIMD tier (vec.c): known-answer checks for
# every op the rasterizer leans on.  Unary ops are in place, zips consume
# their src, gather/slice thread the read-only operand back.

main =
  # iota + axpb + sar: v = ((3*i + 4) >> 1) over i = 0..5
  a = Vec.iota 6 |> Vec.axpb 3 4 |> Vec.sar 1;
  _ = print "axpb/sar: {Vec.toList a}";

  # dup + zipAdd: i + i = 2i ; zipMul: squares
  (b1, b2) = Vec.dup (Vec.iota 5);
  _ = print "zipAdd:   {Vec.toList (Vec.zipAdd b1 b2)}";
  (c1, c2) = Vec.dup (Vec.iota 5);
  _ = print "zipMul:   {Vec.toList (Vec.zipMul c1 c2)}";

  # clamps and masks
  d = Vec.iota 7 |> Vec.axpb 1 (0 - 3) |> Vec.maxS (0 - 1) |> Vec.minS 2;
  _ = print "clamp:    {Vec.toList d}";
  e = Vec.iota 6 |> Vec.axpb 1 (0 - 3) |> Vec.ges 0;
  _ = print "ges0:     {Vec.toList e}";

  # zipMin + zipLt
  f = Vec.zipMin (Vec.iota 5) (Vec.iota 5 |> Vec.axpb (0 - 1) 4);   # min(i, 4-i)
  _ = print "zipMin:   {Vec.toList f}";
  g = Vec.zipLt (Vec.iota 5) (Vec.iota 5 |> Vec.axpb 0 2);          # i < 2
  _ = print "zipLt:    {Vec.toList g}";

  # zipDiv (16.16-ish): (i << 8) / 2, and the divide-by-zero clamp
  h = Vec.zipDiv (Vec.iota 4 |> Vec.axpb 256 0) (Vec.iota 4 |> Vec.axpb 0 2);
  _ = print "zipDiv:   {Vec.toList h}";
  h2 = Vec.zipDiv (Vec.iota 3 |> Vec.axpb 0 9) (Vec.iota 3);        # 9/0 9/1 9/2
  _ = print "div0:     {Vec.toList h2}";

  # gather through a table (threads the table back)
  tab = Vec.fromList [10, 20, 30, 40];
  (gt, tab2) = Vec.gather (Vec.fromList [3, 0, 1, 99]) tab;         # 0-based; 99 OOB -> 0
  _ = print "gather:   {Vec.toList gt}";
  _ = Vec.free tab2;

  # the DDA lanes: subtract, compare-equal, max, abs, scalar-eq
  _ = print "zipSub:   {Vec.toList (Vec.zipSub (Vec.iota 5 |> Vec.axpb 0 10) (Vec.iota 5))}";
  _ = print "zipEq:    {Vec.toList (Vec.zipEq (Vec.iota 5) (Vec.iota 5 |> Vec.axpb 0 2))}";
  _ = print "zipMax:   {Vec.toList (Vec.zipMax (Vec.iota 5) (Vec.iota 5 |> Vec.axpb 0 2))}";
  _ = print "absv:     {Vec.toList (Vec.absv (Vec.iota 5 |> Vec.axpb 1 (0 - 2)))}";
  _ = print "eqS:      {Vec.toList (Vec.eqS 3 (Vec.iota 5))}";

  # blend + slice + burst: splice a masked span into a framebuffer row
  fb = Vec.iota 8 |> Vec.axpb 0 7;                                  # row of 7s
  (sl, fb2) = Vec.slice 2 4 fb;
  m = Vec.fromList [1, 0, 1, 0];
  src = Vec.fromList [50, 51, 52, 53];
  fb3 = Vec.burst 2 (Vec.blend m src sl) fb2;
  _ = print "blit:     {Vec.toList fb3}";
  print "vsimd done".
