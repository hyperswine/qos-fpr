# slab.fpr -- THE reclamation regression for the slab refactor.
# 300 sequential workers, each ~1 MiB of list churn + a 256 KiB stack +
# its acb: ~390 MiB total through a 96 MiB buddy region.  Passes ONLY
# if actor death returns slabs+stacks and dropping the last promoted
# object frees its orphaned slab.  (The old per-hart arenas died at
# roughly worker 20.)
build n acc = case n <= 0 of True -> acc | False -> build (n - 1) (n :: acc).
lenL xs = case xs of Nil -> 0 | _ :: r -> 1 + lenL r.
worker parent me =
  xs = build 30000 Nil;
  send parent (Ok (case xs of Nil -> 0 | x :: _ -> x)).
loop me i acc =
  case i > 300 of
    True -> acc
  | False -> loopStep me i acc.
loopStep me i acc =
  w = spawn (worker me);
  r = receiveRes me;
  n = case r of Ok k -> k;
  _ = drop r;
  loop me (i + 1) (acc + n).
main =
  me = myself 0;
  t = loop me 1 0;
  print "slab churn total = {t}  arcLive after = {arcLive 0}".
