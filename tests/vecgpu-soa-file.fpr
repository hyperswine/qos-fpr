# Read CSV pairs into an automatically selected SoA Vector, then fold.

ParseState = Type (PS left right side count).

parse s i n state v | i > n = case state of PS left right side count -> (count, v).
parse s i n state v =
  c = charAt s i;
  parseChar c s i n state v.

parseChar c s i n state v | c == 44 = comma s i n state v.
parseChar c s i n state v | c == 10 = newline s i n state v.
parseChar c s i n state v | c < 48 = parse s (i + 1) n state v.
parseChar c s i n state v | c > 57 = parse s (i + 1) n state v.
parseChar c s i n state v = digit c s i n state v.

comma s i n state v = case state of
  PS left right side count -> parse s (i + 1) n (PS left right 1 count) v.

newline s i n state v = case state of
  PS left right side count ->
    parse s (i + 1) n (PS 0 0 0 (count + 1)) (Vec.push (left, right) v).

digit c s i n state v = case state of
  PS left right side count -> case side == 0 of
    True -> parse s (i + 1) n (PS (left * 10 + c - 48) right side count) v
  | False -> parse s (i + 1) n (PS left (right * 10 + c - 48) side count) v.

sumPair acc p = case p of (left, right) -> acc + left + right.

main =
  text = fileRead "build/vec-tuples.csv";
  (rows, v) = parse text 1 (strlen text) (PS 0 0 0 0) (Vec.new Unit);
  (total, v2) = Vec.fold sumPair 0 v;
  _ = print "rows={rows} total={total}";
  _ = Vec.free v2;
  print "vecgpu SoA file fold done".