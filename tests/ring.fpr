uart = device "uart" .
putc c =
  v = read (reg8 uart 5);
  case BITTEST v 5 of
    True -> write (reg8 uart 0) c
  | False -> putc c . # if the transmit buffer is full, wait until it is not
puts s = putsFrom s 1 .
putsFrom s i =
  n = Str.len s;
  case i > n of True -> Unit | False -> putc (Str.at s i) >> putsFrom s (i + 1) .
nl = putc 13 >> putc 10 .

# a hop first learns its neighbor (first message), then relays tokens.
hop me =
  to = Actor.recv me;
  hopLoop to me .

hopLoop to me =
  m = Actor.recv me;
  case m of
    (home, n) ->
      case n == 0 of
        True -> Actor.send home 0 >> drop m >> hopLoop to me
      | False -> Actor.send to (home, n - 1) >> drop m >> hopLoop to me .

main =
  me = Actor.self 0;
  _ = puts "token ring: 4 actors in a true cycle, 100000 hops" >> nl;
  a = Actor.spawn hop;
  b = Actor.spawn hop;
  c = Actor.spawn hop;
  d = Actor.spawn hop;
  _ = Actor.send a b;   # tie the knot: neighbors delivered as first messages
  _ = Actor.send b c;
  _ = Actor.send c d;
  _ = Actor.send d a;
  _ = Actor.send a (me, 100000);
  r = Actor.recv me;
  _ = puts "token expired with value {r} after 100000 hops around the cycle" >> nl;
  puts "arc live after 100k promote/drop cycles: {arcLive 0} (the 4 neighbor handles)" >> nl .
