# vectime.fpr -- measures the tiers against each other with CLINT mtime
# (QEMU virt: 10 MHz).  Same 20k-element workload three ways:
#   A. generic C tier      (unknown fn: a PAP, forced through fpr_apply)
#   B. specialized scalar  (known arith fn -> unboxed column loop)
#   C. (--rvv builds) B's map/fold body drops to vector instructions

clint = device "clint" .
now = read (reg32 clint 49144) .

warp n = n * 3 + 1.
sum2 a b = a + b.

fill i m v = case i > m of
    True -> v
  | False -> fill (i + 1) m (Vec.push i v).

# `pick f` returns f through a data-dependent branch: the call site can
# no longer see a static CVar, so Vec.map goes to the GENERIC tier.
pick f x = case x > 0 of True -> f | False -> f.

main =
  n = 20000;
  v = fill 1 n (Vec.new Unit);

  t0 = now;
  v2 = Vec.map (pick warp 1) v;          # generic: apply per element
  t1 = now;
  v3 = Vec.map warp v2;                  # specialized (or RVV)
  t2 = now;
  (s, v4) = Vec.fold sum2 0 v3;
  t3 = now;
  _ = Vec.free v4;

  _ = print "n            = {n}";
  _ = print "generic map  : {t1 - t0} mtime ticks";
  _ = print "spec map     : {t2 - t1} mtime ticks";
  _ = print "spec fold    : {t3 - t2} mtime ticks   (sum = {s})";
  print "vectime done".
