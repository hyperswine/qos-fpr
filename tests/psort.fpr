# psort.fpr -- sorting two halves of a Vector in parallel via a par2
# synchronous actor block group, with the same work run sequentially
# first so the wall-clock overlap is visible in CLINT mtime ticks.

clint = device "clint" .
now = read (reg32 clint 49144) .

imod a b = a - (a / b) * b.

# Lehmer LCG mod 65537: values stay well inside rv32's tagged range
fillV i n x v =
  case i > n of
    True  -> v
  | False -> fillV (i + 1) n (imod (x * 75) 65537) (Vec.push x v).

# ---- tail-recursive list merge sort (O(1) stack for merge) -----------
rev2 acc rest = case acc of Nil -> rest | Cons a at -> rev2 at (Cons a rest).

mergeGo acc xs ys =
  case xs of
    Nil -> rev2 acc ys
  | Cons x xt ->
      case ys of
        Nil -> rev2 acc xs
      | Cons y yt ->
          case x <= y of
            True  -> mergeGo (Cons x acc) xt ys
          | False -> mergeGo (Cons y acc) xs yt.

merge xs ys = mergeGo Nil xs ys.

halveGo a b xs = case xs of Nil -> (a, b) | Cons x xt -> halveGo b (Cons x a) xt.

msort xs =
  case xs of
    Nil -> xs
  | Cons x xt ->
      case xt of
        Nil -> xs
      | Cons y yt ->
          case halveGo Nil Nil xs of
            (a, b) -> merge (msort a) (msort b).

sortVec v = Vec.fromList (msort (Vec.toList v)).

# ---- checks ------------------------------------------------------------
sortedGo prev xs =
  case xs of
    Nil -> True
  | Cons x xt -> case prev <= x of True -> sortedGo x xt | False -> False.
isSorted xs = case xs of Nil -> True | Cons x xt -> sortedGo x xt.
lenGo n xs = case xs of Nil -> n | Cons x xt -> lenGo (n + 1) xt.
sumGo s xs = case xs of Nil -> s | Cons x xt -> sumGo (s + x) xt.

mkData n = fillV 1 n 12345 (Vec.new Unit).

main =
  n = 6000;
  h = n / 2;

  # ---- sequential baseline: both halves on hart 0 --------------------
  d1 = mkData n;
  t0 = now;
  (lo1, hi1) = Vec.split h d1;
  sl = sortVec lo1;
  sh = sortVec hi1;
  m1 = merge (Vec.toList sl) (Vec.toList sh);
  t1 = now;
  _ = print "sequential: {t1 - t0} ticks";
  ck1 = sumGo 0 m1;
  ok1 = isSorted m1;
  n1 = lenGo 0 m1;

  # ---- parallel: hart 1 sorts one half while hart 0 sorts the other --
  d2 = mkData n;
  t2 = now;
  (lo2, hi2) = Vec.split h d2;
  (pl, ph) = par2 1 sortVec lo2 sortVec hi2;
  m2 = merge (Vec.toList pl) (Vec.toList ph);
  t3 = now;
  _ = print "parallel  : {t3 - t2} ticks   (speedup x100 = {(t1 - t0) * 100 / (t3 - t2)})";

  ck2 = sumGo 0 m2;
  _ = print "sorted: {ok1} {isSorted m2}   len: {n1} {lenGo 0 m2}   checksum: {ck1} {ck2}";
  case ck1 == ck2 of
    True  -> print "psort OK: identical sorted output, computed on two harts"
  | False -> print "psort MISMATCH".
