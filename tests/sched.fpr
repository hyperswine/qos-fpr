# sched.fpr -- the two-tier bounded-latency scheduler, pinned:
#   (1) LIVENESS under load: K yielding workers all make progress.
#   (2) THE AGING BOUND: with tau set low, schedMaxWait (measured in
#       machine admissions by the runtime itself) stays under
#       tau + resident-actor count -- the deterministic-tier guarantee
#       from docs/SCHED-MODEL.md, checked against the real counter.
#   (3) Introspection round-trips (schedSetTau / schedTau).

expect name got want = case got == want of
  True -> print "ok {name}"
| False -> error "FAIL {name}: {got} vs {want}".

# a worker: ping-pong with main `rounds` times, yielding between beats
worker me =
  boss = receive me;
  wLoop me boss 0.
wLoop me boss n =
  m = receive me;
  u = yield me;
  u2 = send boss (n + 1);
  wLoop me boss (n + 1).

poke k ws | k == 0 = 0.
poke k ws = w :: rest = ws; u = send w 1; poke (k - 1) rest.

gather me k acc | k == 0 = acc.
gather me k acc = r = receive me; gather me (k - 1) (acc + r).

spawnK me k | k == 0 = [].
spawnK me k =
  w = spawn worker;
  u = send w me;
  w :: spawnK me (k - 1).

beat me ws n | n == 0 = 0.
beat me ws n =
  u = poke 8 ws;
  s = gather me 8 0;
  beat me ws (n - 1).

main u =
  t0 = schedTau 0;
  u1 = expect "tau default readable" (t0 > 0) True;
  u2 = schedSetTau 4;
  u3 = expect "tau set round-trips" (schedTau 0) 4;
  me = myself 0;
  ws = spawnK me 8;
  u4 = beat me ws 200;
  mw = schedMaxWait 0;
  u5 = expect "aging bound: maxWait <= tau + residents" (mw <= 4 + 12) True;
  u6 = print "maxWait observed: {mw} admissions (tau=4, steals: {schedSteals 0})";
  u7 = expect "liveness: 200 rounds x 8 workers completed" 1 1;

  # phase 2: burst-poke every worker twice per beat so 8+ actors are
  # READY at once on the spawning hart -- backlog passes DONATE_HI,
  # donation publishes the oldest, the idle hart steals (deterministic
  # FIFO, counted by the runtime)
  u80 = burst me ws 50;
  st = schedSteals 0;
  u8 = expect "deterministic stealing engaged" (st > 0) True;
  u9 = print "steals: {st}";
  print "sched done".

burst me ws n | n == 0 = 0.
burst me ws n =
  u1 = poke 8 ws;
  u2 = poke 8 ws;
  s = gather me 16 0;
  burst me ws (n - 1).
