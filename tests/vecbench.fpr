# vecbench.fpr -- exercises the specialized tier: unboxed column loops,
# SoA-dualized fold, guard fallbacks, and (with --rvv) real vector code.

# straight-line arithmetic: RVV-mappable
warp n = n * 3 + 1.

# branchy: unboxed scalar loop with a call per element (no RVV)
collatz n = case n == 1 of
    True -> 0
  | False -> case n / 2 * 2 == n of
      True  -> 1 + collatz (n / 2)
    | False -> 1 + collatz (n * 3 + 1).

keep n = n > 50.
sum2 a b = a + b.
dot a p = case p of (k, v) -> a + k * v.

fill i m v = case i > m of
    True -> v
  | False -> fill (i + 1) m (Vec.push i v).

fillP i m v = case i > m of
    True -> v
  | False -> fillP (i + 1) m (Vec.push (i, i + 1) v).

main =
  v = fill 1 100 (Vec.new Unit);
  v2 = Vec.map warp v;                    # spec map (RVV-able)
  (a, v3) = Vec.get 1 v2;
  (b, v4) = Vec.get 100 v3;
  _ = print "warp: first = {a}, last = {b}";
  v5 = Vec.filter keep v4;                # spec filter, in place
  (n, v6) = Vec.len v5;
  _ = print "kept > 50: {n}";
  (s, v7) = Vec.fold sum2 0 v6;           # spec fold (RVV vredsum-able)
  _ = print "sum = {s}";
  v8 = Vec.map collatz v7;                # spec map, recursive unboxed fn
  (c, v9) = Vec.get 1 v8;
  _ = print "collatz steps of first = {c}";
  _ = Vec.free v9;

  p = fillP 1 50 (Vec.new Unit);          # SoA (Int, Int)
  (d, p2) = Vec.fold dot 0 p;             # spec fold, DUALIZED (no tuples built)
  _ = print "dot = {d}";
  _ = Vec.free p2;

  s1 = Vec.push "x" (Vec.new Unit);       # boxed rep: guard must fall back
  s2 = Vec.map collatz2str s1;
  (t, s3) = Vec.get 1 s2;
  _ = print "fallback map over boxed: {t}";
  _ = Vec.free s3;
  print "vecbench done".

collatz2str s = strcat s "!".
