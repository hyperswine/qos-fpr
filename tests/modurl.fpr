# modurl.fpr -- the URL method for module identity: "<hash>/<fn>" split
# + Mod.resolve, where a MISS IS DATA (the resolver contract that lets
# a disk store or an FPRLive remote peer sit behind the same URL).
M = use "mods/mymod#ddbe5fa48f1a5018".
findSlash s i n = case i > n of True -> 0 | False -> case charAt s i == 47 of True -> i | False -> findSlash s (i + 1) n.
urlHead s = k = findSlash s 1 (strlen s); case k == 0 of True -> s | False -> substr s 1 (k - 1).
urlTail s = k = findSlash s 1 (strlen s); case k == 0 of True -> "" | False -> substr s (k + 1) (strlen s - k).
resolveUrl u = Mod.resolve (urlHead u) (urlTail u).
show tag r = case r of (ok, f) -> case ok == 1 of True -> print "{tag}: hit, f 21 = {f 21}" | False -> print "{tag}: miss (as data)".
main =
  _ = show "good url " (resolveUrl "{M}/double");
  _ = show "bad fn   " (resolveUrl "{M}/nosuch");
  _ = show "bad hash " (resolveUrl "ffffffffffffffff/double");
  print "modurl done".
