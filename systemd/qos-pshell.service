# qos-pshell.service -- pshell.qa under qosp as the SBC's startup shell:
# the .qa is the whole UI (gen_view -> GLES via mods/scene2d), qosp is
# the only Linux-visible program, and virtual keys arrive over ssh
# through the same evdev tier a physical keyboard uses.  Install:
#
#   sudo install -m755 qosp /opt/qos/qosp
#   sudo install -m644 app.qa /opt/qos/pshell.qa      # portable-qa PROG=programs/pshell.fpr
#   sudo install -m644 systemd/qos-pshell.service /etc/systemd/system/
#   sudo useradd -r -G video,render,input qos
#   sudo systemctl disable getty@tty1
#   sudo systemctl enable --now qos-pshell
#
# Keyboard input: a real keyboard via FPR_EVDEV=/dev/input/eventN, or
# the ssh virtual keyboard through the FIFO this unit creates --
#
#   ssh -t sbc /opt/qos/tools/kbdsim.py --tty /run/qos/kbd
#
# -- raw termios in, struct input_event out, the identical bytes a
# physical device delivers, so scripted replays and live typing share
# one input path (the fpr-linux-shell's qos-type story, without the
# bespoke ctl protocol: the wire IS evdev).
#
# DISPLAY: the gfx tier currently renders to an offscreen FBO (frames
# via snapshots; llvmpipe or the GPU, whichever EGL finds).  Direct
# DRM/GBM scanout on the SBC is the qos-shell C shim's proven path and
# is the planned next port into gfx_raw -- this unit's contract does
# not change when it lands: same qosp, same .qa, same FIFO.

[Unit]
Description=QOS Portable shell (pshell.qa under qosp)
After=systemd-udevd.service

[Service]
Type=simple
User=qos
SupplementaryGroups=video render input
UMask=0007
RuntimeDirectory=qos
WorkingDirectory=/var/lib/qos
StateDirectory=qos
# the kv store (qos-store/pshell.kv) lands under WorkingDirectory --
# notes survive restarts because the append log does
ExecStartPre=/bin/sh -c 'rm -f /run/qos/kbd && mkfifo -m660 /run/qos/kbd'
Environment=FPR_EVDEV=/run/qos/kbd
# FPR_HARTS unset: qosp auto-detects the online core count (v2 ABI);
# pin with Environment=FPR_HARTS=1 for deterministic replays
ExecStart=/opt/qos/qosp --yes /opt/qos/pshell.qa
Restart=on-failure
RestartSec=1
StandardError=journal

[Install]
WantedBy=multi-user.target
