# ============================================================================
# pshell.fpr -- the QOS Portable startup shell: a keyboard-driven 2D UI
# rendered ENTIRELY through the Scene walker's OpenGL ES backend, with
# the view built by mods/scene2d (gen_view's static/dynamic split mapped
# onto the walker's static/dynamic GPU buffers).
#
#   HOME       a tile grid: NOTES (a real app), plus live RENDER /
#              HARTS / CLOCK / STORE tiles whose text arrives as
#              dynamics -- steady state re-uploads ONLY those glyphs
#              (the dynBytes readout on the RENDER tile is the proof,
#              measured by the walker itself).  Moving the focus ring
#              hands the walker a NEW statics value: that is its
#              recompile trigger, and the S readout counts them.
#   NOTES      type a line, ENTER commits, ESC returns.  Notes persist
#              through the storage syscall channel (Sys.storeReq: kv
#              append on commit, replay at boot) -- kill the shell,
#              relaunch, the notes are back.
#
# Architecture = gfxdemo.fpr's service actors: graphics/display own the
# GL context and are spawnOn 0 -- explicit placement now PINS an actor
# (multi-hart qosp donates unpinned backlog to idle harts; an EGL
# context is thread-bound, so the gfx actors opt out).  Every frame is
# a fresh WORKER actor (voxel-interactive's frame-per-actor shape): it
# formats the dynamics text, builds the scene, drives Render, reports,
# and dies -- per-frame allocation dies with it, the shell's own pool
# grows only with real state.
#
#   keys   arrows move focus / ENTER open / ESC back / letters type
#          p = snapshot pshell<frame>.ppm    q (at home) = quit
#
#   make portable-run GFX=1 PROG=programs/pshell.fpr        # under qosp
#   make posix-run GFX=1 PROG=programs/pshell.fpr           # co-compiled
#   FPR_EVDEV=script.evd ...                                # scripted
# ============================================================================

S2 = use "mods/scene2d".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

AK = use "mods/appkit".

Msg = Type (Lookup url | Reg reg | Render scene | Present path | Poll a | Dims a).
# sts = the per-app STATE LIST, parallel to the launcher's app list --
# suspension IS this list: leaving an app just stops rendering it; its
# state value sits here until re-entry.  screen 0 = home, i+1 = app i.
Md = Type (Md screen focus sts frame lastR lastKey scomp).
Fd = Type (Fd screen frame lastR lastKey scomp av fb env).
Av = Type (AvHome | AvApp vlsF st).
Cm = Type (CQuit | CSnap).
Rt = Type (Rt cache fbA fbB back cfg apps).  # cfg = (vw, env)
# a discovered app: metas + the four resolved contract functions
Ap = Type (Ap nm sb ini upd tre vls).   # loop roots: statics cache + the
                                     # two packed framebuffers + which
                                     # one is the back buffer this frame

# ---- the System actor + services (gfxdemo.fpr verbatim) --------------------

strEqGo a b i n | i > n = True.
strEqGo a b i n | charAt a i == charAt b i = strEqGo a b (i + 1) n.
strEqGo a b i n = False.
strEq a b | strlen a == strlen b = strEqGo a b 1 (strlen a).
strEq a b = False.

findSvc Nil url = 0.
findSvc ((u, a) :: r) url | strEq u url = a.
findSvc ((u, a) :: r) url = findSvc r url.

# one loop, forever: lookups answered, registrations APPENDED -- a
# service can be registered at any time, not only in one boot batch.
# Received roots dropped (immortal actor).
systemActor me = sysLoop me Nil.
sysLoop me reg0 =
  m = receive me;
  (replyTo, q) = m;
  sysMsg me reg0 replyTo q m.
sysMsg me reg0 replyTo (Lookup url) m =
  _ = send replyTo (findSvc reg0 url);
  _ = drop m;
  sysLoop me reg0.
sysMsg me reg0 replyTo (Reg reg) m =
  _ = send replyTo 1;
  _ = drop m;
  sysLoop me (cat reg reg0).

# AUTO RESOLUTION: glInit 0 0 sizes the FBO to the connected display's
# own mode (640x480 headless) and returns what it settled on; the shell
# asks via Dims and lays out to vw = 240 * w / h.
graphicsActor me =
  d = glInit 0 0;
  gfxServe me d.
gfxServe me d =
  m = receive me;
  (replyTo, pl) = m;
  _ = gfxAct d replyTo pl;
  _ = drop m;              # the received root: without this every
                           # frame's Render message pins its worker's
                           # slab forever (the leak that took a Pi 4
                           # down in 439 frames -- twice, deterministically)
  gfxServe me d.
gfxAct d replyTo (Render scene) = send replyTo (glRender scene).
gfxAct d replyTo (Dims u) = send replyTo d.

displayActor me =
  m = receive me;
  (replyTo, Present path) = m;
  send replyTo (glSavePpm path) >> drop m >> displayActor me.

inputActor me =
  m = receive me;
  (replyTo, Poll u) = m;
  send replyTo (inputPoll u) >> drop m >> inputActor me.

# the log service: /services/log.  A capped ring of lines; every write
# also echoes to the console ("[log] ...") -- the simple log itself.
# Received roots are dropped (immortal actor, the law); a line falling
# off the ring is dropped too (its writer's slab pin ends here).
logActor me = logServe me Nil 0.
logServe me lines n =
  m = receive me;
  (replyTo, q) = m;
  logMsg me lines n replyTo q m.
logMsg me lines n replyTo (LogAdd line) m =
  _ = print "[log] {line}";
  # COPY the line into OUR pool before dropping the request: promotion
  # pinned only the message ROOT -- the nested string rides that pin,
  # and dropping the root frees the sender's slab out from under
  # anything nested we kept.  Retention beyond the root's life = copy.
  # NOTE "{line}" is NOT a copy -- one-segment interpolation desugars
  # to `str line`, identity on a string.  substr always mkstr's.
  own = substr line 1 (strlen line);
  (l2, n2) = logPush lines n own;
  _ = send replyTo 0;
  _ = drop m;
  logServe me l2 n2.
logMsg me lines n replyTo (LogSnap u) m =
  # NEVER send live state: the caller rightly drops what it received,
  # and dropping OUR ring root would free it under us.  Fresh cells
  # (the strings inside are ours and immortal-pooled; sharing them is
  # fine -- it is the SPINE that must be disposable).
  _ = send replyTo (snapCopy lines);
  _ = drop m;
  logServe me lines n.
snapCopy Nil = Nil.
snapCopy (x :: r) = x :: snapCopy r.
logPush lines n line | n < 12 = (line :: lines, n + 1).
logPush lines n line =
  (kept, old) = logSplit lines 11 Nil;
  _ = drop old;
  (line :: logRev kept Nil, n).
logSplit (x :: r) 0 acc = (logRev acc Nil, x).
logSplit (x :: r) k acc = logSplit r (k - 1) (x :: acc).
logRev Nil acc = acc.
logRev (x :: r) acc = logRev r (x :: acc).
LogAdd = AK.LogAdd.
LogSnap = AK.LogSnap.

svcCall me a q = _ = send a (me, q); receive me.
svcLookup me sys url = svcCall me sys (Lookup url).

# ---- colors ----------------------------------------------------------------

cBg u = (62, 70, 88).
cPanel u = (92, 104, 130).
cPanelHi u = (112, 128, 162).
cText u = (930, 940, 960).
cDim u = (560, 590, 650).
cAccent u = (999, 800, 300).
cFocus u = (330, 720, 999).
cEdge u = (150, 165, 200).
cOk u = (420, 900, 560).

# ---- views -----------------------------------------------------------------
# HOME slots: 0 clock  1 notes-count  2 render  3 harts  4 store  5 status
# NOTES slots: 0 count  1..6 lines (oldest..newest of the last 6)
#              7 input  8 status

tileBord f i | f == i = Bord (330, 720, 999).
tileBord f i = Bord (150, 165, 200).

tile f i title si cap =
  Box [Col, Pad 6, Gap 5, H 52, Grow, Bg (92, 104, 130), tileBord f i]
    [ Lbl [Sc 2, Fg (930, 940, 960)] title
    , Slot [Fg (999, 800, 300)] si cap ].

# app tiles two to a row; slot i = tile i's subtitle (see homeVals)
tileRows apps f i =
  case apps of
    Nil -> Nil
  | (a :: r) -> tileRowsGo a r f i.
tileRowsGo a Nil f i =
  Box [Row, Gap 6] [ apTile a f i, Box [Grow] Nil ] :: Nil.
tileRowsGo a (b :: r) f i =
  Box [Row, Gap 6] [ apTile a f i, apTile b f (i + 1) ]
    :: tileRows r f (i + 2).
apTile (Ap nm sb ini upd tre vls) f i = tile f i nm i 14.

homeTree apps vw f =
  n = appN apps;
  Box [Col, Pad 8, Gap 6, W vw, H 240, Bg (62, 70, 88)]
    (cat
      ( Box [Row, Gap 8]
          [ Lbl [Sc 3, Fg (930, 940, 960)] "QOS"
          , Box [Grow] Nil
          , Lbl [Fg (560, 590, 650)] "T"
          , Slot [Fg (930, 940, 960)] n 6 ]
        :: tileRows apps f 0)
      ( Box [Row, Gap 6]
          [ tile f n "RENDER" (n + 1) 12
          , tile f (n + 1) "HARTS" (n + 2) 12 ]
        :: Box [Grow] Nil
        :: Box [Row, Pad 4, Bg (92, 104, 130)]
             [ Slot [Fg (999, 800, 300)] (n + 3) 60 ]
        :: Nil )).
appN Nil = 0.
appN (a :: r) = 1 + appN r.

treeFor apps vw 0 f = homeTree apps vw f.
treeFor apps vw s f = apTree (nthAp apps (s - 1)) vw.
apTree (Ap nm sb ini upd tre vls) vw = tre vw.
nthAp (a :: r) 0 = a.
nthAp (a :: r) i = nthAp r (i - 1).

# ---- dynamics: the per-frame text, formatted IN THE WORKER -----------------

len Nil = 0.
len (x :: r) = 1 + len r.

nthS Nil i = "".
nthS (v :: r) 0 = v.
nthS (v :: r) i = nthS r (i - 1).

# last 6 notes, oldest first (notes list is newest-first)
lastSix notes = padTo (rev6 (take6 notes) Nil) 6.
take6 l = takeN l 6.
takeN Nil n = Nil.
takeN l 0 = Nil.
takeN (x :: r) n = x :: takeN r (n - 1).
rev6 Nil acc = acc.
rev6 (x :: r) acc = rev6 r (x :: acc).
padTo l n | len l >= n = l.
padTo l n = padTo (apnd l "") n.
apnd Nil x = x :: Nil.
apnd (a :: r) x = a :: apnd r x.

clock u =
  clint = device "clint";
  mt = reg32 clint 49144;
  t = read mt / 1000000;
  "T {t / 60}:{pad2 (imod2 t 60)}".
pad2 n | n < 10 = "0{n}".
pad2 n = "{n}".
imod2 a b = a - (a / b) * b.

# home: slot 0..n-1 = tile subtitles, n = clock, n+1 = render,
# n+2 = harts, n+3 = status.  App screens: the app's own appVals, run
# HERE in the frame worker with self (it may svcCall services).
wvals apps (Fd 0 frame lastR lastKey scomp av fb env) self =
  (log, mt) = env;
  (draws, dynB) = lastR;
  cat (subs apps)
      ( AK.clockStr mt
        :: "{draws}D {dynB}B"
        :: "{harts 0} LIVE"
        :: "F{frame}  K{lastKey}  S{scomp}  DYN {dynB}B"
        :: Nil ).
wvals apps (Fd s frame lastR lastKey scomp av fb env) self =
  AvApp vlsF st = av;
  vlsF self env st.
subs Nil = Nil.
subs (Ap nm sb ini upd tre vls :: r) = sb :: subs r.

# ---- the frame worker (frame-per-actor) ------------------------------------

# PACKED, DOUBLE-BUFFERED dynamics: the shell owns two framebuffer
# VECTORS (S2.fbNew, immortal pool); each frame the worker writes the
# slot text straight into the BACK one with Vec.set -- mutation through
# a linear handle, zero per-frame list allocation -- and Render takes
# (fb, n).  The buffers swap every frame (Fb a b in the loop state), so
# the frame being written is never the one the walker just consumed.
frameWorker parent gfx st sl fdw self =
  (apps, fd) = fdw;
  Fd sN fr lr lk sc av fb env = fd;
  vs = wvals apps fd self;
  (fb2, n) = S2.dynsInto fb sl vs;
  r = svcCall self gfx (Render (S2.scene st (fb2, n)));
  _ = send parent r;
  drop r.                # forward then release OUR ref: the reply's
                         # ARC entry dies when the shell drops its own

# ---- input -----------------------------------------------------------------
# evdev (kind 4): Linux keycodes, presses only.  stdin (kind 1): ascii
# folded onto the same codes so a live tty behaves.

ascii2code c | c == 27 = 1.
ascii2code c | c == 10 = 28.
ascii2code c | c == 13 = 28.
ascii2code c | c == 127 = 14.
ascii2code c | c == 8 = 14.
ascii2code c = 0 - c.               # negative = literal ascii char

# NB acc is prepend-built: reverse before returning so keys inside one
# frame apply in ARRIVAL order (the voxel-interactive pollKeys lesson)
drain me inp n acc | n == 0 = revK Nil acc.
drain me inp n acc =
  ev = svcCall me inp (Poll 0);
  (kind, a, b) = ev;
  _ = drop ev;           # every received message is dropped once read
  drainEv me inp n acc kind a b.
drainEv me inp n acc kind a b | kind == 0 = revK Nil acc.
drainEv me inp n acc kind a b | kind == 4 =
  case b == 1 of
    True -> drain me inp (n - 1) (a :: acc)
  | False -> drain me inp (n - 1) acc.
drainEv me inp n acc kind a b | kind == 1 =
  drain me inp (n - 1) (ascii2code a :: acc).
drainEv me inp n acc kind a b = drain me inp (n - 1) acc.

# keycode -> typed char ("" = not typable); kbdsim's code table
revK acc Nil = acc.
revK acc (x :: r) = revK (x :: acc) r.

keyChar 57 = " ".
keyChar 30 = "a". keyChar 48 = "b". keyChar 46 = "c". keyChar 32 = "d".
keyChar 18 = "e". keyChar 33 = "f". keyChar 34 = "g". keyChar 35 = "h".
keyChar 23 = "i". keyChar 36 = "j". keyChar 37 = "k". keyChar 38 = "l".
keyChar 50 = "m". keyChar 49 = "n". keyChar 24 = "o". keyChar 25 = "p".
keyChar 16 = "q". keyChar 19 = "r". keyChar 31 = "s". keyChar 20 = "t".
keyChar 22 = "u". keyChar 47 = "v". keyChar 17 = "w". keyChar 45 = "x".
keyChar 21 = "y". keyChar 44 = "z".
keyChar 11 = "0". keyChar 2 = "1". keyChar 3 = "2". keyChar 4 = "3".
keyChar 5 = "4". keyChar 6 = "5". keyChar 7 = "6". keyChar 8 = "7".
keyChar 9 = "8". keyChar 10 = "9".
keyChar c | c < 0 = chr (0 - c).    # stdin literal
keyChar c = "".

# ---- update ----------------------------------------------------------------
# update k model -> (model', cmds)

clampF t f | f < 0 = 0.
clampF t f | f > t - 1 = t - 1.
clampF t f = f.

moveF t f 105 | imod2 f 2 == 1 = f - 1.
moveF t f 106 | imod2 f 2 == 0 = clampF t (f + 1).
moveF t f 103 = clampF t (f - 2).
moveF t f 108 = clampF t (f + 2).
moveF t f k = f.

# home screen
# The launcher's key protocol: esc = suspend (back to home, state
# kept), p = snapshot, q-at-home = quit; everything else while an app
# is focused goes to THAT app's appUpdate, which returns its new state
# value -- setNth into the state list and carry on.  Suspension is
# nothing but this list.
update apps k (Md 0 f sts fr lr lk sc) | k == 16 =
  (Md 0 f sts fr lr k sc, [CQuit]).
update apps k (Md 0 f sts fr lr lk sc) | k == 25 =
  (Md 0 f sts fr lr k sc, [CSnap]).
update apps k (Md 0 f sts fr lr lk sc) | k == 28 =
  (homeEnter (appN apps) f (Md 0 f sts fr lr k sc), Nil).
update apps k (Md 0 f sts fr lr lk sc) =
  (Md 0 (moveF (appN apps + 2) f k) sts fr lr k sc, Nil).
update apps k (Md sN f sts fr lr lk sc) | k == 1 =
  (Md 0 f sts fr lr k sc, Nil).
update apps k (Md sN f sts fr lr lk sc) | k == 25 =
  (Md sN f sts fr lr k sc, [CSnap]).
update apps k (Md sN f sts fr lr lk sc) =
  st2 = apUpd (nthAp apps (sN - 1)) k (nthSt sts (sN - 1));
  (Md sN f (setNth sts (sN - 1) st2) fr lr k sc, Nil).
apUpd (Ap nm sb ini upd tre vls) k st = upd k st.

homeEnter n f m | f < n = openApp (f + 1) m.
homeEnter n f m = m.
openApp sN (Md s g sts fr lr lk sc) = Md sN g sts fr lr lk sc.

nthSt (x :: r) 0 = x.
nthSt (x :: r) i = nthSt r (i - 1).
setNth (x :: r) 0 v = v :: r.
setNth (x :: r) i v = x :: setNth r (i - 1) v.

applyKeys apps Nil mc = mc.
applyKeys apps (k :: r) (m, cs) =
  (m2, c2) = update apps k m;
  applyKeys apps r (m2, cat cs c2).
cat Nil b = b.
cat (a :: r) b = a :: cat r b.

# ---- effects ---------------------------------------------------------------

doCmds me dsp fr Nil = 0.
doCmds me dsp fr (c :: r) =
  _ = doCmd me dsp fr c;
  doCmds me dsp fr r.
doCmd me dsp fr CQuit = 0.
doCmd me dsp fr CSnap = svcCall me dsp (Present "pshell{fr}.ppm").
wantsQuit Nil = False.
wantsQuit (CQuit :: r) = True.
wantsQuit (c :: r) = wantsQuit r.

# ---- the shell loop --------------------------------------------------------
# cache = (skey, statics, slots): the statics VALUE lives here across
# frames -- pointer-stable while retained, which is the walker's
# recompile trigger when a screen/focus change swaps it out.

tick = 50000.                        # 50 ms -> 20 fps (10 MHz clint)

waitTick mt t0 | read mt - t0 >= tick = read mt.
waitTick mt t0 = waitTick mt t0.

skeyOf (Md s f sts fr lr lk sc) = s * 100 + f.

ensure apps vw cache key =
  (k, st, sl) = cache;
  case k == key of
    True -> (cache, 0)
  | False -> (rebuildTree apps vw key, 1).
rebuildTree apps vw key =
  (st2, sl2) = S2.buildW vw (treeFor apps vw (key / 100) (imod2 key 100));
  (key, st2, sl2).

# av for the worker: home = 0, app screen = (that app's vals fn, state)
fdOf fb env apps (Md sN f sts fr lr lk sc) =
  Fd sN fr lr lk sc (avFor apps sN sts) fb env.
avFor apps 0 sts = AvHome.
avFor apps sN sts = AvApp (apVls (nthAp apps (sN - 1))) (nthSt sts (sN - 1)).
apVls (Ap nm sb ini upd tre vls) = vls.

result apps (Md s f sts fr lr lk sc) =
  "pshell: {fr} frames, {sc} statics compiles, {appN apps} apps".

loop me gfx dsp inp mt rt model =
  t0 = read mt;
  ks = drain me inp 16 Nil;
  (m2, cmds) = applyKeys (appsOf rt) ks (model, Nil);
  _ = doCmds me dsp (frOf m2) cmds;
  case wantsQuit cmds of
    True -> result (appsOf rt) m2
  | False -> frame me gfx dsp inp mt rt m2 t0.

frOf (Md s f sts fr lr lk sc) = fr.

frame me gfx dsp inp mt rt m2 t0 =
  (cache2, rebuilt) = ensureRt rt (skeyOf m2);
  m3 = bumpS m2 rebuilt;
  (k, st, sl) = cache2;
  _ = spawn (frameWorker me gfx st sl (appsOf rt, fdOf (backFb rt) (envOf rt) (appsOf rt) m3));
  r = receive me;
  m4 = advance m3 r;
  _ = waitTick mt t0;
  loop me gfx dsp inp mt (swapRt rt cache2) m4.

ensureRt (Rt cache a b bk cfg apps) key =
  (vw, env) = cfg;
  ensure apps vw cache key.
backFb (Rt cache a b bk cfg apps) = case bk == 0 of True -> a | False -> b.
appsOf (Rt cache a b bk cfg apps) = apps.
envOf (Rt cache a b bk cfg apps) =
  (vw, env) = cfg;
  env.
swapRt (Rt cache a b bk cfg apps) cache2 = Rt cache2 a b (1 - bk) cfg apps.

bumpS m 0 = m.
bumpS (Md s f sts fr lr lk sc) n = Md s f sts fr lr lk (sc + n).
# the reply tuple ESCAPED into this immortal actor (worker -> shell
# send); dropping the previous one releases its ARC entry -- without
# this, one live entry per frame fills the ARC table in ~50 s of idle
advance (Md s f sts fr lr lk sc) r =
  _ = drop lr;
  Md s f sts (fr + 1) r lk sc.

# ---- main ------------------------------------------------------------------

main =
  me = myself 0;
  _ = print "pshell: QOS Portable shell (gen_view -> GLES via scene2d)";
  sys = spawn systemActor;
  gfx = spawnOn 0 graphicsActor;    # pinned: the EGL context is
  dsp = spawnOn 0 displayActor;     # thread-bound; hart 0 owns GL
  inp = spawn inputActor;
  reg = ("/services/graphics", gfx)
     :: ("/services/display", dsp)
     :: ("/services/input", inp) :: Nil;
  _ = send sys (me, Reg reg);
  _ = receive me;
  g = svcLookup me sys "/services/graphics";
  d = svcLookup me sys "/services/display";
  i = svcLookup me sys "/services/input";
  clint = device "clint";
  mt = reg32 clint 49144;
  # /services/log: the ring every app actor writes through
  logA = spawn logActor;
  _ = send sys (me, Reg (("/services/log", logA) :: Nil));
  _ = receive me;
  log = svcLookup me sys "/services/log";
  env = (log, mt);
  cache0 = (0 - 1, Nil, Nil);
  # the two packed framebuffers, allocated ONCE here (immortal pool --
  # handle addresses stay put, the voxel-interactive discipline); 4096
  # instances each = the walker's MAX_INST
  fbA = S2.fbNew 4096;
  fbB = S2.fbNew 4096;
  (gw, gh) = svcCall me g (Dims 0);
  vw = clampVw (240 * gw / imax1 gh);
  _ = print "pshell: display {gw}x{gh} -> virtual {vw}x240";
  # attach every app .qa present, discover contracts per table, init
  # each app (inits run HERE -- an app may spawn its own actors now)
  _ = tryAttach "pnotes.qa";
  _ = tryAttach "clock.qa";
  _ = tryAttach "hello.qa";
  _ = tryAttach "logs.qa";
  apps = discover 0 (Mod.plugs 0);
  _ = print "pshell: {appN apps} apps loaded; q quits (home), p snapshots, esc suspends";
  sts = initAll apps env;
  m0 = Md 0 0 sts 0 (0, 0) 0 0;
  loop me g d i mt (Rt cache0 fbA fbB 0 (vw, env) apps) m0.

tryAttach nm =
  case Sys.attachQa nm of
    Ok u -> 1
  | Err e -> attachMiss nm e.
attachMiss nm e =
  _ = print "pshell: {nm}: {e}";
  0.

# per attached table: the contract or nothing (a plugin that is not an
# app -- or a partial one -- is skipped, stated)
discover i n | i >= n = Nil.
discover i n =
  (h1, meta) = Mod.findAt i "appMeta";
  (h2, ini) = Mod.findAt i "appInit";
  (h3, upd) = Mod.findAt i "appUpdate";
  (h4, tre) = Mod.findAt i "appTree";
  (h5, vls) = Mod.findAt i "appVals";
  discovered (h1 * h2 * h3 * h4 * h5) meta ini upd tre vls i n.
discovered ok meta ini upd tre vls i n | ok == 1 =
  (nm, sb) = meta 0;
  _ = print "pshell: app {i}: {nm}";
  Ap nm sb ini upd tre vls :: discover (i + 1) n.
discovered ok meta ini upd tre vls i n =
  _ = print "pshell: table {i}: not an app (skipped)";
  discover (i + 1) n.

initAll Nil env = Nil.
initAll (Ap nm sb ini upd tre vls :: r) env = ini env :: initAll r env.

imax1 h | h < 1 = 1.
imax1 h = h.
clampVw v | v < 320 = 320.
clampVw v | v > 720 = 720.
clampVw v = v.
