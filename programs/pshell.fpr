# ============================================================================
# pshell.fpr -- the QOS Portable startup shell: a keyboard-driven 2D UI
# rendered ENTIRELY through the Scene walker's OpenGL ES backend, with
# the view built by mods/scene2d (gen_view's static/dynamic split mapped
# onto the walker's static/dynamic GPU buffers).
#
#   HOME       a tile grid: NOTES (a real app), plus live RENDER /
#              HARTS / CLOCK / STORE tiles whose text arrives as
#              dynamics -- steady state re-uploads ONLY those glyphs
#              (the dynBytes readout on the RENDER tile is the proof,
#              measured by the walker itself).  Moving the focus ring
#              hands the walker a NEW statics value: that is its
#              recompile trigger, and the S readout counts them.
#   NOTES      type a line, ENTER commits, ESC returns.  Notes persist
#              through the storage syscall channel (Sys.storeReq: kv
#              append on commit, replay at boot) -- kill the shell,
#              relaunch, the notes are back.
#
# Architecture = gfxdemo.fpr's service actors: graphics/display own the
# GL context and are spawnOn 0 -- explicit placement now PINS an actor
# (multi-hart qosp donates unpinned backlog to idle harts; an EGL
# context is thread-bound, so the gfx actors opt out).  Every frame is
# a fresh WORKER actor (voxel-interactive's frame-per-actor shape): it
# formats the dynamics text, builds the scene, drives Render, reports,
# and dies -- per-frame allocation dies with it, the shell's own pool
# grows only with real state.
#
#   keys   arrows move focus / ENTER open / ESC back / letters type
#          p = snapshot pshell<frame>.ppm    q (at home) = quit
#
#   make portable-run GFX=1 PROG=programs/pshell.fpr        # under qosp
#   make posix-run GFX=1 PROG=programs/pshell.fpr           # co-compiled
#   FPR_EVDEV=script.evd ...                                # scripted
# ============================================================================

S2 = use "mods/scene2d".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

AK = use "mods/appkit".

Msg = Type (Lookup url | Reg reg | Render scene | Present path | Poll a | Dims a).
# sts = the per-app STATE LIST, parallel to the launcher's app list --
# suspension IS this list: leaving an app just stops rendering it; its
# state value sits here until re-entry.  screen 0 = home, i+1 = app i.
Md = Type (Md screen focus sts frame lastR lastKey scomp).
Fd = Type (Fd screen frame lastR lastKey scomp av fb env).
Av = Type (AvHome | AvApp vlsF st).
Cm = Type (CQuit | CSnap).
Rt = Type (Rt cache fbA fbB back cfg apps).  # cfg = (vp, env, cam)
# a discovered app: metas + the four resolved contract functions
Ap = Type (Ap nm sb ini upd tre vls).   # loop roots: statics cache + the
                                     # two packed framebuffers + which
                                     # one is the back buffer this frame

# ---- the System actor + services (gfxdemo.fpr verbatim) --------------------

strEqGo a b i n | i > n = True.
strEqGo a b i n | charAt a i == charAt b i = strEqGo a b (i + 1) n.
strEqGo a b i n = False.
strEq a b | strlen a == strlen b = strEqGo a b 1 (strlen a).
strEq a b = False.

findSvc Nil url = 0.
findSvc ((u, a) :: r) url | strEq u url = a.
findSvc ((u, a) :: r) url = findSvc r url.

# one loop, forever: lookups answered, registrations APPENDED -- a
# service can be registered at any time, not only in one boot batch.
# Received roots dropped (immortal actor).
systemActor me = sysLoop me Nil.
sysLoop me reg0 =
  m = receive me;
  (replyTo, q) = m;
  sysMsg me reg0 replyTo q m.
sysMsg me reg0 replyTo (Lookup url) m =
  _ = send replyTo (findSvc reg0 url);
  _ = drop m;
  sysLoop me reg0.
sysMsg me reg0 replyTo (Reg reg) m =
  _ = send replyTo 1;
  _ = drop m;
  sysLoop me (cat reg reg0).

# AUTO RESOLUTION: glInit 0 0 sizes the FBO to the connected display's
# own mode (640x480 headless) and returns what it settled on; the shell
# asks via Dims and lays out to vw = 240 * w / h.
graphicsActor me =
  d = glInit 0 0;
  gfxServe me d.
gfxServe me d =
  m = receive me;
  (replyTo, pl) = m;
  _ = gfxAct d replyTo pl;
  _ = drop m;              # the received root: without this every
                           # frame's Render message pins its worker's
                           # slab forever (the leak that took a Pi 4
                           # down in 439 frames -- twice, deterministically)
  gfxServe me d.
gfxAct d replyTo (Render scene) = send replyTo (glRender scene).
gfxAct d replyTo (Dims u) = send replyTo d.

displayActor me =
  m = receive me;
  (replyTo, Present path) = m;
  send replyTo (glSavePpm path) >> drop m >> displayActor me.

inputActor me =
  m = receive me;
  (replyTo, Poll u) = m;
  send replyTo (inputPoll u) >> drop m >> inputActor me.

# the log service: /services/log.  A capped ring of lines; every write
# also echoes to the console ("[log] ...") -- the simple log itself.
# Received roots are dropped (immortal actor, the law); a line falling
# off the ring is dropped too (its writer's slab pin ends here).
# the log service: /logs (aliases /logs/errors|warns|normal).  Now a
# STATELESS façade over the runtime's severity rings: LogAdd copies
# into C-owned storage (Sys.logAt), snapshots come out as fresh copies
# in whoever asks -- the cross-actor lifetime problems this actor used
# to have are designed away, not defended against.
logActor me =
  m = receive me;
  (replyTo, q) = m;
  logMsg me replyTo q m.
logMsg me replyTo (LogAdd sev line) m =
  _ = Sys.logAt sev line;
  _ = send replyTo 0;
  _ = drop m;
  logActor me.
logMsg me replyTo (LogSnap sev) m =
  _ = send replyTo (Sys.logSnap sev);
  _ = drop m;
  logActor me.
# the log actor SERVES its paths: resolution reached it, so it is the
# one that knows what /logs/warns contains
logMsg me replyTo (Read path) m =
  _ = send replyTo (logText (sevOfPath path));
  _ = drop m;
  logActor me.
sevOfPath p | strEq p "/logs/warns" = 1.
sevOfPath p | strEq p "/logs/errors" = 2.
sevOfPath p = 0.
logText sev = joinNl (Sys.logSnap sev).
joinNl Nil = "(empty)".
joinNl (x :: r) = joinGo x r.
joinGo acc Nil = acc.
joinGo acc (x :: r) = joinGo "{acc}\n{x}" r.
LogAdd = AK.LogAdd.
LogSnap = AK.LogSnap.

# the STORE server: the two paths whose bytes are really on disk.
# /store/notes is the replayed content; /disk/records is the append
# log's own index -- offsets and lengths of every delta ever written.
storeActor me =
  m = receive me;
  (replyTo, Read path) = m;
  _ = send replyTo (storeText path);
  _ = drop m;
  storeActor me.
storeText path | strEq path "/disk/records" = diskIndex 0.
storeText path = replayText 0.
replayText u =
  case Sys.storeReq 3 "" of
    Ok s -> emptyAs s "(no records)"
  | Err e -> "unreadable: {e}".
diskIndex u =
  case Sys.storeReq 5 "" of
    Ok s -> emptyAs s "(no records)"
  | Err e -> "unreadable: {e}".
emptyAs s alt | strlen s == 0 = alt.
emptyAs s alt = s.

# ---- files: one actor per real file, inside System.qa ------------------
# A path that names bytes on disk gets its OWN actor, spawned lazily on
# first use and kept in an active set.  That actor is the file: it
# holds the content cached in memory (so reads never touch the disk
# after the first replay), and because a mailbox is a queue, access to
# the file is serialized without a lock existing anywhere.  Writes
# append a DELTA to the one append-only log and update the cache --
# the file's content IS the replay of its own records.
#
# The manager keeps [(path, actor)] and threads the set through its
# loop; spawning is the only thing it does that the file actors don't.
filesActor me = filesServe me Nil.
filesServe me act =
  m = receive me;
  (replyTo, q) = m;
  filesMsg me act replyTo q m.
filesMsg me act replyTo (Read path) m =
  (a, act2) = fileOf me act path;
  _ = relay me a replyTo (Read path);
  _ = drop m;
  filesServe me act2.
filesMsg me act replyTo (Write path text) m =
  (a, act2) = fileOf me act path;
  _ = relay me a replyTo (Write path text);
  _ = drop m;
  filesServe me act2.
relay me a replyTo q =
  r = svcCall me a q;
  _ = send replyTo r;
  drop r.
# find-or-spawn: the lazy part
fileOf me act path =
  a0 = findAct act path;
  fileOf2 me act path a0.
fileOf2 me act path a0 | a0 != 0 = (a0, act).
fileOf2 me act path a0 =
  _ = Sys.logAt 0 "system: opening {path}";
  a = spawn (fileActor path);
  (a, (path, a) :: act).
findAct Nil path = 0.
findAct ((p, a) :: r) path | strEq p path = a.
findAct ((p, a) :: r) path = findAct r path.

# the file itself: content cached after the first replay
fileActor path me = fileServe path me (fileReplay path) 0.
fileServe path me body dirty =
  m = receive me;
  (replyTo, q) = m;
  fileMsg path me body replyTo q m.
fileMsg path me body replyTo (Read p) m =
  _ = send replyTo (emptyAs body "(empty file)");
  _ = drop m;
  fileServe path me body 0.
fileMsg path me body replyTo (Write p text) m =
  ok = fileAppend path text;
  _ = send replyTo ok;
  _ = drop m;
  fileServe path me "{body}{text}" 0.

# a record is "path\npayload"; the file's content is the concatenation
# of ITS records' payloads, in log order -- writes are appends, which
# is the only thing an append-only log can honestly offer (replacing
# content would need a tombstone record; not implemented)
fileAppend path text =
  case Sys.storeReq 2 "{path}\n{text}" of
    Ok u -> "wrote {strlen text} bytes to {path}"
  | Err e -> "write failed: {e}".
fileReplay path =
  blob = replayText 0;
  idx = diskIndex 0;
  recAt path blob idx 1 "".
# walk the index lines ("seq off len") in step with the flat payload
# blob: tag 5 gives the framing tag 3 flattened away
recAt path blob idx pos acc | pos > strlen blob = acc.
recAt path blob idx pos acc =
  (len, idx2) = nextLen idx;
  recAt2 path blob idx2 pos acc len.
recAt2 path blob idx pos acc 0 = acc.
recAt2 path blob idx pos acc len =
  rec = substr blob pos len;
  recAt path blob idx (pos + len) (accIf path rec acc).
accIf path rec acc =
  n = strlen path;
  case recIsFor path rec n of
    True -> "{acc}{substr rec (n + 2) (strlen rec - n - 1)}"
  | False -> acc.
recIsFor path rec n | strlen rec <= n = False.
recIsFor path rec n | charAt rec (n + 1) != 10 = False.
recIsFor path rec n = strEq (substr rec 1 n) path.
# "seq off len\n" lines -> the len of each record, in order
nextLen idx | strlen idx == 0 = (0, "").
nextLen idx = nlGo idx 1 0 0.
nlGo idx i sp v | i > strlen idx = (v, "").
nlGo idx i sp v | charAt idx i == 10 = (v, substr idx (i + 1) (strlen idx - i)).
nlGo idx i sp v | charAt idx i == 32 = nlGo idx (i + 1) (sp + 1) 0.
nlGo idx i sp v | sp == 2 = nlGo idx (i + 1) sp (v * 10 + charAt idx i - 48).
nlGo idx i sp v = nlGo idx (i + 1) sp v.

# the APPS server: /apps/<name> -- a loaded app is a resource in the
# namespace exactly like a service is
appsActor me = appsServe me.
appsServe me =
  m = receive me;
  (replyTo, Read path) = m;
  _ = send replyTo "loaded app plugin\npath resolves to its module table\nsub-slot image in the plugin window";
  _ = drop m;
  appsServe me.

# ---- the resolver: the root, such as it is ------------------------------
# entries = [(path, kind, owner)]; kind 0 = a service endpoint (an
# actor you send to), 1 = readable bytes.  There is no directory
# structure stored anywhere -- prefixes are a display idea.
vfsActor ents me = vfsServe ents me.
vfsServe ents me =
  m = receive me;
  (replyTo, q) = m;
  vfsMsg ents me replyTo q m.
vfsMsg ents me replyTo (VfsList u) m =
  _ = send replyTo (listCopy ents);
  _ = drop m;
  vfsServe ents me.
vfsMsg ents me replyTo (Read path) m =
  _ = vfsRead ents me replyTo path;
  _ = drop m;
  vfsServe ents me.
# Writing to a path nobody has named yet CREATES it, if it sits in a
# namespace that holds files: the entry is added here and its actor
# spawns on first touch, which is what "System.qa maps known URLs and
# some of them are files" means when the set of files can grow.
vfsMsg ents me replyTo (Write path text) m =
  ents2 = vfsEnsure ents path;
  _ = vfsWrite ents2 me replyTo path text;
  _ = drop m;
  vfsServe ents2 me.
vfsEnsure ents path | hasPath ents path = ents.
vfsEnsure ents path | fileSpace path = mkEntry ents path.
vfsEnsure ents path = ents.
hasPath Nil path = False.
hasPath ((p, k, o) :: r) path | strEq p path = True.
hasPath ((p, k, o) :: r) path = hasPath r path.
# the file namespaces; everything else is served by whoever owns it
fileSpace path | hasPrefix path "/tmp/" = True.
fileSpace path | hasPrefix path "/home/" = True.
fileSpace path = False.
hasPrefix s pre | strlen s < strlen pre = False.
hasPrefix s pre = strEq (substr s 1 (strlen pre)) pre.
mkEntry ents path =
  _ = Sys.logAt 0 "system: creating {path}";
  cat ents ((path, 2, filesOf ents) :: Nil).
# the files manager is whoever already owns the file entries
filesOf Nil = 0.
filesOf ((p, k, o) :: r) | k == 2 = o.
filesOf ((p, k, o) :: r) = filesOf r.
vfsWrite Nil me replyTo path text = send replyTo "no such path".
vfsWrite ((p, k, o) :: r) me replyTo path text | strEq p path =
  vfsWriteOne k o me replyTo path text.
vfsWrite (e :: r) me replyTo path text = vfsWrite r me replyTo path text.
vfsWriteOne 2 o me replyTo path text = relay me o replyTo (Write path text).
vfsWriteOne k o me replyTo path text =
  send replyTo "not writable (kind {k})".
listCopy Nil = Nil.
listCopy ((p, k, o) :: r) = (p, k) :: listCopy r.
# resolution = walk to the owner and relay; a kind-0 path has no bytes
# to give, and says so rather than pretending
vfsRead Nil me replyTo path = send replyTo "no such path".
vfsRead ((p, k, o) :: r) me replyTo path | strEq p path =
  vfsServeOne k o me replyTo path.
vfsRead (e :: r) me replyTo path = vfsRead r me replyTo path.
vfsServeOne 0 o me replyTo path =
  send replyTo "service endpoint (an actor)\nsend it a message; it has no bytes".
vfsServeOne k o me replyTo path = relay me o replyTo (Read path).

svcCall me a q = _ = send a (me, q); receive me.
svcLookup me sys url = svcCall me sys (Lookup url).
VfsList = AK.VfsList.
Read = AK.Read.
Write = AK.Write.

# ---- colors ----------------------------------------------------------------

cBg u = (62, 70, 88).
cPanel u = (92, 104, 130).
cPanelHi u = (112, 128, 162).
cText u = (930, 940, 960).
cDim u = (560, 590, 650).
cAccent u = (999, 800, 300).
cFocus u = (330, 720, 999).
cEdge u = (150, 165, 200).
cOk u = (420, 900, 560).

# ---- views -----------------------------------------------------------------
# HOME slots: 0 clock  1 notes-count  2 render  3 harts  4 store  5 status
# NOTES slots: 0 count  1..6 lines (oldest..newest of the last 6)
#              7 input  8 status

tileBord f i | f == i = Bord (330, 720, 999).
tileBord f i = Bord (150, 165, 200).

tile f i title si cap =
  Box [Col, Pad 6, Gap 5, H 52, Grow, Bg (92, 104, 130), tileBord f i]
    [ Lbl [Sc 2, Fg (930, 940, 960)] title
    , Slot [Fg (999, 800, 300)] si cap ].

# The home grid: one descriptor (title, focusIdx, slotIdx) per tile --
# the apps, then RENDER and HARTS -- chunked into rows.  Two columns
# while they fit, three once the app list outgrows them; nothing about
# the layout is written down twice.
homeTiles apps n =
  cat (appTs apps 0)
      (("RENDER", n, n + 1) :: ("HARTS", n + 1, n + 2) :: Nil).
appTs Nil i = Nil.
appTs (Ap nm sb ini upd tre vls :: r) i = (nm, i, i) :: appTs r (i + 1).

colsFor t | t > 9 = 4.
colsFor t | t > 6 = 3.
colsFor t = 2.

rowsOf Nil f cols = Nil.
rowsOf ts f cols =
  (hd, tl) = splitN cols ts;
  Box [Row, Gap 6] (tileList hd f) :: rowsOf tl f cols.
tileList Nil f = Nil.
tileList ((nm, fi, si) :: r) f = tile f fi nm si 14 :: tileList r f.
splitN 0 l = (Nil, l).
splitN n Nil = (Nil, Nil).
splitN n (x :: r) =
  (hd, tl) = splitN (n - 1) r;
  (x :: hd, tl).

homeTree apps vp f =
  (vw, vh) = vp;
  n = appN apps;
  ts = homeTiles apps n;
  Box [Col, Pad 8, Gap 6, W vw, H vh, Bg (62, 70, 88)]
    (cat
      ( Box [Row, Gap 8]
          [ Lbl [Sc 3, Fg (930, 940, 960)] "QOS"
          , Box [Grow] Nil
          , Lbl [Fg (560, 590, 650)] "T"
          , Slot [Fg (930, 940, 960)] n 6 ]
        :: rowsOf ts f (colsFor (appN apps + 2)) )
      ( Box [Grow] Nil
        :: Box [Row, Pad 4, Bg (92, 104, 130)]
             [ Slot [Fg (999, 800, 300)] (n + 3) 60 ]
        :: Nil )).
appN Nil = 0.
appN (a :: r) = 1 + appN r.

treeFor apps vp 0 f = homeTree apps vp f.
treeFor apps vp s f = apTree (nthAp apps (s - 1)) vp.
apTree (Ap nm sb ini upd tre vls) vp = tre vp.
nthAp (a :: r) 0 = a.
nthAp (a :: r) i = nthAp r (i - 1).

# ---- dynamics: the per-frame text, formatted IN THE WORKER -----------------

len Nil = 0.
len (x :: r) = 1 + len r.

nthS Nil i = "".
nthS (v :: r) 0 = v.
nthS (v :: r) i = nthS r (i - 1).

# last 6 notes, oldest first (notes list is newest-first)
lastSix notes = padTo (rev6 (take6 notes) Nil) 6.
take6 l = takeN l 6.
takeN Nil n = Nil.
takeN l 0 = Nil.
takeN (x :: r) n = x :: takeN r (n - 1).
rev6 Nil acc = acc.
rev6 (x :: r) acc = rev6 r (x :: acc).
padTo l n | len l >= n = l.
padTo l n = padTo (apnd l "") n.
apnd Nil x = x :: Nil.
apnd (a :: r) x = a :: apnd r x.

clock u =
  clint = device "clint";
  mt = reg32 clint 49144;
  t = read mt / 1000000;
  "T {t / 60}:{pad2 (imod2 t 60)}".
pad2 n | n < 10 = "0{n}".
pad2 n = "{n}".
imod2 a b = a - (a / b) * b.

# home: slot 0..n-1 = tile subtitles, n = clock, n+1 = render,
# n+2 = harts, n+3 = status.  App screens: the app's own appVals, run
# HERE in the frame worker with self (it may svcCall services).
titles Nil = Nil.
titles (Ap nm sb ini upd tre vls :: r) = nm :: titles r.

appEnts Nil appsA = Nil.
appEnts (t :: r) appsA = ("/apps/{lower t}", 1, appsA) :: appEnts r appsA.
# titles are display-cased; paths are not
lower s = lowerGo s 1 (strlen s) "".
lowerGo s i n acc | i > n = acc.
lowerGo s i n acc = lowerGo s (i + 1) n "{acc}{lowerC (charAt s i)}".
lowerC c | c >= 65 = case c <= 90 of True -> chr (c + 32) | False -> chr c.
lowerC c = chr c.

wvals apps (Fd 0 frame lastR lastKey scomp av fb env) self =
  mt = AK.envMt env;
  (draws, dynB) = lastR;
  cat (subs apps)
      ( AK.clockStr mt
        :: "{draws}D {dynB}B"
        :: hartsLine 0
        :: "F{frame}  K{lastKey}  S{scomp}  DYN {dynB}B  {arenaLine 0}"
        :: Nil ).
wvals apps (Fd s frame lastR lastKey scomp av fb env) self =
  AvApp vlsF st = av;
  vlsF self env st.
hartsLine u =
  (g, mb) = Sys.memStats 0;
  "{harts 0} LIVE  {mb}MB".
arenaLine u =
  (g, mb) = Sys.memStats 0;
  "ARENA {g}g/{mb}MB".
subs Nil = Nil.
subs (Ap nm sb ini upd tre vls :: r) = sb :: subs r.

# ---- the frame worker (frame-per-actor) ------------------------------------

# PACKED, DOUBLE-BUFFERED dynamics: the shell owns two framebuffer
# VECTORS (S2.fbNew, immortal pool); each frame the worker writes the
# slot text straight into the BACK one with Vec.set -- mutation through
# a linear handle, zero per-frame list allocation -- and Render takes
# (fb, n).  The buffers swap every frame (Fb a b in the loop state), so
# the frame being written is never the one the walker just consumed.
frameWorker parent gfx st sl fdw self =
  (apps, fd, cam) = fdw;
  Fd sN fr lr lk sc av fb env = fd;
  vs = wvals apps fd self;
  (fb2, n) = S2.dynsInto fb sl vs;
  r = svcCall self gfx (Render (S2.sceneWith cam st (fb2, n)));
  _ = send parent r;
  drop r.                # forward then release OUR ref: the reply's
                         # ARC entry dies when the shell drops its own

# ---- input -----------------------------------------------------------------
# evdev (kind 4): Linux keycodes, presses only.  stdin (kind 1): ascii
# folded onto the same codes so a live tty behaves.

ascii2code c | c == 27 = 1.
ascii2code c | c == 10 = 28.
ascii2code c | c == 13 = 28.
ascii2code c | c == 127 = 14.
ascii2code c | c == 8 = 14.
ascii2code c = 0 - c.               # negative = literal ascii char

# NB acc is prepend-built: reverse before returning so keys inside one
# frame apply in ARRIVAL order (the voxel-interactive pollKeys lesson)
drain me inp n acc | n == 0 = revK Nil acc.
drain me inp n acc =
  ev = svcCall me inp (Poll 0);
  (kind, a, b) = ev;
  _ = drop ev;           # every received message is dropped once read
  drainEv me inp n acc kind a b.
drainEv me inp n acc kind a b | kind == 0 = revK Nil acc.
drainEv me inp n acc kind a b | kind == 4 =
  case b == 1 of
    True -> drain me inp (n - 1) (a :: acc)
  | False -> drain me inp (n - 1) acc.
drainEv me inp n acc kind a b | kind == 1 =
  drain me inp (n - 1) (ascii2code a :: acc).
drainEv me inp n acc kind a b = drain me inp (n - 1) acc.

# keycode -> typed char ("" = not typable); kbdsim's code table
revK acc Nil = acc.
revK acc (x :: r) = revK (x :: acc) r.

keyChar 57 = " ".
keyChar 30 = "a". keyChar 48 = "b". keyChar 46 = "c". keyChar 32 = "d".
keyChar 18 = "e". keyChar 33 = "f". keyChar 34 = "g". keyChar 35 = "h".
keyChar 23 = "i". keyChar 36 = "j". keyChar 37 = "k". keyChar 38 = "l".
keyChar 50 = "m". keyChar 49 = "n". keyChar 24 = "o". keyChar 25 = "p".
keyChar 16 = "q". keyChar 19 = "r". keyChar 31 = "s". keyChar 20 = "t".
keyChar 22 = "u". keyChar 47 = "v". keyChar 17 = "w". keyChar 45 = "x".
keyChar 21 = "y". keyChar 44 = "z".
keyChar 11 = "0". keyChar 2 = "1". keyChar 3 = "2". keyChar 4 = "3".
keyChar 5 = "4". keyChar 6 = "5". keyChar 7 = "6". keyChar 8 = "7".
keyChar 9 = "8". keyChar 10 = "9".
keyChar c | c < 0 = chr (0 - c).    # stdin literal
keyChar c = "".

# ---- update ----------------------------------------------------------------
# update k model -> (model', cmds)

clampF t f | f < 0 = 0.
clampF t f | f > t - 1 = t - 1.
clampF t f = f.

moveF cols t f 105 | imod2 f cols != 0 = f - 1.
moveF cols t f 106 | imod2 f cols != cols - 1 = clampF t (f + 1).
moveF cols t f 103 = clampF t (f - cols).
moveF cols t f 108 = clampF t (f + cols).
moveF cols t f k = f.

# home screen
# The launcher's key protocol: esc = suspend (back to home, state
# kept), p = snapshot, q-at-home = quit; everything else while an app
# is focused goes to THAT app's appUpdate, which returns its new state
# value -- setNth into the state list and carry on.  Suspension is
# nothing but this list.
update me env apps k m = updateK me env apps (AK.keyBase k) k m.
updateK me env apps kb k (Md 0 f sts fr lr lk sc) | kb == 16 =
  (Md 0 f sts fr lr k sc, [CQuit]).
updateK me env apps kb k (Md 0 f sts fr lr lk sc) | kb == 25 = homeSnap f sts fr lr k sc.
updateK me env apps kb k (Md 0 f sts fr lr lk sc) | kb == 88 = homeSnap f sts fr lr k sc.
updateK me env apps kb k (Md 0 f sts fr lr lk sc) | kb == 28 =
  (homeEnter (appN apps) f (Md 0 f sts fr lr k sc), Nil).
updateK me env apps kb k (Md 0 f sts fr lr lk sc) =
  (Md 0 (moveF (colsFor (appN apps + 2)) (appN apps + 2) f kb) sts fr lr k sc, Nil).
updateK me env apps kb k (Md sN f sts fr lr lk sc) | kb == 1 =
  (Md 0 f sts fr lr k sc, Nil).
# INSIDE an app only F12 is the shell's: an app with a text field must
# be able to type every letter, so p and q belong to it like any other
# key.  esc (suspend) is the one universal reservation.
updateK me env apps kb k (Md sN f sts fr lr lk sc) | kb == 88 =
  (Md sN f sts fr lr k sc, [CSnap]).
updateK me env apps kb k (Md sN f sts fr lr lk sc) =
  st2 = apUpd (nthAp apps (sN - 1)) me env k (nthSt sts (sN - 1));
  (Md sN f (setNth sts (sN - 1) st2) fr lr k sc, Nil).
apUpd (Ap nm sb ini upd tre vls) me env k st = upd me env k st.

homeSnap f sts fr lr k sc = (Md 0 f sts fr lr k sc, [CSnap]).

homeEnter n f m | f < n = openApp (f + 1) m.
homeEnter n f m = m.
openApp sN (Md s g sts fr lr lk sc) = Md sN g sts fr lr lk sc.

nthSt (x :: r) 0 = x.
nthSt (x :: r) i = nthSt r (i - 1).
setNth (x :: r) 0 v = v :: r.
setNth (x :: r) i v = x :: setNth r (i - 1) v.

applyKeys me env apps Nil mc = mc.
applyKeys me env apps (k :: r) (m, cs) =
  (m2, c2) = update me env apps k m;
  applyKeys me env apps r (m2, cat cs c2).
cat Nil b = b.
cat (a :: r) b = a :: cat r b.

# ---- effects ---------------------------------------------------------------

doCmds me dsp fr Nil = 0.
doCmds me dsp fr (c :: r) =
  _ = doCmd me dsp fr c;
  doCmds me dsp fr r.
doCmd me dsp fr CQuit = 0.
doCmd me dsp fr CSnap = svcCall me dsp (Present "pshell{fr}.ppm").
wantsQuit Nil = False.
wantsQuit (CQuit :: r) = True.
wantsQuit (c :: r) = wantsQuit r.

# ---- the shell loop --------------------------------------------------------
# cache = (skey, statics, slots): the statics VALUE lives here across
# frames -- pointer-stable while retained, which is the walker's
# recompile trigger when a screen/focus change swaps it out.

tick = 50000.                        # 50 ms -> 20 fps (10 MHz clint)

waitTick mt t0 | read mt - t0 >= tick = read mt.
waitTick mt t0 = waitTick mt t0.

skeyOf (Md s f sts fr lr lk sc) = s * 100 + f.

ensure apps vp cache key =
  (k, st, sl) = cache;
  case k == key of
    True -> (cache, 0)
  | False -> (rebuildTree apps vp key, 1).
rebuildTree apps vp key =
  (st2, sl2) = S2.buildW vp (treeFor apps vp (key / 100) (imod2 key 100));
  (key, st2, sl2).

# av for the worker: home = 0, app screen = (that app's vals fn, state)
fdOf fb env apps (Md sN f sts fr lr lk sc) =
  Fd sN fr lr lk sc (avFor apps sN sts) fb env.
avFor apps 0 sts = AvHome.
avFor apps sN sts = AvApp (apVls (nthAp apps (sN - 1))) (nthSt sts (sN - 1)).
apVls (Ap nm sb ini upd tre vls) = vls.

result apps (Md s f sts fr lr lk sc) =
  "pshell: {fr} frames, {sc} statics compiles, {appN apps} apps".

loop me gfx dsp inp mt rt model =
  t0 = read mt;
  ks = drain me inp 16 Nil;
  (m2, cmds) = applyKeys me (envOf rt) (appsOf rt) ks (model, Nil);
  _ = doCmds me dsp (frOf m2) cmds;
  case wantsQuit cmds of
    True -> result (appsOf rt) m2
  | False -> frame me gfx dsp inp mt rt m2 t0.

frOf (Md s f sts fr lr lk sc) = fr.

frame me gfx dsp inp mt rt m2 t0 =
  (cache2, rebuilt) = ensureRt rt (skeyOf m2);
  m3 = bumpS m2 rebuilt;
  (k, st, sl) = cache2;
  _ = spawn (frameWorker me gfx st sl (appsOf rt, fdOf (backFb rt) (envOf rt) (appsOf rt) m3, camOfRt rt));
  r = receive me;
  m4 = advance m3 r;
  _ = waitTick mt t0;
  loop me gfx dsp inp mt (swapRt rt cache2) m4.

ensureRt (Rt cache a b bk cfg apps) key =
  (vp, env, cam) = cfg;
  ensure apps vp cache key.
backFb (Rt cache a b bk cfg apps) = case bk == 0 of True -> a | False -> b.
appsOf (Rt cache a b bk cfg apps) = apps.
envOf (Rt cache a b bk cfg apps) =
  (vp, env, cam) = cfg;
  env.
# the camera, built once at boot: nothing in the frame path allocates it
camOfRt (Rt cache a b bk cfg apps) =
  (vp, env, cam) = cfg;
  cam.
swapRt (Rt cache a b bk cfg apps) cache2 = Rt cache2 a b (1 - bk) cfg apps.

bumpS m 0 = m.
bumpS (Md s f sts fr lr lk sc) n = Md s f sts fr lr lk (sc + n).
# the reply tuple ESCAPED into this immortal actor (worker -> shell
# send); dropping the previous one releases its ARC entry -- without
# this, one live entry per frame fills the ARC table in ~50 s of idle
advance (Md s f sts fr lr lk sc) r =
  _ = drop lr;
  Md s f sts (fr + 1) r lk sc.

# ---- main ------------------------------------------------------------------

main =
  me = myself 0;
  _ = print "pshell: QOS Portable shell (gen_view -> GLES via scene2d)";
  sys = spawn systemActor;
  gfx = spawnOn 0 graphicsActor;    # pinned: the EGL context is
  dsp = spawnOn 0 displayActor;     # thread-bound; hart 0 owns GL
  inp = spawn inputActor;
  reg = ("/services/graphics", gfx)
     :: ("/services/display", dsp)
     :: ("/services/input", inp) :: Nil;
  _ = send sys (me, Reg reg);
  _ = receive me;
  g = svcLookup me sys "/services/graphics";
  d = svcLookup me sys "/services/display";
  i = svcLookup me sys "/services/input";
  clint = device "clint";
  mt = reg32 clint 49144;
  # /services/log: the ring every app actor writes through
  logA = spawn logActor;
  _ = send sys (me, Reg ( ("/services/log", logA)
                       :: ("/logs", logA)
                       :: ("/logs/normal", logA)
                       :: ("/logs/warns", logA)
                       :: ("/logs/errors", logA) :: Nil));
  _ = receive me;
  log = svcLookup me sys "/logs";
  cache0 = (0 - 1, Nil, Nil);
  # the two packed framebuffers, allocated ONCE here (immortal pool --
  # handle addresses stay put, the voxel-interactive discipline); 4096
  # instances each = the walker's MAX_INST
  fbA = S2.fbNew 16384;
  fbB = S2.fbNew 16384;
  (gw, gh) = svcCall me g (Dims 0);
  # INTEGER UI SCALE: the largest s that still leaves >= 240 virtual
  # rows.  vp = (gw/s, gh/s) means one virtual pixel is exactly s by s
  # real pixels -- no half-covered glyph cells, and a bigger panel buys
  # more virtual area rather than chunkier text.
  s = uiScale gh;
  vw = gw / s;
  vh = gh / s;
  vp = (vw, vh);
  _ = print "pshell: display {gw}x{gh} -> virtual {vw}x{vh} at {s}x";
  # attach every app .qa present, discover contracts per table, init
  # each app (inits run HERE -- an app may spawn its own actors now)
  _ = tryAttach "pnotes.qa";
  _ = tryAttach "clock.qa";
  _ = tryAttach "hello.qa";
  _ = tryAttach "logs.qa";
  _ = tryAttach "monitor.qa";
  _ = tryAttach "browser.qa";
  _ = tryAttach "disk.qa";
  _ = tryAttach "cli.qa";
  apps = discover 0 (Mod.plugs 0);
  _ = print "pshell: {appN apps} apps loaded; q quits (home), F12 snapshots, esc suspends";
  # the root namespace: what the system KNOWS how to name.  Service
  # endpoints, the log paths, one entry per loaded app, and the two
  # paths whose bytes are genuinely on disk.
  storeA = spawn storeActor;
  appsA = spawn appsActor;
  filesA = spawn filesActor;
  ents = cat ( ("/services/graphics", 0, g)
            :: ("/services/display", 0, d)
            :: ("/services/input", 0, i)
            :: ("/services/log", 0, log)
            :: ("/logs/normal", 1, log)
            :: ("/logs/warns", 1, log)
            :: ("/logs/errors", 1, log)
            :: ("/store/notes", 1, storeA)
            :: ("/disk/records", 1, storeA)
            :: ("/home/notes.txt", 2, filesA)
            :: ("/tmp/scratch.txt", 2, filesA) :: Nil)
            (appEnts (titles apps) appsA);
  vfs = spawn (vfsActor ents);
  _ = send sys (me, Reg (("/services/vfs", vfs) :: Nil));
  _ = receive me;
  env = (log, mt, (titles apps, vfs));
  sts = initAll me apps env;
  m0 = Md 0 0 sts 0 (0, 0) 0 0;
  loop me g d i mt (Rt cache0 fbA fbB 0 (vp, env, S2.camAt vh) apps) m0.

tryAttach nm =
  case Sys.attachQa nm of
    Ok u -> 1
  | Err e -> attachMiss nm e.
attachMiss nm e =
  _ = print "pshell: {nm}: {e}";
  0.

# per attached table: the contract or nothing (a plugin that is not an
# app -- or a partial one -- is skipped, stated)
discover i n | i >= n = Nil.
discover i n =
  (h1, meta) = Mod.findAt i "appMeta";
  (h2, ini) = Mod.findAt i "appInit";
  (h3, upd) = Mod.findAt i "appUpdate";
  (h4, tre) = Mod.findAt i "appTree";
  (h5, vls) = Mod.findAt i "appVals";
  discovered (h1 * h2 * h3 * h4 * h5) meta ini upd tre vls i n.
discovered ok meta ini upd tre vls i n | ok == 1 =
  (nm, sb) = meta 0;
  _ = print "pshell: app {i}: {nm}";
  Ap nm sb ini upd tre vls :: discover (i + 1) n.
discovered ok meta ini upd tre vls i n =
  _ = print "pshell: table {i}: not an app (skipped)";
  discover (i + 1) n.

initAll me Nil env = Nil.
initAll me (Ap nm sb ini upd tre vls :: r) env = ini me env :: initAll me r env.

uiScale h | h < 240 = 1.
uiScale h = h / 240.
