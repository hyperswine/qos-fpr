# docsite.fpr -- an interactive documentation site, served by FP-RISC.
#
#   make posix.bin PROG=programs/docsite.fpr && ./posix.bin
#   -> http://localhost:8000  (bare-metal: make run PROG=..., slirp :8000)
#
# The pos2 shape brought over: a visually sophisticated single-page app
# (tabs, a ctrl-K search modal with keyboard navigation, recent chips)
# on the MVU static/dynamic split. The STATIC half -- web/shell.html
# plus the whole doc corpus -- is embedded at build time by
# tools/docsgen.sol (mods/docsdata.fpr), so this binary is the entire
# site. The DYNAMIC half is small JSON against a single-writer MODEL
# ACTOR (the MVU rule: update runs linearly in one place):
#
#   GET  /            the shell (text/html, once)
#   GET  /api/docs    tab list          GET /api/doc?n=   one doc body
#   GET  /api/search?q=   content search: doc, line no, line text
#   POST /api/visit   {"doc":...}       GET /api/recent   recent list
#   GET  /api/status  runtime counters for the footer
#
# Recent-docs state is a Persist "docsite/recent" value (mods/persist):
# saved on every visit through the store actor, reloaded on every read
# -- the same code binds to qlog storage on QOS native for kill-9
# durability; hosted, it lives for the server's life.

D = use "mods/docsdata".
P = use "mods/persist".
Persist = P.Persist.

# ---- model actor: the single writer for interaction state -------------------

MReq = Type (Visit me doc | Recent me | Searched me).
Model = Type (Model store searches).

spawnModel u =
  store = P.spawnStore Unit;
  spawn (fn me -> mLoop me (Model store 0)).

mLoop me m = mServe me m (receive me).
mServe me (Model store n) (Visit who doc) =
  # the model receives the store's reply on ITS OWN handle -- receiving
  # on `who` is another actor's mailbox and panics by design
  old = P.load store me "docsite/recent" "";
  u = P.save store (Persist "docsite/recent" (pushRecent old doc));
  u2 = send who (Ok "ok");
  mLoop me (Model store n).
mServe me (Model store n) (Recent who) =
  u = send who (Ok (P.load store me "docsite/recent" ""));
  mLoop me (Model store n).
mServe me (Model store n) (Searched who) =
  u = send who (Ok (str (n + 1)));
  mLoop me (Model store (n + 1)).

# recent list encoded "a|b|c" newest-first, dedup, cap 6
pushRecent enc doc = encodeR (doc :: dropDoc (splitBar enc) doc) 6.
dropDoc Nil doc = Nil.
dropDoc (d :: r) doc | strEq d doc = dropDoc r doc.
dropDoc (d :: r) doc = d :: dropDoc r doc.
encodeR Nil k = "".
encodeR (d :: r) k | k == 0 = "".
encodeR (d :: r) k = eR2 d (encodeR r (k - 1)).
eR2 d "" = d.
eR2 d rest = "{d}|{rest}".
splitBar s | strlen s == 0 = Nil.
splitBar s = sbGo s 1 (strlen s) "".
sbGo s i n acc | i > n = acc :: Nil.
sbGo s i n acc | charAt s i == 124 = acc :: sbGo s (i + 1) n "".
sbGo s i n acc = sbGo s (i + 1) n (strcat acc (chr (charAt s i))).

# ---- run-chunked JSON escaping ---------------------------------------------
# FPR strings are contiguous (substr/strcat are memcpy), so escaping in
# RUNS -- one substr+strcat per stretch of chars needing no escape --
# is effectively O(n), unlike the per-char strcat fold. SString stays
# out of this: it is the fixed-128B tier by design.

jescRun s = jrGo s 1 (strlen s) "".
jrGo s i n acc | i > n = acc.
jrGo s i n acc =
  z = runEnd s i n;
  acc2 = jrTake acc s i z;
  jrEsc s (z + 1) n acc2.
# extend [i..z] while chars are JSON-safe
runEnd s i n = reGo s (i - 1) n.
reGo s z n | z + 1 > n = z.
reGo s z n | jsafe (charAt s (z + 1)) = reGo s (z + 1) n.
reGo s z n = z.
jsafe 34 = False.
jsafe 92 = False.
jsafe c = c >= 32.
jrTake acc s i z | z < i = acc.
jrTake acc s i z = strcat acc (substr s i (z - i + 1)).
jrEsc s i n acc | i > n = acc.
jrEsc s i n acc = jrGo s (i + 1) n (strcat acc (jescCh (charAt s i))).
jescCh 34 = "\\\"".
jescCh 92 = "\\\\".
jescCh 10 = "\\n".
jescCh 13 = "".
jescCh 9 = "\\t".
jescCh c = " ".

# ---- content search ---------------------------------------------------------
# case-insensitive substring scan over every embedded doc; hits carry
# (doc, 1-based line, whole line). Caps: 24 hits total.

low c | c >= 65 = lowUp c.
low c = c.
lowUp c | c <= 90 = c + 32.
lowUp c = c.

ciAt s i q j m | j > m = True.
ciAt s i q j m | low (charAt s (i + j - 1)) == low (charAt q j) = ciAt s i q (j + 1) m.
ciAt s i q j m = False.

# scan one doc: hits accumulated onto b as JSON; PoC ABI is 8 args, so
# the scanner state rides in one Scan constructor (the livenotes rule)
Scan = Type (Scan name s q n m).
scanDoc b name s q cap first =
  sdGo b (Scan name s (strlen s) (strlen q) 0) s q 1 1 first cap.
sdGo b sc s q i ln c cap | sdDone sc i c cap = (b, c).
sdGo b sc s q i ln c cap | charAt s i == 10 = sdGo b sc s q (i + 1) (ln + 1) c cap.
sdGo b sc s q i ln c cap | ciAt s i q 1 (scM sc) = sdHit b sc s q i ln c cap.
sdGo b sc s q i ln c cap = sdGo b sc s q (i + 1) ln c cap.
sdDone (Scan name s2 n m z) i c cap | i + m - 1 > n = True.
sdDone (Scan name s2 n m z) i c cap = c >= cap.
scM (Scan name s2 n m z) = m.
scName (Scan name s2 n m z) = name.
scN (Scan name s2 n m z) = n.
sdHit b sc s q i ln c cap =
  a = lineStart s i;
  z = lineEnd s i (scN sc);
  b2 = hitJson b (scName sc) ln s a z c;
  # resume AFTER this line so one line yields one hit
  sdGo b2 sc s q (z + 1) (ln + 1) (c + 1) cap.
lineStart s i | i == 1 = 1.
lineStart s i | charAt s (i - 1) == 10 = i.
lineStart s i = lineStart s (i - 1).
lineEnd s i n | i > n = n.
lineEnd s i n | charAt s i == 10 = i - 1.
lineEnd s i n = lineEnd s (i + 1) n.

# the per-hit JSON object; truncate long lines to 160 chars
hitJson b name ln s a z c =
  z2 = minI z (a + 159);
  strcat b (strcat (hitSep c) "\{\"doc\":\"{name}\",\"line\":{ln},\"text\":\"{jescRun (substr s a (z2 - a + 1))}\"}").
hitSep 0 = "".
hitSep c = ",".
minI a b = case a < b of True -> a | False -> b.

searchAll q =
  (b1, total) = saGo "\{\"hits\":[" (D.docs Unit) q 0;
  strcat b1 "],\"n\":{total},\"us\":{fuelPreempts 0}}".
saGo b Nil q c = (b, c).
saGo b ((name, title) :: r) q c | c >= 24 = (b, c).
saGo b ((name, title) :: r) q c =
  (b2, c2) = scanDoc b name (D.body name) q 24 c;
  saGo b2 r q c2.

# ---- HTTP plumbing (httpd.fpr lineage) --------------------------------------

crlf = strcat (chr 13) (chr 10).
hline s = strcat s crlf.
resp ct status body =
  n = strlen body;
  strcat (hline "HTTP/1.0 {status}")
  (strcat (hline "Content-Type: {ct}")
  (strcat (hline "Content-Length: {n}")
  (strcat (hline "Connection: close")
  (strcat crlf body)))).
jresp body = resp "application/json" "200 OK" body.

findSub s sub from = fsGo s sub from (strlen s) (strlen sub).
fsGo s sub i n m | i + m - 1 > n = 0.
fsGo s sub i n m | ciAt s i sub 1 m = i.
fsGo s sub i n m = fsGo s sub (i + 1) n m.

reqMethod s = takeTok s 1 (strlen s).
reqPathQ s =
  sp1 = findCh s 32 1;
  takeTok s (sp1 + 1) (strlen s).
takeTok s i n = ttGo s i n "".
ttGo s i n acc | i > n = acc.
ttGo s i n acc | charAt s i == 32 = acc.
ttGo s i n acc | charAt s i == 13 = acc.
ttGo s i n acc = ttGo s (i + 1) n (strcat acc (chr (charAt s i))).
findCh s c i | i > strlen s = 0.
findCh s c i | charAt s i == c = i.
findCh s c i = findCh s c (i + 1).

# split "/api/doc?n=API.md" -> path + url-decoded query value for key
pathOf pq = pOf pq (findCh pq 63 1).
pOf pq 0 = pq.
pOf pq k = slice pq 1 (k - 1).
qVal pq key = qv pq (findCh pq 63 1) key.
qv pq 0 key = "".
qv pq k key = qFind (slice pq (k + 1) (strlen pq)) key.
qFind qs key = qScan (splitAmp qs) key.
qScan Nil key = "".
qScan (p :: r) key = qHit p r key (findCh p 61 1).
qHit p r key 0 = qScan r key.
qHit p r key eq | strEq (slice p 1 (eq - 1)) key = urlDec (slice p (eq + 1) (strlen p)).
qHit p r key eq = qScan r key.
splitAmp s | strlen s == 0 = Nil.
splitAmp s = saSp s 1 (strlen s) "".
saSp s i n acc | i > n = acc :: Nil.
saSp s i n acc | charAt s i == 38 = acc :: saSp s (i + 1) n "".
saSp s i n acc = saSp s (i + 1) n (strcat acc (chr (charAt s i))).

slice s a b = slGo s a b "".
slGo s i b acc | i > b = acc.
slGo s i b acc = slGo s (i + 1) b (strcat acc (chr (charAt s i))).

# %XX + '+' -> space; enough for search queries
urlDec s = udGo s 1 (strlen s) "".
udGo s i n acc | i > n = acc.
udGo s i n acc | charAt s i == 43 = udGo s (i + 1) n (strcat acc " ").
udGo s i n acc | charAt s i == 37 = udPct s i n acc.
udGo s i n acc = udGo s (i + 1) n (strcat acc (chr (charAt s i))).
udPct s i n acc | i + 2 > n = acc.
udPct s i n acc = udGo s (i + 3) n (strcat acc (chr (hex (charAt s (i + 1)) * 16 + hex (charAt s (i + 2))))).
hex c | c >= 97 = c - 87.
hex c | c >= 65 = c - 55.
hex c = c - 48.

strEq a b = case strlen a == strlen b of True -> seGo a b 1 (strlen a) | False -> False.
seGo a b i n | i > n = True.
seGo a b i n | charAt a i == charAt b i = seGo a b (i + 1) n.
seGo a b i n = False.

# request accumulation: header-only GET/POST-with-small-body reads
readReq nd acc = rp (netPoll nd) nd acc.
rp 2 nd acc = rTest nd (strcat acc (netRead nd)).
rp 0 nd acc = rp (netPoll nd) nd acc.
rp r nd acc = Err "conn lost".
rTest nd acc | findSub acc (strcat crlf crlf) 1 > 0 = Ok acc.
rTest nd acc = readReq nd acc.

jstr s = "\"{jescRun s}\"".

# ---- routes -----------------------------------------------------------------

docsJson u = "\{\"docs\":[{docsRows (D.docs Unit)}]}".
docsRows Nil = "".
docsRows ((n, t) :: r) = dr2 "\{\"name\":{jstr n},\"title\":{jstr t}}" (docsRows r).
dr2 x "" = x.
dr2 x rest = "{x},{rest}".

docJson name =
  strcat "\{\"name\":{jstr name},\"body\":\"" (strcat (jescRun (D.body name)) "\"}").

recentJson mdl me =
  u = send mdl (Recent me);
  rj (receiveRes me).
rj (Ok enc) = "\{\"recent\":[{jbars (splitBar enc)}]}".
rj (Err e) = "\{\"recent\":[]}".
jbars Nil = "".
jbars (d :: r) = dr2 (jstr d) (jbars r).

statusJson searched =
  h = heapUsed Unit / 1024;
  p = fuelPreempts 0;
  "\{\"heap_kib\":{h},\"preempts\":{p},\"searches\":{searched}}".

route "GET" "/" q body mdl me n = resp "text/html; charset=utf-8" "200 OK" (D.shell Unit).
route "GET" "/api/docs" q body mdl me n = jresp (docsJson Unit).
route "GET" "/api/doc" q body mdl me n = jresp (docJson q).
route "GET" "/api/search" q body mdl me n =
  u = send mdl (Searched me);
  u2 = receiveRes me;
  jresp (searchAll q).
route "GET" "/api/recent" q body mdl me n = jresp (recentJson mdl me).
route "GET" "/api/status" q body mdl me n = jresp (statusJson n).
route "POST" "/api/visit" q body mdl me n = doVisit mdl me (jsonField body "doc").
route m p q body mdl me n = resp "application/json" "404 Not Found" "\{\"error\":\"not found\"}".

doVisit mdl me (Ok doc) =
  u = send mdl (Visit me doc);
  u2 = receiveRes me;
  jresp "\{\"ok\":true}".
doVisit mdl me (Err e) = resp "application/json" "400 Bad Request" "\{\"error\":{jstr e}}".

# minimal {"doc":"..."} extractor
jsonField body key =
  k = "\"{key}\"";
  jf body (findSub body k 1) (strlen k).
jf body 0 kn = Err "missing field".
jf body p kn = jf2 body (skipToQuote body (p + kn) (strlen body)).
skipToQuote s i n | i > n = 0.
skipToQuote s i n | charAt s i == 34 = i + 1.
skipToQuote s i n = skipToQuote s (i + 1) n.
jf2 body 0 = Err "bad json".
jf2 body i = jfRead body i (strlen body) "".
jfRead s i n acc | i > n = Err "unterminated".
jfRead s i n acc | charAt s i == 34 = Ok acc.
jfRead s i n acc = jfRead s (i + 1) n (strcat acc (chr (charAt s i))).

bodyOf req = bo req (findSub req (strcat crlf crlf) 1).
bo req 0 = "".
bo req p = slice req (p + 4) (strlen req).

# ---- server loop ------------------------------------------------------------

srv nd mdl me n = sp (netPoll nd) nd mdl me n.
sp 2 nd mdl me n = s2 nd mdl me n (readReq nd "").
sp r nd mdl me n = srv nd mdl me n.
s2 nd mdl me n (Err e) = print "[docs] dropped: {e}" >> srv nd mdl me n.
s2 nd mdl me n (Ok req) =
  m = reqMethod req;
  pq = reqPathQ req;
  p = pathOf pq;
  q = qVal pq "n";
  q2 = case strlen q of 0 -> qVal pq "q" | _ -> q;
  u = print "[docs] {m} {p}";
  u2 = netWrite nd (route m p q2 (bodyOf req) mdl me n);
  u3 = netClose nd;
  srv nd mdl me (n + 1).

main =
  nd = device "net";
  mdl = spawnModel Unit;
  me = myself 0;
  print "[docsite] embedded corpus: {docsCount (D.docs Unit)} docs; http on host :8000 (http://localhost:8000)" >>
  srv nd mdl me 0.
docsCount Nil = 0.
docsCount (e :: r) = 1 + docsCount r.
