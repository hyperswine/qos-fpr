# ============================================================================
# qlog.fpr -- the append-only page log, as a separately compiled module,
#             plus the STORAGE ACTOR System.qa spawns to own it.
#
# The on-disk format is diskfs.fpr's QLOG, unchanged (images interoperate):
#   page 0            superblock  "QLOG <head>"
#   a record          header page "QREC <npages> <paylen> <url>"  or a
#                     "QDEL 0 0 <url>" tombstone, then <npages> whole
#                     payload pages -- page-aligned, so a reader that
#                     knows where a record starts does arithmetic.
#   recency           position: later records for a url shadow earlier
#                     ones; nothing is rewritten but the superblock head.
#
# TWO read disciplines, both exported:
#   readLatest  -- the FILE read: the newest record for the url wins
#                  (a .qa, a text file, a binary blob).
#   replayAll   -- the EVENT-SOURCE read: concatenate EVERY live record
#                  for the url in log order.  This is Sol's Persistent
#                  model mapped onto the log: an app's kv url is a msg
#                  stream, `append` logs one msg, replay folds them.
#
# The ACTOR (spawned by System.qa; single writer, which is what keeps
# append-only sound with no further ceremony) answers 4-tuples
# (replyTo, tag, url, payload) with builtin Ok/Err Results:
#   tag 1 read-latest   2 append-record   3 replay-concat
#   tag 4 tombstone     5 stats
# Requests and replies are tuples/Strings/Ints only -- the shapes that
# are stable across separately compiled units by construction.
# ============================================================================

# ---- small self-contained helpers (module units see only the prelude) ------
minI a b = case a < b of True -> a | False -> b.
ceilDiv a b = (a + b - 1) / b.

parseNum w = pnGo w 1 (strlen w) 0.
pnGo w i n acc = case i > n of True -> acc | False -> pnCh w i n acc (charAt w i).
pnCh w i n acc c =
  case and2 (c >= 48) (c <= 57) of
    True -> pnGo w (i + 1) n (acc * 10 + (c - 48))
  | False -> acc.
and2 a b = case a of True -> b | False -> False.

# word starting at i; returns (word, next index past the delimiter)
takeWord s i n = twGo s i n "".
twGo s i n acc = case i > n of True -> (acc, i) | False -> twCh s i n acc (charAt s i).
twCh s i n acc c =
  case or2 (c == 32) (c == 10) of
    True -> (acc, i + 1)
  | False -> twGo s (i + 1) n (strcat acc (chr c)).
or2 a b = case a of True -> True | False -> b.

pgsz = 4096.

# ---- headers ---------------------------------------------------------------
lf = chr 10.
hdrLine tag np pl url = strcat "{tag} {np} {pl} {url}" lf.
sbLine head = strcat "QLOG {head}" lf.

# parse "TAG NP PL URL"; -> Ok (tag, np, pl, url) | Err
parseHdr s =
  n = strlen s;
  (tag, i1) = takeWord s 1 n;
  case or2 (strEq tag "QREC") (strEq tag "QDEL") of
    True -> parseHdr2 s n i1 tag
  | False -> Err "not a record header".
parseHdr2 s n i1 tag =
  (npw, i2) = takeWord s i1 n;
  (plw, i3) = takeWord s i2 n;
  (url, i4) = takeWord s i3 n;
  Ok (tag, parseNum npw, parseNum plw, url).
strEq a b = case strlen a == strlen b of True -> seGo a b 1 (strlen a) | False -> False.
seGo a b i n = case i > n of True -> True | False -> seCh a b i n.
seCh a b i n = case charAt a i == charAt b i of True -> seGo a b (i + 1) n | False -> False.

sbHead s =
  n = strlen s;
  (tag, i1) = takeWord s 1 n;
  case strEq tag "QLOG" of
    True -> sbHead2 s n i1
  | False -> Err "unformatted".
sbHead2 s n i1 =
  (hw, i2) = takeWord s i1 n;
  Ok (parseNum hw).

# ---- format / open ----------------------------------------------------------
# ensure dev -> head : format page 0 if unrecognized, return the head
ensure dev =
  case sbHead (blkRead dev 0) of
    Ok h -> h
  | Err _ -> ensureFmt dev.
ensureFmt dev =
  _ = blkWrite dev 0 (sbLine 1);
  1.

# ---- writes (single writer: the actor) --------------------------------------
# append a record; -> new head
appendRec dev head tag url s =
  pl = strlen s;
  np = ceilDiv pl pgsz;
  _ = blkWrite dev head (hdrLine tag np pl url);
  _ = writePages dev (head + 1) s 1 pl;
  h2 = head + 1 + np;
  _ = blkWrite dev 0 (sbLine h2);
  h2.
writePages dev p s i pl =
  case i > pl of
    True -> Unit
  | False -> writeOne dev p s i pl.
writeOne dev p s i pl =
  _ = blkWrite dev p (substr s i (minI pgsz (pl - i + 1)));
  writePages dev (p + 1) s (i + pgsz) pl.

# ---- reads -------------------------------------------------------------------
# payload of the record whose header is at page p (paylen pl)
readPayload dev p pl = rpGo dev (p + 1) pl "".
rpGo dev p left acc =
  case left <= 0 of
    True -> acc
  | False -> rpOne dev p left acc.
rpOne dev p left acc =
  s = blkRead dev p;
  rpGo dev (p + 1) (left - pgsz) (strcat acc (substr s 1 (minI pgsz left))).

# readLatest: STREAM the log, keep the last live record for url.
#   -> Ok content | Err "no such file"
readLatest dev head url = rlGo dev head url 1 (Err "no such file").
rlGo dev head url p best =
  case p >= head of
    True -> best
  | False -> rlStep dev head url p best (parseHdr (blkRead dev p)).
rlStep dev head url p best h =
  case h of
    Err _ -> best
  | Ok rec -> rlHit dev head url p best rec.
rlHit dev head url p best rec =
  (tag, np, pl, u) = rec;
  case strEq u url of
    True -> rlTake dev head url p pl (strEq tag "QDEL") np
  | False -> rlGo dev head url (p + 1 + np) best.
rlTake dev head url p pl dead np =
  case dead of
    True -> rlGo dev head url (p + 1 + np) (Err "no such file")
  | False -> rlGo dev head url (p + 1 + np) (Ok (readPayload dev p pl)).

# replayAll: concatenate EVERY live record for url, log order (the
# event-source read; a QDEL resets the stream -- "forget my history").
replayAll dev head url = raGo dev head url 1 "".
raGo dev head url p acc =
  case p >= head of
    True -> acc
  | False -> raStep dev head url p acc (parseHdr (blkRead dev p)).
raStep dev head url p acc h =
  case h of
    Err _ -> acc
  | Ok rec -> raHit dev head url p acc rec.
raHit dev head url p acc rec =
  (tag, np, pl, u) = rec;
  case strEq u url of
    True -> raTake dev head url (p + 1 + np) acc (strEq tag "QDEL") (readPayload dev p pl)
  | False -> raGo dev head url (p + 1 + np) acc.
raTake dev head url pnext acc dead pay =
  case dead of
    True -> raGo dev head url pnext ""
  | False -> raGo dev head url pnext (strcat acc pay).

# count live records for url (replay length without the bytes)
countRecs dev head url = crGo dev head url 1 0.
crGo dev head url p n =
  case p >= head of
    True -> n
  | False -> crStep dev head url p n (parseHdr (blkRead dev p)).
crStep dev head url p n h =
  case h of
    Err _ -> n
  | Ok rec -> crHit dev head url p n rec.
crHit dev head url p n rec =
  (tag, np, pl, u) = rec;
  case strEq u url of
    True -> crTake dev head url p n (strEq tag "QDEL") np
  | False -> crGo dev head url (p + 1 + np) n.
crTake dev head url p n dead np =
  case dead of
    True -> crGo dev head url (p + 1 + np) 0
  | False -> crGo dev head url (p + 1 + np) (n + 1).

# ---- the boot-scan INDEX -----------------------------------------------------
# One pass over the log at actor start builds `idx`: a list of
# (url, headerPage, paylen) for every LIVE record, in log order (a
# QDEL drops the url's earlier entries).  Reads become index walks
# instead of disk walks; appends extend the index incrementally.  The
# next elaboration after this is per-url URActors.
scanIdx dev head = siGo dev head 1 Nil.
siGo dev head p idx =
  case p >= head of
    True -> idx
  | False -> siStep dev head p idx (parseHdr (blkRead dev p)).
siStep dev head p idx h =
  case h of
    Err _ -> idx
  | Ok rec -> siHit dev head p idx rec.
siHit dev head p idx rec =
  (tag, np, pl, u) = rec;
  case strEq tag "QDEL" of
    True -> siGo dev head (p + 1 + np) (dropUrl idx u)
  | False -> siGo dev head (p + 1 + np) (append idx ((u, p, pl) :: Nil)).
append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.
dropUrl idx u =
  case idx of
    Nil -> Nil
  | e :: r -> case e of (eu, ep, epl) ->
      case strEq eu u of True -> dropUrl r u | False -> e :: dropUrl r u.

# index reads
idxLatest dev idx url = ilGo dev idx url (Err "no such file").
ilGo dev idx url best =
  case idx of
    Nil -> best
  | e :: r -> ilStep dev r url best e.
ilStep dev r url best e =
  case e of (u, p, pl) ->
    case strEq u url of
      True -> ilGo dev r url (Ok (readPayload dev p pl))
    | False -> ilGo dev r url best.
idxReplay dev idx url acc =
  case idx of
    Nil -> acc
  | e :: r -> irStep dev r url acc e.
irStep dev r url acc e =
  case e of (u, p, pl) ->
    case strEq u url of
      True -> idxReplay dev r url (strcat acc (readPayload dev p pl))
    | False -> idxReplay dev r url acc.
idxCount idx url =
  case idx of
    Nil -> 0
  | e :: r -> icStep r url e.
icStep r url e =
  case e of (u, _, _) ->
    case strEq u url of True -> 1 + idxCount r url | False -> idxCount r url.

# ---- the storage actor -------------------------------------------------------
# System.qa spawns `actor dev`; the actor owns (dev, head, idx) and is
# the ONE writer.  Reads consult the boot-scan index.
actor dev me =
  head = ensure dev;
  aLoop dev me head (scanIdx dev head).
aLoop dev me head idx =
  m = receive me;
  case m of (replyTo, tag, url, pay) -> aServe dev me head idx replyTo tag url pay.
aServe dev me head idx replyTo tag url pay =
  case tag of
    1 -> send replyTo (idxLatest dev idx url)          >> aLoop dev me head idx
  | 2 -> aAppend dev me head idx replyTo "QREC" url pay
  | 3 -> send replyTo (Ok (idxReplay dev idx url ""))  >> aLoop dev me head idx
  | 4 -> aAppend dev me head idx replyTo "QDEL" url ""
  | 5 -> send replyTo (Ok "head={head} url-records={idxCount idx url}") >> aLoop dev me head idx
  | _ -> send replyTo (Err "storage: unknown request tag") >> aLoop dev me head idx.
aAppend dev me head idx replyTo tag url pay =
  h2 = appendRec dev head tag url pay;
  # OWN COPY of the url before it goes into the long-lived index: the
  # message's url string lives in the SENDER's slab -- freed when that
  # actor is reaped, or bulk-freed with a loaded process's whole arena
  # on exit (the syscall trampoline allocates it from the process
  # heap).  strcat always allocates fresh in the CURRENT actor's slab,
  # and aAppend runs in the storage actor, so this pins ownership here.
  u2 = strcat url "";
  idx2 = case strEq tag "QDEL" of
           True -> dropUrl idx url
         | False -> append idx ((u2, head, strlen pay) :: Nil);
  _ = send replyTo (Ok "");
  aLoop dev me h2 idx2.
