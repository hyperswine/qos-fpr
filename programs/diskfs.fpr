# diskfs.fpr -- PERSISTENCE: an append-only page log under the namespace.
#
#   HAL      : blk.c -- the disk is 4 KiB pages, read/written whole, nothing
#              else. blkRead/blkWrite will touch ANY page directly; that this
#              program only ever appends is policy, and policy lives here.
#   log      : page 0 is the superblock "QLOG <head>". Records are
#              PAGE-ALIGNED: one header page ("QREC <npages> <paylen> <url>"
#              or a "QDEL" tombstone) followed by whole payload pages.
#              Newer = later in the log; the latest record for a url wins.
#              Nothing is ever rewritten except the superblock head.
#   FSApp    : mounted at /srv/disk. Owns the META side: the in-memory index
#              (rebuilt by one boot-time log scan), ls/stat of the directory,
#              page ALLOCATION (Alloc/Commit -- the single-writer discipline
#              that keeps append-only sound), and DISCOVERY: a Cat/Write/Del
#              on /srv/disk/<name> lazily spawns the URActor for that url
#              and forwards -- with the ORIGINAL replyTo, vfs-style, so the
#              URActor answers the client directly.
#   URActor  : owns one url. A "file" is a LOGICAL thing it reconstructs
#              from pages via the HAL. Two read strategies, both live:
#                cat  -> ask FSApp's index (FLookup), read exactly the
#                        payload pages (they are page-aligned: no math)
#                stat -> STREAM the whole log: read a page, parse the
#                        header, keep it if the url matches, DROP it and
#                        skip ahead if not -- the no-index fallback.
#              Writes append directly: FAlloc pages from FSApp, blkWrite
#              header + payload chunks, FCommit. Del appends a tombstone.
#   boots    : persistent MVU in miniature, mounted at /srv/boots. Model =
#              boot count; init = replay (cat its url through the
#              namespace); update = write-through append. Reboot on the
#              same disk.img and watch it climb. A persistent stax would
#              save its Model through exactly this path.
#
#   make disk.img && make run-disk PROG=programs/diskfs.fpr
#   try: write /srv/disk/note the machine remembers now
#        cat /srv/disk/note ; stat /srv/disk/note ; ls /srv/disk
#        rm /srv/disk/note ; cat /srv/boots/count ; exit -- then boot again

# ---- protocol ---------------------------------------------------------

Req = Type (Ls Int | Cat Int | Stat Int | Write Int Int | Del Int | Mount Int Int).

# FSApp-internal traffic from URActors (index lookups + page allocation)
FMsg = Type (FLookup Int | FHead Int | FAlloc Int | FCommit Int Int Int Int Int).

# an index entry: url, start page, total pages (incl header), payload
# bytes, alive (0 = latest record is a tombstone)
Ent = Type (Ent Int Int Int Int Int).

# messages to the terminal
TMsg = Type (Line Int | Notice Int).

# ---- the namespace tree ------------------------------------------------

Node = Type (FNode Int | DNode Int | MNode Int).
Res = Type (RFound Int | RMount Int Int | RErr Int).

# ---- tiny console over raw MMIO (registers passed in, never remade) ----

isOdd v = Int.mod v 2 == 1.

putc con c =
  (lsr, dat) = con;
  putcW lsr dat c.
putcW lsr dat c = putcV lsr dat c (read lsr).
putcV lsr dat c v =
  case isOdd (v / 32) of
    True -> write dat c
  | False -> putcW lsr dat c.

puts con s = putsFrom con s 1 (strlen s).
putsFrom con s i n =
  case i > n of
    True -> Unit
  | False -> putc con (charAt s i) >> putsFrom con s (i + 1) n.

nl con = putc con 13 >> putc con 10.
putLn con s = puts con s >> nl con.

getc me con =
  (lsr, dat) = con;
  getcW me lsr dat.
getcW me lsr dat = getcV me lsr dat (read lsr).
getcV me lsr dat v =
  case isOdd v of
    True -> read dat
  | False -> yield me >> getcW me lsr dat.

# ---- string / list / int utilities --------------------------------------

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.

revGo xs acc = case xs of Nil -> acc | x :: r -> revGo r (x :: acc).
revList xs = revGo xs Nil.

strInit s = strTakeGo s 1 (strlen s - 1) "".
strTakeGo s i n acc =
  case i > n of
    True -> acc
  | False -> strTakeGo s (i + 1) n (strcat acc (chr (charAt s i))).

split c s = splitGo c s 1 (strlen s) "" Nil.
splitGo c s i n cur acc =
  case i > n of
    True -> revList (pushTok cur acc)
  | False -> splitCh c s i n cur acc (charAt s i).
splitCh c s i n cur acc ch =
  case ch == c of
    True -> splitGo c s (i + 1) n "" (pushTok cur acc)
  | False -> splitGo c s (i + 1) n (strcat cur (chr ch)) acc.
pushTok cur acc = case cur == "" of True -> acc | False -> cur :: acc.

joinSp xs = case xs of Nil -> "" | x :: r -> joinGo x r.
joinGo acc r = case r of Nil -> acc | x :: rest -> joinGo (strcat acc (strcat " " x)) rest.

minI a b = case a < b of True -> a | False -> b.
ceilDiv a b = (a + b - 1) / b.

# parse a leading decimal number; anything else ends it (0 on none)
parseNum w = pnGo w 1 (strlen w) 0.
pnGo w i n acc = case i > n of True -> acc | False -> pnCh w i n acc (charAt w i).
pnCh w i n acc c =
  case and2 (c >= 48) (c <= 57) of
    True -> pnGo w (i + 1) n (acc * 10 + (c - 48))
  | False -> acc.

# take one word from s starting at i: ends at space or any control byte
# (a blkRead page is zero-padded, so NUL terminates the last word too).
# Returns (word, index just past the delimiter).
takeWord s i n acc =
  case i > n of
    True -> (acc, i)
  | False -> twCh s i n acc (charAt s i).
twCh s i n acc c =
  case or2 (c == 32) (c < 32) of
    True -> (acc, i + 1)
  | False -> takeWord s (i + 1) n (strcat acc (chr c)).

# ---- paths ---------------------------------------------------------------

normGo stack segs =
  case segs of
    Nil -> revList stack
  | seg :: rest -> normSeg stack rest seg.
normSeg stack rest seg =
  case seg of
    "." -> normGo stack rest
  | ".." -> normGo (dropTop stack) rest
  | _ -> normGo (seg :: stack) rest.
dropTop st = case st of Nil -> Nil | _ :: r -> r.

absPath cwd s =
  case strlen s == 0 of
    True -> cwd
  | False -> absPath1 cwd s.
absPath1 cwd s =
  case charAt s 1 == 47 of
    True -> normGo Nil (split 47 s)
  | False -> normGo (revList cwd) (split 47 s).

renderPath p = case p of Nil -> "/" | _ -> renderGo p "".
renderGo p acc =
  case p of
    Nil -> acc
  | s :: r -> renderGo r (strcat acc (strcat "/" s)).

# ---- VFS resolution ------------------------------------------------------

lookupE name entries =
  case entries of
    Nil -> Err "no such entry"
  | (len, lnode) :: lrest -> lookupHit name lnode lrest (len == name).
lookupHit name node rest hit =
  case hit of
    True -> Ok node
  | False -> lookupE name rest.

resolve node path =
  case node of
    MNode h -> RMount h path
  | FNode c -> resolveFile c path
  | DNode es -> resolveDir es path.
resolveFile c path =
  case path of
    Nil -> RFound (FNode c)
  | _ -> RErr "not a directory".
resolveDir es path =
  case path of
    Nil -> RFound (DNode es)
  | seg :: rest -> resolveChild seg rest es.
resolveChild seg rest es =
  case lookupE seg es of
    Ok child -> resolve child rest
  | Err _ -> RErr "no such path".

reqPath r = case r of Ls p -> p | Cat p -> p | Stat p -> p | Write p _ -> p | Del p -> p | _ -> Nil.
reqWith r p = case r of Ls _ -> Ls p | Cat _ -> Cat p | Stat _ -> Stat p | Write _ c -> Write p c | Del _ -> Del p | _ -> r.

# local answers (never sees MNode: resolve already peeled those off)
answer req node =
  case req of
    Ls _ -> answerLs node
  | Cat _ -> answerCat node
  | Stat _ -> answerStat node
  | Write _ _ -> Err "read-only (writes land on live mounts: try /srv/disk/<name>)"
  | Del _ -> Err "read-only (deletes land on live mounts: try /srv/disk/<name>)"
  | _ -> Err "unsupported".
answerLs node =
  case node of
    DNode es -> Ok (decorate es)
  | _ -> Err "not a directory".
decorate es =
  case es of
    Nil -> Nil
  | (den, denode) :: derest -> decor1 den denode :: decorate derest.
decor1 n node =
  case node of
    DNode _ -> strcat n "/"
  | MNode _ -> strcat n "@"
  | FNode _ -> n.
answerCat node = case node of FNode c -> Ok c | _ -> Err "is a directory".
answerStat node = case node of FNode _ -> Ok "file" | _ -> Ok "dir".

# ---- dynamic mounts: /srv ------------------------------------------------

mountAt tree name h =
  case tree of
    DNode ents -> DNode (graftSrv ents name h)
  | _ -> tree.
graftSrv ents name h =
  case ents of
    Nil -> Nil
  | (grn, grnode) :: grrest -> graftHit grn grnode grrest name h (grn == "srv").
graftHit n node rest name h hit =
  case hit of
    True -> (n, srvAdd node name h) :: rest
  | False -> (n, node) :: graftSrv rest name h.
srvAdd node name h = case node of DNode es -> DNode ((name, MNode h) :: es) | _ -> node.

# ---- the VFS actor (unchanged from vfsh2: non-blocking forwards) ----------

vfs tree me = vfsLoop me tree.
vfsLoop me tree =
  m = receive me;
  case m of
    (replyTo, req) -> vfsHandle me tree replyTo req m
  | _ -> vfsLoop me tree.
vfsHandle me tree replyTo req m =
  _ = drop m;
  case req of
    Mount name h -> send replyTo (Ok "mounted at /srv/{name}") >> vfsLoop me (mountAt tree name h)
  | _ -> vfsDispatch replyTo req (resolve tree (reqPath req)) >> vfsLoop me tree.
vfsDispatch replyTo req res =
  case res of
    RFound node -> send replyTo (answer req node)
  | RErr msg -> send replyTo (Err msg)
  | RMount h rest -> send h (replyTo, reqWith req rest).

rpc me v req = send v (me, req) >> receiveRes me.

# ---- /dev/term (unchanged) -------------------------------------------------

termSrv term me = tsLoop term me.
tsLoop term me =
  m = receive me;
  case m of
    (replyTo, req) -> tsServe term replyTo req >> drop m >> tsLoop term me
  | _ -> tsLoop term me.
tsServe term replyTo req =
  case req of
    Write p s -> tsWrite term replyTo p s
  | Ls p -> send replyTo (Err "not a directory")
  | Cat p -> send replyTo (tsCat p)
  | Stat p -> send replyTo (Ok "file")
  | _ -> send replyTo (Err "unsupported").
tsWrite term replyTo p s =
  case p of
    Nil -> send replyTo (Ok "delivered to actor 0") >> send term (Notice s)
  | _ -> send replyTo (Err "not a directory").
tsCat p =
  case p of
    Nil -> Ok "the terminal. write here and the text becomes a Notice message to actor 0"
  | _ -> Err "not a directory".

# ---- /proc (unchanged) ------------------------------------------------------

procApp mt me = procLoop mt me.
procLoop mt me =
  m = receive me;
  case m of
    (replyTo, req) -> send replyTo (procAnswer mt req) >> drop m >> procLoop mt me
  | _ -> procLoop mt me.
procAnswer mt req =
  case req of
    Ls p -> procLs p
  | Cat p -> procCat mt p
  | Stat p -> procStat p
  | _ -> Err "read-only".
procLs p = case p of Nil -> Ok ["uptime", "arc", "heap", "fuel"] | _ -> Err "not a directory".
procCat mt p =
  case p of
    "uptime" :: Nil -> Ok "mtime = {read mt} ticks"
  | "arc" :: Nil -> Ok "arc live objects: {arcLive 0}"
  | "heap" :: Nil -> Ok "heap claimed: {heapUsed 0} bytes"
  | "fuel" :: Nil -> Ok "quantum {fuelQuantum 0} calls/slice; preemptions so far: {fuelPreempts 0}"
  | Nil -> Err "is a directory"
  | _ -> Err "no such file".
procStat p =
  case p of
    Nil -> Ok "dir"
  | _ :: Nil -> Ok "file"
  | _ -> Err "no such path".

# ==== THE LOG FORMAT =========================================================
# superblock (page 0):  "QLOG <head>"            head = next free page
# record (page-aligned): header page then whole payload pages
#   header line:        "QREC <npages> <paylen> <url>"   live record
#                       "QDEL 1 0 <url>"                 tombstone
# Everything textual, newline-terminated, zero-padded to the page: a
# hexdump of disk.img reads like a story, and the parser is takeWord.
# Recency = position: later record for the same url shadows the earlier.

lf = chr 10.

hdrLine tag np pl url = strcat "{tag} {np} {pl} {url}" (lf).
sbLine head = strcat "QLOG {head}" (lf).

# parse a record header page -> Ok (Ent url 0 npages paylen alive) | Err
parseHdr s =
  n = strlen s;
  (m, i1) = takeWord s 1 n "";
  parseHdr2 s n i1 m.
parseHdr2 s n i1 m =
  case m of
    "QREC" -> parseBody s n i1 1
  | "QDEL" -> parseBody s n i1 0
  | _ -> Err "not a record".
parseBody s n i al =
  (w1, i2) = takeWord s i n "";
  (w2, i3) = takeWord s i2 n "";
  (u, i4) = takeWord s i3 n "";
  Ok (Ent u 0 (parseNum w1) (parseNum w2) al).

# parse the superblock -> Ok head | Err
sbParse s =
  n = strlen s;
  (m, i1) = takeWord s 1 n "";
  sbParse2 s n i1 m.
sbParse2 s n i1 m =
  case m of
    "QLOG" -> sbHead s n i1
  | _ -> Err "unformatted".
sbHead s n i =
  (w, j) = takeWord s i n "";
  Ok (parseNum w).

# ---- index: latest entry per url, alive flag included ----------------------

idxPut idx e = case e of Ent u a b c d -> idxGo idx u e Nil.
idxGo rest u e seen =
  case rest of
    Nil -> revGo seen (e :: Nil)
  | x :: r -> idxStep x r u e seen.
idxStep x r u e seen = case x of Ent xu a b c d -> idxStep2 x r u e seen (xu == u).
idxStep2 x r u e seen hit =
  case hit of
    True -> revGo seen (e :: r)
  | False -> idxGo r u e (x :: seen).

idxFind idx u =
  case idx of
    Nil -> Err "no such file"
  | e :: r -> idxFind1 e r u.
idxFind1 e r u = case e of Ent eu st np pl al -> idxFind2 e r u al (eu == u).
idxFind2 e r u al hit =
  case hit of
    True -> idxAlive e al
  | False -> idxFind r u.
idxAlive e al = case al == 1 of True -> Ok e | False -> Err "no such file".

idxNames idx = case idx of Nil -> Nil | e :: r -> idxName1 e r.
idxName1 e r = case e of Ent u st np pl al -> idxName2 u r al.
idxName2 u r al = case al == 1 of True -> u :: idxNames r | False -> idxNames r.

idxCount idx = case idx of Nil -> 0 | e :: r -> idxCount1 e r.
idxCount1 e r = case e of Ent u st np pl al -> al + idxCount r.

# ---- the boot-time log scan: FSApp rebuilding its index from disk ----------
# One pass, header pages only: parse, record the LATEST entry per url,
# leap over payload pages. A page that parses as neither QREC nor QDEL is
# skipped one page at a time (an orphan from a crash between Alloc and
# Commit -- see the caveat at fsAlloc).

scanLog dev head p idx =
  case p >= head of
    True -> idx
  | False -> scanPage dev head p idx (blkRead dev p).
scanPage dev head p idx s = scanRec dev head p idx s (parseHdr s).
scanRec dev head p idx s h =
  _ = drop s;
  case h of
    Ok (Ent u z np pl al) -> scanLog dev head (p + np) (idxPut idx (Ent u p np pl al))
  | Err _ -> scanLog dev head (p + 1) idx.

# ---- streaming find: the NO-INDEX read strategy -----------------------------
# What a URActor does when it can't (or won't) ask for an index: stream
# every record header into memory, keep the ones whose url matches,
# DROP the page and leap the payload when it doesn't. Records are
# page-aligned so "leap" is exact arithmetic, no byte offsets. Returns
# the LAST match (Ok (Ent url start np pl alive)) or Err.

streamFind dev head url = sfGo dev head url 1 (Err "no such file").
sfGo dev head url p best =
  case p >= head of
    True -> best
  | False -> sfPage dev head url p best (blkRead dev p).
sfPage dev head url p best s = sfRec dev head url p best s (parseHdr s).
sfRec dev head url p best s h =
  _ = drop s;
  case h of
    Ok (Ent u z np pl al) -> sfHit dev head url p best (Ent u p np pl al) (u == url)
  | Err _ -> sfGo dev head url (p + 1) best.
sfHit dev head url p best e hit =
  case hit of
    True -> sfNext dev head url p (Ok e) e
  | False -> sfNext dev head url p best e.
sfNext dev head url p best e =
  case e of
    Ent u st np pl al -> sfGo dev head url (p + np) best.

# ---- payload movement: whole pages, exact prefixes --------------------------
# Payload pages are page-aligned (record layout guarantees it), so a read
# is: page in, take the used prefix, drop, next. substr does the prefix.

readPay dev p remaining acc =
  case remaining == 0 of
    True -> acc
  | False -> readPay2 dev p remaining acc (blkRead dev p).
readPay2 dev p remaining acc s =
  k = minI remaining 4096;
  chunk = substr s 1 k;
  _ = drop s;
  readPay dev (p + 1) (remaining - k) (strcat acc chunk).

writePay dev p s i pl =
  case i > pl of
    True -> Unit
  | False -> writePay2 dev p s i pl.
writePay2 dev p s i pl =
  k = minI (pl - i + 1) 4096;
  _ = blkWrite dev p (substr s i k);
  writePay dev (p + 1) s (i + k) pl.

# ==== FSApp: meta + discovery + allocation ==================================
# State threaded through the loop: dev, head (next free page), idx (the
# in-memory index), kids ((url, actor) assoc -- the lazy-spawn cache).
#
# Discovery: a data request on /srv/disk/<name> spawns the URActor for
# <name> on FIRST touch and forwards (replyTo passes through: the URActor
# answers the client directly, FSApp never blocks -- the vfs discipline
# again, one level down).
#
# Allocation: FAlloc n bumps head in memory and hands the range out;
# FCommit updates the index and persists the superblock. head is only
# persisted at commit, so a crash mid-write leaves the OLD head on disk
# and the orphan pages get overwritten by the next writer. Caveat: with
# MULTIPLE writers in flight, commits must land in alloc order for the
# scan to stay clean -- fine on this one-hart PoC, the multi-writer story
# is a WAL sequence number in the header (one more takeWord).

fsApp v dev me =
  r = rpc me v (Mount "disk" me);
  _ = drop r;
  fsBoot dev me.
fsBoot dev me =
  s0 = blkRead dev 0;
  fsBoot2 dev me s0 (sbParse s0).
fsBoot2 dev me s0 r =
  _ = drop s0;
  case r of
    Ok head -> fsLoop me ((dev, head), (scanLog dev head 1 Nil, Nil))
  | Err _ -> fsFormat dev me.
fsFormat dev me =
  _ = blkWrite dev 0 (sbLine 1);
  fsLoop me ((dev, 1), (Nil, Nil)).

# state stt = ((dev, head), (idx, kids)) -- packed to stay under the
# PoC ABI's 8-argument ceiling; unpack where needed, repack on change.
fsLoop me stt =
  m = receive me;
  case m of
    (replyTo, req) -> fsHandle me stt replyTo req m
  | _ -> fsLoop me stt.
fsHandle me stt replyTo req m =
  _ = drop m;
  (dh, ik) = stt;
  (dev, head) = dh;
  (idx, kids) = ik;
  case req of
    FLookup u -> send replyTo (idxFind idx u) >> fsLoop me stt
  | FHead z -> send replyTo (Ok head) >> fsLoop me stt
  | FAlloc n -> send replyTo (Ok head) >> fsLoop me ((dev, head + n), ik)
  | FCommit u st np pl al -> fsCommit me stt replyTo (Ent u st np pl al)
  | Ls p -> send replyTo (fsLs idx p) >> fsLoop me stt
  | Stat p -> fsStat me stt replyTo p
  | Mount a b -> send replyTo (Err "not a mount point") >> fsLoop me stt
  | _ -> fsFwd me stt replyTo req.

fsCommit me stt replyTo e =
  (dh, ik) = stt;
  (dev, head) = dh;
  (idx, kids) = ik;
  _ = blkWrite dev 0 (sbLine head);
  _ = send replyTo (Ok "committed");
  fsLoop me (dh, (idxPut idx e, kids)).

fsLs idx p =
  case p of
    Nil -> Ok (idxNames idx)
  | _ :: Nil -> Err "not a directory"
  | _ -> Err "no such path".

# dir-level stat is META and answered here; FILE-level stat is forwarded
# to the URActor, whose answer is the streaming-scan demo.
fsStat me stt replyTo p =
  case p of
    Nil -> fsStatDir me stt replyTo
  | _ -> fsFwd me stt replyTo (Stat p).
fsStatDir me stt replyTo =
  (dh, ik) = stt;
  (dev, head) = dh;
  (idx, kids) = ik;
  _ = send replyTo (Ok "dir  {idxCount idx} live urls, log head at page {head} of {blkPages dev}");
  fsLoop me stt.

fsFwd me stt replyTo req =
  case reqPath req of
    name :: Nil -> fsKid me stt replyTo req name
  | Nil -> send replyTo (Err "is a directory") >> fsLoop me stt
  | _ -> send replyTo (Err "no such path") >> fsLoop me stt.
fsKid me stt replyTo req name =
  (dh, ik) = stt;
  (idx, kids) = ik;
  case kidFind kids name of
    Ok h -> send h (replyTo, reqWith req Nil) >> fsLoop me stt
  | Err _ -> fsSpawn me stt replyTo req name.
fsSpawn me stt replyTo req name =
  (dh, ik) = stt;
  (dev, head) = dh;
  (idx, kids) = ik;
  h = spawn (urActor me dev name);
  _ = send h (replyTo, reqWith req Nil);
  fsLoop me (dh, (idx, (name, h) :: kids)).

kidFind kids name =
  case kids of
    Nil -> Err "not spawned"
  | (kn, kh) :: kr -> kidHit kh kr name (kn == name).
kidHit kh kr name hit =
  case hit of
    True -> Ok kh
  | False -> kidFind kr name.

# ==== URActor: owns one url, moves the actual bytes =========================
# Spawned lazily by FSApp, lives forever after (kids cache). All disk
# traffic is HAL pages; all interpretation of those pages happens here.

urActor fs dev url me = urLoop fs dev url me.
urLoop fs dev url me =
  m = receive me;
  case m of
    (replyTo, req) -> urHandle fs dev url me replyTo req m
  | _ -> urLoop fs dev url me.
urHandle fs dev url me replyTo req m =
  _ = drop m;
  case req of
    Cat _ -> urCat fs dev url me replyTo
  | Stat _ -> urStat fs dev url me replyTo
  | Write _ s -> urWrite fs dev url me replyTo s
  | Del _ -> urDel fs dev url me replyTo
  | Ls _ -> send replyTo (Err "not a directory") >> urLoop fs dev url me
  | _ -> send replyTo (Err "unsupported") >> urLoop fs dev url me.

# cat: the INDEXED read. Ask FSApp where the latest record lives, then
# read exactly its payload pages -- page-aligned, so no offset juggling.
urCat fs dev url me replyTo =
  r = rpc me fs (FLookup url);
  urCat2 fs dev url me replyTo r.
urCat2 fs dev url me replyTo r =
  case r of
    Ok (Ent u st np pl al) -> drop r >> urCatRead fs dev url me replyTo st pl
  | Err e -> send replyTo (Err e) >> drop r >> urLoop fs dev url me.
urCatRead fs dev url me replyTo st pl =
  _ = send replyTo (Ok (readPay dev (st + 1) pl ""));
  urLoop fs dev url me.

# stat: the STREAMING read. Deliberately ignores the index: scans the
# whole log page by page, filtering for this url, dropping misses --
# and says so, so you can see both strategies answer from the shell.
urStat fs dev url me replyTo =
  hr = rpc me fs (FHead 0);
  urStat2 fs dev url me replyTo hr.
urStat2 fs dev url me replyTo hr =
  case hr of
    Ok head -> drop hr >> urStat3 fs dev url me replyTo (streamFind dev head url)
  | Err e -> send replyTo (Err e) >> drop hr >> urLoop fs dev url me.
urStat3 fs dev url me replyTo b =
  _ = send replyTo (statAnswer b);
  urLoop fs dev url me.
statAnswer b =
  case b of
    Ok (Ent u st np pl al) -> statAlive u st np pl al
  | Err e -> Err e.
statAlive u st np pl al =
  case al == 1 of
    True -> Ok "file  {pl} bytes  record @ page {st} ({np} pages)  [found by streaming log scan, no index]"
  | False -> Err "no such file (latest record is a tombstone)".

# write: append directly. FAlloc reserves the page range, blkWrite lays
# down header + payload chunks, FCommit publishes it (index + superblock).
# npages is recomputed from paylen where needed rather than threaded --
# the PoC ABI caps arity at 8 and these chains are at the ceiling.
recNp pl = 1 + ceilDiv pl 4096.

urWrite fs dev url me replyTo s =
  pl = strlen s;
  a = rpc me fs (FAlloc (recNp pl));
  urWrite2 fs dev url me replyTo s pl a.
urWrite2 fs dev url me replyTo s pl a =
  case a of
    Ok st -> drop a >> urWrite3 fs dev url me replyTo s pl st
  | Err e -> send replyTo (Err e) >> drop a >> urLoop fs dev url me.
urWrite3 fs dev url me replyTo s pl st =
  np = recNp pl;
  _ = blkWrite dev st (hdrLine "QREC" np pl url);
  _ = writePay dev (st + 1) s 1 pl;
  c = rpc me fs (FCommit url st np pl 1);
  _ = drop c;
  _ = send replyTo (Ok "appended {pl} bytes as record @ page {st} ({np} pages)");
  urLoop fs dev url me.

# del: an append too -- a one-page tombstone. Nothing is erased; the
# index just stops resolving the url. (The HAL would let anyone blkWrite
# over history directly; nobody up here ever does.)
urDel fs dev url me replyTo =
  a = rpc me fs (FAlloc 1);
  urDel2 fs dev url me replyTo a.
urDel2 fs dev url me replyTo a =
  case a of
    Ok st -> drop a >> urDel3 fs dev url me replyTo st
  | Err e -> send replyTo (Err e) >> drop a >> urLoop fs dev url me.
urDel3 fs dev url me replyTo st =
  _ = blkWrite dev st (hdrLine "QDEL" 1 0 url);
  c = rpc me fs (FCommit url st 1 0 0);
  _ = drop c;
  _ = send replyTo (Ok "tombstone appended @ page {st}");
  urLoop fs dev url me.

# ==== /srv/boots: persistent MVU in miniature ===============================
# Model = boot count. init = REPLAY: cat the url through the namespace
# (vfs -> FSApp -> lazily spawned URActor -> indexed page read); missing
# file = model 0. update = WRITE-THROUGH: append the new model before
# serving. The whole persistence story of the stax web-app VM is this
# shape: Model out through a URActor on update, Model back by replay at
# boot. Retries until /srv/disk is mounted (boot-order independence).

bootsApp v me = bootsTry v me.
bootsTry v me =
  r = rpc me v (Cat ("srv" :: "disk" :: "boots" :: Nil));
  bootsDecide v me r.
bootsDecide v me r =
  case r of
    Ok s -> bootsInit v me (parseNum s) r
  | Err "no such file" -> bootsInit v me 0 r
  | Err _ -> drop r >> yield me >> bootsTry v me.
bootsInit v me n r =
  _ = drop r;
  w = rpc me v (Write ("srv" :: "disk" :: "boots" :: Nil) "{n + 1}");
  _ = drop w;
  m2 = rpc me v (Mount "boots" me);
  _ = drop m2;
  bootsLoop me (n + 1).
bootsLoop me n =
  m = receive me;
  case m of
    (replyTo, req) -> send replyTo (bootsAnswer n req) >> drop m >> bootsLoop me n
  | _ -> bootsLoop me n.
bootsAnswer n req =
  case req of
    Ls p -> bootsLs p
  | Cat p -> bootsCat n p
  | Stat p -> bootsStat p
  | _ -> Err "read-only (the model persists itself)".
bootsLs p = case p of Nil -> Ok ["count", "readme"] | _ -> Err "not a directory".
bootsCat n p =
  case p of
    "count" :: Nil -> Ok "{n}"
  | "readme" :: Nil -> Ok "persistent MVU: the count is Model, replayed from /srv/disk/boots at init, appended on update"
  | Nil -> Err "is a directory"
  | _ -> Err "no such file".
bootsStat p =
  case p of
    Nil -> Ok "dir"
  | _ :: Nil -> Ok "file"
  | _ -> Err "no such path".

# ---- the reader actor: UART RX + line editing (unchanged) -------------------

reader term con me = readLoop term con me "".
readLoop term con me buf = readCh term con me buf (getc me con).
readCh term con me buf c =
  case c of
    13 -> readEol term con me buf
  | 10 -> readEol term con me buf
  | 8 -> readBs term con me buf
  | 127 -> readBs term con me buf
  | _ -> readPr term con me buf c.
readEol term con me buf =
  _ = nl con;
  _ = send term (Line buf);
  readLoop term con me "".
readBs term con me buf =
  case strlen buf == 0 of
    True -> readLoop term con me buf
  | False -> putc con 8 >> putc con 32 >> putc con 8 >> readLoop term con me (strInit buf).
readPr term con me buf c =
  case c < 32 of
    True -> readLoop term con me buf
  | False -> putc con c >> readLoop term con me (strcat buf (chr c)).

# ---- the terminal: MVU app (actor 0), now with rm ---------------------------

termLoop me v con cwd =
  _ = puts con "qos:" >> puts con (renderPath cwd) >> puts con "$ ";
  termMsg me v con cwd (receive me).
termMsg me v con cwd m =
  case m of
    Line s -> termParse me v con cwd m (split 32 s)
  | Notice s -> termNotice me v con cwd m s
  | _ -> termLoop me v con cwd.
termNotice me v con cwd m s =
  _ = nl con;
  _ = putLn con "[term] {s}";
  _ = drop m;
  termLoop me v con cwd.
termParse me v con cwd m toks =
  _ = drop m;
  termExec me v con cwd toks.
termExec me v con cwd toks =
  case toks of
    Nil -> termLoop me v con cwd
  | cmd :: args -> termCmd me v con cwd cmd args.
termCmd me v con cwd cmd args =
  case cmd of
    "help" -> doHelp con >> termLoop me v con cwd
  | "pwd" -> putLn con (renderPath cwd) >> termLoop me v con cwd
  | "ls" -> doLs me v con cwd args
  | "cd" -> doCd me v con cwd args
  | "cat" -> doCat me v con cwd args
  | "stat" -> doStat me v con cwd args
  | "write" -> doWrite me v con cwd args
  | "rm" -> doRm me v con cwd args
  | "exit" -> putLn con "halting."
  | _ -> putLn con "{cmd}: unknown command   (try help)" >> termLoop me v con cwd.

doHelp con =
  putLn con "ls [p]   cd [p]   cat p   stat p   write p text...   rm p   pwd   exit"
    >> putLn con "the disk log is mounted at /srv/disk@ -- cat reads by index,"
    >> putLn con "stat streams the whole log, write/rm append (nothing rewrites)"
    >> putLn con "try: write /srv/disk/note it persists ; cat /srv/disk/note"
    >> putLn con "     stat /srv/disk/note ; ls /srv/disk ; stat /srv/disk"
    >> putLn con "     rm /srv/disk/note ; cat /srv/boots/count -- then reboot".

argPath cwd args = case args of Nil -> cwd | a :: _ -> absPath cwd a.

doLs me v con cwd args =
  r = rpc me v (Ls (argPath cwd args));
  renderLs con r >> drop r >> termLoop me v con cwd.
renderLs con r =
  case r of
    Ok entries -> lsPrint con entries
  | Err m -> putLn con "ls: {m}".
lsPrint con es = case es of Nil -> Unit | e :: rest -> putLn con e >> lsPrint con rest.

doCat me v con cwd args =
  case args of
    Nil -> putLn con "cat: missing operand" >> termLoop me v con cwd
  | a :: _ -> doCat1 me v con cwd a.
doCat1 me v con cwd a =
  r = rpc me v (Cat (absPath cwd a));
  renderCat con r >> drop r >> termLoop me v con cwd.
renderCat con r = case r of Ok c -> putLn con c | Err m -> putLn con "cat: {m}".

doStat me v con cwd args =
  case args of
    Nil -> putLn con "stat: missing operand" >> termLoop me v con cwd
  | a :: _ -> doStat1 me v con cwd a.
doStat1 me v con cwd a =
  r = rpc me v (Stat (absPath cwd a));
  renderStat con r >> drop r >> termLoop me v con cwd.
renderStat con r = case r of Ok k -> putLn con k | Err m -> putLn con "stat: {m}".

doWrite me v con cwd args =
  case args of
    Nil -> putLn con "write: usage: write <path> <text...>" >> termLoop me v con cwd
  | p :: rest -> doWrite1 me v con cwd p rest.
doWrite1 me v con cwd p rest =
  r = rpc me v (Write (absPath cwd p) (joinSp rest));
  renderWrite con r >> drop r >> termLoop me v con cwd.
renderWrite con r = case r of Ok s -> putLn con s | Err m -> putLn con "write: {m}".

doRm me v con cwd args =
  case args of
    Nil -> putLn con "rm: missing operand" >> termLoop me v con cwd
  | a :: _ -> doRm1 me v con cwd a.
doRm1 me v con cwd a =
  r = rpc me v (Del (absPath cwd a));
  renderRm con r >> drop r >> termLoop me v con cwd.
renderRm con r = case r of Ok s -> putLn con s | Err m -> putLn con "rm: {m}".

doCd me v con cwd args =
  case args of
    Nil -> termLoop me v con Nil
  | a :: _ -> doCd1 me v con cwd (absPath cwd a).
doCd1 me v con cwd p =
  r = rpc me v (Stat p);
  cdFinish me v con cwd p r.
cdFinish me v con cwd p r =
  case r of
    Ok "dir" -> drop r >> termLoop me v con p
  | Ok _ -> putLn con "cd: not a directory" >> drop r >> termLoop me v con cwd
  | Err m -> putLn con "cd: {m}" >> drop r >> termLoop me v con cwd.

# ---- boot: build the world, mount the disk, become the terminal -------------

buildTree proc tsrv =
  DNode
    [ ("etc", DNode
        [ ("motd", FNode "the namespace persists now: /srv/disk is an append-only page log"),
          ("hostname", FNode "qos-hub")
        ]),
      ("dev", DNode
        [ ("uart0", FNode "ns16550a @ 0x10000000"),
          ("blk0", FNode "virtio-blk: 4 KiB pages, whole-page read/write, no policy (see /srv/disk@ for the policy)"),
          ("term", MNode tsrv)
        ]),
      ("proc", MNode proc),
      ("srv", DNode Nil)
    ].

main =
  me = myself 0;
  u = device "uart";
  cl = device "clint";
  bd = device "blk";
  con = (reg8 u 5, reg8 u 0);
  mt = reg32 cl 49144;
  tsrv = spawn (termSrv me);
  proc = spawn (procApp mt);
  v = spawn (vfs (buildTree proc tsrv));
  _ = spawn (fsApp v bd);
  _ = spawn (bootsApp v);
  _ = spawn (reader me con);
  _ = nl con >> putLn con "qos diskfs -- append-only page log at /srv/disk, persistent MVU at /srv/boots";
  _ = putLn con "boot count survives reboots on the same disk.img: cat /srv/boots/count";
  _ = putLn con "type help for commands";
  termLoop me v con Nil.
