# ============================================================================
# system.fpr -- System.qa: the QOS bootstrap process, the .qa launcher with
#               static permission flow, and the shipped apps, all co-compiled
#               into one image (the name-dispatch era -- docs/QA-FORMAT.md).
#
# Boot flow (mirrors the request):
#   crt0 -> fpr_rt_init sets up the clean HAL -> fpr_fn_main (this file's
#   `main`, actor 0) IS System.qa. It reads its own config to find the
#   startup app id, then LAUNCHES it through the permission flow. That app
#   is TUIAppLauncher, which is "just another app": it uses only the
#   URL-addressed services System.qa hands it (keyboard/display/clock/apps),
#   never touching lower-level code.
#
#   System.qa (main, actor 0)
#     |  owns: the service router (URL -> capability), the .qa loader,
#     |        the permission-grant UI, the FSProcess duties (/apps registry)
#     |  reader (actor) --Key--> System.qa    display writes go straight to UART
#     v
#   launch "TUIAppLauncher"  --perm flow-->  launcher_main caps
#     |                                         |  grid of app icons + header
#     v                                         v
#   pick "TUINotes" -> launch  --perm flow-->  tuinotes_main caps
#
# Services are URL strings; a capability is a granted (url, mode) the app
# may exercise through System.qa's `svc*` helpers. The app never sees a
# device register -- it says `svcReadKey caps` and `svcWriteLine caps s`.
# ============================================================================

# ---- console over raw MMIO (registers threaded, made once in main) ----------

isOdd v = Int.mod v 2 == 1.

putc con c =
  (lsr, dat) = con;
  putcW lsr dat c.
putcW lsr dat c = putcV lsr dat c (read lsr).
putcV lsr dat c v =
  case isOdd (v / 32) of
    True -> write dat c
  | False -> putcW lsr dat c.

puts con s = putsFrom con s 1 (strlen s).
putsFrom con s i n =
  case i > n of
    True -> Unit
  | False -> putc con (charAt s i) >> putsFrom con s (i + 1) n.

nl con = putc con 13 >> putc con 10.
putLn con s = puts con s >> nl con.

getc me con =
  (lsr, dat) = con;
  getcW me lsr dat.
getcW me lsr dat = getcV me lsr dat (read lsr).
getcV me lsr dat v =
  case isOdd v of
    True -> read dat
  | False -> yield me >> getcW me lsr dat.

# ---- runtime-resolvable modules --------------------------------------------
# Modules System.qa is willing to resolve BY URL at runtime.  The alias
# evaluates to the hash string, so "{TimeFmt}/pad2" is a complete
# mod-service URL; the app that asks for it never links the module's
# name, only the (hash, fn) identity -- the FPRLive wire shape.
TimeFmt = use "mods/timefmt#48c8226ba0480e57".
QLog    = use "mods/qlog#9c8b89e0dd258d0e".
MK      = use "mods/matrixkpd".
TUI     = use "mods/tui#dd2f2f35bad3f6bb".

# ---- small prelude ----------------------------------------------------------

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
not1 b = case b of True -> False | False -> True.

append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.
len xs = case xs of Nil -> 0 | _ :: t -> 1 + len t.
revGo xs acc = case xs of Nil -> acc | x :: r -> revGo r (x :: acc).
rev xs = revGo xs Nil.
nth xs i = case xs of Nil -> Err "nth" | x :: r -> case i <= 1 of True -> Ok x | False -> nth r (i - 1).

# ---- string helpers ---------------------------------------------------------

# byte value of char i (1-indexed); 0 if out of range
byteAt s i = case or2 (i < 1) (i > strlen s) of True -> 0 | False -> charAt s i.

strEqGo a b i n =
  case i > n of
    True -> True
  | False -> case charAt a i == charAt b i of
      True -> strEqGo a b (i + 1) n
    | False -> False.
strEq a b = case strlen a == strlen b of
    True -> strEqGo a b 1 (strlen a)
  | False -> False.

# substring s[i..j] inclusive, 1-indexed -- ON the O(1) runtime prim
# (`substr s off len`).  The old FPRISC-level subGo copied char by char:
# quadratic, one allocation per byte, and it SHADOWED the prim -- the
# exact trap docs/PROCESS-LOADING.md recorded for ELF payloads.
slice s i j = substr s i (j - i + 1).

isSpace c = or2 (c == 32) (c == 9).
isNL c = or2 (c == 13) (c == 10).

# index of first byte b at/after i; 0 if none
findByte s b i =
  case i > strlen s of
    True -> 0
  | False -> case charAt s i == b of
      True -> i
    | False -> findByte s b (i + 1).

# trim leading/trailing spaces
ltrim s i = case and2 (i <= strlen s) (isSpace (byteAt s i)) of True -> ltrim s (i + 1) | False -> i.
rtrim s j = case and2 (j >= 1) (isSpace (byteAt s j)) of True -> rtrim s (j - 1) | False -> j.
trim s = slice s (ltrim s 1) (rtrim s (strlen s)).

# strip a leading/trailing double-quote pair if present
unquote s =
  n = strlen s;
  case and2 (n >= 2) (and2 (byteAt s 1 == 34) (byteAt s n == 34)) of
    True -> slice s 2 (n - 1)
  | False -> s.

# ============================================================================
# THE .qa PARSER -- section table + manifest (a minimal TOML subset)
# ============================================================================

# A .qa is:  "QAR1\n" <table lines> "\n" <payloads>
# We only need the MANIFEST payload. Parse the table to (off,len), then
# slice. Offsets in the table are relative to the first payload byte.

# find the byte index just past the "\n\n" that ends the table
tableEnd s i =
  case i >= strlen s of
    True -> strlen s
  | False -> case and2 (byteAt s i == 10) (byteAt s (i + 1) == 10) of
      True -> i                              # index of the FIRST \n of the pair
    | False -> tableEnd s (i + 1).

# split a whitespace token starting at i: returns (token, nextIndex)
tokAt s i =
  st = ltrim s i;
  en = tokEnd s st;
  (slice s st (en - 1), en).
tokEnd s i =
  case or2 (i > strlen s) (or2 (isSpace (byteAt s i)) (isNL (byteAt s i))) of
    True -> i
  | False -> tokEnd s (i + 1).

# parse int from a token string
toInt s = toIntGo s 1 (strlen s) 0.
toIntGo s i n acc =
  case i > n of
    True -> acc
  | False -> toIntGo s (i + 1) n (acc * 10 + (charAt s i - 48)).

# scan table lines for section NAME; return Ok (off,len) | Err
# tstart = first char after "QAR1\n"; tend = index of blank-line's first \n
findSection s name tstart tend =
  case tstart >= tend of
    True -> Err "no such section"
  | False -> findSecLine s name tstart tend (tokAt s tstart).
findSecLine s name tstart tend t0 =
  case t0 of (nm, a1) ->
    case tokAt s a1 of (offS, a2) ->
      case tokAt s a2 of (lenS, a3) ->
        case strEq nm name of
          True -> Ok (toInt offS, toInt lenS)
        | False -> findSection s name (lineNext s a3) tend.
lineNext s i = case or2 (i > strlen s) (byteAt s i == 10) of True -> i + 1 | False -> lineNext s (i + 1).

# the MANIFEST bytes of a .qa string
manifestOf qa =
  blank = tableEnd qa 1;                # 1-indexed pos of 1st \n in "\n\n"
  payload0 = blank + 2;                 # first payload byte (skip both \n)
  tstart = 6;                           # just past "QAR1\n" (5 bytes) -> byte 6
  case findSection qa "MANIFEST" tstart blank of
    Err e -> Err e
  | Ok r -> case r of (off, ln) ->
      Ok (slice qa (payload0 + off) (payload0 + off + ln - 1)).

# ---- manifest (line-oriented mini-TOML) ------------------------------------
# We fold the manifest into: (id, entry, requiredPerms, optionalPerms)
# where a perm is (url, mode). Section state is carried as an Int:
#   0 = top level, 1 = [permissions.required], 2 = [permissions.optional]

# split manifest text into lines (list of strings)
lines s = linesGo s 1 (strlen s) "" Nil.
linesGo s i n cur acc =
  case i > n of
    True -> rev (case strlen cur == 0 of True -> acc | False -> cur :: acc)
  | False -> case charAt s i == 10 of
      True -> linesGo s (i + 1) n "" (cur :: acc)
    | False -> case charAt s i == 13 of
        True -> linesGo s (i + 1) n cur acc
      | False -> linesGo s (i + 1) n (strcat cur (chr (charAt s i))) acc.

# classify one line under section state st; return (newState, action)
# action: TopKV key val | PermKV url mode | Ignore, folded directly below.

# is this line a [header]? return Ok headerText | Err
asHeader ln =
  t = trim ln;
  case and2 (strlen t >= 2) (and2 (byteAt t 1 == 91) (byteAt t (strlen t) == 93)) of
    True -> Ok (slice t 2 (strlen t - 1))
  | False -> Err "not header".

# split "key = value" -> Ok (trimmed key, unquoted trimmed value) | Err
asKV ln =
  eq = findByte ln 61 1;                # '='
  case eq == 0 of
    True -> Err "no ="
  | False -> Ok (unquote (trim (slice ln 1 (eq - 1))), unquote (trim (slice ln (eq + 1) (strlen ln)))).

# blank or comment: guard charAt behind the length check (or2 is strict)
isBlankOrComment t =
  case strlen t == 0 of
    True -> True
  | False -> charAt t 1 == 35.

# fold the manifest lines into a Manifest record. We accumulate:
#   id, entry (strings, "" until seen)
#   req, opt : lists of (url, mode) pairs (as Tup2 Strings)
foldMan lns = fmGo lns 0 "" "" "" Nil Nil.
fmGo lns st id entry mode req opt =
  case lns of
    Nil -> mkManifest id entry (rev req) (rev opt) mode
  | ln :: rest -> fmLine rest st id entry mode req opt (trim ln).
fmLine rest st id entry mode req opt t =
  case isBlankOrComment t of                              # blank or # comment
    True -> fmGo rest st id entry mode req opt
  | False -> case asHeader t of
      Ok h -> fmGo rest (headerState h) id entry mode req opt
    | Err _ -> case asKV t of
        Err _ -> fmGo rest st id entry mode req opt
      | Ok kv -> case kv of (k, v) ->
          case st of
            0 -> fmGo rest st (pickId id k v) (pickEntry entry k v) (pickMode mode k v) req opt
          | 1 -> fmGo rest st id entry mode ((k, v) :: req) opt
          | _ -> fmGo rest st id entry mode req ((k, v) :: opt).

headerState h =
  case strEq h "permissions.required" of
    True -> 1
  | False -> case strEq h "permissions.optional" of True -> 2 | False -> 0.

pickId cur k v = case strEq k "id" of True -> v | False -> cur.
pickEntry cur k v = case strEq k "entry" of True -> v | False -> cur.
# loadMode = "process" opts an app into REAL dynamic ELF loading
# (Sys.loadElfAt); anything else (or absent, the default) keeps the
# co-compiled name-dispatch path (Apps.entry/Apps.run).
pickMode cur k v = case strEq k "loadMode" of True -> v | False -> cur.

# a friendlier constructor name used above
mkManifest id entry req opt mode = (id, entry, req, opt, mode).

# parse a .qa string all the way to (id, entry, req, opt) | Err
parseQa qa =
  case manifestOf qa of
    Err e -> Err e
  | Ok man -> Ok (foldMan (lines man)).

# ============================================================================
# THE PERMISSION FLOW  (the compulsory static gate)
# ============================================================================

# render one permission prompt and read y/n. `caps` here is the console +
# reader actor needed for IO; the app-facing capability set is separate.
# Returns True (grant) / False (deny).
askPerm io url mode =
  (con, me, clk, st0) = io;
  _ = puts con "  grant ";
  _ = puts con url;
  _ = puts con " (";
  _ = puts con mode;
  _ = puts con ") ? [y/N] ";
  c = getc me con;
  _ = putc con c >> nl con;              # echo
  or2 (c == 121) (c == 89).              # 'y' or 'Y'

# ask every perm in a list; returns list of Bool (parallel to input)
askAll io perms =
  case perms of
    Nil -> Nil
  | p :: rest -> case p of (url, mode) ->
      askPerm io url mode :: askAll io rest.

# all required granted?  (fold AND over the Bool list)
allTrue bs = case bs of Nil -> True | b :: r -> and2 b (allTrue r).
bNot b = case b of True -> False | False -> True.

# ---- remembered permission decisions (persisted on the log) -----------------
# One record per app at "sys/perms/<aid>": the FULL decision set,
# appended only when a prompt was actually shown, so readLatest wins
# and reruns don't grow the log.  Line format: "<y|n> <url> <mode>".
# Remembered decisions replay silently ([remembered y/n] echoed in the
# prompt's place); a REQUIRED perm remembered as denied is RE-ASKED
# (a manifest may promote an optional to required -- auto-denying
# forever would brick the app; also, the set is only persisted when
# the launch actually proceeds, so a stored required-deny can only
# arrive via that promotion path).  `make wipe-disk` forgets all;
# a QDEL (storage tag 4) on sys/perms/<aid> forgets one app.
permsUrl aid = strcat "sys/perms/" aid.

permsStored io aid =
  case storeRpc1 (ioMe io) (ioSt io) 1 (permsUrl aid) "" of
    Ok s -> s
  | Err _ -> "".

# end index (inclusive) of the line starting at i; \n excluded
plEnd s i n = case i > n of True -> n | False -> case charAt s i == 10 of True -> i - 1 | False -> plEnd s (i + 1) n.

# look up (url, mode) in a stored blob -> Ok Bool | Err "absent"
pLook s url mode = plGo s 1 (strlen s) url mode.
plGo s i n url mode =
  case i > n of
    True -> Err "absent"
  | False -> plLine s i n url mode (plEnd s i n).
plLine s i n url mode j =
  sp = findByte s 32 (i + 2);                    # space after the url
  case and2 (sp > 0) (sp < j) of
    True -> plHit s i n url mode j sp
  | False -> plGo s (j + 2) n url mode.          # malformed line: skip
plHit s i n url mode j sp =
  case and2 (strEq (slice s (i + 2) (sp - 1)) url)
            (strEq (slice s (sp + 1) j) mode) of
    True -> Ok (byteAt s i == 121)               # 'y'
  | False -> plGo s (j + 2) n url mode.

# render a decision set: parallel (url,mode) list + Bool list -> blob
rendPerms perms bs =
  case perms of
    Nil -> ""
  | p :: pr -> case bs of
      Nil -> ""
    | b :: br -> case p of (url, mode) ->
        strcat (rendPermLine url mode b) (rendPerms pr br).
rendPermLine url mode b =
  strcat (case b of True -> "y " | False -> "n ")
         (strcat url (strcat " " (strcat mode (chr 10)))).

# would asking this list show at least one prompt?  (absent, or a
# required perm remembered as denied -> yes)
permsNeedAsk stored perms isReq =
  case perms of
    Nil -> False
  | p :: r -> case p of (url, mode) ->
      case pLook stored url mode of
        Err _ -> True
      | Ok b -> case and2 isReq (bNot b) of
          True -> True
        | False -> permsNeedAsk stored r isReq.

# askAll with memory: replay a remembered decision, prompt on a miss
askAllRem io stored isReq perms =
  case perms of
    Nil -> Nil
  | p :: rest -> case p of (url, mode) ->
      askOneRem io stored isReq url mode :: askAllRem io stored isReq rest.
askOneRem io stored isReq url mode =
  case pLook stored url mode of
    Err _ -> askPerm io url mode
  | Ok b -> case and2 isReq (bNot b) of
      True -> askPerm io url mode                # required + remembered-deny
    | False -> sayRem io url mode b.
sayRem io url mode b =
  con = ioCon io;
  _ = puts con "  grant ";
  _ = puts con url;
  _ = puts con " (";
  _ = puts con mode;
  _ = puts con ") ? [remembered ";
  _ = puts con (case b of True -> "y" | False -> "n");
  _ = putLn con "]";
  b.

# persist the full set iff a prompt was shown this launch
persistPerms io aid stored req reqG opt optG =
  case or2 (permsNeedAsk stored req True) (permsNeedAsk stored opt False) of
    False -> Unit
  | True -> persistPerms1 io aid req reqG opt optG.
persistPerms1 io aid req reqG opt optG =
  _ = storeRpc1 (ioMe io) (ioSt io) 2 (permsUrl aid)
        (strcat (rendPerms req reqG) (rendPerms opt optG));
  Unit.

# ============================================================================
# CAPABILITIES  -- what a launched app actually receives
# ============================================================================
# A capability set is everything an app needs to talk to System.qa services
# WITHOUT any device knowledge: the console pair (for display), the reader
# actor handle (for keyboard), the CLINT reg (for clock), and a granted-URL
# list so svc* can enforce at the call site too. Bundled as a big tuple and
# threaded like any linear-ish token (it is copied, not linear, in this PoC).
#
#   caps = (con, me, clk, granted)
# where granted is the list of (url,mode) the user allowed.

mkCaps con me clk granted aid st = (con, me, clk, granted, aid, st).

capCon caps = case caps of (c, _, _, _, _, _) -> c.
capMe  caps = case caps of (_, m, _, _, _, _) -> m.
capClk caps = case caps of (_, _, k, _, _, _) -> k.
capGranted caps = case caps of (_, _, _, g, _, _) -> g.
capId  caps = case caps of (_, _, _, _, a, _) -> a.
capSt  caps = case caps of (_, _, _, _, _, s) -> s.

# is (url,mode) in the granted set?  services check this so a bug that
# calls an ungranted service faults loudly instead of silently working.
hasCap caps url mode = anyPerm (capGranted caps) url mode.
anyPerm g url mode =
  case g of
    Nil -> False
  | p :: r -> case p of (u, m) ->
      case and2 (strEq u url) (strEq m mode) of True -> True | False -> anyPerm r url mode.

# ---- the URL-addressed services (the ONLY api an app uses) -----------------

svcWrite caps s =
  case hasCap caps "/services/display" "write" of
    True -> puts (capCon caps) s
  | False -> capBug "/services/display".
svcWriteLn caps s = svcWrite caps s >> nl (capCon caps).

svcReadKey caps =
  case hasCap caps "/services/keyboard" "read" of
    True -> getc (capMe caps) (capCon caps)
  | False -> capBug "/services/keyboard".

# nonblocking key poll (0 = none waiting): what makes an app DYNAMIC --
# it can tick a clock or animate between keystrokes instead of parking
# in getc.  Same capability as svcReadKey.
svcPollKey caps =
  case hasCap caps "/services/keyboard" "read" of
    True -> pollKey (capCon caps)
  | False -> capBug "/services/keyboard".
pollKey con =
  (lsr, dat) = con;
  case isOdd (read lsr) of
    True -> read dat
  | False -> 0.

svcClock caps =
  case hasCap caps "/services/clock" "read" of
    True -> read (capClk caps)
  | False -> capBug "/services/clock".

# /services/modules: URL-addressed module resolution (the URL method).
# url is "<hash>/<fn>"; the answer is (1, fn) or (0, 0) -- a miss is
# DATA, because a resolver that panics on absence cannot front a disk
# module store or an FPRLive remote peer, where misses are routine.
# Today's backend is the link-time module table (Mod.resolve); swapping
# in .qa module archives or a remote node changes THIS function only.
svcModFn caps url =
  case hasCap caps "/services/modules" "read" of
    True -> Mod.resolve (urlHead url) (urlTail url)
  | False -> capBug "/services/modules".

# split "<head>/<tail>" at the first '/' (charAt is 1-indexed; '/' = 47)
findSlash s i n = case i > n of True -> 0 | False -> case charAt s i == 47 of True -> i | False -> findSlash s (i + 1) n.
urlHead s = k = findSlash s 1 (strlen s); case k == 0 of True -> s | False -> substr s 1 (k - 1).
urlTail s = k = findSlash s 1 (strlen s); case k == 0 of True -> "" | False -> substr s (k + 1) (strlen s - k).

# /services/storage: the app-scoped persistent kv (Sol's Persistent
# model on the append-only log).  The app's kv URL is FIXED BY ITS ID --
# "apps/<id>/<id>.kv" -- and built HERE, from the capability, so an app
# physically cannot name another app's stream.  svcKvAppend logs one
# msg (one QREC); svcKvReplay hands back the concatenated stream and
# the app folds its own update over it -- event sourcing, with the app
# as the runner.  Diskless boots answer Err: absence is data.
kvUrl caps = strcat "apps/" (strcat (capId caps) (strcat "/" (strcat (capId caps) ".kv"))).

svcKvAppend caps line =
  case hasCap caps "/services/storage" "write" of
    True -> storeRpc caps 2 (kvUrl caps) (strcat line (chr 10))
  | False -> capBug "/services/storage".
svcKvReplay caps =
  case hasCap caps "/services/storage" "write" of
    True -> storeRpc caps 3 (kvUrl caps) ""
  | False -> capBug "/services/storage".

storeRpc caps tag url pay = storeRpc1 (capMe caps) (capSt caps) tag url pay.
storeRpc1 me st tag url pay =
  case stHas st of
    True -> send (stAct st) (me, tag, url, pay) >> receiveRes me
  | False -> Err "no disk".

# /pins/<n>: the raw GPIO tier as capability-gated URLs.  Direction,
# level, read -- dynamically reconfigurable while running, which is
# the whole point: what pad does what is a RUNTIME decision an app
# makes through its grant, not a build-time wiring table.  Typical
# FPRISC then wraps these into services: svcKeypadScan below IS
# /services/keypad, built from mods/matrixkpd over svcPin*, with its
# pin map read from the "sys/pinmap.keypad" storage url -- remapping a
# soldered-differently board is one storage write, no rebuild.
svcPinMode caps n m =
  case hasCap caps "/pins" "rw" of
    True -> Pin.mode n m
  | False -> capBug "/pins".
svcPinWrite caps n v =
  case hasCap caps "/pins" "rw" of
    True -> Pin.write n v
  | False -> capBug "/pins".
svcPinRead caps n =
  case hasCap caps "/pins" "rw" of
    True -> Pin.read n
  | False -> capBug "/pins".

kpdDefaultMap = "4 5 6 7 8 9 10 11".
kpdMap caps =
  case stHas (capSt caps) of
    False -> kpdDefaultMap
  | True -> kpdMap1 (storeRpc caps 1 "sys/pinmap.keypad" "").
kpdMap1 r = case r of Ok s -> s | Err _ -> kpdDefaultMap.
kpdPins s = kpParse s 1 (strlen s) Nil.
kpNum w = knGo w 1 (strlen w) 0.
knGo w i n acc = case i > n of True -> acc | False -> knCh w i n acc (charAt w i).
knCh w i n acc c = case and2 (c >= 48) (c <= 57) of True -> knGo w (i + 1) n (acc * 10 + (c - 48)) | False -> acc.
kpTakeWord s i n = ktGo s i n "".
ktGo s i n acc = case i > n of True -> (acc, i) | False -> ktCh s i n acc (charAt s i).
ktCh s i n acc c = case or2 (c == 32) (c == 10) of True -> (acc, i + 1) | False -> ktGo s (i + 1) n (strcat acc (chr c)).
kpParse s i n acc =
  case i > n of
    True -> revI acc Nil
  | False -> kpWord s i n acc.
kpWord s i n acc =
  (w, j) = kpTakeWord s i n;
  case strlen w == 0 of
    True -> kpParse s j n acc
  | False -> kpParse s j n (kpNum w :: acc).
revI xs acc = case xs of Nil -> acc | x :: r -> revI r (x :: acc).
takeN n xs = case n <= 0 of True -> Nil | False -> tkGo n xs.
tkGo n xs = case xs of Nil -> Nil | x :: r -> x :: takeN (n - 1) r.
dropN n xs = case n <= 0 of True -> xs | False -> case xs of Nil -> Nil | _ :: r -> dropN (n - 1) r.

# /services/keypad: one scan (key ASCII | 0) over the current pin map
svcKeypadScan caps =
  case hasCap caps "/services/keypad" "read" of
    True -> kpScan1 caps (kpdPins (kpdMap caps))
  | False -> capBug "/services/keypad".
kpScan1 caps ps =
  rows = takeN 4 ps;
  cols = takeN 4 (dropN 4 ps);
  _ = MK.init (svcPinMode caps) rows cols;
  MK.scan (svcPinWrite caps) (svcPinRead caps) rows cols.

capBug url = error (strcat "capability fault: app used ungranted service " url).

# ============================================================================
# THE LAUNCHER CORE  (System.qa's LaunchElf seam)
# ============================================================================
# Given an app id, run the whole flow:
#   read /apps/<id>.qa  ->  parse  ->  ask permissions  ->  gate  ->  dispatch
# On full grant, resolve the manifest `entry` symbol to a co-compiled PAP
# via Apps.entry / Apps.run and hand it the granted capabilities.
# This is where a real ELF-in-ELF loader would swap in: instead of
# Apps.run (name dispatch), it would map the .qa's ELF section into a
# fresh FSProcess and jump to its entry with the same caps. One function.

# read a .qa by id: the DISK is the install target and overrides the
# shipped rodata set -- "apps/<id>.qa" on the log wins; rodata is the
# fallback ("" if absent everywhere).
qaFor io id =
  case stHas (ioSt io) of
    True -> qaFromDisk io id
  | False -> Apps.read id.
qaFromDisk io id =
  r = storeRpc1 (ioMe io) (ioSt io) 1 (strcat "apps/" (strcat id ".qa")) "";
  case r of
    Ok qa -> qa
  | Err _ -> Apps.read id.

launch io id =
  con = ioCon io;
  qa = qaFor io id;
  case strlen qa == 0 of
    True -> putLn con (strcat "No such app: " id)
  | False -> launchParsed io id qa (parseQa qa).

ioCon io = case io of (c, _, _, _) -> c.

launchParsed io id qa pr =
  con = ioCon io;
  case pr of
    Err e -> putLn con (strcat (strcat "Bad .qa (" e) (strcat ") for " id))
  | Ok m -> launchMan io qa m.

# m = (aid, entry, req, opt, mode); ask required perms, gate, then run
launchMan io qa m =
  con = ioCon io;
  aid = manId m;
  req = manReq m;
  stored = permsStored io aid;
  _ = putLn con (strcat "Launching " aid);
  _ = putLn con "Required permissions:";
  reqG = askAllRem io stored True req;
  case allTrue reqG of
    False -> putLn con "Cannot Run Application without all required compulsory Permissions"
  | True -> launchGranted io qa m stored reqG.

# required granted: ask optionals, persist the decision set, assemble
# caps, dispatch.  (Persisting only on this path means a stored set
# always describes a launch that actually happened.)
launchGranted io qa m stored reqG =
  con = ioCon io;
  opt = manOpt m;
  _ = case opt of Nil -> Unit | _ :: _ -> putLn con "Optional permissions:";
  optG = askAllRem io stored False opt;
  _ = persistPerms io (manId m) stored (manReq m) reqG opt optG;
  granted = append (keepGranted (manReq m) reqG) (keepGranted opt optG);
  caps = mkCaps con (ioMe io) (ioClk io) granted (manId m) (ioSt io);
  runEntry con qa m caps.

manId m = case m of (a, _, _, _, _) -> a.
manEntry m = case m of (_, e, _, _, _) -> e.
manReq m = case m of (_, _, r, _, _) -> r.
manOpt m = case m of (_, _, _, o, _) -> o.
manMode m = case m of (_, _, _, _, md) -> md.
ioMe io = case io of (_, me, _, _) -> me.
ioClk io = case io of (_, _, k, _) -> k.
ioSt  io = case io of (_, _, _, st) -> st.
stHas st = case st of (h, _) -> h.
stAct st = case st of (_, a) -> a.

# keep only the (url,mode) pairs whose parallel Bool is True
keepGranted perms bs =
  case perms of
    Nil -> Nil
  | p :: pr -> case bs of
      Nil -> Nil
    | b :: br -> case b of
        True -> p :: keepGranted pr br
      | False -> keepGranted pr br.

# runEntry: the LaunchElf seam. loadMode="process" -> real dynamic ELF
# loading (Sys.loadElfAt), extracting the .qa's ELF section by
# (offset,length) ONLY -- never materialized as a separate FPRISC
# String (docs/PROCESS-LOADING.md: a naive slice on a multi-KB ELF
# payload is O(n^2) and will exhaust the heap). Anything else keeps
# the co-compiled name-dispatch path (Apps.entry/Apps.run), which is
# what every app shipped as rodata in this build actually uses.
#
# CAPS THROUGH THE PROCESS ABI (the launch-path blocker, now closed):
# the granted set is serialized as "appid\nurl mode\n..." and rides
# fpr_process_entry's fourth argument; the process reads it back via
# Sys.caps and enforces its own gate.  Same trust model as the
# co-compiled path -- neither has an MMU behind it; both make the
# grant the app's ONLY story about what it may touch.
runEntry con qa m caps =
  case strEq (manMode m) "process" of
    True -> Sys.bindApp (manId m) >> runProcess con qa (capsBlob caps)
  | False -> runBuiltin con (manEntry m) caps.

# "appid\nurl mode\n" per grant
capsBlob caps =
  strcat (capId caps) (strcat (chr 10) (grantLines (capGranted caps))).
grantLines g =
  case g of
    Nil -> ""
  | p :: r -> case p of (u, m) ->
      strcat u (strcat " " (strcat m (strcat (chr 10) (grantLines r)))).

# NAME-DISPATCH IS DEAD.  The only in-image app is the launcher --
# System.qa's builtin shell, which cannot be a process while there is
# one slot (the shell could never nest-launch anything).  Everything
# else is a loaded process.  Apps.entry/Apps.run and the genapps entry
# table are deleted with it.
runBuiltin con entry caps =
  case strEq entry "launcher_main" of
    True -> launcher_main caps
  | False -> putLn con (strcat entry ": not a builtin; ship it as loadMode = process").

runProcess con qa blob =
  blank = tableEnd qa 1;
  payload0 = blank + 2;
  case findSection qa "ELF" 6 blank of
    Err e -> putLn con (strcat "No ELF section in this .qa: " e)
  | Ok r -> runProcessAt con qa payload0 r blob.

runProcessAt con qa payload0 r blob = case r of (off, ln) -> runProcessLoaded con (Sys.loadElfAt qa (payload0 + off - 1) ln blob).

runProcessLoaded con res =
  case res of (ok, msg) ->
    case ok == 1 of
      True -> putLn con (strcat "process exited: " msg)
    | False -> putLn con (strcat "process load failed: " msg).

# ============================================================================
# SHIPPED APPS  -- each is "just an app": it receives caps and uses ONLY
# svcWrite / svcReadKey / svcClock. No device access, no launcher internals.
# Every app's entry symbol is the FPRISC global fprc emits as fpr_g_<name>,
# which tools/genapps.py wires into the rodata entry table.
# ============================================================================

# ---- helpers apps share -----------------------------------------------------

# render an Int as decimal string
showInt n = case n < 0 of True -> strcat "-" (showNat (0 - n)) | False -> showNat n.
showNat n = case n < 10 of True -> chr (48 + n) | False -> strcat (showNat (n / 10)) (chr (48 + n - (n / 10) * 10)).

# clock reg is CLINT mtime (64-bit lo word is enough for a demo clock);
# QEMU virt mtime is 10 MHz -> seconds = ticks / 10000000
secsOf ticks = ticks / 10000000.
clockStr caps =
  s = secsOf (svcClock caps);
  mm = s / 60;
  ss = s - mm * 60;
  strcat (strcat (pad2 mm) ":") (pad2 ss).
pad2 n = case n < 10 of True -> strcat "0" (showInt n) | False -> showInt n.

# ============================================================================
# TUIAppLauncher  -- the main app System.qa starts. A paginated grid of app
# icons with a header bar (clock + count). "Just an app": it reads the app
# list via /services/apps, draws via /services/display, and takes keys via
# /services/keyboard. Selecting an app re-enters the launch flow.
#
# Layout (80 col):
#   +--------------------------------------------------------------+
#   | QOS  12:34            Apps 1-6 / 6                    page 1  |
#   +--------------------------------------------------------------+
#   |  [1] TUINotes      [2] TUIClock      [3] ...                  |
#   |  [4] ...                                                      |
#   +--------------------------------------------------------------+
#   |  1-9 launch   n/p page   q quit                              |
#   +--------------------------------------------------------------+
# ============================================================================

launcherPageN = 8.                        # list rows per page

dropSelf ids =
  case ids of
    Nil -> Nil
  | x :: r -> case strEq x "TUIAppLauncher" of
      True -> dropSelf r
    | False -> x :: dropSelf r.

launcher_main caps =
  ids = dropSelf (appsList caps);         # disk index first, rodata fallback;
                                          # the shell doesn't list itself
  launcherLoop caps ids 0.

# The apps service: reading /services/apps yields the app id list. We route
# it through the capability check like everything else.
# discovery is a DISK read like everything else: the seeded apps/index
# record names the installed set; rodata's list is the diskless
# fallback.  Same storage protocol as the kv streams, different url.
appsList caps =
  case hasCap caps "/services/apps" "read" of
    True -> appsListFrom caps
  | False -> capBug "/services/apps".
appsListFrom caps =
  case stHas (capSt caps) of
    False -> splitLines (Apps.list Unit)
  | True -> appsListDisk caps (storeRpc caps 1 "apps/index" "").
appsListDisk caps r =
  case r of
    Ok s -> splitLines s
  | Err _ -> splitLines (Apps.list Unit).

splitLines s = slGo s 1 (strlen s) "" Nil.
slGo s i n cur acc =
  case i > n of
    True -> rev (case strlen cur == 0 of True -> acc | False -> cur :: acc)
  | False -> case charAt s i == 10 of
      True -> slGo s (i + 1) n "" (case strlen cur == 0 of True -> acc | False -> cur :: acc)
    | False -> slGo s (i + 1) n (strcat cur (chr (charAt s i))) acc.

# Full-screen launcher on the TUI module: a cached cell buffer, diff
# frames, a LIVE clock in the header (ticks between keystrokes via
# svcPollKey), and j/k selection.  A tick repaints exactly the clock
# cells; a selection move repaints exactly two rows -- the module's
# diff renderer is what makes "dynamic" cheap.
launcherLoop caps ids page =
  _ = TUI.enterScreen (svcWrite caps);
  lFrame caps ids 1 page (TUI.invalidBuf 80 24).

lFrame caps ids sel page old =
  sec = secsOf (svcClock caps);
  new = TUI.frame (svcWrite caps) old (launcherW ids sel page sec) (80, 24);
  lWait caps ids sel page new sec.
lWait caps ids sel page buf sec =
  k = svcPollKey caps;
  case k == 0 of
    True -> lTick caps ids sel page buf sec
  | False -> lKey caps ids sel page buf sec k.
lTick caps ids sel page buf sec =
  case secsOf (svcClock caps) == sec of
    True -> lWait caps ids sel page buf sec
  | False -> lFrame caps ids sel page buf.
lKey caps ids sel page buf sec k =
  case k == 113 of                                        # q
    True -> lQuit caps
  | False -> case k == 106 of                             # j: down
      True -> lFrame caps ids (selClamp ids page (sel + 1)) page buf
    | False -> case k == 107 of                           # k: up
        True -> lFrame caps ids (selClamp ids page (sel - 1)) page buf
      | False -> case or2 (k == 13) (k == 10) of          # enter
          True -> lPick caps ids sel page buf
        | False -> case k == 110 of                       # n: next page
            True -> lFrame caps ids 1 (nextPage ids page) buf
          | False -> case k == 112 of                     # p: prev page
              True -> lFrame caps ids 1 (prevPage page) buf
            | False -> case and2 (k >= 49) (k <= 57) of   # 1..9 direct
                True -> lPick caps ids (k - 48) page buf
              | False -> lWait caps ids sel page buf sec.

selClamp ids page s = maxI 1 (minI s (pageLen ids page)).
maxI a b = case a > b of True -> a | False -> b.
pageLen ids page = minI launcherPageN (len ids - page * launcherPageN).

nPages ids = (len ids + launcherPageN - 1) / launcherPageN.
nextPage ids page = case page + 1 >= nPages ids of True -> page | False -> page + 1.
prevPage page = case page <= 0 of True -> 0 | False -> page - 1.

lPick caps ids slot page buf =
  gi = page * launcherPageN + slot;
  case nth ids gi of
    Err _ -> lWait caps ids slot page buf (0 - 1)
  | Ok id -> lRun caps ids slot page id.

# nested launch: DROP to the plain screen (the permission gate is line
# chrome), run the app, come back and repaint from an invalid buffer.
lRun caps ids sel page id =
  _ = TUI.leaveScreen (svcWrite caps);
  _ = svcWriteLn caps "";
  _ = launchFromApp caps id;
  _ = svcWriteLn caps "  (press any key to return to the launcher)";
  _ = svcReadKey caps;
  _ = TUI.enterScreen (svcWrite caps);
  lFrame caps ids sel page (TUI.invalidBuf 80 24).
lQuit caps =
  _ = TUI.leaveScreen (svcWrite caps);
  svcWriteLn caps "  (launcher exit)".

# an app launching another app: rebuild the io triple from our own caps and
# re-enter the permission flow. This is the recursive heart -- the launcher
# is an app that uses System.qa's launch service on /services/apps.
launchFromApp caps id =
  io = (capCon caps, capMe caps, capClk caps, capSt caps);
  launch io id.

# ---- the launcher widget tree ----------------------------------------------
minI a b = case a < b of True -> a | False -> b.

launcherW ids sel page sec sz =
  TUI.borderW 6 (TUI.vboxW (
    (TUI.LFix 1, launcherHdrW ids page sec) ::
    (TUI.LFix 1, TUI.lineW 6 0 "") ::
    (TUI.LFlex 1, appListW ids sel page) ::
    (TUI.LFix 1, TUI.lineW 6 0 "") ::
    (TUI.LFix 1, TUI.lineW 1 7 "  j/k move   enter launch   1-9 direct   n/p page   q quit") ::
    Nil)) sz.

launcherHdrW ids page sec sz =
  TUI.hboxW (
    (TUI.LFix 22, TUI.lineW 6 0 "  QOS   app launcher") ::
    (TUI.LFlex 1, TUI.lineW 4 0 "      apps {len ids}   page {page + 1}/{nPages ids}") ::
    (TUI.LFix 12, TUI.lineW 3 0 "  {pad2 (sec / 60)}:{pad2 (sec - (sec / 60) * 60)}") ::
    Nil) sz.

# the selectable rows: the selection is white-on-blue with a chevron;
# everything else default.  Rows are cells, so the diff pays only for
# the two rows the selection swap touches.
appListW ids sel page sz =
  (w, h) = sz;
  appRowsW ids (page * launcherPageN) sel 1 w h.
appRowsW ids base sel slot w h =
  case slot > h of
    True -> Nil
  | False -> appRowW ids (base + slot) sel slot w :: appRowsW ids base sel (slot + 1) w h.
appRowW ids gi sel slot w =
  case nth ids gi of
    Err _ -> TUI.repCell 8192 w
  | Ok id -> appRowOne id sel slot w.
appRowOne id sel slot w =
  case slot == sel of
    True  -> TUI.lineRow 8 5 "   > [{slot}] {id}" w
  | False -> TUI.lineRow 0 0 "     [{slot}] {id}" w.

# ============================================================================
# System.qa CONFIG + BOOTSTRAP
# ============================================================================
# System.qa's config is a key-value block (same mini-TOML). In a full QOS
# this is /system/config on disk; here it is inline rodata so `make run`
# needs no disk. The one key that matters for boot: `startup`.

systemConfig =
  strcat "name = \"System\"\n"
  (strcat "startup = \"TUIAppLauncher\"\n"
          "version = \"1\"\n").

# read a top-level string key from a config block
configGet cfg key =
  cfgGo (lines cfg) key.
cfgGo lns key =
  case lns of
    Nil -> ""
  | ln :: rest -> case asKV (trim ln) of
      Ok kv -> (case kv of (k, v) -> (case strEq k key of True -> v | False -> cfgGo rest key))
    | Err _ -> cfgGo rest key.

# ---- System.qa main : actor 0, THE system process --------------------------
# 1. bring up the clean HAL registers (the bootstrap the request describes)
# 2. read config -> startup app id
# 3. launch it through the SAME permission flow every app goes through
#    (the launcher is not privileged; it asks for its perms like anyone)
main =
  me = myself 0;
  u = device "uart";
  cl = device "clint";
  con = (reg8 u 5, reg8 u 0);
  clk = reg32 cl 49144;                  # CLINT mtime low word

  _ = Sys.init Unit; # buddy_init the process arena -- see docs/PROCESS-LOADING.md
  _ = putLn con "";
  _ = putLn con "QOS System.qa  --  bootstrap";
  _ = putLn con "----------------------------";

  # ---- storage: the default setup HAS a disk; boot degrades without one ----
  dsk = device "blk";
  st = case blkPages dsk == 0 of
         True  -> (False, 0)
       | False -> (True, spawnStore dsk);
  io = (con, me, clk, st);
  _ = bootBeat io con;
  startup = configGet systemConfig "startup";
  _ = putLn con (strcat "config: startup = " startup);
  _ = putLn con "";

  # launch the startup app (TUIAppLauncher) through the permission gate
  _ = launch io startup;

  putLn con "System.qa: startup app returned; halting.".

# System.qa's own persistent MVU in miniature: Model = boot count,
# init = replay "sys/boots" off the log, update = append one msg.
# Reboot on the same disk.img and the number climbs -- the whole
# Persistent story in one line of state.
# storage lives on hart 1 when there is one, so it keeps serving while
# hart 0 is inside a synchronous process run (the syscall channel
# depends on this); bound into C for the trampoline.
spawnStore dsk =
  a = case Sys.harts Unit > 1 of
        True -> spawnOn 1 (QLog.actor dsk)
      | False -> spawn (QLog.actor dsk);
  _ = Sys.bindStore a;
  a.

bootBeat io con =
  case stHas (ioSt io) of
    False -> putLn con "storage: no disk (kv + /apps overrides offline)"
  | True  -> bootBeat1 io con.
bootBeat1 io con =
  r = storeRpc1 (ioMe io) (ioSt io) 3 "sys/boots" "";
  n = case r of Ok s -> strlen s + 1 | Err _ -> 1;
  _ = storeRpc1 (ioMe io) (ioSt io) 2 "sys/boots" "b";
  putLn con "storage: disk online -- boot #{n} on this log".
