# ============================================================================
# raster.fpr -- a 3D graphics pipeline PoC, fully in FP-RISC.  No OpenGL.
#
#   Scene ----> vertex stage ----> raster ----> pixel stage ----> framebuffer
#            (SoA transform)   (edge eqns)   (gather+blend)      (3 planes + Z)
#
# The MVU split mirrors gfxdemo/FPRLive: the STATIC batch (mesh vertex
# lists, the texture, the framebuffer planes) is built once at boot; the
# per-frame DYNAMIC part is just the Model -> view -> Scene (instances =
# angle + translation), and render is the dispatcher that walks the Scene.
#
# All the compute-heavy work runs in the Vector SoA SIMD tier (vec.c):
#   * vertex stage: whole-mesh rotate/translate/project as axpb / zipAdd /
#     zipDiv column ops (vmul.vx / vadd.vv / vdiv shapes)
#   * raster rows: the three edge functions and the z/u/v attribute
#     planes are affine in x, so each is ONE axpb over the row span;
#     coverage is zipMin + ges, the depth test is zipLt on a Z slice
#   * pixel stage: texel addresses by SoA arithmetic, texture fetch by
#     Vec.gather (vluxei), lambert scale by axpb/sar, write by Vec.blend
#     (vmerge) + Vec.burst back into the framebuffer planes
#   * the texture itself is built by a SPECIALIZED Vec.map (closed
#     arithmetic fn -> the compiler's unboxed column loop), and frame
#     checksums by specialized Vec.fold (+) -- the vredsum shape
#
# Everything is 16.16 fixed point (the word is 64-bit: no overflow at
# this scale).  Attribute interpolation is affine, not perspective-
# correct, and shared edges have no top-left fill rule -- both are
# stated PoC simplifications, not accidents.
#
#   make posix.bin PROG=programs/raster.fpr && ./posix.bin > out.txt
#   tools/raster-check.sh      # checksums + extracts frame8.ppm
# ============================================================================

# ---- little prelude ---------------------------------------------------------

and2 True b = b.
and2 False b = False.

len Nil = 0.
len (_ :: t) = 1 + len t.

nth (x :: r) 0 = x.
nth (x :: r) i = nth r (i - 1).

maxI a b | a > b = a.
maxI a b = b.
minI a b | a < b = a.
minI a b = b.
min3 a b c = minI a (minI b c).
max3 a b c = maxI a (maxI b c).
absI n | n < 0 = 0 - n.
absI n = n.
clampI lo hi n = maxI lo (minI hi n).

# the specialized-fold shape: fold sumF == vredsum
sumF a n = a + n.

# ---- fixed point ------------------------------------------------------------

fx = 65536.                      # 16.16

# 15-degree steps, cos/sin * 65536 (one full turn = 24 entries)
cosT = [65536, 63303, 56756, 46341, 32768, 16962, 0, 0 - 16962, 0 - 32768,
        0 - 46341, 0 - 56756, 0 - 63303, 0 - 65536, 0 - 63303, 0 - 56756,
        0 - 46341, 0 - 32768, 0 - 16962, 0, 16962, 32768, 46341, 56756, 63303].
sinT = [0, 16962, 32768, 46341, 56756, 63303, 65536, 63303, 56756, 46341,
        32768, 16962, 0, 0 - 16962, 0 - 32768, 0 - 46341, 0 - 56756, 0 - 63303,
        0 - 65536, 0 - 63303, 0 - 56756, 0 - 46341, 0 - 32768, 0 - 16962].
cosA i = nth cosT (imod i 24).
sinA i = nth sinT (imod i 24).
imod n d = n - (n / d) * d.

# ---- the screen and the texture --------------------------------------------

scrW = 128.
scrH = 128.
focal = 110.                     # pixels
farZ = 2147483647.
bgR = 18. bgG = 20. bgB = 34.    # night-sky clear color

texW = 32.

# texel color channels from the linear index -- CLOSED arithmetic
# functions, so `Vec.map texR (Vec.iota 1024)` takes the compiler's
# specialized unboxed column loop (the RVV-able path), not fpr_apply.
texCheck i = imod (i - (i / 256) * 256) 2 + (i / 256) - ((i / 256) / 2) * 2.
texR i = 60 + imod (texCheck i) 2 * 170 + imod i 8 * 3.
texG i = 70 + imod (texCheck i) 2 * 120 + imod (i / 32) 8 * 3.
texB i = 160 - imod (texCheck i) 2 * 90.

mkTexture u =
  ( Vec.map texR (Vec.iota 1024),
    Vec.map texG (Vec.iota 1024),
    Vec.map texB (Vec.iota 1024) ).

# ---- the static mesh: a unit cube, 24 verts (per-face UVs), 12 tris --------
# vertex order per face: (-,-) (+,-) (+,+) (-,+) in face-local axes;
# S scales +-0.55 into 16.16

cubeS = 36044.                   # 0.55 * 65536
cubeN = 0 - 36044.

meshXs = [cubeN, cubeS, cubeS, cubeN,  cubeS, cubeS, cubeS, cubeS,    cubeS, cubeN, cubeN, cubeS,   cubeN, cubeN, cubeN, cubeN,  cubeN, cubeS, cubeS, cubeN,  cubeN, cubeS, cubeS, cubeN].
meshYs = [cubeN, cubeN, cubeS, cubeS,  cubeN, cubeN, cubeS, cubeS,  cubeN, cubeN, cubeS, cubeS,   cubeN, cubeN, cubeS, cubeS,    cubeS, cubeS, cubeS, cubeS,    cubeN, cubeN, cubeN, cubeN].
meshZs = [cubeS, cubeS, cubeS, cubeS,    cubeS, cubeN, cubeN, cubeS,  cubeN, cubeN, cubeN, cubeN, cubeN, cubeS, cubeS, cubeN,    cubeS, cubeS, cubeN, cubeN,  cubeN, cubeN, cubeS, cubeS].
meshUs = [0, 31, 31, 0,  0, 31, 31, 0,  0, 31, 31, 0,   0, 31, 31, 0,    0, 31, 31, 0,  0, 31, 31, 0].
meshVs = [31, 31, 0, 0,  31, 31, 0, 0,  31, 31, 0, 0,   31, 31, 0, 0,    31, 31, 0, 0,  31, 31, 0, 0].

meshTris =
  (0, 1, 2) :: (0, 2, 3) ::       # front
  (4, 5, 6) :: (4, 6, 7) ::       # right
  (8, 9, 10) :: (8, 10, 11) ::    # back
  (12, 13, 14) :: (12, 14, 15) :: # left
  (16, 17, 18) :: (16, 18, 19) :: # top
  (20, 21, 22) :: (20, 22, 23) :: Nil. # bottom

# ============================================================================
# MVU: Model -> view -> Scene.  The Scene is the whole dynamic surface --
# render sees nothing else.  Inst angleIdx tx ty tz  (translation 16.16).
# ============================================================================

Inst = Type (Inst ang tx ty tz).

# model = (frame, angle of cube A, angle of cube B)
update (f, a, b) = (f + 1, imod (a + 1) 24, imod (b + 22) 24).

view (f, a, b) =
  Inst a (0 - 45000) 6000 245760 ::       # left cube, spinning +15 deg/frame
  Inst b 52000 (0 - 12000) 327680 :: Nil. # right cube, further, counter-spinning

# ============================================================================
# VERTEX STAGE: whole-mesh SoA column math.
#   rotate Y   x' = (c*x + s*z) >> 16 ; z' = (c*z - s*x) >> 16
#   translate  += t
#   project    sx = W/2 + f*x/z ; sy = H/2 - f*y/z   (z > 0 after clamp)
# Returns everything triangle setup needs, as plain lists (the setup is
# scalar and tiny; the SoA tier did the per-vertex arithmetic).
# ============================================================================

vstage (Inst ang tx ty tz) =
  c = cosA ang;
  s = sinA ang;
  (xsA, xsB) = Vec.dup (Vec.fromList meshXs);
  (zsA, zsB) = Vec.dup (Vec.fromList meshZs);
  xw = Vec.zipAdd (Vec.axpb c 0 xsA) (Vec.axpb s 0 zsA) |> Vec.sar 16 |> Vec.axpb 1 tx;
  zw = Vec.zipAdd (Vec.axpb c 0 zsB) (Vec.axpb (0 - s) 0 xsB) |> Vec.sar 16 |> Vec.axpb 1 tz
       |> Vec.maxS 6554;                          # near clamp at 0.1
  yw = Vec.fromList meshYs |> Vec.axpb 1 ty;
  (xw1, xw2) = Vec.dup xw;
  (yw1, yw2) = Vec.dup yw;
  (zw1, zwB) = Vec.dup zw;
  (zw2, zw3) = Vec.dup zwB;
  sx = Vec.zipDiv (Vec.axpb focal 0 xw1) zw1 |> Vec.axpb 1 (scrW / 2);
  sy = Vec.zipDiv (Vec.axpb (0 - focal) 0 yw1) zw2 |> Vec.axpb 1 (scrH / 2);
  ((Vec.toList sx, Vec.toList sy, Vec.toList zw3),
   (Vec.toList xw2, Vec.toList yw2)).

# ============================================================================
# TRIANGLE SETUP: scalar, per triangle.  Edge functions and attribute
# planes; both are affine in x, which is what makes each raster row ONE
# axpb in the SIMD tier.
#   E a b c : w(x,y) = a*x + b*y + c   (>= 0 inside, given area2 > 0)
#   P dx dy k : f(x,y) = (dx*x + dy*y + k) >> 16
# ============================================================================

E = Type (E ea eb ec).
P = Type (P dx dy k).

edgeFor xa ya xb yb = E (ya - yb) (xb - xa) (xa * yb - xb * ya).

# the plane coefficients divide by the signed area: the contract IS the
# signature, and every caller discharges it with its backface-cull guard
planeDx : Int -> Int -> Int -> Int -> (a2 : Int | a2 != 0) -> Int.
planeDx f01 f02 y01 y02 a2 = (f01 * y02 - f02 * y01) * fx / a2.
planeDy : Int -> Int -> Int -> Int -> (a2 : Int | a2 != 0) -> Int.
planeDy f01 f02 x01 x02 a2 = (f02 * x01 - f01 * x02) * fx / a2.

planeFor f0 f1 f2 g a2 =
  ((x0, y0), (x1, y1), (x2, y2)) = g;
  dx = planeDx (f1 - f0) (f2 - f0) (y1 - y0) (y2 - y0) a2;
  dy = planeDy (f1 - f0) (f2 - f0) (x1 - x0) (x2 - x0) a2;
  P dx dy (f0 * fx - dx * x0 - dy * y0).

# manhattan-normalized lambert toward the viewer (light sits at the eye)
lightOf nx ny nz | absI nx + absI ny + absI nz == 0 = 160.
lightOf nx ny nz = clampI 70 255 (120 + (0 - nz) * 150 / (absI nx + absI ny + absI nz)).

# ============================================================================
# RASTER + PIXEL STAGE: per row, everything is span-wide vector math.
# ============================================================================

# a fresh copy chain: one x-row, used by 3 edges + 3 planes
xrow x0 span = Vec.iota span |> Vec.axpb 1 x0.

rowMask es y x0 span =
  (E a0 b0 c0, E a1 b1 c1, E a2 b2 c2) = es;
  w0 = Vec.axpb a0 (b0 * y + c0) (xrow x0 span);
  w1 = Vec.axpb a1 (b1 * y + c1) (xrow x0 span);
  w2 = Vec.axpb a2 (b2 * y + c2) (xrow x0 span);
  w0 |> Vec.zipMin w1 |> Vec.zipMin w2 |> Vec.ges 0.

rowAttr (P dx dy k) y x0 span =
  Vec.axpb dx (dy * y + k) (xrow x0 span) |> Vec.sar 16.

# shade one channel: gather texels, lambert-scale, mask into the fb slice
chanBlit tv fv m addr light off span =
  (texels, tv2) = Vec.gather addr tv;
  lit = texels |> Vec.axpb light 0 |> Vec.sar 8;
  (fsl, fv2) = Vec.slice off span fv;
  (tv2, Vec.burst off (Vec.blend m lit fsl) fv2).

rasterRow tex fb depth es ps bb y | y > bbY1 bb = (tex, fb, depth).
rasterRow tex fb depth es ps bb y =
  ((x0, span, _), _) = bb;
  off = y * scrW + x0;
  (pz, pu, pv) = ps;
  # coverage & depth: zrow twice (test + write), the z slice twice
  (z1, z2) = Vec.dup (rowAttr pz y x0 span);
  (dsl, depth2) = Vec.slice off span depth;
  (dslA, dslB) = Vec.dup dsl;
  m0 = Vec.zipMul (rowMask es y x0 span) (Vec.zipLt z1 dslA);
  (m1, mA) = Vec.dup m0;
  (m2, mB) = Vec.dup mA;
  (m3, m4) = Vec.dup mB;
  depth3 = Vec.burst off (Vec.blend m1 z2 dslB) depth2;
  # texel addresses: v*32 + u, clamped into the atlas
  urow = rowAttr pu y x0 span |> Vec.maxS 0 |> Vec.minS 31;
  vrow = rowAttr pv y x0 span |> Vec.maxS 0 |> Vec.minS 31;
  addr = Vec.zipAdd (Vec.axpb texW 0 vrow) urow;
  (ad1, adA) = Vec.dup addr;
  (ad2, ad3) = Vec.dup adA;
  (tr, tg, tb) = tex;
  (fr, fg, fbb) = fb;
  (light, _, _) = snd2 bb;
  (tr2, fr2) = chanBlit tr fr m2 ad1 light off span;
  (tg2, fg2) = chanBlit tg fg m3 ad2 light off span;
  (tb2, fb2) = chanBlit tb fbb m4 ad3 light off span;
  rasterRow (tr2, tg2, tb2) (fr2, fg2, fb2) depth3 es ps bb (y + 1).

# bb packs the scalar row-loop context: ((x0, span, y1), (light, y, _))
bbY1 ((x0, span, y1), lt) = y1.
snd2 (a, b) = b.

# ============================================================================
# DRAW: fetch a triangle from the vertex-stage lists, cull, set up, scan.
# ============================================================================

drawTri tex fb depth vd (i0, i1, i2) =
  ((sxL, syL, zL), (xwL, ywL)) = vd;
  x0 = nth sxL i0; y0 = nth syL i0;
  x1 = nth sxL i1; y1 = nth syL i1;
  x2 = nth sxL i2; y2 = nth syL i2;
  a2 = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0);
  drawCulled tex fb depth vd (i0, i1, i2) ((x0, y0), (x1, y1), (x2, y2)) a2.

# backface / degenerate cull: the guard that discharges every plane's
# (a2 != 0) precondition statically
drawCulled tex fb depth vd tri g a2 | a2 > 0 = drawFront tex fb depth vd tri g a2.
drawCulled tex fb depth vd tri g a2 = (tex, fb, depth).

drawFront tex fb depth vd (i0, i1, i2) g a2 =
  ((sxL, syL, zL), (xwL, ywL)) = vd;
  ((x0, y0), (x1, y1), (x2, y2)) = g;
  es = (edgeFor x0 y0 x1 y1, edgeFor x1 y1 x2 y2, edgeFor x2 y2 x0 y0);
  ps = ( planeFor (nth zL i0) (nth zL i1) (nth zL i2) g a2,
         planeFor (nth meshUs i0) (nth meshUs i1) (nth meshUs i2) g a2,
         planeFor (nth meshVs i0) (nth meshVs i1) (nth meshVs i2) g a2 );
  light = faceLight xwL ywL zL i0 i1 i2;
  bx0 = maxI 0 (min3 x0 x1 x2);
  bx1 = minI (scrW - 1) (max3 x0 x1 x2);
  by0 = maxI 0 (min3 y0 y1 y2);
  by1 = minI (scrH - 1) (max3 y0 y1 y2);
  drawSpan tex fb depth es ps (((bx0, bx1 - bx0 + 1, by1), (light, by0, 0))) by0.

drawSpan tex fb depth es ps bb y0 | bbSpan bb <= 0 = (tex, fb, depth).
drawSpan tex fb depth es ps bb y0 = rasterRow tex fb depth es ps bb y0.
bbSpan ((x0, span, y1), lt) = span.

# world-space face normal (z-in-view is depth for the eye light)
faceLight xw yw zw i0 i1 i2 =
  ax = nth xw i1 - nth xw i0; ay = nth yw i1 - nth yw i0; az = nth zw i1 - nth zw i0;
  bx = nth xw i2 - nth xw i0; by = nth yw i2 - nth yw i0; bz = nth zw i2 - nth zw i0;
  nx = (ay * bz - az * by) / fx;
  ny = (az * bx - ax * bz) / fx;
  nz = (ax * by - ay * bx) / fx;
  lightOf nx ny nz.

drawTris tex fb depth vd Nil = (tex, fb, depth).
drawTris tex fb depth vd (t :: rest) =
  (tex2, fb2, depth2) = drawTri tex fb depth vd t;
  drawTris tex2 fb2 depth2 vd rest.

# ============================================================================
# RENDER: the dispatcher.  Scene in, framebuffer out.  Nothing above the
# Scene reaches in here; nothing in here knows about Msg or the Model.
# ============================================================================

render Nil tex fb depth = (tex, fb, depth).
render (inst :: rest) tex fb depth =
  (tex2, fb2, depth2) = drawTris tex fb depth (vstage inst) meshTris;
  render rest tex2 fb2 depth2.

clearFrame (fr, fg, fbb) depth =
  ( (Vec.axpb 0 bgR fr, Vec.axpb 0 bgG fg, Vec.axpb 0 bgB fbb),
    Vec.axpb 0 farZ depth ).

# ============================================================================
# OUTPUT: per-frame checksums (specialized Vec.fold), final frame as P3.
# ============================================================================

checksum (fr, fg, fbb) =
  (cr, fr2) = Vec.fold sumF 0 fr;
  (cg, fg2) = Vec.fold sumF 0 fg;
  (cb, fb2) = Vec.fold sumF 0 fbb;
  ((cr, cg, cb), (fr2, fg2, fb2)).

ppmRow Nil gs bs k acc = acc.
ppmRow (r :: rt) (g :: gt) (b :: bt) k acc =
  ppmRow rt gt bt (k + 1) (strcat acc "{r} {g} {b} ").

ppmRows Nil gs bs = Unit.
ppmRows rs gs bs =
  _ = print (ppmRow (takeN scrW rs) (takeN scrW gs) (takeN scrW bs) 0 "");
  ppmRows (dropN scrW rs) (dropN scrW gs) (dropN scrW bs).

takeN n xs | n <= 0 = Nil.
takeN n Nil = Nil.
takeN n (x :: r) = x :: takeN (n - 1) r.
dropN n xs | n <= 0 = xs.
dropN n Nil = Nil.
dropN n (_ :: r) = dropN (n - 1) r.

emitPpm (fr, fg, fbb) =
  _ = print "PPMBEGIN";
  _ = print "P3";
  _ = print "{scrW} {scrH}";
  _ = print "255";
  _ = ppmRows (Vec.toList fr) (Vec.toList fg) (Vec.toList fbb);
  print "PPMEND".

# ============================================================================
# THE FRAME LOOP: static batch threads through; the Model is the only
# thing that changes.  Zero steady-state allocation of the render
# targets: clear is an in-place axpb over persistent planes.
# ============================================================================

frameLoop tex fb depth model n | n > 8 = frameDone tex fb depth.
frameLoop tex fb depth model n =
  (fb1, depth1) = clearFrame fb depth;
  (tex2, fb2, depth2) = render (view model) tex fb1 depth1;
  ((cr, cg, cb), fb3) = checksum fb2;
  _ = print "frame {n}: checksum {cr} {cg} {cb}";
  frameLoop tex2 fb3 depth2 (update model) (n + 1).

frameDone (tr, tg, tb) fb depth =
  _ = emitPpm fb;
  _ = Vec.free tr; _ = Vec.free tg; _ = Vec.free tb;
  _ = Vec.free depth;
  print "raster done".

main =
  _ = print "raster (FP-RISC): {scrW}x{scrH}, {len meshXs} verts, {len meshTris} tris/cube, 2 instances";
  fb0 = (Vec.iota (scrW * scrH), Vec.iota (scrW * scrH), Vec.iota (scrW * scrH));
  frameLoop (mkTexture Unit) fb0 (Vec.iota (scrW * scrH)) (1, 0, 8) 1.
