# ============================================================================
# httpd.fpr -- a JSON REST API over the HAL's virtio-net transport,
# with the stax VM as the application behind it.
#
#   GET  /        -> service description
#   GET  /status  -> live runtime counters (heap / preempts / arc / cmds)
#   POST /run     -> body {"prog": "1 2 + ."} -> stax log lines as JSON
#
# The HAL owns frames, ARP, IP and a one-connection TCP (see runtime/net.c
# for the honest simplifications); everything above the byte stream --
# request accumulation, HTTP parsing, routing, JSON in and out -- is FPRISC.
#
#   make image.elf PROG=programs/httpd.fpr && make run-net
#   curl localhost:8000/run -d '{"prog":"1 5 begin swap over * swap 1 - dup 0 = until drop ."}'
# ============================================================================

# ---- little prelude (shared by TUI and stax) --------------------------------

and2 True b = b.
and2 False b = False.

or2 True b = True.
or2 False b = b.

boolToInt True = 1.
boolToInt False = 0.

append Nil ys = ys.
append (h :: t) ys = h :: append t ys.

len Nil = 0.
len (_ :: t) = 1 + len t.

revGo Nil acc = acc.
revGo (x :: r) acc = revGo r (x :: acc).
revList xs = revGo xs Nil.

takeN n xs | n <= 0 = Nil.
takeN n Nil = Nil.
takeN n (x :: r) = x :: takeN (n - 1) r.

maxI a b | a > b = a.
maxI a b = b.

strInit s = strTakeGo s 1 (strlen s - 1) "".
strTakeGo s i n acc | i > n = acc.
strTakeGo s i n acc = strTakeGo s (i + 1) n (strcat acc (chr (charAt s i))).


# ============================================================================
# STAX: the mini stack language -- parser combinators -> Ast -> bytecode -> VM
# (from stax.fpr; VM made TOTAL: Ok/Err + gas budget instead of `error`,
#  and `.` output captured into a line list instead of printed)
# ============================================================================

PRes  = Type (POk a Int | PFail String Int).
Ast   = Type (ANum Int | APrim String | AIf a b | ALoop a).
Instr = Type (IPush Int | IOp String | IJz Int | IJmp Int | IPrint).

isDigit b = and2 (b >= 48) (b <= 57).
isLetter2 b = or2 (and2 (b >= 97) (b <= 122)) (and2 (b >= 65) (b <= 90)).
isSpace2 b = or2 (b == 32) (or2 (b == 10) (or2 (b == 9) (b == 13))).
isSym b = or2 (b == 43) (or2 (b == 45) (or2 (b == 42) (or2 (b == 47)
          (or2 (b == 61) (or2 (b == 60) (or2 (b == 62) (b == 46))))))).

# parser : String -> Int -> PRes
pok v s i = POk v i.
pfail m s i = PFail m i.
pbind p f s i = case p s i of
    POk v j -> f v s j
  | PFail m j -> PFail m j.
palt p q s i = case p s i of
    POk v j -> POk v j
  | PFail _ _ -> q s i.
pmapK f v = pok (f v).
pmap f p s i = pbind p (pmapK f) s i.

skipWs s i | i > String.len s = i.
skipWs s i = skipWsB (charAt s i) s i.
skipWsB b s i | isSpace2 b = skipWs s (i + 1).
skipWsB b s i = i.

pdigit s i | i > String.len s = PFail "eof: digit" i.
pdigit s i = pdigitB (charAt s i) i.
pdigitB b i | isDigit b = POk (b - 48) (i + 1).
pdigitB b i = PFail "expected digit" i.

pletter s i | i > String.len s = PFail "eof: letter" i.
pletter s i = pletterB (charAt s i) i.
pletterB b i | isLetter2 b = POk b (i + 1).
pletterB b i = PFail "expected letter" i.

psym s i | i > String.len s = PFail "eof: sym" i.
psym s i = psymB (charAt s i) i.
psymB b i | isSym b = POk (chr b) (i + 1).
psymB b i = PFail "expected symbol" i.

pintAcc n s i = case pdigit s i of
    POk d j -> pintAcc (n * 10 + d) s j
  | PFail _ _ -> POk n i.
pint s i = pbind pdigit pintAcc s i.

plettersK b = plettersAcc (chr b).
plettersAcc acc s i = case pletter s i of
    POk b j -> plettersAcc (strcat acc (chr b)) s j
  | PFail _ _ -> POk acc i.
pletters s i = pbind pletter plettersK s i.

pword s i = palt pletters psym s i.

pkwChk k w | w == k = pok 1.
pkwChk k w = pfail "expected {k}".
pkwRaw k s i = pbind pletters (pkwChk k) s i.
pkw k s i = pkwRaw k s (skipWs s i).

pnumT s i = pmap ANum pint s i.

ptermWord "if" = pif.
ptermWord "begin" = ploop.
ptermWord "else" = pfail "unexpected else".
ptermWord "then" = pfail "unexpected then".
ptermWord "until" = pfail "unexpected until".
ptermWord w = pok (APrim w).
pwordT s i = pbind pword ptermWord s i.

ptermRaw s i = palt pnumT pwordT s i.
pterm s i = ptermRaw s (skipWs s i).

pseq s i = case pterm s i of
    POk t j -> pseqK t s j
  | PFail _ _ -> POk Nil i.
pseqK t s j = case pseq s j of
    POk ts k -> POk (t :: ts) k
  | PFail m k -> PFail m k.

pifElse thn s i =
  pbind (pkw "else") (fn u ->
    pbind pseq (fn els ->
      pbind (pkw "then") (fn u2 -> pok (AIf thn els)))) s i.
pifThen thn s i = pbind (pkw "then") (fn u -> pok (AIf thn Nil)) s i.
pifK thn = palt (pifElse thn) (pifThen thn).
pif s i = pbind pseq pifK s i.

ploop s i = pbind pseq (fn body -> pbind (pkw "until") (fn u -> pok (ALoop body))) s i.

parseEof src ts j | j > String.len src = Ok ts.
parseEof src ts j = Err "unexpected input at byte {j}".
parseFin src (POk ts j) = parseEof src ts (skipWs src j).
parseFin src (PFail m j) = Err "at byte {j}: {m}".
parseProg src = parseFin src (pseq src 1).

# ---- compiler: Ast -> bytecode (absolute targets, single pass) --------------

compileSeq Nil a = (Nil, a).
compileSeq (t :: rest) a = compileSeqCons t rest a.
compileSeqCons t rest a =
  (c1, a1) = compileOne t a;
  (c2, a2) = compileSeq rest a1;
  (append c1 c2, a2).
compileOne (ANum n) a = (IPush n :: Nil, a + 1).
compileOne (APrim o) a = compilePrim o a.
compileOne (AIf thn els) a = compileIf thn els a.
compileOne (ALoop b) a = compileLoop b a.

compilePrim "." a = (IPrint :: Nil, a + 1).
compilePrim o a = (IOp o :: Nil, a + 1).
compileIf thn els a =
  (ct, at) = compileSeq thn (a + 1);
  (ce, ae) = compileSeq els (at + 1);
  (append (IJz (at + 1) :: ct) (IJmp ae :: ce), ae).
compileLoop b a =
  (cb, ab) = compileSeq b a;
  (append cb (IJz a :: Nil), ab + 1).

# ---- the VM, made total: Result-valued ops, gas budget, captured output -----

addI a b = a + b.
subI a b = a - b.
mulI a b = a * b.
divI a b = a / b.
eqI a b = boolToInt (a == b).
ltI a b = boolToInt (a < b).
gtI a b = boolToInt (a > b).

binOp f (b :: (a :: r)) = Ok (f a b :: r).
binOp f st = Err "vm: stack underflow (need 2)".

dupOp (x :: r) = Ok (x :: x :: r).
dupOp Nil = Err "vm: stack underflow".

dropOp (_ :: r) = Ok r.
dropOp Nil = Err "vm: stack underflow".

swapK t s r = s :: t :: r.
overK t s r = s :: t :: s :: r.
binOp2K k (t :: (s :: r)) = Ok (k t s r).
binOp2K k st = Err "vm: stack underflow (need 2)".

divChk (0 :: _) = Err "vm: division by zero".
divChk st = binOp divI st.

applyOp "+" st = binOp addI st.
applyOp "-" st = binOp subI st.
applyOp "*" st = binOp mulI st.
applyOp "/" st = divChk st.
applyOp "=" st = binOp eqI st.
applyOp "<" st = binOp ltI st.
applyOp ">" st = binOp gtI st.
applyOp "dup" st = dupOp st.
applyOp "drop" st = dropOp st.
applyOp "swap" st = binOp2K swapK st.
applyOp "over" st = binOp2K overK st.
applyOp o st = Err "vm: unknown op '{o}'".

runVM code n pc st out gas | gas <= 0 = Err "vm: out of gas (100000 steps)".
runVM code n pc st out gas | pc > n = Ok (st, out).
runVM code n pc st out gas = step code n pc (code ! pc) st out gas.

step code n pc (IPush v) st out gas = runVM code n (pc + 1) (v :: st) out (gas - 1).
step code n pc (IOp o) st out gas = stepOp code n pc (applyOp o st) out gas.
step code n pc (IJmp t) st out gas = runVM code n t st out (gas - 1).
step code n pc (IJz t) st out gas = stepJz code n pc t st out gas.
step code n pc IPrint st out gas = stepPrint code n pc st out gas.

stepOp code n pc (Ok st2) out gas = runVM code n (pc + 1) st2 out (gas - 1).
stepOp code n pc (Err m) out gas = Err m.

stepJz code n pc t (0 :: rest) out gas = runVM code n t rest out (gas - 1).
stepJz code n pc t (_ :: rest) out gas = runVM code n (pc + 1) rest out (gas - 1).
stepJz code n pc t Nil out gas = Err "vm: jz: stack underflow".

stepPrint code n pc (x :: rest) out gas = runVM code n (pc + 1) rest ("output: {x}" :: out) (gas - 1).
stepPrint code n pc Nil out gas = Err "vm: print: stack underflow".

# ---- REPL driver: source -> (color, text) log lines, oldest first -----------

showStack st = strcat "[" (strcat (joinC st) "]").
joinC Nil = "".
joinC (x :: r) = joinCGo "{x}" r.
joinCGo acc Nil = acc.
joinCGo acc (x :: rest) = joinCGo (strcat acc ", {x}") rest.

runStax src = runParsed (parseProg src).
runParsed (Err m) = (2, "parse error: {m}") :: Nil.
runParsed (Ok ast) =
  (code, _) = compileSeq ast 1;
  runOutcome (runVM code (len code) 1 Nil Nil 100000).
runOutcome (Err m) = (2, m) :: Nil.
runOutcome (Ok (st, out)) =
  out
  |> revList
  |> outLines
  |> fn ls -> append ls ((0, "stack: {showStack st}") :: Nil).

outLines Nil = Nil.
outLines (s :: r) = (0, s) :: outLines r.


# ---- HTTP wire bits ----------------------------------------------------------

crlf = strcat (chr 13) (chr 10).
hline s = strcat s crlf.

httpResp status body =
  n = String.len body;
  strcat (hline "HTTP/1.0 {status}")
  (strcat (hline "Content-Type: application/json")
  (strcat (hline "Content-Length: {n}")
  (strcat (hline "Connection: close")
  (strcat crlf body)))).

# ---- string scanning (1-indexed, charAt) --------------------------------------

# index of sub in s at or after `from`, 0 if absent
findSub s sub from =
  n = String.len s;
  m = String.len sub;
  findGo s sub from n m.
findGo s sub i n m | i + m - 1 > n = 0.
findGo s sub i n m | matchAt s sub i 1 m = i.
findGo s sub i n m = findGo s sub (i + 1) n m.

matchAt s sub i j m | j > m = True.
matchAt s sub i j m | charAt s (i + j - 1) == charAt sub j = matchAt s sub i (j + 1) m.
matchAt s sub i j m = False.

# substring [a..b] inclusive
strSlice s a b = sliceGo s a b "".
sliceGo s i b acc | i > b = acc.
sliceGo s i b acc = sliceGo s (i + 1) b (strcat acc (chr (charAt s i))).

# parse a decimal starting at i, skipping leading spaces
parseIntAt s i = piSkip s i (String.len s).
piSkip s i n | i > n = 0.
piSkip s i n = piSkip2 s i n (charAt s i).
piSkip2 s i n 32 = piSkip s (i + 1) n.
piSkip2 s i n c = piGo s i n 0.
piGo s i n acc | i > n = acc.
piGo s i n acc = piGo2 s i n acc (charAt s i).
piGo2 s i n acc c | and2 (c >= 48) (c <= 57) = piGo s (i + 1) n (acc * 10 + (c - 48)).
piGo2 s i n acc c = acc.

# ---- JSON out ------------------------------------------------------------------

jesc s = jescGo s 1 (String.len s) "".
jescGo s i n acc | i > n = acc.
jescGo s i n acc = jescGo s (i + 1) n (strcat acc (jescCh (charAt s i))).
jescCh 34 = "\\\"".
jescCh 92 = "\\\\".
jescCh 10 = "\\n".
jescCh 13 = "".
jescCh 9 = "\\t".
jescCh c | c < 32 = " ".
jescCh c = chr c.

jstr s = strcat "\"" (strcat (jesc s) "\"").

# ["a","b",...] from a list of raw strings
jarr xs = strcat "[" (strcat (jarrGo xs "") "]").
jarrGo Nil acc = acc.
jarrGo (s :: r) acc | acc == "" = jarrGo r (jstr s).
jarrGo (s :: r) acc = jarrGo r (strcat acc (strcat "," (jstr s))).

# ---- JSON in: extract a string field (ascii, \" \\ \n \t \/ escapes) ----------

jsonStr body key =
  k = strcat "\"" (strcat key "\"");
  jsonAt body (findSub body k 1) (String.len k).
jsonAt body 0 kn = Err "missing field".
jsonAt body p kn = jsonStr2 body (jsAfterColon body (p + kn)).
jsAfterColon s i = jsSkip s i (String.len s).
jsSkip s i n | i > n = 0.
jsSkip s i n = jsSkip2 s i n (charAt s i).
jsSkip2 s i n c | or2 (c == 58) (or2 (c == 32) (or2 (c == 9) (or2 (c == 13) (c == 10)))) = jsSkip s (i + 1) n.
jsSkip2 s i n 34 = i + 1.
jsSkip2 s i n c = 0.
jsonStr2 body 0 = Err "field is not a string".
jsonStr2 body i = jsRead body i (String.len body) "".
jsRead s i n acc | i > n = Err "unterminated string".
jsRead s i n acc = jsRead2 s i n acc (charAt s i).
jsRead2 s i n acc 34 = Ok acc.
jsRead2 s i n acc 92 = jsEsc s (i + 1) n acc.
jsRead2 s i n acc c = jsRead s (i + 1) n (strcat acc (chr c)).
jsEsc s i n acc | i > n = Err "dangling escape".
jsEsc s i n acc = jsEsc2 s i n acc (charAt s i).
jsEsc2 s i n acc 110 = jsRead s (i + 1) n (strcat acc (chr 10)).
jsEsc2 s i n acc 116 = jsRead s (i + 1) n (strcat acc (chr 9)).
jsEsc2 s i n acc c = jsRead s (i + 1) n (strcat acc (chr c)).

# ---- request accumulation ------------------------------------------------------

# read until headers + declared body are in; Err on connection loss
readReq nd acc = readPolled (netPoll nd) nd acc.
readPolled 0 nd acc = Err "connection lost".
readPolled 2 nd acc = readTest nd (strcat acc (netRead nd)).
readPolled r nd acc = readTest nd acc.
readTest nd acc = readHdr nd acc (findSub acc (strcat crlf crlf) 1).
readHdr nd acc 0 = readReq nd acc.
readHdr nd acc he | String.len acc >= he + 3 + reqCLen acc he = Ok acc.
readHdr nd acc he = readReq nd acc.
reqCLen acc he =
  p = findSub acc "Content-Length:" 1;
  reqCLenAt acc p he.
reqCLenAt acc p he | and2 (p > 0) (p < he) = parseIntAt acc (p + 15).
reqCLenAt acc p he = 0.

# ---- request parse + routing ----------------------------------------------------

reqMethod s = strSlice s 1 (findSub s " " 1 - 1).
reqPath s =
  a = findSub s " " 1 + 1;
  strSlice s a (findSub s " " a - 1).
reqBody s =
  he = findSub s (strcat crlf crlf) 1;
  strSlice s (he + 4) (String.len s).

route "GET" "/" req n = httpResp "200 OK" apiInfo.
route "GET" "/status" req n = httpResp "200 OK" (statusJson n).
route "POST" "/run" req n = routeRun (jsonStr (reqBody req) "prog").
route m p req n = httpResp "404 Not Found" "\{\"ok\":false,\"error\":\"not found\"\}".

routeRun (Err m) = httpResp "400 Bad Request" (strcat "\{\"ok\":false,\"error\":" (strcat (jstr m) "\}")).
routeRun (Ok prog) =
  prog
  |> runStax
  |> runJson
  |> httpResp "200 OK".

runJson lines = strcat "\{\"ok\":true,\"lines\":" (strcat (jarr (dropColors lines)) "\}").
dropColors Nil = Nil.
dropColors ((_, t) :: r) = t :: dropColors r.

apiInfo = "\{\"service\":\"stax over QOS net HAL\",\"endpoints\":\{\"GET /status\":\"runtime counters\",\"POST /run\":\"\{\\\"prog\\\":\\\"1 2 + .\\\"\} -> stax log lines\"\}\}".

statusJson n =
  h = heapUsed Unit / 1024;
  p = fuelPreempts 0;
  a = arcLive 0;
  "\{\"ok\":true,\"heap_kib\":{h},\"preempts\":{p},\"arc_live\":{a},\"cmds\":{n}\}".

# ---- the server loop -------------------------------------------------------------

srv nd n = srvPolled (netPoll nd) nd n.
srvPolled 2 nd n = serve2 nd n (readReq nd "").
srvPolled r nd n = srv nd n.
serve2 nd n (Err e) = print "[http] dropped: {e}" >> srv nd n.
serve2 nd n (Ok req) = serve3 nd n req.
serve3 nd n req =
  m = reqMethod req;
  p = reqPath req;
  _ = print "[http] {m} {p}";
  _ = netWrite nd (route m p req n);
  _ = netClose nd;
  srv nd (n + 1).

main =
  nd = device "net";
  print "[httpd] serving on guest :80 (host :8000 via slirp hostfwd)" >>
  srv nd 0.
