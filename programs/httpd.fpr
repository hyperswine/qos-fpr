# ============================================================================
# httpd.fpr -- a JSON REST API over the HAL's virtio-net transport,
# with the stax VM as the application behind it.
#
#   GET  /        -> service description
#   GET  /status  -> live runtime counters (heap / preempts / arc / cmds)
#   POST /run     -> body {"prog": "1 2 + ."} -> stax log lines as JSON
#
# The HAL owns frames, ARP, IP and a one-connection TCP (see runtime/net.c
# for the honest simplifications); everything above the byte stream --
# request accumulation, HTTP parsing, routing, JSON in and out -- is FPRISC.
#
#   make image.elf PROG=programs/httpd.fpr && make run-net
#   curl localhost:8000/run -d '{"prog":"1 5 begin swap over * swap 1 - dup 0 = until drop ."}'
# ============================================================================

# ---- little prelude (shared by TUI and stax) --------------------------------

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
boolToInt b = case b of True -> 1 | False -> 0.

append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.
len xs = case xs of Nil -> 0 | _ :: t -> 1 + len t.

revGo xs acc = case xs of Nil -> acc | x :: r -> revGo r (x :: acc).
revList xs = revGo xs Nil.

takeN n xs = case n <= 0 of True -> Nil | False -> takeGo n xs.
takeGo n xs = case xs of Nil -> Nil | x :: r -> x :: takeN (n - 1) r.

maxI a b = case a > b of True -> a | False -> b.

strInit s = strTakeGo s 1 (strlen s - 1) "".
strTakeGo s i n acc =
  case i > n of
    True -> acc
  | False -> strTakeGo s (i + 1) n (strcat acc (chr (charAt s i))).


# ============================================================================
# STAX: the mini stack language -- parser combinators -> Ast -> bytecode -> VM
# (from stax.fpr; VM made TOTAL: Ok/Err + gas budget instead of `error`,
#  and `.` output captured into a line list instead of printed)
# ============================================================================

PRes  = Type (POk a Int | PFail String Int).
Ast   = Type (ANum Int | APrim String | AIf a b | ALoop a).
Instr = Type (IPush Int | IOp String | IJz Int | IJmp Int | IPrint).

isDigit b = and2 (b >= 48) (b <= 57).
isLetter2 b = or2 (and2 (b >= 97) (b <= 122)) (and2 (b >= 65) (b <= 90)).
isSpace2 b = or2 (b == 32) (or2 (b == 10) (or2 (b == 9) (b == 13))).
isSym b = or2 (b == 43) (or2 (b == 45) (or2 (b == 42) (or2 (b == 47)
          (or2 (b == 61) (or2 (b == 60) (or2 (b == 62) (b == 46))))))).

# parser : String -> Int -> PRes
pok v s i = POk v i.
pfail m s i = PFail m i.
pbind p f s i = case p s i of
    POk v j -> f v s j
  | PFail m j -> PFail m j.
palt p q s i = case p s i of
    POk v j -> POk v j
  | PFail _ _ -> q s i.
pmapK f v = pok (f v).
pmap f p s i = pbind p (pmapK f) s i.

skipWs s i | i > String.len s = i.
skipWs s i = skipWsB (charAt s i) s i.
skipWsB b s i | isSpace2 b = skipWs s (i + 1).
skipWsB b s i = i.

pdigit s i | i > String.len s = PFail "eof: digit" i.
pdigit s i = pdigitB (charAt s i) i.
pdigitB b i | isDigit b = POk (b - 48) (i + 1).
pdigitB b i = PFail "expected digit" i.

pletter s i | i > String.len s = PFail "eof: letter" i.
pletter s i = pletterB (charAt s i) i.
pletterB b i | isLetter2 b = POk b (i + 1).
pletterB b i = PFail "expected letter" i.

psym s i | i > String.len s = PFail "eof: sym" i.
psym s i = psymB (charAt s i) i.
psymB b i | isSym b = POk (chr b) (i + 1).
psymB b i = PFail "expected symbol" i.

pintAcc n s i = case pdigit s i of
    POk d j -> pintAcc (n * 10 + d) s j
  | PFail _ _ -> POk n i.
pint s i = pbind pdigit pintAcc s i.

plettersK b = plettersAcc (chr b).
plettersAcc acc s i = case pletter s i of
    POk b j -> plettersAcc (strcat acc (chr b)) s j
  | PFail _ _ -> POk acc i.
pletters s i = pbind pletter plettersK s i.

pword s i = palt pletters psym s i.

pkwChk k w = case w == k of True -> pok 1 | False -> pfail "expected {k}".
pkwRaw k s i = pbind pletters (pkwChk k) s i.
pkw k s i = pkwRaw k s (skipWs s i).

pnumT s i = pmap ANum pint s i.

ptermWord w = case w of
    "if" -> pif
  | "begin" -> ploop
  | "else" -> pfail "unexpected else"
  | "then" -> pfail "unexpected then"
  | "until" -> pfail "unexpected until"
  | _ -> pok (APrim w).
pwordT s i = pbind pword ptermWord s i.

ptermRaw s i = palt pnumT pwordT s i.
pterm s i = ptermRaw s (skipWs s i).

pseq s i = case pterm s i of
    POk t j -> pseqK t s j
  | PFail _ _ -> POk Nil i.
pseqK t s j = case pseq s j of
    POk ts k -> POk (t :: ts) k
  | PFail m k -> PFail m k.

pifElse thn s i =
  pbind (pkw "else") (fn u ->
    pbind pseq (fn els ->
      pbind (pkw "then") (fn u2 -> pok (AIf thn els)))) s i.
pifThen thn s i = pbind (pkw "then") (fn u -> pok (AIf thn Nil)) s i.
pifK thn = palt (pifElse thn) (pifThen thn).
pif s i = pbind pseq pifK s i.

ploop s i = pbind pseq (fn body -> pbind (pkw "until") (fn u -> pok (ALoop body))) s i.

parseEof src ts j = case j > String.len src of
    True -> Ok ts
  | False -> Err "unexpected input at byte {j}".
parseFin src r = case r of
    POk ts j -> parseEof src ts (skipWs src j)
  | PFail m j -> Err "at byte {j}: {m}".
parseProg src = parseFin src (pseq src 1).

# ---- compiler: Ast -> bytecode (absolute targets, single pass) --------------

compileSeq asts a = case asts of
    Nil -> (Nil, a)
  | t :: rest -> compileSeqCons t rest a.
compileSeqCons t rest a =
  (c1, a1) = compileOne t a;
  (c2, a2) = compileSeq rest a1;
  (append c1 c2, a2).
compileOne t a = case t of
    ANum n -> (IPush n :: Nil, a + 1)
  | APrim o -> compilePrim o a
  | AIf thn els -> compileIf thn els a
  | ALoop b -> compileLoop b a.
compilePrim o a = case o of
    "." -> (IPrint :: Nil, a + 1)
  | _ -> (IOp o :: Nil, a + 1).
compileIf thn els a =
  (ct, at) = compileSeq thn (a + 1);
  (ce, ae) = compileSeq els (at + 1);
  (append (IJz (at + 1) :: ct) (IJmp ae :: ce), ae).
compileLoop b a =
  (cb, ab) = compileSeq b a;
  (append cb (IJz a :: Nil), ab + 1).

# ---- the VM, made total: Result-valued ops, gas budget, captured output -----

addI a b = a + b.
subI a b = a - b.
mulI a b = a * b.
divI a b = a / b.
eqI a b = boolToInt (a == b).
ltI a b = boolToInt (a < b).
gtI a b = boolToInt (a > b).

binOp f st = case st of
    b :: rest -> binOp2 f b rest
  | Nil -> Err "vm: stack underflow (need 2)".
binOp2 f b st = case st of
    a :: r -> Ok (f a b :: r)
  | Nil -> Err "vm: stack underflow (need 2)".

dupOp st = case st of x :: r -> Ok (x :: x :: r) | Nil -> Err "vm: stack underflow".
dropOp st = case st of _ :: r -> Ok r | Nil -> Err "vm: stack underflow".

swapK t s r = s :: t :: r.
overK t s r = s :: t :: s :: r.
binOp2K k st = case st of
    t :: rest -> binOp2K2 k t rest
  | Nil -> Err "vm: stack underflow (need 2)".
binOp2K2 k t st = case st of
    s :: r -> Ok (k t s r)
  | Nil -> Err "vm: stack underflow (need 2)".

divChk st = case st of
    0 :: _ -> Err "vm: division by zero"
  | _ -> binOp divI st.

applyOp o st = case o of
    "+" -> binOp addI st
  | "-" -> binOp subI st
  | "*" -> binOp mulI st
  | "/" -> divChk st
  | "=" -> binOp eqI st
  | "<" -> binOp ltI st
  | ">" -> binOp gtI st
  | "dup" -> dupOp st
  | "drop" -> dropOp st
  | "swap" -> binOp2K swapK st
  | "over" -> binOp2K overK st
  | _ -> Err "vm: unknown op '{o}'".

runVM code n pc st out gas =
  case gas <= 0 of
    True -> Err "vm: out of gas (100000 steps)"
  | False -> runVM2 code n pc st out gas.
runVM2 code n pc st out gas =
  case pc > n of
    True -> Ok (st, out)
  | False -> step code n pc (code ! pc) st out gas.
step code n pc ins st out gas = case ins of
    IPush v -> runVM code n (pc + 1) (v :: st) out (gas - 1)
  | IOp o -> stepOp code n pc (applyOp o st) out gas
  | IJmp t -> runVM code n t st out (gas - 1)
  | IJz t -> stepJz code n pc t st out gas
  | IPrint -> stepPrint code n pc st out gas.
stepOp code n pc r out gas = case r of
    Ok st2 -> runVM code n (pc + 1) st2 out (gas - 1)
  | Err m -> Err m.
stepJz code n pc t st out gas = case st of
    0 :: rest -> runVM code n t rest out (gas - 1)
  | _ :: rest -> runVM code n (pc + 1) rest out (gas - 1)
  | Nil -> Err "vm: jz: stack underflow".
stepPrint code n pc st out gas = case st of
    x :: rest -> runVM code n (pc + 1) rest ("output: {x}" :: out) (gas - 1)
  | Nil -> Err "vm: print: stack underflow".

# ---- REPL driver: source -> (color, text) log lines, oldest first -----------

showStack st = strcat "[" (strcat (joinC st) "]").
joinC xs = case xs of Nil -> "" | x :: r -> joinCGo "{x}" r.
joinCGo acc r = case r of Nil -> acc | x :: rest -> joinCGo (strcat acc ", {x}") rest.

runStax src = case parseProg src of
    Err m -> (2, "parse error: {m}") :: Nil
  | Ok ast -> runStax2 (compileSeq ast 1).
runStax2 cp = case cp of (code, _) -> runStax3 code (len code).
runStax3 code n = runStax4 (runVM code n 1 Nil Nil 100000).
runStax4 r = case r of
    Err m -> (2, m) :: Nil
  | Ok so -> runStax5 so.
runStax5 so =
  case so of
    (st, out) -> append (outLines (revList out)) ((0, "stack: {showStack st}") :: Nil).
outLines os = case os of Nil -> Nil | s :: r -> (0, s) :: outLines r.


# ---- HTTP wire bits ----------------------------------------------------------

crlf = strcat (chr 13) (chr 10).
hline s = strcat s crlf.

httpResp status body =
  n = String.len body;
  strcat (hline "HTTP/1.0 {status}")
  (strcat (hline "Content-Type: application/json")
  (strcat (hline "Content-Length: {n}")
  (strcat (hline "Connection: close")
  (strcat crlf body)))).

# ---- string scanning (1-indexed, charAt) --------------------------------------

# index of sub in s at or after `from`, 0 if absent
findSub s sub from =
  n = String.len s;
  m = String.len sub;
  findGo s sub from n m.
findGo s sub i n m =
  case i + m - 1 > n of
    True -> 0
  | False -> findAt s sub i n m.
findAt s sub i n m =
  case matchAt s sub i 1 m of
    True -> i
  | False -> findGo s sub (i + 1) n m.
matchAt s sub i j m =
  case j > m of
    True -> True
  | False -> matchAt2 s sub i j m.
matchAt2 s sub i j m =
  case charAt s (i + j - 1) == charAt sub j of
    True -> matchAt s sub i (j + 1) m
  | False -> False.

# substring [a..b] inclusive
strSlice s a b = sliceGo s a b "".
sliceGo s i b acc =
  case i > b of
    True -> acc
  | False -> sliceGo s (i + 1) b (strcat acc (chr (charAt s i))).

# parse a decimal starting at i, skipping leading spaces
parseInt s i = piSkip s i (String.len s).
piSkip s i n =
  case i > n of
    True -> 0
  | False -> piSkip2 s i n (charAt s i).
piSkip2 s i n c =
  case c == 32 of
    True -> piSkip s (i + 1) n
  | False -> piGo s i n 0.
piGo s i n acc =
  case i > n of
    True -> acc
  | False -> piGo2 s i n acc (charAt s i).
piGo2 s i n acc c =
  case and2 (c >= 48) (c <= 57) of
    True -> piGo s (i + 1) n (acc * 10 + (c - 48))
  | False -> acc.

# ---- JSON out ------------------------------------------------------------------

jesc s = jescGo s 1 (String.len s) "".
jescGo s i n acc =
  case i > n of
    True -> acc
  | False -> jescGo s (i + 1) n (strcat acc (jescCh (charAt s i))).
jescCh c =
  case c of
    34 -> "\\\""
  | 92 -> "\\\\"
  | 10 -> "\\n"
  | 13 -> ""
  | 9  -> "\\t"
  | _  -> jescPr c.
jescPr c = case c < 32 of True -> " " | False -> chr c.

jstr s = strcat "\"" (strcat (jesc s) "\"").

# ["a","b",...] from a list of raw strings
jarr xs = strcat "[" (strcat (jarrGo xs "") "]").
jarrGo xs acc =
  case xs of
    Nil -> acc
  | s :: r -> jarrGo2 s r acc.
jarrGo2 s r acc =
  case acc == "" of
    True -> jarrGo r (jstr s)
  | False -> jarrGo r (strcat acc (strcat "," (jstr s))).

# ---- JSON in: extract a string field (ascii, \" \\ \n \t \/ escapes) ----------

jsonStr body key =
  k = strcat "\"" (strcat key "\"");
  p = findSub body k 1;
  case p of
    0 -> Err "missing field"
  | _ -> jsonStr2 body (jsAfterColon body (p + String.len k)).
jsAfterColon s i = jsSkip s i (String.len s).
jsSkip s i n =
  case i > n of
    True -> 0
  | False -> jsSkip2 s i n (charAt s i).
jsSkip2 s i n c =
  case or2 (c == 58) (or2 (c == 32) (or2 (c == 9) (or2 (c == 13) (c == 10)))) of
    True -> jsSkip s (i + 1) n
  | False -> jsOpen s i c.
jsOpen s i c = case c == 34 of True -> i + 1 | False -> 0.
jsonStr2 body i =
  case i of
    0 -> Err "field is not a string"
  | _ -> jsRead body i (String.len body) "".
jsRead s i n acc =
  case i > n of
    True -> Err "unterminated string"
  | False -> jsRead2 s i n acc (charAt s i).
jsRead2 s i n acc c =
  case c of
    34 -> Ok acc
  | 92 -> jsEsc s (i + 1) n acc
  | _  -> jsRead s (i + 1) n (strcat acc (chr c)).
jsEsc s i n acc =
  case i > n of
    True -> Err "dangling escape"
  | False -> jsEsc2 s i n acc (charAt s i).
jsEsc2 s i n acc c =
  case c of
    110 -> jsRead s (i + 1) n (strcat acc (chr 10))
  | 116 -> jsRead s (i + 1) n (strcat acc (chr 9))
  | _   -> jsRead s (i + 1) n (strcat acc (chr c)).

# ---- request accumulation ------------------------------------------------------

# read until headers + declared body are in; Err on connection loss
readReq nd acc =
  case netPoll nd of
    0 -> Err "connection lost"
  | 2 -> readMore nd acc
  | _ -> readTest nd acc.
readMore nd acc = readTest nd (strcat acc (netRead nd)).
readTest nd acc =
  he = findSub acc (strcat crlf crlf) 1;
  case he of
    0 -> readReq nd acc
  | _ -> readBody nd acc he.
readBody nd acc he =
  need = he + 3 + reqCLen acc he;
  case String.len acc >= need of
    True -> Ok acc
  | False -> readReq nd acc.
reqCLen acc he =
  p = findSub acc "Content-Length:" 1;
  case and2 (p > 0) (p < he) of
    True -> parseInt acc (p + 15)
  | False -> 0.

# ---- request parse + routing ----------------------------------------------------

reqMethod s = strSlice s 1 (findSub s " " 1 - 1).
reqPath s =
  a = findSub s " " 1 + 1;
  strSlice s a (findSub s " " a - 1).
reqBody s =
  he = findSub s (strcat crlf crlf) 1;
  strSlice s (he + 4) (String.len s).

route m p req n =
  case (m, p) of
    ("GET", "/") -> httpResp "200 OK" apiInfo
  | ("GET", "/status") -> httpResp "200 OK" (statusJson n)
  | ("POST", "/run") -> routeRun (jsonStr (reqBody req) "prog")
  | _ -> httpResp "404 Not Found" "\{\"ok\":false,\"error\":\"not found\"\}".
routeRun r =
  case r of
    Err m -> httpResp "400 Bad Request" (strcat "\{\"ok\":false,\"error\":" (strcat (jstr m) "\}"))
  | Ok prog -> httpResp "200 OK" (runJson (runStax prog)).
runJson lines = strcat "\{\"ok\":true,\"lines\":" (strcat (jarr (dropColors lines)) "\}").
dropColors ls = case ls of Nil -> Nil | (_, t) :: r -> t :: dropColors r.

apiInfo = "\{\"service\":\"stax over QOS net HAL\",\"endpoints\":\{\"GET /status\":\"runtime counters\",\"POST /run\":\"\{\\\"prog\\\":\\\"1 2 + .\\\"\} -> stax log lines\"\}\}".

statusJson n =
  h = heapUsed 0 / 1024;
  p = fuelPreempts 0;
  a = arcLive 0;
  "\{\"ok\":true,\"heap_kib\":{h},\"preempts\":{p},\"arc_live\":{a},\"cmds\":{n}\}".

# ---- the server loop -------------------------------------------------------------

srv nd n =
  case netPoll nd of
    2 -> serve nd n
  | _ -> srv nd n.
serve nd n =
  r = readReq nd "";
  serve2 nd n r.
serve2 nd n r =
  case r of
    Err e -> logDrop nd n e
  | Ok req -> serve3 nd n req.
logDrop nd n e = print "[http] dropped: {e}" >> srv nd n.
serve3 nd n req =
  m = reqMethod req;
  p = reqPath req;
  _ = print "[http] {m} {p}";
  _ = netWrite nd (route m p req n);
  _ = netClose nd;
  srv nd (n + 1).

main =
  nd = device "net";
  print "[httpd] serving on guest :80 (host :8000 via slirp hostfwd)" >>
  srv nd 0.
