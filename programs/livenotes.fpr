# ============================================================================
# livenotes.fpr -- FPRLive, fully in FP-RISC: a note-taking app served live.
#
#   THIS PROGRAM IS THE SERVER *AND* THE COMPILER *AND* THE REFERENCE.
#
#   * it holds the app: schema (reactive cells), static tree, computes,
#     input map, timing contract -- the note app itself
#   * it COMPILES every compute to the FPRLive client ISA (19 ops,
#     op:6|rd:5|rs1:5|rs2:5|imm:11, wide LI = LUI/ORI pair), content-
#     addressed by FNV-1a over a canonical rendering, deduplicated
#   * it EMITS the same `FPRL 1` image format the Haskell reference
#     emits -- the C backend parses it with no changes
#   * it INTERPRETS its own emitted words naively (every bind after
#     every event) to produce golden.txt -- conformance is defined by
#     this program, in this language, not by the Haskell reference
#   * it SERVES the whole thing over one TCP connection: image on
#     HELLO, golden on GOLDEN, then a live session -- `E <keycode>`
#     upstream, `P <slot> <word>` / `PS <slot> <text>` pushes + `A`
#     acks downstream.  Keys the client can settle locally (sel
#     up/down) are in the image's input map for optimistic latency;
#     the server's answer is authoritative (it clamps).
#
#   build:  make posix.bin PROG=programs/livenotes.fpr     (x64 linux)
#           make posix.bin PROG=programs/livenotes.fpr POSIXARCH=a64  (pi 4)
#   run:    FPR_PORT=8790 ./posix.bin
#   check:  tools/livenotes-check.sh     (golden vs client trace + contract)
#
#   label targets are resolved to WORD offsets (a wide LI costs two
#   words), which the reference's instruction-indexed resolver gets
#   wrong for any compute with a wide literal after a branch target.
# ============================================================================

# ---- little prelude ---------------------------------------------------------

and2 True b = b.
and2 False b = False.

or2 True b = True.
or2 False b = b.

append Nil ys = ys.
append (h :: t) ys = h :: append t ys.

len Nil = 0.
len (_ :: t) = 1 + len t.

revGo Nil acc = acc.
revGo (x :: r) acc = revGo r (x :: acc).
revList xs = revGo xs Nil.

elemI x Nil = False.
elemI x (y :: r) | x == y = True.
elemI x (y :: r) = elemI x r.

elemS x Nil = False.
elemS x (y :: r) | x == y = True.
elemS x (y :: r) = elemS x r.

nubS Nil = Nil.
nubS (x :: r) | elemS x r = nubS r.
nubS (x :: r) = x :: nubS r.

# insertion sort, ascending ints
insI x Nil = x :: Nil.
insI x (y :: r) | x <= y = x :: y :: r.
insI x (y :: r) = y :: insI x r.
sortI Nil = Nil.
sortI (x :: r) = insI x (sortI r).

nubI Nil = Nil.
nubI (x :: r) | elemI x r = nubI r.
nubI (x :: r) = x :: nubI r.

# index of string in list, 0-based; -1 if absent
idxS s xs = idxSGo s xs 0.
idxSGo s Nil i = 0 - 1.
idxSGo s (x :: r) i | x == s = i.
idxSGo s (x :: r) i = idxSGo s r (i + 1).

# nth of a list, 0-based (lists here are small; the `!` prim is 1-based)
nth (x :: r) 0 = x.
nth (x :: r) i = nth r (i - 1).

setNth (x :: r) 0 v = v :: r.
setNth (x :: r) i v = x :: setNth r (i - 1) v.

takeN n xs | n <= 0 = Nil.
takeN n Nil = Nil.
takeN n (x :: r) = x :: takeN (n - 1) r.

dropN n xs | n <= 0 = xs.
dropN n Nil = Nil.
dropN n (_ :: r) = dropN (n - 1) r.

maxI a b | a > b = a.
maxI a b = b.
minI a b | a < b = a.
minI a b = b.

strInit s = strTakeGo s 1 (strlen s - 1) "".
strTakeGo s i n acc | i > n = acc.
strTakeGo s i n acc = strTakeGo s (i + 1) n (strcat acc (chr (charAt s i))).

joinSpGo acc Nil = acc.
joinSpGo acc (x :: r) = joinSpGo (strcat acc (strcat " " x)) r.

# ---- proper floor division / modulo on possibly-negative ints ---------------
# (encoding needs arithmetic-shift semantics; `/` truncates toward zero)

fdiv n d | n >= 0 = n / d.
fdiv n d = (n - (d - 1)) / d.

fmod n d = n - (fdiv n d) * d.

# ---- fnv-1a 32 over a string, and 8-digit hex -------------------------------

band32 x = fmod x 4294967296.

# fnv-1a xors the incoming byte into the hash; xor via a bit loop
# (32 bits, powers of two -- no bitwise prims needed):
xorGo a b p acc | p > 2147483648 = acc.
xorGo a b p acc =
  ab = fmod (a / p) 2;
  bb = fmod (b / p) 2;
  xorGo a b (p * 2) (acc + (fmod (ab + bb) 2) * p).
xor32 a b = xorGo a b 1 0.

fnv1aGo s i n h | i > n = h.
fnv1aGo s i n h = fnv1aGo s (i + 1) n (band32 ((xor32 h (charAt s i)) * 16777619)).
fnv1a s = fnv1aGo s 1 (strlen s) 2166136261.

hexDig d | d < 10 = chr (48 + d).
hexDig d = chr (87 + d).
hex8Go v 0 acc = acc.
hex8Go v k acc = hex8Go (v / 16) (k - 1) (strcat (hexDig (fmod v 16)) acc).
hex8 v = hex8Go v 8 "".

# ============================================================================
# THE APP: a note pad.  4-row window over the note list, a status line,
# a live input line.  sel moves locally (optimistic) and is clamped by
# the server (authoritative); text only ever comes from the server.
# ============================================================================

# ---- reactive cells: (name, slot, ty)   ty: 0 Int, 1 Bool, 2 Str ------------

schema =
  ("sel",   0, 0) ::
  ("count", 1, 0) ::
  ("input", 2, 2) ::
  ("n0",    3, 2) ::
  ("n1",    4, 2) ::
  ("n2",    5, 2) ::
  ("n3",    6, 2) :: Nil.

# initial values: IW slot word | IS slot str
Init = Type (IW slot w | IS slot s).

inits =
  IW 0 0 ::
  IW 1 0 ::
  IS 2 "" ::
  IS 3 "" ::
  IS 4 "" ::
  IS 5 "" ::
  IS 6 "" :: Nil.

# ---- compute expressions ----------------------------------------------------

Ex = Type (EI n | ES s | ECl nm
         | EAdd a b | ESub a b | EMul a b | ELt a b | EEq a b
         | EAnd a b | EOr a b | ENot a | EI2S a | ECat a b
         | EIf c t e).

# the computes of the note app
rootClass = EIf (ELt (EI 0) (ECl "count")) (ES "notes-live") (ES "notes-empty").
statusText = ECat (ES "notes: ") (EI2S (ECl "count")).
rowClass i = EIf (EEq (ECl "sel") (EI i)) (ES "row-sel") (ES "row").
rowShow i = ELt (EI i) (ECl "count").
inputText = ECat (ES "> ") (ECl "input").

# ---- the static tree --------------------------------------------------------
#   Bi target attrName expr     target: 0 text, 1 attr, 2 class, 3 show
#   Nd tag attrs binds kids

Bi = Type (Bi tgt anm ex).
Nd = Type (Nd tag attrs binds kids).

rowNode i slotName =
  Nd "li" Nil
     (Bi 2 "" (rowClass i) :: Bi 0 "" (ECl slotName) :: Bi 3 "" (rowShow i) :: Nil)
     Nil.

appTree =
  Nd "div" (("id", "notes") :: Nil)
     (Bi 2 "" rootClass :: Nil)
     ( Nd "h1" Nil (Bi 0 "" statusText :: Nil) Nil
    :: rowNode 0 "n0"
    :: rowNode 1 "n1"
    :: rowNode 2 "n2"
    :: rowNode 3 "n3"
    :: Nd "input" Nil (Bi 0 "" inputText :: Nil) Nil
    :: Nd "footer" Nil (Bi 2 "" rootClass :: Nil) Nil   # identical compute: cache hit
    :: Nil).

# ---- input map: evdev keycode -> LOCAL cell mutation (op 0 set, 1 add, 2 toggle)
# only sel navigation is local; everything else round-trips.  the client
# forwards EVERY key upstream regardless; the server's pushes win.

Ky = Type (Ky code op slot arg).

keymapL =
  Ky 103 1 0 (0 - 1) ::     # KEY_UP    sel--  (optimistic; server clamps)
  Ky 108 1 0 1 :: Nil.      # KEY_DOWN  sel++

# ---- the timing contract ----------------------------------------------------

contractHz = 2.
contractLatUs = 20000.

# ---- the scripted timeline baked into the image (conformance mode) ----------
#   Ev ms kind a b     kind: 0 key, 2 idle checkpoint

Ev = Type (Ev ms kind a b).

script =
  Ev 150 0 35 0 ::      # h
  Ev 200 0 23 0 ::      # i
  Ev 280 0 28 0 ::      # enter -> note "hi"
  Ev 400 0 25 0 ::      # p
  Ev 430 0 23 0 ::      # i
  Ev 460 0 57 0 ::      # space
  Ev 500 0 24 0 ::      # o
  Ev 530 0 37 0 ::      # k
  Ev 600 0 28 0 ::      # enter -> note "pi ok"
  Ev 900 2 0 0 ::       # idle checkpoint
  Ev 1000 0 108 0 ::    # down (sel 0 -> 1)
  Ev 1050 0 108 0 ::    # down (clamped at 1: two notes)
  Ev 1100 0 103 0 ::    # up   (sel -> 0)
  Ev 1150 0 103 0 ::    # up   (clamped at 0)
  Ev 1300 0 20 0 ::     # t
  Ev 1330 0 24 0 ::     # o
  Ev 1360 0 14 0 ::     # backspace -> "t"
  Ev 1400 0 24 0 ::     # o
  Ev 1450 0 28 0 ::     # enter -> note "to"
  Ev 1600 0 108 0 ::    # down
  Ev 1700 0 111 0 ::    # delete selected note
  Ev 2000 2 0 0 ::      # idle checkpoint
  Ev 2400 0 46 0 ::     # c
  Ev 2450 0 28 0 ::     # enter -> note "c"
  Ev 2900 2 0 0 :: Nil.

# evdev keycode -> ascii for the typing keys the server understands
keyChar 30 = "a". keyChar 48 = "b". keyChar 46 = "c". keyChar 32 = "d".
keyChar 18 = "e". keyChar 33 = "f". keyChar 34 = "g". keyChar 35 = "h".
keyChar 23 = "i". keyChar 36 = "j". keyChar 37 = "k". keyChar 38 = "l".
keyChar 50 = "m". keyChar 49 = "n". keyChar 24 = "o". keyChar 25 = "p".
keyChar 16 = "q". keyChar 19 = "r". keyChar 31 = "s". keyChar 20 = "t".
keyChar 22 = "u". keyChar 47 = "v". keyChar 17 = "w". keyChar 45 = "x".
keyChar 21 = "y". keyChar 44 = "z". keyChar 57 = " ".
keyChar 11 = "0". keyChar 2 = "1". keyChar 3 = "2". keyChar 4 = "3".
keyChar 5 = "4". keyChar 6 = "5". keyChar 7 = "6". keyChar 8 = "7".
keyChar 9 = "8". keyChar 10 = "9".
keyChar c = "".

# ============================================================================
# THE COMPILER: check -> lower -> resolve -> encode, content-addressed.
# ============================================================================

# ---- schema lookups ---------------------------------------------------------

schSlot nm = schSlotGo nm schema.
schSlotGo nm Nil = 0 - 1.
schSlotGo nm ((n, sl, ty) :: r) | n == nm = sl.
schSlotGo nm ((n, sl, ty) :: r) = schSlotGo nm r.

schTy nm = schTyGo nm schema.
schTyGo nm Nil = 0 - 1.
schTyGo nm ((n, sl, ty) :: r) | n == nm = ty.
schTyGo nm ((n, sl, ty) :: r) = schTyGo nm r.

# ---- canonical rendering (the content address is FNV-1a over this) ----------

renderEx (EI n) = "(i {n})".
renderEx (ES s) = "(s {s})".
renderEx (ECl nm) = "(c {nm})".
renderEx (EAdd a b) = renderBin "+" a b.
renderEx (ESub a b) = renderBin "-" a b.
renderEx (EMul a b) = renderBin "*" a b.
renderEx (ELt a b) = renderBin "<" a b.
renderEx (EEq a b) = renderBin "=" a b.
renderEx (EAnd a b) = renderBin "&" a b.
renderEx (EOr a b) = renderBin "^" a b.
renderEx (ECat a b) = renderBin "$" a b.
renderEx (ENot a) = "(! {renderEx a})".
renderEx (EI2S a) = "(# {renderEx a})".
renderEx (EIf c t e) = "(? {renderEx c} {renderEx t} {renderEx e})".
renderBin o a b = "({o} {renderEx a} {renderEx b})".

# ---- the checker: Ok tyCode | Err msg.  ty: 0 Int, 1 Bool, 2 Str ------------

tyName 0 = "Int".
tyName 1 = "Bool".
tyName 2 = "Str".
tyName t = "?".

checkEx (EI n) = Ok 0.
checkEx (ES s) = Ok 2.
checkEx (ECl nm) = checkCell nm (schTy nm).
checkEx (EAdd a b) = checkII "+" 0 a b.
checkEx (ESub a b) = checkII "-" 0 a b.
checkEx (EMul a b) = checkII "*" 0 a b.
checkEx (ELt a b) = checkII "<" 1 a b.
checkEx (EEq a b) = checkII "=" 1 a b.
checkEx (EAnd a b) = checkBB "and" a b.
checkEx (EOr a b) = checkBB "or" a b.
checkEx (ENot a) = checkUn "not" 1 1 a.
checkEx (EI2S a) = checkUn "i2s" 0 2 a.
checkEx (ECat a b) = checkCat a b.
checkEx (EIf c t e) = checkIf (checkEx c) (checkEx t) (checkEx e).

checkCell nm ty | ty < 0 = Err "unbound cell: {nm}".
checkCell nm ty = Ok ty.

# both operands must be Int; result ty is `res`
checkII o res a b = checkII2 o res (checkEx a) (checkEx b).
checkII2 o res (Ok 0) (Ok 0) = Ok res.
checkII2 o res (Err m) rb = Err m.
checkII2 o res ra (Err m) = Err m.
checkII2 o res (Ok ta) (Ok tb) = Err "{o}: expected Int/Int, got {tyName ta}/{tyName tb}".

checkBB o a b = checkBB2 o (checkEx a) (checkEx b).
checkBB2 o (Ok 1) (Ok 1) = Ok 1.
checkBB2 o (Err m) rb = Err m.
checkBB2 o ra (Err m) = Err m.
checkBB2 o ra rb = Err "{o}: expected Bool/Bool".

checkUn o want res a = checkUn2 o want res (checkEx a).
checkUn2 o want res (Err m) = Err m.
checkUn2 o want res (Ok t) | t == want = Ok res.
checkUn2 o want res (Ok t) = Err "{o}: expected {tyName want}, got {tyName t}".

checkCat a b = checkCat2 (checkEx a) (checkEx b).
checkCat2 (Ok 2) (Ok 2) = Ok 2.
checkCat2 (Err m) rb = Err m.
checkCat2 ra (Err m) = Err m.
checkCat2 ra rb = Err "cat: expected Str/Str".

checkIf (Err m) rt re = Err m.
checkIf rc (Err m) re = Err m.
checkIf rc rt (Err m) = Err m.
checkIf (Ok 1) (Ok tt) (Ok te) | tt == te = Ok tt.
checkIf (Ok 1) (Ok tt) (Ok te) = Err "if: branch mismatch {tyName tt} vs {tyName te}".
checkIf (Ok tc) rt re = Err "if: condition must be Bool".

# ---- dependencies (sorted, deduplicated slots) ------------------------------

depsGo (ECl nm) acc = schSlot nm :: acc.
depsGo (EAdd a b) acc = depsGo a (depsGo b acc).
depsGo (ESub a b) acc = depsGo a (depsGo b acc).
depsGo (EMul a b) acc = depsGo a (depsGo b acc).
depsGo (ELt a b) acc = depsGo a (depsGo b acc).
depsGo (EEq a b) acc = depsGo a (depsGo b acc).
depsGo (EAnd a b) acc = depsGo a (depsGo b acc).
depsGo (EOr a b) acc = depsGo a (depsGo b acc).
depsGo (ECat a b) acc = depsGo a (depsGo b acc).
depsGo (ENot a) acc = depsGo a acc.
depsGo (EI2S a) acc = depsGo a acc.
depsGo (EIf c t e) acc = depsGo c (depsGo t (depsGo e acc)).
depsGo e acc = acc.
depsOf e = sortI (nubI (depsGo e Nil)).

# ---- lowering ---------------------------------------------------------------
# gen state gs = (instrs-reversed, maxreg, nextlbl, pool-reversed)
# instruction set (labels symbolic until resolve):

In = Type (ILi d n | ILcon d k | ILcel d s
         | IAdd d a b | ISub d a b | IMul d a b | ISlt d a b | ISeq d a b
         | INot d a | ICat d a b | IItoa d a
         | IBeqz a l | IBnez a l | IJmp l | ILbl l | IRet a).

# gen state: GS instrs-reversed maxreg nextlbl pool-reversed
GSt = Type (GS is mr nl pl).

emitG i (GS is mr nl pl) = GS (i :: is) mr nl pl.
noteG d (GS is mr nl pl) = GS is (maxI mr d) nl pl.
newLblG (GS is mr nl pl) = (nl, GS is mr (nl + 1) pl).
internG s (GS is mr nl pl) = internG2 s (idxS s (revList pl)) (GS is mr nl pl).
internG2 s i gs | i >= 0 = (i, gs).
internG2 s i (GS is mr nl pl) = (len pl, GS is mr nl (s :: pl)).

# result lands in register d; d+1.. are scratch (naive, bounded by depth)
lowerE d (EI n) gs = emitG (ILi d n) (noteG d gs).
lowerE d (ES s) gs =
  (k, g1) = internG s gs;
  emitG (ILcon d k) (noteG d g1).
lowerE d (ECl nm) gs = emitG (ILcel d (schSlot nm)) (noteG d gs).
lowerE d (EAdd a b) gs = lowerBin d IAdd a b gs.
lowerE d (ESub a b) gs = lowerBin d ISub a b gs.
lowerE d (EMul a b) gs = lowerBin d IMul a b gs.
lowerE d (ELt a b) gs = lowerBin d ISlt a b gs.
lowerE d (EEq a b) gs = lowerBin d ISeq a b gs.
lowerE d (ECat a b) gs = lowerBin d ICat a b gs.
lowerE d (ENot a) gs = emitG (INot d d) (lowerE d a gs).
lowerE d (EI2S a) gs = emitG (IItoa d d) (lowerE d a gs).
lowerE d (EAnd a b) gs =
  (l, g1) = newLblG gs;
  g2 = lowerE d a g1;
  g3 = emitG (IBeqz d l) g2;
  g4 = lowerE d b g3;
  emitG (ILbl l) g4.
lowerE d (EOr a b) gs =
  (l, g1) = newLblG gs;
  g2 = lowerE d a g1;
  g3 = emitG (IBnez d l) g2;
  g4 = lowerE d b g3;
  emitG (ILbl l) g4.
lowerE d (EIf c t e) gs =
  (le, g1) = newLblG gs;
  (lend, g2) = newLblG g1;
  g3 = lowerE d c g2;
  g4 = emitG (IBeqz d le) g3;
  g5 = lowerE d t g4;
  g6 = emitG (IJmp lend) g5;
  g7 = emitG (ILbl le) g6;
  g8 = lowerE d e g7;
  emitG (ILbl lend) g8.

lowerBin d op a b gs =
  g1 = lowerE d a gs;
  g2 = lowerE (d + 1) b g1;
  g3 = noteG (d + 1) g2;
  emitG (op d d (d + 1)) g3.

# compile top: returns (nregs, poolStrs, instrs)
compileEx e =
  GS isR2 mr2 nl2 plR2 = emitG (IRet 0) (lowerE 0 e (GS Nil 0 0 Nil));
  (mr2 + 1, revList plR2, revList isR2).

# ---- label resolution to WORD offsets + encoding ----------------------------
# a word cost per instruction: wide LI costs 2 (LUI/ORI pair)

wideLi n = or2 (n < (0 - 1024)) (n >= 1024).
wcost (ILi d n) | wideLi n = 2.
wcost (ILbl l) = 0.
wcost i = 1.

# pass 1: label -> word pc
lblTabGo Nil pc acc = acc.
lblTabGo (ILbl l :: r) pc acc = lblTabGo r pc ((l, pc) :: acc).
lblTabGo (i :: r) pc acc = lblTabGo r (pc + wcost i) acc.
lblPc l tab = lblPcGo l tab.
lblPcGo l ((k, pc) :: r) | k == l = pc.
lblPcGo l ((k, pc) :: r) = lblPcGo l r.
lblPcGo l Nil = 0 - 1.

# the fixed-width word: op:6 | rd:5 | rs1:5 | rs2:5 | imm:11
wEnc op d a b imm = ((((op * 32 + d) * 32 + a) * 32 + b) * 2048) + fmod imm 2048.

# pass 2: encode (labels resolved through tab)
encIns tab (ILi d n) | wideLi n = wEnc 2 d 0 0 (fdiv n 2048) :: wEnc 3 d d 0 n :: Nil.
encIns tab (ILi d n) = wEnc 1 d 0 0 n :: Nil.
encIns tab (ILcon d k) = wEnc 4 d 0 0 k :: Nil.
encIns tab (ILcel d s) = wEnc 5 d 0 0 s :: Nil.
encIns tab (IAdd d a b) = wEnc 7 d a b 0 :: Nil.
encIns tab (ISub d a b) = wEnc 8 d a b 0 :: Nil.
encIns tab (IMul d a b) = wEnc 9 d a b 0 :: Nil.
encIns tab (ISlt d a b) = wEnc 10 d a b 0 :: Nil.
encIns tab (ISeq d a b) = wEnc 11 d a b 0 :: Nil.
encIns tab (INot d a) = wEnc 12 d a 0 0 :: Nil.
encIns tab (ICat d a b) = wEnc 13 d a b 0 :: Nil.
encIns tab (IItoa d a) = wEnc 14 d a 0 0 :: Nil.
encIns tab (IBeqz a l) = wEnc 15 0 a 0 (lblPc l tab) :: Nil.
encIns tab (IBnez a l) = wEnc 16 0 a 0 (lblPc l tab) :: Nil.
encIns tab (IJmp l) = wEnc 17 0 0 0 (lblPc l tab) :: Nil.
encIns tab (ILbl l) = Nil.
encIns tab (IRet a) = wEnc 18 0 a 0 0 :: Nil.

encAll tab Nil = Nil.
encAll tab (i :: r) = append (encIns tab i) (encAll tab r).

encodeIns instrs = encAll (lblTabGo instrs 0 Nil) instrs.

# ============================================================================
# FLATTEN: preorder node ids, bind ids in visit order (reference `flatten`).
# ============================================================================

FlatN = Type (FN nid par tag attrs).
FlatB = Type (FB bid nid tgt anm ex).
FSt = Type (FS nn bb nsr bsr).

flatBinds me Nil bb bsr = (bb, bsr).
flatBinds me (Bi tgt anm ex :: r) bb bsr =
  flatBinds me r (bb + 1) (FB bb me tgt anm ex :: bsr).

flatGo par (Nd tag attrs binds kids) (FS nn bb nsr bsr) =
  me = nn;
  (bb2, bsr2) = flatBinds me binds bb bsr;
  flatKids me kids (FS (nn + 1) bb2 (FN me par tag attrs :: nsr) bsr2).
flatKids me Nil st = st.
flatKids me (k :: r) st = flatKids me r (flatGo me k st).

flatten tree =
  FS nn bb nsr bsr = flatGo (0 - 1) tree (FS 0 0 Nil Nil);
  (revList nsr, revList bsr).

# ============================================================================
# CODE TABLE: compile each distinct compute once, first-use order.
#   CE hash ty nregs deps poolStrs words
# ============================================================================

CEnt = Type (CE h ty nregs deps pool words).

ceHas h Nil = False.
ceHas h (CE h2 ty nr dp pl ws :: r) | h2 == h = True.
ceHas h (CE h2 ty nr dp pl ws :: r) = ceHas h r.

ceIdx h tab = ceIdxGo h tab 0.
ceIdxGo h (CE h2 ty nr dp pl ws :: r) i | h2 == h = i.
ceIdxGo h (CE h2 ty nr dp pl ws :: r) i = ceIdxGo h r (i + 1).

buildCode ex =
  h = fnv1a (renderEx ex);
  buildCode2 ex h (checkEx ex).
buildCode2 ex h (Err m) = error "livenotes: compute rejected: {m}".
buildCode2 ex h (Ok ty) =
  (nregs, pool, instrs) = compileEx ex;
  CE h ty nregs (depsOf ex) pool (encodeIns instrs).

codeTabGo Nil tab hits = (revList tab, hits).
codeTabGo (FB bid nid tgt anm ex :: r) tab hits =
  codeTab2 (fnv1a (renderEx ex)) ex r tab hits.
codeTab2 h ex r tab hits | ceHas h tab = codeTabGo r tab (hits + 1).
codeTab2 h ex r tab hits = codeTabGo r (buildCode ex :: tab) hits.
codeTable fbinds = codeTabGo fbinds Nil 0.

# ============================================================================
# STRING TABLE: nub of tags, attrs, pool strings, initial Str values.
# ============================================================================

tagStrs Nil = Nil.
tagStrs (FN nid par tag attrs :: r) =
  tag :: append (attrStrs attrs) (tagStrs r).
attrStrs Nil = Nil.
attrStrs ((k, v) :: r) = k :: v :: attrStrs r.

anmStrs Nil = Nil.
anmStrs (FB bid nid tgt anm ex :: r) | anm == "" = anmStrs r.
anmStrs (FB bid nid tgt anm ex :: r) = anm :: anmStrs r.

poolStrs Nil = Nil.
poolStrs (CE h ty nr dp pl ws :: r) = append pl (poolStrs r).

initStrs Nil = Nil.
initStrs (IS sl s :: r) = s :: initStrs r.
initStrs (_ :: r) = initStrs r.

stringTable fns fbs tab =
  nubS (append (tagStrs fns)
       (append (anmStrs fbs)
       (append (poolStrs tab) (initStrs inits)))).

# ============================================================================
# IMAGE EMISSION: the exact FPRL 1 text format.
# ============================================================================

nl2 a b = strcat a (strcat b (chr 10)).
line1 s = strcat s (chr 10).

emitStrs strs =
  emitStrsGo strs 0 (line1 "strings {len strs}").
emitStrsGo Nil i acc = acc.
emitStrsGo (s :: r) i acc =
  emitStrsGo r (i + 1) (strcat acc (line1 "s {i} {strlen s} {s}")).

initWord strs (IW sl w) = w.
initWord strs (IS sl s) = idxS s strs.
initSlot (IW sl w) = sl.
initSlot (IS sl s) = sl.
initTy strs it = cellTyOf (initSlot it).
cellTyOf sl = cellTyGo sl schema.
cellTyGo sl Nil = 0.
cellTyGo sl ((n, s2, ty) :: r) | s2 == sl = ty.
cellTyGo sl ((n, s2, ty) :: r) = cellTyGo sl r.

emitCells strs =
  emitCellsGo strs inits (line1 "cells {len inits}").
emitCellsGo strs Nil acc = acc.
emitCellsGo strs (it :: r) acc =
  emitCellsGo strs r (strcat acc (line1 "c {initSlot it} {initTy strs it} {initWord strs it}")).

joinNums Nil acc = acc.
joinNums (x :: r) acc = joinNums r (strcat acc " {x}").

joinHexW Nil acc = acc.
joinHexW (w :: r) acc = joinHexW r (strcat acc (strcat " " (hex8 w))).

poolIdxs strs Nil acc = acc.
poolIdxs strs (s :: r) acc = poolIdxs strs r (strcat acc " {idxS s strs}").

emitCodes strs tab =
  emitCodesGo strs tab 0 (line1 "codes {len tab}").
emitCodesGo strs Nil i acc = acc.
emitCodesGo strs (CE h ty nr dp pl ws :: r) i acc =
  row = strcat "k {i} {hex8 h} {ty} {nr} {len dp}"
        (strcat (joinNums dp "")
        (strcat " {len pl}"
        (strcat (poolIdxs strs pl "")
        (strcat " {len ws}" (joinHexW ws "")))));
  emitCodesGo strs r (i + 1) (strcat acc (line1 row)).

attrIdxs strs Nil acc = acc.
attrIdxs strs ((k, v) :: r) acc =
  attrIdxs strs r (strcat acc " {idxS k strs} {idxS v strs}").

emitNodes strs fns =
  emitNodesGo strs fns (line1 "nodes {len fns}").
emitNodesGo strs Nil acc = acc.
emitNodesGo strs (FN nid par tag attrs :: r) acc =
  row = strcat "n {nid} {par} {idxS tag strs} {len attrs}" (attrIdxs strs attrs "");
  emitNodesGo strs r (strcat acc (line1 row)).

anmIdx strs anm | anm == "" = 0 - 1.
anmIdx strs anm = idxS anm strs.

emitBinds strs tab fbs =
  emitBindsGo strs tab fbs (line1 "binds {len fbs}").
emitBindsGo strs tab Nil acc = acc.
emitBindsGo strs tab (FB bid nid tgt anm ex :: r) acc =
  ci = ceIdx (fnv1a (renderEx ex)) tab;
  emitBindsGo strs tab r (strcat acc (line1 "b {bid} {nid} {tgt} {anmIdx strs anm} {ci}")).

emitKeys km =
  emitKeysGo km (line1 "keys {len km}").
emitKeysGo Nil acc = acc.
emitKeysGo (Ky code op slot arg :: r) acc =
  emitKeysGo r (strcat acc (line1 "y {code} {op} {slot} {arg}")).

emitScript evs =
  emitScriptGo evs (line1 "script {len evs}").
emitScriptGo Nil acc = acc.
emitScriptGo (Ev ms kind a b :: r) acc =
  emitScriptGo r (strcat acc (line1 "e {ms} {kind} {a} {b}")).

emitImage fns fbs tab strs =
  strcat (line1 "# FPRLive protocol image, emitted by livenotes.fpr (FP-RISC).")
  (strcat (line1 "FPRL 1")
  (strcat (line1 "contract {contractHz} {contractLatUs}")
  (strcat (emitStrs strs)
  (strcat (emitCells strs)
  (strcat (emitCodes strs tab)
  (strcat (emitNodes strs fns)
  (strcat (emitBinds strs tab fbs)
  (strcat (emitKeys keymapL) (emitScript script))))))))).

# ============================================================================
# THE INTERPRETER: executes the EMITTED words (not the Instr list) --
# golden.txt is produced by running exactly what ships in the image.
# Arena model matches the C backend: handles 0..nstr-1 are the string
# table; CAT/ITOA/pushes append.  LCON resolves through the code's pool
# to a global string-table handle, as the client does.
# ============================================================================

MC = Type (MC cells arena).

zeros8 = 0 :: 0 :: 0 :: 0 :: 0 :: 0 :: 0 :: 0 :: Nil.

sext11 imm | imm >= 1024 = imm - 2048.
sext11 imm = imm.

# exec state, packed to stay under the 8-arg PoC ABI:
EXs = Type (EX words pidx cells arena regs).

exGet (EX words pidx cells arena regs) a = nth regs a.
exSet (EX words pidx cells arena regs) d v = EX words pidx cells arena (setNth regs d v).
exAlloc (EX words pidx cells arena regs) sv =
  (len arena, EX words pidx cells (append arena (sv :: Nil)) regs).
exWord (EX words pidx cells arena regs) pc = nth words pc.

# one step; returns (value, arena')
runW ex pc =
  w = exWord ex pc;
  op = w / 67108864;
  a = fmod (w / 65536) 32;
  b = fmod (w / 2048) 32;
  imm = fmod w 2048;
  runOp ex pc op a b imm.

# OpR v: register result | OpS s: allocate string | OpB t: branch (t<0: fall)
OpV = Type (OpR v | OpS s | OpB t).

runOp ex pc 18 a b imm = exDone ex a.
runOp ex pc op a b imm = runOp2 ex pc (opValue ex op a b imm).

exDone (EX words pidx cells arena regs) a = (nth regs a, arena).

opValue ex 1 a b imm = OpR (sext11 imm).
opValue ex 2 a b imm = OpR ((sext11 imm) * 2048).
opValue ex 3 a b imm = OpR (exGet ex a + imm).            # ORI: disjoint bits
opValue (EX words pidx cells arena regs) 4 a b imm = OpR (nth pidx imm).
opValue (EX words pidx cells arena regs) 5 a b imm = OpR (nth cells imm).
opValue ex 6 a b imm = OpR (exGet ex a).
opValue ex 7 a b imm = OpR (exGet ex a + exGet ex b).
opValue ex 8 a b imm = OpR (exGet ex a - exGet ex b).
opValue ex 9 a b imm = OpR (exGet ex a * exGet ex b).
opValue ex 10 a b imm = OpR (boolW (exGet ex a < exGet ex b)).
opValue ex 11 a b imm = OpR (boolW (exGet ex a == exGet ex b)).
opValue ex 12 a b imm = OpR (boolW (exGet ex a == 0)).
opValue (EX words pidx cells arena regs) 13 a b imm =
  OpS (strcat (nth arena (nth regs a)) (nth arena (nth regs b))).
opValue ex 14 a b imm = OpS "{exGet ex a}".
opValue ex 15 a b imm = brIf (exGet ex a == 0) imm.
opValue ex 16 a b imm = brIf (exGet ex a == 1) imm.
opValue ex 17 a b imm = OpB imm.
opValue ex op a b imm = error "livenotes vm: bad opcode {op}".

boolW True = 1.
boolW False = 0.
brIf True t = OpB t.
brIf False t = OpB (0 - 1).

curD ex pc = fmod ((exWord ex pc) / 2097152) 32.

runOp2 ex pc (OpR v) = runW (exSet ex (curD ex pc) v) (pc + 1).
runOp2 ex pc (OpS sv) =
  (h, ex2) = exAlloc ex sv;
  runW (exSet ex2 (curD ex2 pc) h) (pc + 1).
runOp2 ex pc (OpB t) | t < 0 = runW ex (pc + 1).
runOp2 ex pc (OpB t) = runW ex t.

decodeV 0 w arena = "{w}".
decodeV 1 0 arena = "0".
decodeV 1 w arena = "1".
decodeV 2 w arena = nth arena w.
decodeV t w arena = "?".

# run one code entry against the machine; returns (renderedValue, machine')
execCE strs (CE h ty nr dp pl ws) (MC cells arena) =
  (v, arena2) = runW (EX ws (mapIdx strs pl) cells arena zeros8) 0;
  (decodeV ty v arena2, MC cells arena2).
mapIdx strs Nil = Nil.
mapIdx strs (s :: r) = idxS s strs :: mapIdx strs r.

# ============================================================================
# THE MODEL: the note pad, shared verbatim by golden generation and the
# live session -- one transition function, two consumers.
#   NM notes input sel        W = WI slot word | WS slot text
# ============================================================================

NM = Type (NM notes input selv).
W = Type (WI slot n | WS slot s).

shownOf notes = minI (len notes) 4.
clampSel v notes = maxI 0 (minI v (maxI 0 (shownOf notes - 1))).

pad4 xs | len xs >= 4 = takeN 4 xs.
pad4 xs = pad4 (append xs ("" :: Nil)).
windowOf notes = pad4 (dropN (maxI 0 (len notes - 4)) notes).

winWrites notes =
  (w0 :: (w1 :: (w2 :: (w3 :: Nil)))) = windowOf notes;
  WS 3 w0 :: WS 4 w1 :: WS 5 w2 :: WS 6 w3 :: Nil.

noteStep (NM notes input selv) 103 =
  s2 = clampSel (selv - 1) notes;
  (NM notes input s2, WI 0 s2 :: Nil).
noteStep (NM notes input selv) 108 =
  s2 = clampSel (selv + 1) notes;
  (NM notes input s2, WI 0 s2 :: Nil).
noteStep (NM notes input selv) 28 | input == "" = (NM notes input selv, Nil).
noteStep (NM notes input selv) 28 =
  notes2 = append notes (input :: Nil);
  s2 = clampSel selv notes2;
  (NM notes2 "" s2,
   WS 2 "" :: WI 1 (len notes2) :: WI 0 s2 :: winWrites notes2).
noteStep (NM notes input selv) 14 | strlen input == 0 = (NM notes input selv, Nil).
noteStep (NM notes input selv) 14 =
  i2 = strInit input;
  (NM notes i2 selv, WS 2 i2 :: Nil).
noteStep (NM notes input selv) 111 | len notes == 0 = (NM notes input selv, Nil).
noteStep (NM notes input selv) 111 =
  absIx = maxI 0 (len notes - 4) + selv;
  notes2 = append (takeN absIx notes) (dropN (absIx + 1) notes);
  s2 = clampSel selv notes2;
  (NM notes2 input s2,
   WI 1 (len notes2) :: WI 0 s2 :: winWrites notes2).
noteStep (NM notes input selv) code = noteType (NM notes input selv) (keyChar code).

noteType m "" = (m, Nil).
noteType (NM notes input selv) c | strlen input >= 40 = (NM notes input selv, Nil).
noteType (NM notes input selv) c =
  i2 = strcat input c;
  (NM notes i2 selv, WS 2 i2 :: Nil).

applyW (MC cells arena) (WI sl n) = MC (setNth cells sl n) arena.
applyW (MC cells arena) (WS sl s) = MC (setNth cells sl (len arena)) (append arena (s :: Nil)).
applyWs m Nil = m.
applyWs m (w :: r) = applyWs (applyW m w) r.

# ============================================================================
# GOLDEN: naive full re-evaluation of every bind after every scripted
# event, using the shared model and the emitted words.
# ============================================================================

seedCell strs (MC cells arena) (IW sl w) = MC (setNth cells sl w) arena.
seedCell strs (MC cells arena) (IS sl s) = MC (setNth cells sl (idxS s strs)) arena.
seedCells strs m Nil = m.
seedCells strs m (it :: r) = seedCells strs (seedCell strs m it) r.

repN 0 v = Nil.
repN n v = v :: repN (n - 1) v.

bootMachine strs = seedCells strs (MC (repN (len schema) 0) strs) inits.

# evaluate every bind in bid order, appending G lines; threads the machine
evalAll strs tab Nil m ei acc = (acc, m).
evalAll strs tab (FB bid nid tgt anm ex :: r) m ei acc =
  ce = nth tab (ceIdx (fnv1a (renderEx ex)) tab);
  (v, m2) = execCE strs ce m;
  evalAll strs tab r m2 ei (strcat acc (line1 "G {ei} {bid} {v}")).

goldenGo strs tab fbs Nil m nm ei acc = acc.
goldenGo strs tab fbs (Ev ms 0 code b :: r) m nm ei acc =
  (nm2, ws) = noteStep nm code;
  m2 = applyWs m ws;
  (acc2, m3) = evalAll strs tab fbs m2 ei acc;
  goldenGo strs tab fbs r m3 nm2 (ei + 1) acc2.
goldenGo strs tab fbs (Ev ms kind a b :: r) m nm ei acc =
  (acc2, m2) = evalAll strs tab fbs m ei acc;
  goldenGo strs tab fbs r m2 nm (ei + 1) acc2.

goldenText strs tab fbs =
  goldenGo strs tab fbs script (bootMachine strs) (NM Nil "" 0) 0 "".

# ============================================================================
# THE LIVE SESSION: one TCP connection.  HELLO -> image; GOLDEN -> golden
# trace; E <keycode> -> model step, pushes, ack; Q -> close (notes persist
# across connections -- the server owns the model).
# ============================================================================

sliceS s a b | a > b = "".
sliceS s a b = sliceGo s a b "".
sliceGo s i b acc | i > b = acc.
sliceGo s i b acc = sliceGo s (i + 1) b (strcat acc (chr (charAt s i))).

findNl s = findNlGo s 1 (strlen s).
findNlGo s i n | i > n = 0.
findNlGo s i n | charAt s i == 10 = i.
findNlGo s i n = findNlGo s (i + 1) n.

startsWith p s | strlen s < strlen p = False.
startsWith p s = swGo p s 1 (strlen p).
swGo p s i n | i > n = True.
swGo p s i n | charAt p i == charAt s i = swGo p s (i + 1) n.
swGo p s i n = False.

parseIntFrom s i = piGo2 s i (strlen s) 0.
piGo2 s i n acc | i > n = acc.
piGo2 s i n acc = piCh s i n acc (charAt s i).
piCh s i n acc c | and2 (c >= 48) (c <= 57) = piGo2 s (i + 1) n (acc * 10 + (c - 48)).
piCh s i n acc c = acc.

sendWrites nd Nil = 0.
sendWrites nd (WI sl n :: r) = netWrite nd (line1 "P {sl} {n}") >> sendWrites nd r.
sendWrites nd (WS sl sv :: r) = netWrite nd (line1 "PS {sl} {sv}") >> sendWrites nd r.

handleLine nd img gold m ln | ln == "HELLO" =
  _ = netWrite nd img;
  _ = netWrite nd (line1 "ENDIMG");
  m.
handleLine nd img gold m ln | ln == "GOLDEN" =
  _ = netWrite nd gold;
  _ = netWrite nd (line1 "ENDGOLDEN");
  m.
handleLine nd img gold m ln | ln == "Q" =
  _ = netClose nd;
  m.
handleLine nd img gold m ln | startsWith "E " ln =
  (m2, ws) = noteStep m (parseIntFrom ln 3);
  _ = sendWrites nd ws;
  _ = netWrite nd (line1 "A");
  m2.
handleLine nd img gold m ln = m.

srvLoop nd img gold m acc = srvPolled (netPoll nd) nd img gold m acc.
srvPolled 0 nd img gold m acc = srvLoop nd img gold m "".
srvPolled 2 nd img gold m acc = srvLines nd img gold m (strcat acc (netRead nd)).
srvPolled p nd img gold m acc = srvLoop nd img gold m acc.

srvLines nd img gold m acc = srvLine nd img gold m acc (findNl acc).
srvLine nd img gold m acc 0 = srvLoop nd img gold m acc.
srvLine nd img gold m acc p =
  m2 = handleLine nd img gold m (sliceS acc 1 (p - 1));
  srvLines nd img gold m2 (sliceS acc (p + 1) (strlen acc)).

# ============================================================================
# MAIN
# ============================================================================

main =
  (fns, fbs) = flatten appTree;
  (tab, hits) = codeTable fbs;
  strs = stringTable fns fbs tab;
  img = emitImage fns fbs tab strs;
  gold = goldenText strs tab fbs;
  _ = print "livenotes (FP-RISC): {len fns} nodes, {len fbs} binds, {len tab} codes ({hits} cache hits), {len strs} strings";
  _ = print "livenotes: image {strlen img} bytes, golden {strlen gold} bytes";
  nd = device "net";
  _ = print "[livenotes] FPRLive server up (FPR_PORT picks the host port)";
  srvLoop nd img gold (NM Nil "" 0) "".
