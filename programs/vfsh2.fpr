# vfsh2.fpr -- the namespace shell, generation 2: MULTIPLE PROGRAMS.
#
#   reader ----Line----> terminal (main, actor 0: the MVU app)
#   termSrv --Notice---> terminal            mounted at /dev/term
#                                            (a Write to that path IS a
#                                             message to actor 0)
#   vfs: owns the tree. Forwards to mounts NON-BLOCKINGLY, passing the
#        ORIGINAL replyTo through -- the mount answers the client
#        directly. The vfs is never in a wait state, so no cycle of
#        blocked servers can pass through it: the app->vfs->app relay
#        deadlock of vfsh v1 is structurally gone.
#   /srv: the registry (Plan 9 flavor). A program sends
#        (me, Mount name handle) to the vfs and appears at /srv/name.
#
# Two PROGRAMS boot alongside the shell, each with its own actor set:
#
#   clock  = front actor + a spinner actor that NEVER yields and never
#            blocks -- pure fuel-based preemption keeps the shell alive.
#            serves /srv/clock/{ticks,readme}; every few ticks it writes
#            "clock: tick N" to /dev/term through the namespace.
#   greet  = front actor + worker actor. `write /srv/greet <name>` makes
#            the front ACK immediately and hand the job to its worker,
#            which composes the greeting and writes it to /dev/term --
#            a message that hops shell -> vfs -> front -> worker -> vfs
#            -> termSrv -> terminal, every hop a per-sender channel.
#
# What the new runtime buys, visibly:
#   - rpc is now `send; receiveRes` -- the stash-and-replay machinery
#     that v1 needed to survive the reply/keyboard interleave is DELETED.
#     Selective receive over per-sender channels made the bug
#     unrepresentable instead of handled.
#   - the fronts serve vfs requests and their internal traffic from the
#     same fair receive; while they wait on an RPC of their own,
#     receiveRes skips past queued requests without disturbing them.
#   - the spinner burns CPU forever; type at the prompt anyway.

# ---- protocol ---------------------------------------------------------

Req = Type (Ls p | Cat p | Stat p | Write p String | Mount String h).

# messages to the terminal: keyboard lines and app notices
TMsg = Type (Line String | Notice String).

# app-internal messages
CMsg = Type (Tick Int | CReq h req).
GMsg = Type (Job String).

# ---- the namespace tree ------------------------------------------------

Node = Type (FNode String | DNode es | MNode h).
Res = Type (RFound n | RMount h p | RErr String).

# ---- tiny console over raw MMIO (registers passed in, never remade) ----

isOdd v = Int.mod v 2 == 1.

putc con c =
  (lsr, dat) = con;
  putcW lsr dat c.
putcW lsr dat c = putcV lsr dat c (read lsr).
putcV lsr dat c v | isOdd (v / 32) = write dat c.
putcV lsr dat c v = putcW lsr dat c.

puts con s = putsFrom con s 1 (strlen s).
putsFrom con s i n | i > n = Unit.
putsFrom con s i n = putc con (charAt s i) >> putsFrom con s (i + 1) n.

nl con = putc con 13 >> putc con 10.
putLn con s = puts con s >> nl con.

getc me con =
  (lsr, dat) = con;
  getcW me lsr dat.
getcW me lsr dat = getcV me lsr dat (read lsr).
getcV me lsr dat v | isOdd v = read dat.
getcV me lsr dat v = yield me >> getcW me lsr dat.

# ---- string / list utilities -------------------------------------------

revGo Nil acc = acc.
revGo (x :: r) acc = revGo r (x :: acc).
revList xs = revGo xs Nil.

strInit s = strTakeGo s 1 (strlen s - 1) "".
strTakeGo s i n acc | i > n = acc.
strTakeGo s i n acc = strTakeGo s (i + 1) n (strcat acc (chr (charAt s i))).

split c s = splitGo c s 1 (strlen s) "" Nil.
splitGo c s i n cur acc | i > n = revList (pushTok cur acc).
splitGo c s i n cur acc = splitCh c s i n cur acc (charAt s i).
splitCh c s i n cur acc ch | ch == c = splitGo c s (i + 1) n "" (pushTok cur acc).
splitCh c s i n cur acc ch = splitGo c s (i + 1) n (strcat cur (chr ch)) acc.
pushTok "" acc = acc.
pushTok cur acc = cur :: acc.

joinSp Nil = "".
joinSp (x :: r) = joinGo x r.
joinGo acc Nil = acc.
joinGo acc (x :: rest) = joinGo (strcat acc (strcat " " x)) rest.

# ---- paths ---------------------------------------------------------------

normGo stack Nil = revList stack.
normGo stack ("." :: rest) = normGo stack rest.
normGo stack (".." :: rest) = normGo (dropTop stack) rest.
normGo stack (seg :: rest) = normGo (seg :: stack) rest.
dropTop Nil = Nil.
dropTop (_ :: r) = r.

absPath cwd s | strlen s == 0 = cwd.
absPath cwd s | charAt s 1 == 47 = normGo Nil (split 47 s).
absPath cwd s = normGo (revList cwd) (split 47 s).

renderPath Nil = "/".
renderPath p = renderGo p "".
renderGo Nil acc = acc.
renderGo (s :: r) acc = renderGo r (strcat acc (strcat "/" s)).

# ---- VFS resolution ------------------------------------------------------

lookupE name Nil = Err "no such entry".
lookupE name ((len, lnode) :: lrest) | len == name = Ok lnode.
lookupE name ((len, lnode) :: lrest) = lookupE name lrest.

resolve (MNode h) path = RMount h path.
resolve (FNode c) Nil = RFound (FNode c).
resolve (FNode c) path = RErr "not a directory".
resolve (DNode es) Nil = RFound (DNode es).
resolve (DNode es) (seg :: rest) = resolveChild seg rest es.
resolveChild seg rest es = resolveHit rest (lookupE seg es).
resolveHit rest (Ok child) = resolve child rest.
resolveHit rest (Err e) = RErr "no such path".

reqPath (Ls p) = p.
reqPath (Cat p) = p.
reqPath (Stat p) = p.
reqPath (Write p _) = p.
reqPath r = Nil.

reqWith (Ls _) p = Ls p.
reqWith (Cat _) p = Cat p.
reqWith (Stat _) p = Stat p.
reqWith (Write _ c) p = Write p c.
reqWith r p = r.

# local answers (never see MNode: resolve already peeled those off).
# NB there is deliberately no single `answer req node`: ls replies
# Ok (List String) while cat replies Ok String, so one function would
# have to unify the two payloads. vfsDispatch below dispatches per
# request constructor instead -- each send instantiates its own type.
answerLs (DNode es) = Ok (decorate es).
answerLs node = Err "not a directory".

decorate Nil = Nil.
decorate ((den, denode) :: derest) = decor1 den denode :: decorate derest.
decor1 n (DNode _) = strcat n "/".
decor1 n (MNode _) = strcat n "@".
decor1 n (FNode _) = n.

answerCat (FNode c) = Ok c.
answerCat node = Err "is a directory".
answerStat (FNode _) = Ok "file".
answerStat node = Ok "dir".

# ---- dynamic mounts: /srv ------------------------------------------------
# Mount name h grafts ("name", MNode h) into the "srv" directory. The
# tree is immutable data; the vfs loop just tail-recurses on the new one.

mountAt (DNode ents) name h = DNode (graftSrv ents name h).
mountAt tree name h = tree.
graftSrv Nil name h = Nil.
graftSrv ((grn, grnode) :: grrest) name h | grn == "srv" = (grn, srvAdd grnode name h) :: grrest.
graftSrv ((grn, grnode) :: grrest) name h = (grn, grnode) :: graftSrv grrest name h.
srvAdd (DNode es) name h = DNode ((name, MNode h) :: es).
srvAdd node name h = node.

# ---- the VFS actor -------------------------------------------------------
# NON-BLOCKING: a forward passes the ORIGINAL replyTo, so the mounted
# app answers the client directly and the vfs immediately serves its
# next request. The vfs holds no conversation state and never waits --
# which is exactly why programs that are THEMSELVES mounts can safely
# RPC through it (clock writing to /dev/term while someone cats
# /srv/clock/ticks: no relay, no cycle, no deadlock).

vfs tree me = vfsLoop me tree.
vfsLoop me tree =
  m = receive me;
  case m of
    (replyTo, req) -> vfsHandle me tree replyTo req m
  | _ -> vfsLoop me tree.
vfsHandle me tree replyTo req m =
  _ = drop m;
  case req of
    Mount name h -> send replyTo (Ok "mounted at /srv/{name}") >> vfsLoop me (mountAt tree name h)
  | _ -> vfsDispatch replyTo req (resolve tree (reqPath req)) >> vfsLoop me tree.
vfsDispatch replyTo req (RErr msg) = send replyTo (Err msg).
vfsDispatch replyTo req (RMount h rest) = send h (replyTo, reqWith req rest).
vfsDispatch replyTo (Ls _) (RFound node) = send replyTo (answerLs node).
vfsDispatch replyTo (Cat _) (RFound node) = send replyTo (answerCat node).
vfsDispatch replyTo (Stat _) (RFound node) = send replyTo (answerStat node).
vfsDispatch replyTo (Write _ _) (RFound node) = send replyTo (Err "read-only (writes only land on live mounts: try /dev/term or /srv/greet)").
vfsDispatch replyTo req (RFound node) = send replyTo (Err "unsupported").

# ---- rpc: send, then selectively receive the reply -------------------------
# The reply may come from the vfs OR directly from whatever mount the
# request was forwarded to -- the client doesn't know and doesn't care:
# receiveRes takes the next Ok/Err from ANY per-sender channel, skipping
# past (and preserving) everything else. vfsh v1's stash-and-replay
# emulation of exactly this is gone.

rpc me v req = send v (me, req) >> receiveRes me.

# ---- /dev/term: the terminal as a file -------------------------------------
# A Write here becomes a Notice message to actor 0. Reply FIRST, notify
# second: if the writer is main itself (write /dev/term hi), the reply
# must be at the head of this channel when receiveRes scans it.

termSrv term me = tsLoop term me.
tsLoop term me =
  m = receive me;
  case m of
    (replyTo, req) -> tsServe term replyTo req >> drop m >> tsLoop term me
  | _ -> tsLoop term me.
tsServe term replyTo (Write p s) = tsWrite term replyTo p s.
tsServe term replyTo (Ls p) = send replyTo (tsLs p).
tsServe term replyTo (Cat p) = send replyTo (tsCat p).
tsServe term replyTo (Stat p) = send replyTo (Ok "file").
tsServe term replyTo req = send replyTo (Err "unsupported").

tsWrite term replyTo Nil s = send replyTo (Ok "delivered to actor 0") >> send term (Notice s).
tsWrite term replyTo p s = send replyTo (Err "not a directory").

tsLs p = Err "not a directory".
tsCat Nil = Ok "the terminal. write here and the text becomes a Notice message to actor 0".
tsCat p = Err "not a directory".

# ---- /proc: answers from live hardware and the live runtime ----------------

procApp mt me = procLoop mt me.
procLoop mt me =
  m = receive me;
  (replyTo, req) = m;
  procServe mt replyTo req >> drop m >> procLoop mt me.
# per-request clauses so ls (Ok (List String)) and cat (Ok String) each
# instantiate their own reply type at their own send
procServe mt replyTo (Ls p) = send replyTo (procLs p).
procServe mt replyTo (Cat p) = send replyTo (procCat mt p).
procServe mt replyTo (Stat p) = send replyTo (procStat p).
procServe mt replyTo req = send replyTo (Err "read-only").

procLs Nil = Ok ["uptime", "arc", "heap", "fuel"].
procLs p = Err "not a directory".

procCat mt ("uptime" :: Nil) = Ok "mtime = {read mt} ticks   (read from the CLINT the moment you ran cat)".
procCat mt ("arc" :: Nil) = Ok "arc live objects: {arcLive 0}".
procCat mt ("heap" :: Nil) = Ok "heap claimed: {heapUsed Unit} bytes".
procCat mt ("fuel" :: Nil) = Ok "quantum {fuelQuantum 0} calls/slice; preemptions so far: {fuelPreempts 0}".
procCat mt Nil = Err "is a directory".
procCat mt p = Err "no such file".

procStat Nil = Ok "dir".
procStat (_ :: Nil) = Ok "file".
procStat p = Err "no such path".

# ---- /apps/counter: unchanged from v1 (reads bump live state) --------------

counterApp me = counterSrv me 0.
counterSrv me n =
  m = receive me;
  (replyTo, req) = m;
  counterStep me n replyTo req m.
counterStep me n replyTo req m =
  _ = counterServe n replyTo req;
  _ = drop m;
  counterSrv me (counterNext n req).
counterNext n (Cat ("value" :: Nil)) = n + 1.
counterNext n req = n.

counterServe n replyTo (Ls p) = send replyTo (counterLs p).
counterServe n replyTo (Cat p) = send replyTo (counterCat n p).
counterServe n replyTo (Stat p) = send replyTo (counterStat p).
counterServe n replyTo req = send replyTo (Err "unsupported").

counterLs Nil = Ok ["value", "readme"].
counterLs p = Err "not a directory".

counterCat n ("value" :: Nil) = Ok "{n}".
counterCat n ("readme" :: Nil) = Ok "each cat of value bumps a live actor; the number is its state".
counterCat n Nil = Err "is a directory".
counterCat n p = Err "no such file".

counterStat Nil = Ok "dir".
counterStat ("value" :: Nil) = Ok "file".
counterStat ("readme" :: Nil) = Ok "file".
counterStat p = Err "no such path".

# ==== PROGRAM 1: clock =======================================================
# Registers /srv/clock, then spawns its spinner. The spinner is the
# fuel demo: a tail loop that never yields, never blocks, never
# allocates on the countdown path -- under v1's purely cooperative
# scheduler it would freeze the machine at boot. The compiler-inserted
# fuel check at every function entry deschedules it ~each 2000 calls.

clockSpinStart front me2 = clockSpin front 1 1500000.
clockSpin front n 0 = send front (Tick n) >> clockSpin front (n + 1) 1500000.
clockSpin front n k = clockSpin front n (k - 1).

# the vfs forwards RAW (replyTo, req) tuples to every mount, but the
# front's own spinner speaks Tick -- one mailbox, two shapes. The
# bridge actor normalizes the envelope: it is what gets MOUNTED, and
# it re-wraps each forward as CReq, so the front's receive is one
# honestly-typed CMsg from either sender.
clockBridge front me =
  m = receive me;
  (replyTo, req) = m;
  send front (CReq replyTo req) >> drop m >> clockBridge front me.

clockFront v me =
  br = spawn (clockBridge me);
  r = rpc me v (Mount "clock" br);
  _ = drop r;
  _ = spawn (clockSpinStart me);
  cfLoop me v 0.
cfLoop me v n =
  m = receive me;
  cfDispatch me v n m.
cfDispatch me v n m =
  case m of
    Tick t -> drop m >> cfTick me v t
  | CReq replyTo req -> cfServe me v n replyTo req m.
cfTick me v t | t - (t / 4) * 4 == 0 = cfNotify me v t.
cfTick me v t = cfLoop me v t.
cfNotify me v t =
  r = rpc me v (Write ("dev" :: "term" :: Nil) "clock: tick {t}");
  drop r >> cfLoop me v t.
cfServe me v n replyTo (Ls p) m = drop m >> send replyTo (cfLs p) >> cfLoop me v n.
cfServe me v n replyTo (Cat p) m = drop m >> send replyTo (cfCat n p) >> cfLoop me v n.
cfServe me v n replyTo (Stat p) m = drop m >> send replyTo (cfStat p) >> cfLoop me v n.
cfServe me v n replyTo req m = drop m >> send replyTo (Err "read-only") >> cfLoop me v n.

cfLs Nil = Ok ["ticks", "readme"].
cfLs p = Err "not a directory".

cfCat n ("ticks" :: Nil) = Ok "{n}".
cfCat n ("readme" :: Nil) = Ok "the tick count of a spinner actor that NEVER yields; fuel preemption keeps this shell alive under it".
cfCat n Nil = Err "is a directory".
cfCat n p = Err "no such file".

cfStat Nil = Ok "dir".
cfStat (_ :: Nil) = Ok "file".
cfStat p = Err "no such path".

# ==== PROGRAM 2: greet =======================================================
# Registers /srv/greet, spawns a worker. `write /srv/greet <name>` --
# the front ACKs the writer immediately and delegates; the worker
# composes the greeting and writes it back through the NAMESPACE to
# /dev/term. Count of greetings served at /srv/greet/count.

greetWorker v me = gwLoop v me.
gwLoop v me =
  m = receive me;
  Job s = m;
  gwRun v me s m.
gwRun v me s m =
  r = rpc me v (Write ("dev" :: "term" :: Nil) "greet: hello, {s}!");
  drop r >> drop m >> gwLoop v me.

greetFront v me =
  r = rpc me v (Mount "greet" me);
  _ = drop r;
  w = spawn (greetWorker v);
  gfLoop me w 0.
gfLoop me w n =
  m = receive me;
  (replyTo, req) = m;
  gfServe me w n replyTo req m.
gfServe me w n replyTo (Write p s) m = drop m >> gfWrite me w n replyTo p s.
gfServe me w n replyTo (Ls p) m = drop m >> send replyTo (gfLs p) >> gfLoop me w n.
gfServe me w n replyTo (Cat p) m = drop m >> send replyTo (gfCat n p) >> gfLoop me w n.
gfServe me w n replyTo (Stat p) m = drop m >> send replyTo (gfStat p) >> gfLoop me w n.
gfServe me w n replyTo req m = drop m >> send replyTo (Err "unsupported") >> gfLoop me w n.

gfWrite me w n replyTo Nil s = send replyTo (Ok "accepted -- a worker actor will greet you") >> send w (Job s) >> gfLoop me w (n + 1).
gfWrite me w n replyTo p s = send replyTo (Err "no such file") >> gfLoop me w n.

gfLs Nil = Ok ["count", "readme"].
gfLs p = Err "not a directory".

gfCat n ("count" :: Nil) = Ok "{n} greetings delivered".
gfCat n ("readme" :: Nil) = Ok "write /srv/greet <name> -- the front ACKs, its worker greets you via /dev/term".
gfCat n Nil = Err "is a directory".
gfCat n p = Err "no such file".

gfStat Nil = Ok "dir".
gfStat (_ :: Nil) = Ok "file".
gfStat p = Err "no such path".

# ---- the reader actor: UART RX + line editing ------------------------------

reader term con me = readLoop term con me "".
readLoop term con me buf = readCh term con me buf (getc me con).
readCh term con me buf 13 = readEol term con me buf.
readCh term con me buf 10 = readEol term con me buf.
readCh term con me buf 8 = readBs term con me buf.
readCh term con me buf 127 = readBs term con me buf.
readCh term con me buf c = readPr term con me buf c.
readEol term con me buf =
  _ = nl con;
  _ = send term (Line buf);
  readLoop term con me "".
readBs term con me buf | strlen buf == 0 = readLoop term con me buf.
readBs term con me buf = putc con 8 >> putc con 32 >> putc con 8 >> readLoop term con me (strInit buf).
readPr term con me buf c | c < 32 = readLoop term con me buf.
readPr term con me buf c = putc con c >> readLoop term con me (strcat buf (chr c)).

# ---- the terminal: an MVU app (actor 0) ------------------------------------
#   Model = cwd    Msg = Line s (reader) | Notice s (termSrv)
# No pending stash, no rpcWait: per-sender channels + receiveRes replaced
# ~20 lines of interleave-defense with nothing.

termLoop me v con cwd =
  _ = puts con "qos:" >> puts con (renderPath cwd) >> puts con "$ ";
  termMsg me v con cwd (receive me).
termMsg me v con cwd m =
  case m of
    Line s -> termParse me v con cwd m (split 32 s)
  | Notice s -> termNotice me v con cwd m s.
termNotice me v con cwd m s =
  _ = nl con;
  _ = putLn con "[term] {s}";
  _ = drop m;
  termLoop me v con cwd.
termParse me v con cwd m toks =
  _ = drop m;
  termExec me v con cwd toks.
termExec me v con cwd Nil = termLoop me v con cwd.
termExec me v con cwd (cmd :: args) = termCmd me v con cwd cmd args.

termCmd me v con cwd "help" args = doHelp con >> termLoop me v con cwd.
termCmd me v con cwd "pwd" args = putLn con (renderPath cwd) >> termLoop me v con cwd.
termCmd me v con cwd "ls" args = doLs me v con cwd args.
termCmd me v con cwd "cd" args = doCd me v con cwd args.
termCmd me v con cwd "cat" args = doCat me v con cwd args.
termCmd me v con cwd "stat" args = doStat me v con cwd args.
termCmd me v con cwd "write" args = doWrite me v con cwd args.
termCmd me v con cwd "exit" args = putLn con "halting.".
termCmd me v con cwd cmd args = putLn con "{cmd}: unknown command   (try help)" >> termLoop me v con cwd.

doHelp con =
  putLn con "ls [p]      cd [p]      cat p      stat p      pwd      exit"
    >> putLn con "write p text...   write to a url; on a live mount it becomes a message"
    >> putLn con "programs register at /srv@; the terminal itself is /dev/term"
    >> putLn con "try: ls /srv ; cat /srv/clock/ticks ; write /srv/greet ada"
    >> putLn con "     write /dev/term hi ; cat /proc/fuel ; cat /apps/counter/value".

argPath cwd Nil = cwd.
argPath cwd (a :: _) = absPath cwd a.

doLs me v con cwd args =
  r = rpc me v (Ls (argPath cwd args));
  renderLs con r >> drop r >> termLoop me v con cwd.
renderLs con (Ok entries) = lsPrint con entries.
renderLs con (Err m) = putLn con "ls: {m}".
lsPrint con Nil = Unit.
lsPrint con (e :: rest) = putLn con e >> lsPrint con rest.

doCat me v con cwd Nil = putLn con "cat: missing operand" >> termLoop me v con cwd.
doCat me v con cwd (a :: _) = doCat1 me v con cwd a.
doCat1 me v con cwd a =
  r = rpc me v (Cat (absPath cwd a));
  renderCat con r >> drop r >> termLoop me v con cwd.
renderCat con (Ok c) = putLn con c.
renderCat con (Err m) = putLn con "cat: {m}".

doStat me v con cwd Nil = putLn con "stat: missing operand" >> termLoop me v con cwd.
doStat me v con cwd (a :: _) = doStat1 me v con cwd a.
doStat1 me v con cwd a =
  r = rpc me v (Stat (absPath cwd a));
  renderStat con r >> drop r >> termLoop me v con cwd.
renderStat con (Ok k) = putLn con k.
renderStat con (Err m) = putLn con "stat: {m}".

doWrite me v con cwd Nil = putLn con "write: usage: write <path> <text...>" >> termLoop me v con cwd.
doWrite me v con cwd (p :: rest) = doWrite1 me v con cwd p rest.
doWrite1 me v con cwd p rest =
  r = rpc me v (Write (absPath cwd p) (joinSp rest));
  renderWrite con r >> drop r >> termLoop me v con cwd.
renderWrite con (Ok s) = putLn con s.
renderWrite con (Err m) = putLn con "write: {m}".

doCd me v con cwd Nil = termLoop me v con Nil.
doCd me v con cwd (a :: _) = doCd1 me v con cwd (absPath cwd a).
doCd1 me v con cwd p =
  r = rpc me v (Stat p);
  cdFinish me v con cwd p r.
cdFinish me v con cwd p (Ok "dir") = termLoop me v con p.
cdFinish me v con cwd p (Ok k) = putLn con "cd: not a directory" >> termLoop me v con cwd.
cdFinish me v con cwd p (Err m) = putLn con "cd: {m}" >> termLoop me v con cwd.

# ---- boot: build the world, start the programs, become the terminal --------

buildTree proc counter tsrv =
  DNode
    [ ("etc", DNode
        [ ("motd", FNode "the machine is a namespace; the namespace is mostly actors"),
          ("hostname", FNode "qos-hub"),
          ("version", FNode "fpriscrv vfsh 0.2 -- per-sender mailboxes, fuel scheduling, /srv programs")
        ]),
      ("dev", DNode
        [ ("uart0", FNode "ns16550a @ 0x10000000  (you are talking through it right now)"),
          ("clint", FNode "clint @ 0x02000000  (mtime feeds /proc/uptime)"),
          ("term", MNode tsrv)
        ]),
      ("apps", DNode [("counter", MNode counter)]),
      ("proc", MNode proc),
      ("srv", DNode Nil)
    ].

main =
  me = myself 0;
  u = device "uart";
  cl = device "clint";
  con = (reg8 u 5, reg8 u 0);
  mt = reg32 cl 49144;
  tsrv = spawn (termSrv me);
  proc = spawn (procApp mt);
  counter = spawn (counterApp);
  v = spawn (vfs (buildTree proc counter tsrv));
  _ = spawn (clockFront v);
  _ = spawn (greetFront v);
  _ = spawn (reader me con);
  _ = nl con >> putLn con "qos vfsh2 -- programs in the namespace, per-sender mailboxes, fuel scheduling";
  _ = putLn con "two programs booted with the shell: ls /srv   (clock never yields; type anyway)";
  _ = putLn con "type help for commands";
  termLoop me v con Nil.
