cabal-version:      2.4
name:               fprc
version:            0.1.0.0
build-type:         Simple
synopsis:           FPRISC to RISC-V compiler

executable fprc
    main-is:          Main.hs
    other-modules:    FPRISC
                    , Codegen
                    , Modules
                    , Infer
                    , Struct
    hs-source-dirs:   .
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:    base       >=4 && <5
                    , containers
                    , mtl
                    , megaparsec >=9 && <10
                    , filepath
                    , directory
